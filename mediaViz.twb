  <worksheets>
    <worksheet name='# of videos with view spikes per day per top 5 categories'>
      <table>
        <view>
          <datasources>
            <datasource caption='mergedStats' name='federated.1qw58wv0wjm7p31db857n0t826b0' />
          </datasources>
          <datasource-dependencies datasource='federated.1qw58wv0wjm7p31db857n0t826b0'>
            <column caption='spike' datatype='integer' name='[Calculation_4203203274121216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [pctChangeViews] &gt; 0.20 THEN 1 ELSE 0 END' />
            </column>
            <column-instance column='[pctChangeViews]' derivation='Avg' name='[avg:pctChangeViews:qk]' pivot='key' type='quantitative' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column caption='Pct Change Views' datatype='real' name='[pctChangeViews]' role='measure' type='quantitative' />
            <column caption='Poll Timestamp' datatype='datetime' name='[pollTimestamp]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4203203274121216]' derivation='Sum' name='[sum:Calculation_4203203274121216:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pollTimestamp]' derivation='Day-Trunc' name='[tdy:pollTimestamp:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1qw58wv0wjm7p31db857n0t826b0].[avg:pctChangeViews:qk]' included-values='in-range'>
            <min>0.0</min>
            <max>2047.0</max>
          </filter>
          <filter class='categorical' column='[federated.1qw58wv0wjm7p31db857n0t826b0].[none:category:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:category:nk]' member='&quot;Education&quot;' />
