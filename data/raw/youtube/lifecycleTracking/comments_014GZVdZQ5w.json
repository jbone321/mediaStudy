                },
                {
                    "text": "\u0411\u044b\u043b\u043e \u0433\u0440\u0443\u0441\u0442\u043d\u043e",
                    "author": "@Giga_Mens",
                    "likes": 1,
                    "publishedAt": "2026-03-02T18:30:40Z"
                },
                {
                    "text": "\u042d\u0434\u0438\u0442 \u043a\u0440\u0443\u0442\u043e\u0439, \u043d\u043e \u043b\u0443\u0447\u0448\u0435 \u0433\u0434\u0435-\u043d\u0438\u0431\u0443\u0434\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c, \u0447\u0442\u043e \u0431\u0443\u0434\u0443\u0442 \u0441\u043f\u043e\u0439\u043b\u0435\u0440\u044b",
                    "author": "@Blinbliat",
                    "likes": 2,
                    "publishedAt": "2026-03-02T15:06:19Z"
                },
                {
                    "text": "\u041f\u0440\u0438 \u0432\u0441\u0435\u043c \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0438. (\u041b\u0430\u0439\u043a \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b)\n\u0420\u0435\u043a\u043b\u0430\u043c\u0430 \u0441\u0432\u0435\u0440\u0445\u0443, \u0432 Edit'e \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f - \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0435\u0440\u0437\u043e\u0441\u0442\u044c.\n\n\u0418\u043c\u0435\u0439\u0442\u0435 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435 \u043a \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u043c.\n\u0410 \u043d\u0435 \u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0438\u0445 \u043d\u0430 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u043b\u044c\u0441\u044b.",
                    "author": "@StemInTheOne",
                    "likes": 2,
                    "publishedAt": "2026-03-02T22:40:18Z"
                },
                {
                    "text": "\u041e\u0444\u0438\u0433\u0435\u043d\u043d\u044b\u0439 \u044d\u0434\u0438\u0442 ,\u0430 \u043a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0435\u0441\u043d\u044f \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u043d\u0435\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430?",
