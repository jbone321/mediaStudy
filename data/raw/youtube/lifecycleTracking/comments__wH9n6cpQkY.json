                    "text": "\u0412\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0435\u043b\u0435\u0441\u0442\u044c , \u0446\u0432\u0435\u0442 \u0432\u043e\u043b\u043e\u0441 - \u043e\u0433\u043e\u043d\u044c \ud83d\udd25",
                    "author": "@ANGELIKA-yq9fw",
                    "likes": 2,
                    "publishedAt": "2026-03-21T23:31:19Z"
                },
                {
                    "text": "\u041e\u0439, \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0412\u0430\u043c, \u0437\u0430 \u044d\u0442\u0443 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u2764",
                    "author": "@\u041b\u0435\u043d\u0430\u041c\u0430\u0433\u043b\u0435\u043b\u0438-\u044c7\u0437",
                    "likes": 5,
                    "publishedAt": "2026-03-21T07:02:08Z"
                },
                {
                    "text": "\u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u2764",
                    "author": "@\u0422\u0443\u0440\u0443\u0448\u0435\u0432\u0430\u041c\u0430\u0440\u0438\u043d\u0430",
                    "likes": 0,
                    "publishedAt": "2026-03-22T15:04:36Z"
                },
                {
                    "text": "\u0414\u0430\u0432\u043d\u043e \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u044e!\ud83d\ude0a",
                    "author": "@kristinateleba6537",
                    "likes": 1,
                    "publishedAt": "2026-03-22T07:37:58Z"
                },
                {
                    "text": "\u041a\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0448\u0430 \u0441\u0442\u0440\u0438\u0436\u043a\u0430? \u0412\u0430\u043c \u043e\u0447\u0435\u043d\u044c \u043a \u043b\u0438\u0446\u0443. \u041c\u043d\u0435 \u0442\u043e\u0436\u0435 \u0437\u0430\u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c.",
                    "author": "@\u041e\u043b\u044c\u0433\u0430-\u04497\u043e1\u044b",
                    "likes": 8,
                    "publishedAt": "2026-03-21T08:00:46Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e! \u2764\u042f \u0442\u0430\u043a \u0438 \u0434\u0435\u043b\u0430\u044e\ud83d\ude0a",
                    "author": "@msa3771",
                    "likes": 0,
                    "publishedAt": "2026-03-22T08:41:51Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e",
                    "author": "@\u041d\u0430\u0442\u0430\u043b\u044c\u044f-\u04417\u04479\u044f",
                    "likes": 0,
                    "publishedAt": "2026-03-22T13:27:32Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u0442\u0430\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439",
                    "author": "@\u041c\u0430\u0439\u044f\u0420\u0443\u0431\u043b\u0435\u0432\u0441\u043a\u0430\u044f",
                    "likes": 0,
                    "publishedAt": "2026-03-21T10:16:36Z"
                },
                {
                    "text": "\u041f\u043e\u0442\u0440\u044f\u0441\u0430\u044e\u0449\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e \u0432\u0441\u0435\u0445 \u0431\u043b\u0430\u0433 \u0432\u0430\u043c \u0438 \u0432\u0430\u0448\u0435\u043c\u0443 \u043a\u0430\u043d\u0430\u043b\u0443 \ud83d\ude0a",
                    "author": "@svetakostin7799",
                    "likes": 1,
                    "publishedAt": "2026-03-21T14:49:25Z"
                },
                {
                    "text": "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e \u0432\u0430\u0441 \ud83d\ude4f\n\u041e\u0447\u0435\u043d\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f!)",
                    "author": "@ElenaQ-f3y",
                    "likes": 0,
                    "publishedAt": "2026-03-21T11:34:27Z"
                },
                {
                    "text": "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e!!! \u2764\u2764\u2764",
                    "author": "@Ekaterina2525",
                    "likes": 1,
                    "publishedAt": "2026-03-21T08:10:08Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u2764",
                    "author": "@ElmiraAbykeeva-o1o",
                    "likes": 2,
                    "publishedAt": "2026-03-21T07:12:09Z"
                },
                {
                    "text": "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e",
                    "author": "@Tata-wu7wq",
                    "likes": 0,
                    "publishedAt": "2026-03-21T14:29:04Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e!!!!!\u2764\u2764\u2764\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@zxcasdf9822",
                    "likes": 1,
                    "publishedAt": "2026-03-21T13:35:37Z"
                },
                {
                    "text": "\ud83d\udc99\ud83d\udc99\ud83d\udc99\ud83d\udc99\ud83d\udc99\ud83d\udc99\ud83d\udc99 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0434\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432 \u0437\u0435\u0440\u043a\u0430\u043b\u043e \u043d\u0430 \u0441\u0435\u0431\u044f.  \n\u0423\u0447\u0435\u0441\u0442\u044c \u0441\u0432\u043e\u044e \u0432\u0435\u0441\u043e\u0432\u0443\u044e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044e. \ud83d\ude03",
                    "author": "@Free66wind",
                    "likes": 0,
                    "publishedAt": "2026-03-22T15:15:10Z"
                },
                {
                    "text": "\u2764\u2764\u2764\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@\u041c\u0430\u0440\u0442\u0426\u0435\u043d\u0442\u0440-\u04459\u0433",
                    "likes": 0,
                    "publishedAt": "2026-03-21T20:06:31Z"
                },
                {
                    "text": "\u2764\ud83c\udf89",
                    "author": "@nataliatiba5814",
                    "likes": 0,
                    "publishedAt": "2026-03-21T19:01:31Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e\u043e\u043e\u043e\u043e\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude4f\ud83d\ude18\ud83d\ude18\ud83d\ude18\ud83d\ude18",
                    "author": "@NataliZar369",
                    "likes": 0,
                    "publishedAt": "2026-03-21T15:38:33Z"
                },
                {
                    "text": "You are fantastic.",
                    "author": "@aldonalukoseviciene1896",
                    "likes": 1,
                    "publishedAt": "2026-03-21T10:08:42Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e)\n\u042f \u0442\u0430\u043a\u0436\u0435 \u0434\u0435\u043b\u0430\u044e.\n\u041f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043a\u0443\u043f\u0438\u0442\u044c \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u044b\u0435 \u0431\u0440\u044e\u043a\u0438, \u043f\u043e\u0448\u043b\u0430 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432 \u043f\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0442, \u0441 \u0447\u0435\u043c \u0441\u043e\u0447\u0435\u0442\u0430\u0442\u044c.\n\u041a\u0443\u043f\u0438\u0448\u044c, \u0430 \u043f\u043e\u0442\u043e\u043c \u043b\u0435\u0436\u0438\u0442.\n\u0415\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0439 \u0431\u043b\u043e\u0433\u0435\u0440 \u0415\u043b\u0435\u043d\u0430 \u0413\u0430\u043b\u0430\u043d\u0442, \u043e\u043d\u0430 \u043a\u043b\u0430\u0441\u0441\u043d\u043e \u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442 \u044f\u0440\u043a\u0438\u0435 \u0446\u0432\u0435\u0442\u0430. \u0415\u0449\u0451 \u0411\u043b\u044d\u0440 \u042d\u0434\u0438",
                    "author": "@gazelle-n5l",
                    "likes": 0,
                    "publishedAt": "2026-03-23T06:02:09Z"
                },
                {
                    "text": "\u041f\u0440\u0438\u0447\u0435\u0441\u043a\u0430 \u0432\u0430\u0448\u0430, \u0430 \u0434\u043b\u0438\u043d\u043d\u044b\u0435 \u043d\u0435\u0442",
                    "author": "@\u041d\u0430\u0442\u0430\u043b\u0438\u044f\u041a\u043e\u0440\u043e\u0447\u043a\u0442\u043d\u0430",
                    "likes": 3,
                    "publishedAt": "2026-03-21T10:16:36Z"
                },
                {
                    "text": "\ud83d\udcaf\ud83d\udc83\ud83d\uddff",
                    "author": "@svetlanasoboleva2120",
                    "likes": 0,
                    "publishedAt": "2026-03-21T07:35:13Z"
                },
                {
                    "text": "\u0412\u0430\u043c \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u0447\u0442\u043e \u0432\u044b \u043f\u043e\u0445\u043e\u0436\u0438 \u043d\u0430 \u0416\u0430\u043a\u043b\u0438\u043d \u041a\u0435\u043d\u043d\u0435\u0434\u0438\ud83e\udef6",
                    "author": "@\u0415\u043b\u0435\u043d\u0430\u0422\u0430\u0440\u0435\u0435\u0432\u0430-\u04487\u0433",
                    "likes": 0,
                    "publishedAt": "2026-03-22T13:42:16Z"
                },
                {
                    "text": "\u0425\u0430 \u0445\u0430 \u044f \u0442\u0430\u043a \u0438 \u0434\u0435\u043b\u0430\u044e",
                    "author": "@flamingo-957",
                    "likes": 0,
                    "publishedAt": "2026-03-21T11:58:16Z"
                },
                {
                    "text": "\u0414\u043b\u044f \u043c\u0435\u043d\u044f \u044d\u0442\u043e \u043d\u0435 \u0441\u0435\u043a\u0440\u0435\u0442\u2026\u0432\u0441\u0435 \u043c\u043e\u0438 \u043d\u0430\u0440\u044f\u0434\u044b \u043e\u0442\u0442\u0443\u0434\u0430\u2026 \u0448\u044c\u044e, \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u0443\u044e \u0438 \u043d\u043e\u0448\u0443\u2026 \u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043e\u043f\u0435\u0440\u0438\u0440\u0443\u044e\n\u041a\u0430\u043a \u0445\u043e\u0440\u043e\u0448\u043e, \u0447\u0442\u043e \u0442\u044b \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0432 \u0441\u0432\u043e\u0435\u043c \u043d\u0430\u0440\u044f\u0434\u0435 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0439 \u043d\u0435\u0442 \u0438 \u0431\u044b\u0442\u044c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442",
                    "author": "@Agnessa.ivi.neurochirurg",
                    "likes": 0,
                    "publishedAt": "2026-03-21T19:55:36Z"
                }
            ]
        }
