                },
                {
                    "text": "- \u0430 \u0432\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c?\n- \u043a\u043e\u043d\u0435\u0447\u043d\u043e?\n- \u0430 \u043f\u043e\u043a\u0430\u0436\u0438 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u044b\u0439 \u043f\u0430\u043b\u0435\u0446",
                    "author": "@\u041a\u043e\u0442\u044d-\u04378\u0438",
                    "likes": 1103,
                    "publishedAt": "2026-04-18T10:02:04Z"
                },
                {
                    "text": "\u041e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u0442\u0430\u0439\u043d\u0430\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u0442\u0441\u0443\u0442\u0441\u0432\u0443\u0435\u0442 \u043f\u0430\u043b\u0435\u0446. \u0414\u0430 \u044d\u0442\u043e \u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u043e!",
                    "author": "@ivalexser6393",
                    "likes": 1267,
                    "publishedAt": "2026-04-16T02:56:08Z"
                },
                {
                    "text": "\u041d\u0435 \u0411\u0430\u0439\u043a \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u0430 \u0410\u043b\u044c\u0442\u0430\u0438\u0440 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u042f\u0431\u043b\u043e\u043a\u0438 \u042d\u0434\u0435\u043c\u0430, \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0447\u0435\u0440\u0442\u0451\u0436  \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u043a\u0440\u044b\u0442\u043e\u0433\u043e \u043a\u043b\u0438\u043d\u043a\u0430 \u0433\u0434\u0435 \u043d\u0435 \u043e\u0431\u0435\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0440\u0435\u0437\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0431\u0435\u0437\u0438\u043c\u044f\u043d\u043d\u044b\u0439 \u043f\u0430\u043b\u0435\u0446, \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0438\u0445 \u043e\u043d \u0432 \u0441\u0432\u043e\u0451\u043c \u041a\u043e\u0434\u0435\u043a\u0441\u0435, \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \"\u041a\u043e\u0434\u0435\u043a\u0441 \u0410\u043b\u044c\u0442\u0430\u0438\u0440\u0430\" \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u044b \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u043c \u0438 \u043e\u0442\u0434\u0430\u0451\u043c \u043d\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u041b\u0435\u043e\u043d\u0430\u0440\u0434\u043e \u0414\u0430\u0432\u0438\u043d\u0447\u0438 \u0432 \u0410\u0441\u0441\u0430\u0441\u0438\u043d \u043a\u0440\u0438\u0434 2.",
                    "author": "@_Dreamer_69",
                    "likes": 888,
                    "publishedAt": "2026-04-13T17:58:37Z"
                },
                {
                    "text": "\u0417\u0430\u0431\u044b\u043b \u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0442\u044c \u0447\u0442\u043e \u0410\u043b\u044c\u0442\u0430\u0438\u0440 \u043e\u0442\u043c\u0435\u043d\u0438\u043b \u0440\u0438\u0442\u0443\u0430\u043b \u043e\u0442\u0440\u0443\u0431\u0430\u043d\u0438\u044f \u043f\u0430\u043b\u044c\u0446\u0430 \u0438 \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043f\u0430\u043b\u0435\u0446 \u0441\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0436\u0438\u0433\u0430\u0442\u044c",
                    "author": "@\u0421\u0430\u0448\u0430\u041a\u0443\u0440\u0448\u0435\u0432-\u044e2\u0441",
                    "likes": 288,
                    "publishedAt": "2026-04-13T18:24:11Z"
                },
                {
                    "text": "\u0410\u0433\u0430 \u0438 \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435 \u043f\u0430\u043b\u0438\u0448\u044c\u0441\u044f \u0431\u0435\u0437 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u043e\u0433\u043e \u043f\u0430\u043b\u044c\u0446\u0430 \u0438 \u0432 \u0431\u0435\u043b\u043e\u0439 \u043e\u0434\u0435\u0436\u0434\u0435 \ud83d\ude0a\ud83d\ude0a\ud83d\ude0a",
                    "author": "@MiracleBogdan",
                    "likes": 165,
                    "publishedAt": "2026-04-16T00:53:09Z"
                },
                {
                    "text": "\u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043c\u043d\u044e, \u043d\u0435 \u0431\u0430\u0439\u0435\u043a, \u0430 \u0410\u043b\u044c\u0442\u0430\u0438\u0440 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043a\u043b\u0438\u043d\u043e\u043a \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u043c. \u0422\u043e\u0433\u0434\u0430 \u0431\u0430\u0439\u0435\u043a \u043a\u0430\u043a \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436 \u043d\u0435 \u0431\u044b\u043b\u0434\u0430\u0436\u0435 \u0432 \u043f\u043b\u0430\u043d\u0430\u0445",
                    "author": "@utiputyman",
                    "likes": 47,
                    "publishedAt": "2026-04-16T18:10:52Z"
                },
                {
                    "text": "\u042d\u0442\u043e \u0436 \u043b\u044e\u0442\u043e\u0435 \u043f\u0430\u043b\u0435\u0432\u043e, \u0435\u0441\u043b\u0438 \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u043f\u0430\u043b\u044c\u0446\u0430-\u0437\u043d\u0430\u0447\u0438\u0442 \u0442\u044b \u0430\u0441\u0441\u0430\u0441\u0438\u043d",
                    "author": "@TretiakoffLTD",
                    "likes": 23,
                    "publishedAt": "2026-04-16T08:21:34Z"
                },
                {
                    "text": "\u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0430\u043b\u043a\u0430\u0448 \u0441 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u0433\u043e \u043f\u043e\u0434\u044a\u0435\u0437\u0434\u0430 \u0431\u044b\u043b \u0430\u0441\u0441\u0430\u0441\u0438\u043d\u043e\u043c",
                    "author": "@Babod1",
                    "likes": 0,
                    "publishedAt": "2026-04-18T13:27:25Z"
                },
                {
                    "text": "\u041a\u043e\u043b\u044c\u0446\u043e \u043d\u0430 \u0441\u0432\u0430\u0434\u044c\u0431\u0435 \u043e\u0434\u0435\u0432\u0430\u044e\u0442 \u043d\u0430 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u044b\u0439 \u043f\u0430\u043b\u0435\u0446...",
                    "author": "@\u0413\u0440\u044b\u0437\u0442\u044c_\u041a\u0430\u0448\u0430\u043a\u0438",
                    "likes": 1,
                    "publishedAt": "2026-04-18T14:13:45Z"
                },
                {
                    "text": "\u0421\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u0430\u0441\u0441\u0430\u0441\u0438\u043d\u044b \u0437\u0430 \u043a\u0430\u043d\u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u043b\u0443\u043f\u043e",
                    "author": "@Savage-3650",
                    "likes": 1,
                    "publishedAt": "2026-04-20T04:14:24Z"
                },
                {
                    "text": "\u0410\u0441\u0430\u0441\u0438\u043d\u044b : \u043d\u0435 \u043a\u0442\u043e \u043d\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0437\u043d\u0430\u0442\u044c \u043a\u0442\u043e \u043c\u044b . \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043e\u0442\u0440\u0443\u0431\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u043f\u0430\u043b\u0435\u0446 !!",
                    "author": "@\u0433\u0443\u0441\u044c\u0440\u0440\u0440\u0440",
                    "likes": 7,
                    "publishedAt": "2026-04-16T15:01:53Z"
                },
                {
                    "text": "\u041e\u0442\u0441\u0430\u0441\u0438\u043d\u044b \u0441\u0435\u0431\u0435 \u0440\u0443\u0431\u0430\u044e\u0442 \u0431\u0435\u0437 \u0438\u043c\u044f\u043d\u044b\u0439 \u043f\u0430\u043b\u0435\u0446 \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0436\u0435\u043d\u0438\u0442\u0441\u044f \ud83d\ude02",
                    "author": "@raykermeyssan2147",
                    "likes": 0,
                    "publishedAt": "2026-04-19T08:56:02Z"
                },
                {
                    "text": "\u042d\u0442\u043e \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u043e\u0434\u0430 \u0441\u043a\u0440\u044b\u0442\u043d\u043e\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043c\u043e\u043d\u0430\u0445\u0438 \u0434\u0430\u044e\u0442 \u043e\u0431\u0435\u0442 \u0431\u0435\u0437\u0431\u0440\u0430\u0447\u0438\u044f, \u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0430\u0436\u0435 \u043e\u0442\u0440\u0435\u0437\u0430\u044e\u0442 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u044b\u0439 \u043f\u0430\u043b\u0435\u0446",
                    "author": "@Gregorych34",
                    "likes": 1,
                    "publishedAt": "2026-04-18T15:36:11Z"
                },
                {
                    "text": "\u0432\u043e\u043e\u0431\u0449\u0435 \u0442\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u0411\u0430\u0439\u043a \u0430 \u0410\u043b\u044c\u0442\u0430\u0438\u0440 \u043f\u043e\u0445\u043e\u0436\u0435 \u043c\u043e\u0438 \u0443\u0447\u0435\u043d\u0438\u043a\u0438 \u043d\u0435 \u0432\u043f\u043e\u043b\u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e\u0442 \u043a\u0430\u043a \u043d\u0443\u0436\u043d\u043e \u043e\u0431\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0441 \u043a\u043b\u0438\u043d\u043a\u043e\u043c \u043c\u043e\u0436\u0435\u0442 \u0442\u044b \u043f\u043e\u043a\u0430\u0436\u0435\u0448\u044c \u0438\u043c",
                    "author": "@HoCo4ek42",
                    "likes": 1,
                    "publishedAt": "2026-04-18T10:54:55Z"
                },
                {
                    "text": "\u043e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0442\u0441\u0430\u0441\u0438\u043d\u044b",
                    "author": "@Artemiys777",
                    "likes": 1,
                    "publishedAt": "2026-04-18T10:11:06Z"
                },
                {
                    "text": "\u042f \u0431\u044b\u043b \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u043c \u043a\u043e\u0433\u0434\u0430 \u0432\u044b\u0448\u043b\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u0430\u0441\u0441\u0430\u0441\u0438\u043d \u0438 \u0442\u043e\u0433\u0434\u0430 \u0445\u043e\u0434\u0438\u043b\u0438 \u0441\u043b\u0443\u0445\u0438 \u0447\u0442\u043e \u0438\u0433\u0440\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u044f\u0445, \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0435 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0439\u0442\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0438\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u0447\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0430\u0441\u0441\u0430\u0441\u0438\u043d\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u0438\u0433\u0440\u0430 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0430\u0441\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0447\u0435\u043c \u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0438\u0433\u0440\u0430. \u0410 \u0432\u0442\u043e\u0440\u043e\u044f \u0447\u0430\u0441\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430 \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043c\u043e\u0438\u043c \u043b\u044e\u0431\u0438\u043c\u043e\u0439 \u0438\u0433\u0440\u043e\u0439.",
                    "author": "@gamecoub6305",
                    "likes": 2,
                    "publishedAt": "2026-04-17T06:18:09Z"
                },
                {
                    "text": "\u0412\u044b \u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0410\u0441\u0441\u0430\u0441\u0438\u043d\u043e\u0432 \u044d\u0442\u043e \u0432\u0430\u043c \u043d\u0435 \u0441\u043a\u0430\u0437\u043a\u0430 \u0438\u0437 \u0438\u0433\u0440",
                    "author": "@\u041c\u0430\u0433\u0430-\u04313\u044c9\u0444",
                    "likes": 1,
                    "publishedAt": "2026-04-17T13:31:14Z"
                },
                {
                    "text": "\u0427\u0442\u043e-\u0442\u043e \u043c\u043d\u0435 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u0431\u0435\u0437 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u043e\u0433\u043e \u043f\u0430\u043b\u044c\u0446\u0430 \u0431\u044b\u043b\u043e \u0431\u044b \u043e\u0447\u0435\u043d\u044c \u0442\u0440\u0443\u0434\u043d\u043e \u043f\u0430\u0440\u043a\u0443\u0440\u0438\u0442\u044c.",
                    "author": "@Surprise-MF-o4s",
                    "likes": 0,
                    "publishedAt": "2026-04-19T19:11:50Z"
                },
                {
                    "text": "\u043e\u043d\u0438 \u0441\u043a\u0440\u044b\u0442\u0430\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f",
                    "author": "@\u0411\u0430\u044d\u043b\u0414\u043e\u0441\u043e\u0435\u0432-\u0443\u0442\u043a\u0430",
                    "likes": 1,
                    "publishedAt": "2026-04-19T12:49:19Z"
                },
                {
                    "text": "\u0410\u043b\u044c\u0442\u0430\u0438\u0440 \u0441\u0434\u0435\u043b\u0430\u043b \u0447\u0435\u0440\u0442\u0435\u0436\u0438 \u0447\u0442\u043e\u0431\u044b \u0434\u043b\u044f \u043a\u043b\u0438\u043d\u043a\u0430 \u043d\u0435 \u043e\u0442\u0440\u0435\u0437\u0430\u043b\u0438 \u043f\u0430\u043b\u0435\u0446, \u0438 \u0438\u0445 \u0432\u0441\u0435\u0445 \u0430\u0441\u0441\u0430\u0441\u0441\u0438\u043d\u043e\u0432 \u043f\u0430\u043b\u0435\u0446 \u043e\u0442\u0440\u0435\u0437\u0430\u043b \u0442\u043e\u043a \u0431\u0430\u0439\u0435\u043a, \u0431\u0430\u0441\u0438\u043c, \u0438 \u0430\u043b\u044c\u0442\u0430\u0438\u0440",
                    "author": "@kkontraa",
                    "likes": 0,
                    "publishedAt": "2026-04-18T21:33:56Z"
                },
                {
                    "text": "\u0412 \u043f\u0435\u0440\u0432\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0435\u043c\u0430 \u043e\u0442\u0440\u0443\u0431\u0430\u043d\u0438\u044f \u043f\u0430\u043b\u044c\u0446\u0430. \u0422\u0430\u043c \u043f\u043e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0431\u043e\u043b\u0435\u0435 \u0441\u043a\u0440\u044b\u0442\u043d\u043e\u0433\u043e (\u0443\u0441\u043b\u043e\u0432\u043d\u043e \u0431\u043e\u043b\u0435\u0435 \u0441\u043a\u0440\u044b\u0442\u043d\u043e\u0433\u043e) \u0443\u0434\u0430\u0440\u0430 \u0441\u043a\u0440\u044b\u0442\u044b\u043c \u043a\u043b\u0438\u043d\u043a\u043e\u043c.\n\u0412 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u043b\u0435\u0446 \u043e\u0442\u0440\u0443\u0431\u0430\u043b\u0438, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430 \u043a\u043b\u0438\u043d\u043e\u043a.",
                    "author": "@jebbushwas114",
                    "likes": 2,
                    "publishedAt": "2026-04-16T05:34:43Z"
                },
                {
                    "text": "\u041e\u0444\u0438\u0433\u0435\u043d\u043d\u0430\u044f \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u0433\u0434\u0430 \u0443 \u0432\u0441\u0435\u0445 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u043d\u0435\u0442 \u0431\u0435\u0437\u044b\u043c\u044f\u043d\u043d\u043e\u0433\u043e \u043f\u0430\u043b\u044c\u0446\u0430",
                    "author": "@Alexey-i7m",
                    "likes": 0,
                    "publishedAt": "2026-04-18T20:26:29Z"
                },
                {
                    "text": "\u041e\u043d\u0438 \u043f\u043e\u0442\u043e\u043c \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u043e \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0431\u044b\u043b\u043e \u043b\u0435\u0433\u043a\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0430\u0441\u0441\u0430\u0441\u0438\u043d\u0430",
                    "author": "@Ogyre4ik228",
                    "likes": 0,
                    "publishedAt": "2026-04-17T17:13:37Z"
                }
            ]
        }
    ]
