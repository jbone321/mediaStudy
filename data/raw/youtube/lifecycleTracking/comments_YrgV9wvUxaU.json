                {
                    "text": "\u0421\u043e\u043b\u0434\u0430\u0442 \u043e\u0434\u043e\u0431\u0440\u044f\u0435\u0442",
                    "author": "@WoveGamut-s2z",
                    "likes": 9,
                    "publishedAt": "2026-04-25T18:07:29Z"
                },
                {
                    "text": "\u041d\u0443\u0436\u043d\u043e \u043a\u0440\u0435\u0441\u043b\u043e \u0432 \u0432\u0438\u0434\u0435 \u0441\u0442\u0443\u043b\u0430 \u043c\u0430\u0442\u0435\u0440\u0438 \u0413\u0430\u0431\u0435\u043d\u0430 (\u0433\u0440\u043e\u0431\u0430)",
                    "author": "@LiMoNad-D08",
                    "likes": 7,
                    "publishedAt": "2026-04-25T17:35:06Z"
                },
                {
                    "text": "\u0422\u044b \u043c\u043e\u0433 \u0431\u044b \u043f\u043e\u0448\u0443\u0442\u0438\u0442\u044c \u043f\u0440\u043e \u0431\u0443\u0442\u044b\u043b\u043a\u0443",
                    "author": "@mr-putis",
                    "likes": 3,
                    "publishedAt": "2026-04-25T18:34:30Z"
                },
                {
                    "text": "\u0414\u043b\u044f \u0438\u0433\u0440\u043e\u043a\u0430 \u0432 \u0441\u0442\u0430\u043b\u043a\u0435\u0440 \u043d\u0443\u0436\u043d\u0430 \u0444\u0438\u0433\u0443\u0440\u043a\u0430 \u043c\u043e\u043d\u043e\u043b\u0438\u0442\u0430.",
                    "author": "@ghost023-e3q",
                    "likes": 5,
                    "publishedAt": "2026-04-25T17:10:09Z"
                },
                {
                    "text": "\u042f \u043d\u043e\u0448\u0443 \u0445\u043b\u0435\u0431 \u0441 \u0441\u043e\u0431\u043e\u0439 \u043a\u0430\u0436\u0434\u044b\u0439 \u0447\u00eb\u0440\u0442\u043e\u0432 \u0434\u0435\u043d\u044c",
                    "author": "@KurwaBobr69",
                    "likes": 1,
                    "publishedAt": "2026-04-25T19:11:41Z"
                },
                {
                    "text": "\u041f\u0440\u043e \u0441\u043a\u043e\u0440\u043f\u0438\u043e\u043d\u0430 \u0436\u0438\u0437\u0430 \u0432 \u0440\u0435\u043a\u0430\u0445 \u043f\u0430\u0434\u0430\u0435\u0442 \u0442\u0438\u043f\u043e \u00ab\u044d\u0442\u043e\u0442 \u043f\u0430\u0440\u0435\u043d\u044c \u0432\u044b\u0438\u0433\u0440\u0430\u043b \u0447\u0430\u0441 \u043d\u0430 \u0441\u0442\u0443\u043b\u0435 \u0441\u043a\u043e\u0440\u043f\u0438\u043e\u043d\u0435\u00bb \u0430 \u043d\u0430\u0444\u0438\u0433\u0430 \u043e\u043d \u043d\u0435 \u043f\u043e\u043d\u044f\u0442\u043d\u043e",
                    "author": "@ARdhds",
                    "likes": 0,
                    "publishedAt": "2026-04-25T19:59:50Z"
                },
                {
                    "text": "\u0423\u0432\u0435\u0440\u0443\u0439\u0442\u0435 \u0432 \u043c\u043e\u043d\u043e\u043b\u0438\u0442, \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430, \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044e \u0438 \u0432 \u043c\u0433\u0435 \u043f\u0430\u0440\u0430\u0432\u043e\u0437\u0438\u043a",
                    "author": "@eeg-isaac",
                    "likes": 1,
                    "publishedAt": "2026-04-25T17:36:10Z"
                },
                {
                    "text": "\u0442\u0435\u0440\u0440\u0430\u0440\u0438\u044f: \u0442\u0435\u0440\u0440\u0430\u0443\u043d\u0438\u0442\u0430\u0437, \u043a\u0443\u043a\u043b\u0430 \u0432\u0443\u0434\u0443 \u0440\u044b\u0431\u0430\u043a\u0430, \u0440\u0451\u0431\u0440\u044b\u0448\u043a\u0438 \u043f\u0430\u043b\u0430\u0434\u0438\u043d\u0430",
                    "author": "@dimooooooooooooooooooooooooon",
                    "likes": 0,
                    "publishedAt": "2026-04-25T19:50:00Z"
                },
                {
                    "text": "\u0410 \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0444\u0430\u043d\u0430\u0442\u0430\u043c Warhammer",
                    "author": "@ekaterine3589",
                    "likes": 0,
                    "publishedAt": "2026-04-25T21:12:40Z"
                },
                {
                    "text": "\u0415\u0441\u043b\u0438 \u043e\u043d \u0441\u043a\u0430\u0436\u0435\u0442 \u0447\u0442\u043e\u0442\u043e \u043f\u0440\u043e \u0430\u043d\u0434\u0435\u0440\u0442\u0435\u0439\u043b \u0442\u043e \u044f \u0441\u043b\u043e\u043c\u0430\u044e 2 \u043f\u043b\u0430\u0448\u043a\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043a\u0438 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0438\u0433\u043e\u0432",
                    "author": "@Tehcnotrak",
                    "likes": 1,
                    "publishedAt": "2026-04-25T18:16:36Z"
                },
                {
                    "text": "\u041f\u0440\u043e \u0434\u0430\u0440\u043a \u0441\u043e\u0443\u043b\u0441 \u044d\u0442\u043e \u0434\u0430(. \u0414\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0440\u043e \u043b\u044e\u0431\u043e\u0439 \u0441\u043e\u0443\u0441\u043b\u0430\u0439\u043a. \u041a\u0430\u043a \u0436\u0435 \u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0431\u043e\u043c\u0431\u0438\u043b \u043e\u0442 \u0443\u0436\u0435 20 \u0441\u043b\u0438\u0432\u0430. \u041d\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u043f\u043e\u0431\u0435\u0434\u0430!!!",
                    "author": "@Loloshkadan",
                    "likes": 1,
                    "publishedAt": "2026-04-25T18:12:24Z"
                },
                {
                    "text": "\u0425\u043b\u0435\u0431 \u0432\u0441\u0435\u043c\u0443 \u0433\u043e\u043b\u043e\u0432\u0430 \u0432 \u043f\u0440\u044f\u043c\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435 \ud83d\udc80",
                    "author": "@Deadpo_ol_228",
                    "likes": 0,
                    "publishedAt": "2026-04-25T17:24:02Z"
                },
                {
                    "text": "\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u043b \u0425\u041b\u0415\u0411!",
                    "author": "@\u0411\u043e\u0440\u0438\u0441-\u044d3\u043f",
                    "likes": 0,
                    "publishedAt": "2026-04-25T21:25:37Z"
                },
                {
                    "text": "\u0410\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440 \u0434\u043b\u044f \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u043e\u0432 \u044d\u0442\u043e \u043c\u043e\u043d\u043e\u043b\u0438\u0442 \u043d\u0430 \u0431\u0440\u0435\u043b\u043a\u0435",
