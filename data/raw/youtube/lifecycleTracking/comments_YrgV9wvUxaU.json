                    "publishedAt": "2026-04-25T18:11:15Z"
                },
                {
                    "text": "\u0423\u0432\u0435\u0440\u0443\u0439\u0442\u0435 \u0432 \u041c\u043e\u043d\u043e\u043b\u0438\u0442",
