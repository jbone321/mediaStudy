                    "likes": 0,
                    "publishedAt": "2026-04-25T17:21:57Z"
                },
                {
                    "text": "\u0421\u0434\u0435\u043b\u0430\u0439 \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u043a\u0443 \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u0442\u04442 \u043f\u0440\u043e\u0448\u0443 \u043f\u043e\u043b\u0442\u043e\u0440\u0430 \u043c\u0435\u0441\u044f\u0446\u0430",
                    "author": "@DmitryBond-u7j",
                    "likes": 1,
                    "publishedAt": "2026-04-25T17:13:21Z"
                },
                {
                    "text": "\u0410\u0425\u0410\u0425\u0410\u0425\u0410, \u042f \u0412\u042b\u0415\u0411\u0410\u041b \u0425\u041b\u0415\u0411",
                    "author": "@DobriHeavy",
                    "likes": 0,
                    "publishedAt": "2026-04-25T20:30:35Z"
                },
                {
                    "text": "\u0418 \u0435\u0449\u0435 \u043d\u0435 \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u043c \u043f\u0440\u043e \u043a\u0443\u0440\u043e\u0447\u043a\u0443 \u043a\u0444\u0441 \u0435\u0441\u043b\u0435 \u0432 \u043a\u0430\u0442\u043a\u0435 \u043f\u043e\u043f\u0430\u043b\u0430\u0441\u044c \u0436\u0435\u043d\u0449\u0438\u043d\u0430",
                    "author": "@Frostbear.207",
                    "likes": 0,
                    "publishedAt": "2026-04-25T20:03:41Z"
                },
                {
                    "text": "\u0414\u041b\u042f \u0425\u041e\u0419\u0429\u0418\u041a\u041e\u0412 \u041d\u0423\u0416\u041d\u041e \u0423\u0414\u0410\u041b\u0418\u0422\u042c \u041f\u041e\u041d\u042f\u0422\u0418\u0415 \u041b\u0418\u0427\u041d\u0410\u042f \u0416\u0418\u0417\u041d\u042c",
