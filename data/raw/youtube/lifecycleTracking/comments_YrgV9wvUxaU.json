                    "likes": 0,
                    "publishedAt": "2026-04-25T21:14:25Z"
                },
                {
                    "text": "\u041e\u0431\u043b\u043e\u043c\u043e\u0432 \u043e\u0434\u043e\u0431\u0440\u0438\u043b",
                    "author": "@GamesikTV",
