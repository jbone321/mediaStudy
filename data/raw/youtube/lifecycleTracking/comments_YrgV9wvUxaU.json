                {
                    "text": "\u0412\u0430\u0448 \u043b\u0443\u0447\u0448\u0438\u0439 \u0430\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440 \u2014 \u0432\u0435\u0440\u0430 \u0432 \u043c\u043e\u043d\u043e\u043b\u0438\u0442",
