                    "likes": 1,
                    "publishedAt": "2026-03-23T18:24:48Z"
                },
                {
                    "text": "\u0417\u0434\u043e\u0440\u043e\u0432\u043e \u043a\u0430\u043a \u0431\u0440\u0430\u0432\u043e",
