                },
                {
                    "text": "\u041a\u0430\u043a \u0445\u043e\u0440\u043e\u0448\u043e \u0447\u0442\u043e \u0432\u0441\u0435 \u043d\u0443\u0436\u043d\u044b\u0435 \u043c\u043d\u0435 \u0438\u0433\u0440\u044b \u0443\u0436\u0435 \u043d\u0430 \u0442\u043e\u0440\u043d\u0435\u0442\u0430\u0445 ,\u0440\u0430\u0437\u0432\u0435 \u0447\u0442\u043e \u043a\u0440\u0438\u043c\u0441\u0435\u043d \u0434\u0451\u0437\u0435\u0440\u0442 \u043d\u0435\u0442\u0443 ,\u043d\u043e \u044d\u0442\u043e \u0443\u0436\u0435 \u0434\u0435\u0442\u0430\u043b\u0438",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0435\u0439\u0424\u0451\u0434\u043e\u0440\u043e\u0432-\u044f9\u0442",
                    "likes": 0,
                    "publishedAt": "2026-03-28T11:20:57Z"
                },
                {
                    "text": "\u0412\u0441\u0435 \u0435\u0449\u0435 \u043b\u0443\u0447\u0448\u0435 \u0447\u0435\u043c \u0441\u0442\u0430\u0440 \u0444\u043e\u0440\u0441. \u041f\u0440\u0438\u0447\u0435\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0445: \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0432.",
                    "author": "@nordwind8347",
                    "likes": 0,
                    "publishedAt": "2026-03-27T18:16:30Z"
                },
                {
                    "text": "\u041f\u0440\u043e\u0432\u043e\u0434\u0438\u043b\u0438\u0441\u044c \u0436\u0435 \u0443\u0436\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430 \u044d\u0442\u0443 \u0442\u0435\u043c\u0443, \u043d\u0443 \u043d\u0435 \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0430\u043d\u0442\u0438\u043f\u0438\u0440\u0430\u0442\u0441\u043a\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u043f\u043e\u0442\u0440\u0430\u0442\u044f\u0442 \u0442\u0435, \u043a\u0442\u043e \u0438\u043b\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043a\u0443\u043f\u0438\u0442\u044c, \u0438\u043b\u0438 \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0432\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043f\u0438\u0440\u0430\u0442\u043a\u0443 \u043a\u0430\u043a \u0434\u0435\u043c\u043a\u0443 \u0438, \u0435\u0441\u043b\u0438 \u0438\u0433\u0440\u0430 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u0430\u0441\u044c, \u043f\u043e\u043a\u0443\u043f\u0430\u044e\u0442. \u042f\u0440\u043a\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440 - \u0441\u0438\u043b\u043a\u0441\u043e\u043d\u0433, \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u0430 \u0438\u0433\u0440\u0430 \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u043d\u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0430 \u0421\u0442\u0438\u043c.",
                    "author": "@\u0412\u0430\u043b\u0435\u0440\u0438\u0439\u0413\u043e\u0440\u0431\u0443\u043d\u043e\u0432-\u04433\u0434",
                    "likes": 0,
                    "publishedAt": "2026-03-28T05:12:12Z"
                },
                {
                    "text": "\u042d\u0442\u043e \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u043d\u0435 \u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442 secure boot \u0438 \u043f\u0440\u043e\u0447\u0435\u0433\u043e \u0432\u0435\u0441\u0435\u043b\u044c\u044f? \u042f \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0430\u0432\u043d\u043e \u043d\u0435 \u0438\u0433\u0440\u0430\u044e \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u0438 \u043d\u0435 \u0441\u043b\u0435\u0436\u0443 \u0437\u0430 \u044d\u0442\u0438\u043c",
                    "author": "@9dgames277",
                    "likes": 1,
                    "publishedAt": "2026-03-27T18:23:14Z"
                },
                {
                    "text": "\u0431\u043b\u0430\u0433\u043e, \u0435\u0435 \u043d\u0430\u0443\u0447\u0438\u043b\u0438\u0441\u044c \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0430\u0440\u0443 \u043d\u0435\u0434\u0435\u043b\u044c \u043d\u0430\u0437\u0430\u0434, \u043d\u0430 \u0434\u043d\u044f\u0445 \u043d\u0430\u0447\u0430\u043b \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u044c HV \u0432\u0435\u0440\u0441\u0438\u0438 \u0440\u0435\u043f\u0430\u043a\u043e\u0432 \u0438\u0433\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0431\u0435\u0437 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0438",
                    "author": "@MrEvgenik87",
                    "likes": 0,
                    "publishedAt": "2026-03-28T03:53:07Z"
                },
                {
                    "text": "\u0414\u0435\u043d\u0443\u0432\u043e \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0435\u0442 SATA ssd, \u0432\u0438\u0434\u0435\u043b \u0442\u0435\u0441\u0442\u044b \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u0438\u0433\u0440\u044b \u0432 \u0438\u0433\u0440\u044b \u0441 \u0434\u0435\u043d\u0443\u0432\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0434\u0438\u0441\u043a\u0430 \u0443\u043b\u0435\u0442\u0430\u0435\u0442 \u0432 \u0430\u0434.",
                    "author": "@MusCat1313",
                    "likes": 0,
                    "publishedAt": "2026-03-27T21:22:25Z"
                },
                {
                    "text": "\ud83c\udff4\u200d\u2620\ufe0f",
                    "author": "@wolf_pf7684",
                    "likes": 0,
                    "publishedAt": "2026-03-28T03:31:06Z"
                },
                {
                    "text": "\u0418 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0434\u043d\u0438 \u0447\u0435\u0440\u0435\u0437 \u044d\u043c\u0443\u043b\u044f\u0446\u0438\u044e \u0433\u0438\u043f\u0435\u0440\u0432\u0438\u0437\u043e\u0440\u0430 \u043d\u0430\u0448\u043b\u0438 \u0441\u043f\u043e\u0441\u043e\u0431 \u0441\u043b\u043e\u043c\u0430\u0442\u044c \u0435\u0451. \u0414\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0438\u0440\u0430\u0442\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u0442\u0430\u043a\u0438\u0445!",
                    "author": "@\u0410\u043d\u0442\u043e\u043d\u0418\u043b\u044c\u0438\u043d-\u04457\u044c",
                    "likes": 4,
