                    "likes": 42,
                    "publishedAt": "2026-03-19T13:47:24Z"
                },
                {
                    "text": "YouTube\u3067\u3053\u306e\u4f5c\u54c1\u3092\u77e5\u308a\n\u6f2b\u753b\u307e\u3067\u9061\u3063\u3066\u5168\u3066\u62dd\u898b\u3057\u307e\u3057\u305f\uff0e\n\n\u914d\u5f79\u304c\u30c9\u30f3\u30d4\u30b7\u30e3\u3059\u304e\u3066\n\u6f2b\u753b\u3092\u5b9f\u5199\u5316\u3057\u305f\u4f5c\u54c1\u3067\u306f\n\u5727\u5012\u7684\u306a\u3093\u3058\u3083\u306a\u3044\u304b\u3068\u601d\u3044\u307e\u3059\u2026\n\n\u30c8\u30e9\u3055\u3093\u306e\u95a2\u897f\u5f01\u304c\n\u95a2\u897f\u4eba\u304c\u805e\u3044\u3066\u3082\u9055\u548c\u611f\u304c\u306a\u3044\u3068\u3044\u3046\u304b\n\u4e0d\u5feb\u611f\u304c\u306a\u304f\u3066\u3073\u3063\u304f\u308a\u3057\u307e\u3057\u305f\u3002",
                    "author": "@Aajdabc",
                    "likes": 30,
                    "publishedAt": "2026-03-19T23:47:40Z"
                },
                {
                    "text": "\u4e80\u68a8\u306e\u864e\u3061\u3083\u3093\u6700\u9ad8\uff01",
                    "author": "@\u30b8\u30a7\u30a4\u30af\u30b8\u30ec\u30f3\u30db\u30fc\u30eb",
                    "likes": 39,
                    "publishedAt": "2026-03-19T11:51:19Z"
                },
                {
                    "text": "\u30c8\u30e9\u4f3c\u3066\u308b \u96f0\u56f2\u6c17\u3042\u3063\u3066\u30ab\u30c3\u30b3\u3044\u3044 \u54f2\u592a\u512a\u3057\u3044",
                    "author": "@\u6c5f\u53e4\u7530\u304f\u308a\u30fc\u3080\u305d\u30fc\u3060",
                    "likes": 35,
                    "publishedAt": "2026-03-19T10:23:38Z"
                },
                {
                    "text": "\u4e80\u68a8\u304f\u3093\u3001\u7dba\u9e97\u306a\u9854\u3084\u306a\u30fc\u3001\u3046\u3064\u304f\u3057\u30fc\u306d\u30fc\u3001\u307f\u305f\u3044\u306a\u30a4\u30e1\u30fc\u30b8\u304c\u3042\u3063\u305f\u3051\u3069\u3001\u30a2\u30a6\u30c8\u30ed\u30fc\u4f3c\u5408\u3044\u904e\u304e\u3066\u597d\u304d\u3002\n\u3054\u304f\u305b\u3093\u306e\u3068\u304d\u306f\u3001\u7d30\u3044\u5b50\u4f9b\u30e4\u30f3\u30ad\u30fc\u3063\u3066\u611f\u3058\u3060\u3063\u305f\u3051\u3069\u3001\u307b\u3093\u307e\u3082\u3093\u306e\u30a2\u30a6\u30c8\u30ed\u30fc\u3082\u4f3c\u5408\u3046\u306d\u3002",
                    "author": "@\u30bd\u30eb\u30c8\u30ad\u30e3\u30c3\u30c8",
                    "likes": 1,
                    "publishedAt": "2026-03-20T07:06:43Z"
                },
                {
                    "text": "\u5b9f\u969b\u306b\u6bba\u3057\u5c4b\u3068\u304b\u59cb\u672b\u5c4b\u3063\u3066\u3044\u3066\u3082\u3044\u3044\u3068\u601d\u3046\u3093\u3060\u3088\u306a\u301c\n\u65e5\u672c\u306e\u5211\u7f70\u304c\u8efd\u3059\u304e\u308b",
                    "author": "@user-xo9wn4rd9s",
                    "likes": 26,
                    "publishedAt": "2026-03-19T12:53:54Z"
                },
                {
                    "text": "\u4eca\u306e\u4e16\u306e\u4e2d\u306b\u3082\u4ed5\u4e8b\u4eba\u3084\u5fa9\u8b90\u5c4b\u304c\u5fc5\u8981\u4e0d\u53ef\u6b20\u3067\u3059\u306d\ud83d\ude0a",
