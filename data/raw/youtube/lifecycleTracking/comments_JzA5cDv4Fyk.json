                },
                {
                    "text": "\u6771\u689d\u82f1\u6a5f\u304c\u5b98\u623f\u9577\u5b98\u306b\u306a\u3063\u305f\u306a\u3089\u7dcf\u7406\u304c\u3069\u3093\u306a\u80fd\u529b\u3069\u3093\u306a\u4eba\u7269\u3060\u3063\u305f\u3068\u3057\u3066\u30823\u5e74\u4ee5\u4e0a\u6301\u305f\u305b\u305f\u540d\u30b5\u30dd\u30fc\u30bf\u30fc\u306b\u306a\u3063\u305f\u3060\u308d\u3046\u306a",
