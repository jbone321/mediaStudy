                    "likes": 20,
                    "publishedAt": "2026-03-28T12:45:52Z"
                },
                {
                    "text": "\u307e\u3055\u3057\u304f\u53c2\u8b00\u8077\u306b\u7279\u5316\u3057\u305f\u624d\u899a\u306e\u4eba\u7269\u3002",
