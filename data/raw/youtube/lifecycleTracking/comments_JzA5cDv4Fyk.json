                    "likes": 0,
                    "publishedAt": "2026-03-28T14:29:39Z"
                },
                {
                    "text": "\u5148\u65e5\u306e\u5b66\u6821\u6642\u4ee3\u306e\u52d5\u753b\u306e\u8a71\u3068\u3001\u3053\u306e\u52d5\u753b\u306e\u8a71\u3068\u3001\u5225\u4eba\u7269\u306b\u3064\u3044\u3066\u306e\u8a71\u306e\u3088\u3046\u306a\u611f\u3058\u304c\u3057\u307e\u3059\u306d",
                    "author": "@\u6c60\u7530\u88d5-e9h",
                    "likes": 1,
                    "publishedAt": "2026-03-28T12:59:40Z"
                },
                {
                    "text": "\u826f\u3044\u4eba\uff06\u6709\u80fd\u306a\u4eba\u304c\u56fd\u306e\u30ea\u30fc\u30c0\u30fc\u306b\u5411\u3044\u3066\u308b\u304b\u3068\u3044\u3046\u3068\u3001\u5373\u7b54\u3067\u304d\u306a\u3044\u6240\u304c\u3042\u308b\u306e\u306f\u3001\u73fe\u4ee3\u3067\u3082\u901a\u3058\u308b\u6240\u304c\u3042\u308b\u3068\u611f\u3058\u307e\u3059\u3002",
                    "author": "@gun_mastar4971",
                    "likes": 0,
                    "publishedAt": "2026-03-28T13:35:25Z"
                },
                {
                    "text": "\u78ba\u304b\u306b\u3001\u6709\u80fd\u306a\u5b98\u50da\u3067\u3044\u305f\u307b\u3046\u304c\u3053\u306e\u4eba\u3082\u5e78\u305b\u3060\u3063\u305f\u308d\u3046\u306a\u3002",
                    "author": "@nimosan3799",
                    "likes": 0,
                    "publishedAt": "2026-03-28T14:58:05Z"
                },
                {
                    "text": "\u7dcf\u7406\u5927\u81e3\u306b\u306f\u4e0d\u9069\u683c\u3002",
                    "author": "@\u30b8\u30e7\u30fc\u30b8\u30a2S",
                    "likes": 1,
                    "publishedAt": "2026-03-28T13:52:08Z"
                },
                {
                    "text": "\u751f\u7c8b\u306e\u5b98\u50da\u4eba\u9593",
                    "author": "@eastchickenrepublic",
                    "likes": 0,
                    "publishedAt": "2026-03-28T14:22:57Z"
                },
                {
                    "text": "\u771f\u9762\u76ee\u3055\u3086\u3048\u306b\u3001\u3042\u308c\u3082\u3053\u308c\u3082\u5168\u90e8\u4e00\u4eba\u3067\u62b1\u3048\u3066\u3057\u307e\u3046\u4eba\u304c\u3044\u308b\u3002\u4ed5\u4e8b\u306e\u8a71\u3067\u3042\u308c\u3070\u3001\u672c\u6765\u8907\u6570\u4eba\u3067\u5206\u62c5\u3057\u3066\u3084\u308b\u3079\u304d\u4ed5\u4e8b\u3092\u5168\u90e8\u4e00\u4eba\u3067\u3084\u3063\u3066\u3057\u307e\u3046\u3068\u3044\u3046\u611f\u3058\u3067\u3042\u308b\u3002\u6771\u689d\u3082\u305d\u3046\u3044\u3063\u305f\u4eba\u7269\u306e\u4e00\u4eba\u3060\u3063\u305f\u306e\u3067\u306f\u306a\u3044\u304b\u3068\u601d\u3046\u3002\n\u305f\u3060\u3001\u305d\u3046\u3044\u3063\u305f\u30ef\u30f3\u30de\u30f3\u7d4c\u55b6\u306f\u9577\u671f\u7684\u306b\u898b\u308c\u3070\u3044\u3044\u4e8b\u306f\u306a\u3044\u3002\u512a\u79c0\u306a\u4eba\u6750\u304c\u80b2\u305f\u306a\u3044\u3057\u3001\u3088\u305d\u304b\u3089\u5f15\u304d\u629c\u304f\u4e8b\u3082\u3046\u307e\u304f\u3067\u304d\u306a\u3044\u3002\uff08\u5b54\u660e\u3068\u5289\u90a6\u306e\u6bd4\u8f03\u304c\u308f\u304b\u308a\u3084\u3059\u3044\u304b\u3082\u3057\u308c\u306a\u3044\u3002\uff09",
                    "author": "@\u30c9\u30e9\u30b4\u30f3\u30c4\u30c3\u30c1\u30fc",
                    "likes": 3,
                    "publishedAt": "2026-03-28T12:19:46Z"
                },
                {
                    "text": "\u6bce\u56de\u6771\u689d\u304c\u3044\u3068\u3053\u306b\u4f3c\u3066\u308b\u3068\u601d\u3046\u3093\u3060\u3088\u306a",
                    "author": "@zaizen-naniwa",
                    "likes": 1,
                    "publishedAt": "2026-03-28T12:28:14Z"
                },
                {
                    "text": "\u771f\u9762\u76ee\u3067\u8ce2\u3044\u4eba\u3060\u3063\u305f\u3093\u3067\u3059\u306d\u3000\u305f\u3060\u3001\u305d\u308c\u3060\u3051\u3067\u3057\u304b\u306a\u304b\u3063\u305f",
                    "author": "@damdamatuko",
                    "likes": 0,
                    "publishedAt": "2026-03-28T13:16:19Z"
                },
                {
                    "text": "\u6c38\u7530\u9244\u5c71\u304c\u751f\u304d\u3066\u3044\u305f\u3089\u6771\u689d\u306e\u51fa\u308b\u5e55\u306f\u7121\u304b\u3063\u305f\u3068\u3044\u3046\u4e8b\u3002",
                    "author": "@\u614e\u543e\u5800-r7w",
                    "likes": 0,
                    "publishedAt": "2026-03-28T14:32:22Z"
                },
                {
                    "text": "\u3042\u304f\u307e\u3067\u79c1\u898b\u3060\u304c\u3001\n\u8fd1\u4ee3\u7248\u3001\n\u300c\u77f3\u7530\u4e09\u6210\u300d\u3068\n\u8a00\u3063\u305f\u3068\u3053\u308d\u304b\u2026\u3002\n\n\u300c\u6307\u5c0e\u8005\u306e\u4e0b\u3067\u50cd\u3051\u3070\u3001\n\u3000\u6709\u80fd\u300d\n\u304b\u3082\u3057\u308c\u306a\u3044\u304c\u3001\n\u300c\u56fd\u5bb6\u3084\u5927\u898f\u6a21\u7d44\u7e54\u306e\n\u3000\u6307\u5c0e\u8005\u3068\u3057\u3066\u306f\u3001\n\u3000\u4e0d\u9069\u683c\u300d\n\u306a\u306e\u304b\u3082\u3002\n\n\u52d5\u753b\u3067\u8a00\u308f\u308c\u308b\u69d8\u306b\u3001\n\u6307\u5c0e\u8005\u30bf\u30a4\u30d7\u3067\u306f\u7121\u304f\u3001\n\u5b98\u50da(\u4e2d\u9593\u7ba1\u7406\u8077)\n\u30bf\u30a4\u30d7\u3060\u308d\u3046\u306a\u2026\u3002\n\n\u3060\u304b\u3089\u3068\u8a00\u3063\u3066\u3001\n\u6771\u689d\u3092\n\u64c1\u8b77\u3092\u3057\u305f\u304f\u306f\u7121\u3044\u304c\u3002",
                    "author": "@Rim_mu_Saeshichi",
                    "likes": 5,
                    "publishedAt": "2026-03-28T12:23:54Z"
                },
                {
                    "text": "\u77f3\u7530\u4e09\u6210\u307f\u305f\u3044\u306a\u4eba\u3084\u306a",
                    "author": "@\u30e4\u30e0\u30c1\u30e3-g2h",
                    "likes": 2,
                    "publishedAt": "2026-03-28T12:33:55Z"
                },
                {
                    "text": "\u5e73\u6642\u306e\u80fd\u540f\u3002\n\u3057\u304b\u3057\u6226\u6642\u306b\u3042\u3063\u3066\u306f\u22ef\u22ef\n\u672c\u6765\u306a\u3089\u958b\u6226\u3092\u907f\u3051\u3089\u308c\u306a\u304b\u3063\u305f\u6642\u70b9\u3067\u8f9e\u8077\u3059\u3079\u304d\u3068\u306f\u8a00\u3048\u3001\u307e\u3055\u304b\u958b\u6226\u76f4\u524d\u306b\u305d\u308c\u306f\u51fa\u6765\u305a\u3001\u958b\u6226\u76f4\u5f8c\u306e\u5927\u6226\u679c\u3068\u3042\u3063\u3066\u306f\u8f9e\u8077\u306a\u3069\u3057\u305f\u3089\u300c\u4e00\u4f53\u4f55\u306a\u3093\u3060\u300d\u3068\u306a\u3063\u3066\u3057\u307e\u3046\u3002",
                    "author": "@\u30d5\u30ed\u30e0\u30d5\u30ed\u30e0",
                    "likes": 0,
                    "publishedAt": "2026-03-28T12:30:41Z"
                },
                {
                    "text": "\u5e73\u6642\u306e\u9678\u8ecd\u5927\u81e3\u3060\u3063\u305f\u3089\u6700\u9ad8\u3060\u3063\u305f\u306d",
                    "author": "@\u9577\u8c37\u5ddd-n3e",
