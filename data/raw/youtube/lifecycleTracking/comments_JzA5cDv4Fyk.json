                },
                {
                    "text": "\u300c\u9678\u8ecd\u5927\u81e3\u300d\u3067\u306f\u306a\u304f\u300c\u9678\u8ecd\u6b21\u5b98\u300d\u5411\u304d\u306e\u4eba",
