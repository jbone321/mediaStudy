                {
                    "text": "\u0623\u0647\u0644\u0627\u064b \u0628\u0643\u0645 \u0641\u064a \u0627\u0644\u062d\u0644\u0642\u0629 18 \u0645\u0646 \u0645\u0633\u0644\u0633\u0644 #\u0639\u064a\u0644\u0629_\u0627\u0644\u0645\u0644\u0643! \ud83d\udd25 \u0647\u0646\u0627\u062f\u064a \u0628\u0644\u0634\u062a \u062a\u0636\u0631\u0628 \u0648\u0645\u0648 \u0634\u0627\u064a\u0641\u0629 \u062d\u062f\u0627 \u0642\u062f\u0627\u0645\u0647\u0627! \u0628\u0631\u0623\u064a\u0643\u0645 \u0645\u064a\u0646 \u0627\u0644\u0636\u062d\u064a\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0627\u0646\u062a\u0642\u0627\u0645\u0647\u0627\u061f \u0648\u0645\u0627\u0632\u0646 \u0627\u0644\u0644\u064a \u0639\u0645 \u064a\u0644\u0639\u0628 \u0628\u0627\u0644\u0646\u0627\u0631 \u0648\u064a\u0628\u062a\u0632 \u0627\u0644\u0643\u0628\u0627\u0631 \u0628\u0627\u0644\u0648\u062b\u0627\u0626\u0642\u060c \u0631\u062d \u064a\u0646\u062c\u0649 \u0628\u0641\u0639\u0644\u062a\u0647 \u0648\u0644\u0627 \u0631\u062d \u064a\u0648\u0631\u0637 \u0627\u0644\u0639\u064a\u0644\u0629 \u0628\u0643\u0627\u0631\u062b\u0629 \u062c\u062f\u064a\u062f\u0629\u061f \ud83e\udd14 \u0641\u062c\u0651\u0631\u0648\u0627 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0628\u062a\u0648\u0642\u0639\u0627\u062a\u0643\u0645 \u0648\u0644\u0627 \u062a\u0646\u0633\u0648\u0627 \u0627\u0644\u0644\u0627\u064a\u0643 \u0648\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0628\u0627\u0644\u0642\u0646\u0627\u0629! \ud83d\udc47\ud83c\udf7f",
