                }
            ]
        },
        {
            "fetchedAt": "20260302_081005",
            "commentCount": 7,
            "comments": [
                {
                    "text": "\u0644\u0627 \u062d\u0648\u0644\u0627 \u0648\u0644\u0627 \u0642\u0648\u0629 \u0625\u0644\u0627 \u0628\u0627\u0644\u0644\u0647",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:38:26Z"
                },
                {
                    "text": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645\n\n\u0644\u0627 \u0627\u0644\u0647 \u0627\u0644\u0627 \u0627\u0644\u0644\u0647   \u0645\u062d\u0645\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T16:59:13Z"
                },
                {
                    "text": "\u0644\u0627 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u062a\u0643\u0648\u0646 \u0647\u0646\u0627\u0643 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0644\u0627 \u064a\u062a\u0645 \u062a\u0646\u0641\u064a\u0630\u0647\u0627 \u0628\u064a\u0646\u0645\u0627 \u0625\u064a\u0631\u0627\u0646 \u0648\u0625\u0633\u0631\u0627\u0626\u064a\u0644 \u062a\u062d\u0627\u0631\u0628\u0627\u0646 \u0623\u0645\u0631\u064a\u0643\u0627 \u0648\u0625\u0633\u0631\u0627\u0626\u064a\u0644.",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:04:24Z"
                },
                {
                    "text": "\u0644\u0646 \u0646\u0642\u062f\u0645 \u0635\u0648\u0631\u0629 \u0644\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0623\u0648\u0647\u0627\u0645 \u064a\u062c\u0628 \u062a\u0635\u062f\u064a\u0642\u0647\u0627\u060c \u0648\u0644\u0643\u0646\u0646\u0627 \u0633\u0646\u0634\u0627\u0631\u0643 \u0641\u064a \u062a\u0639\u0632\u064a\u0632 \u062b\u0642\u0629 \u062c\u0645\u064a\u0639 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629 \u0641\u064a \u062a\u0646\u0641\u064a\u0630 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645 \u0625\u0639\u062f\u0627\u062f\u0647\u0627 \u0628\u062b\u0642\u0629 \u0648\u0623\u0645\u0627\u0646\u0629.",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:02:45Z"
                },
                {
                    "text": "\u0645\u0646\u0630 \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0648\u062d\u062a\u0649 \u0627\u0644\u0622\u0646\u060c \"\u0625\u0646 \u0627\u0644\u062a\u0633\u0627\u0645\u062d \u0645\u0639 \u0627\u0644\u062a\u062e\u0631\u064a\u0628 \u062e\u0637\u0623 \u0643\u0628\u064a\u0631 \u0641\u064a \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629\".  \n\n\u062a\u0623\u0643\u062f\u0648\u0627 \u0645\u0646 \u0623\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u062a\u064f\u0639\u0643\u0633 \u0648\u062a\u064f\u0638\u0647\u0631 \u0643\u064a\u0641 \u062a\u064f\u0633\u062a\u062e\u0644\u0635 \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u062a\u0627\u0626\u062c. \u062a\u062d\u064a\u0629 \u0644\u0644\u062d\u0631\u0633 \u0627\u0644\u062b\u0648\u0631\u064a \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a \u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629.",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:13:17Z"
                },
                {
                    "text": "\u0644\u064a\u0633 \u0644\u062f\u0649 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629 \u0633\u0648\u0649 \u0647\u062f\u0641 \u0631\u0626\u064a\u0633\u064a \u0648\u0627\u062d\u062f\u060c \u0648\u0647\u0648 \u062d\u0645\u0627\u064a\u0629 \u0633\u064a\u0627\u062f\u0629 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629 \u0643\u0643\u0644\u060c \u0648\u0627\u0644\u0642\u0636\u0627\u0621 \u0639\u0644\u0649 \u0643\u0644 \u0645\u0646 \u064a\u0642\u0648\u0636 \u0627\u0644\u0633\u064a\u0627\u062f\u0629.",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:16:26Z"
                },
                {
                    "text": "\u0625\u0646 \u0627\u0644\u0647\u062f\u0641 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u062e\u062f\u0645\u0647 \u062c\u0645\u064a\u0639 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629 \u0647\u0648 \u0628\u0646\u0627\u0621 \u0646\u0636\u0627\u0644 \u0645\u0648\u062d\u062f \u0648\u0634\u0627\u0645\u0644\u060c \u0644\u0627 \u0633\u064a\u0645\u0627 \u0641\u064a \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632. \u0644\u0627 \u0645\u062c\u0627\u0644 \u0644\u0644\u062a\u0633\u0627\u0645\u062d \u0645\u0637\u0644\u0642\u064b\u0627 \u0645\u0639 \u0645\u0646 \u064a\u0642\u0648\u0636 \u0633\u064a\u0627\u062f\u0629 \u0625\u064a\u0631\u0627\u0646\u060c \u0648\u0644\u0627 \u0645\u0639 \u0645\u0646 \u064a\u062e\u0648\u0646 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629. \u064a\u062c\u0628 \u0623\u0644\u0627 \u064a\u0643\u0648\u0646 \u0647\u0646\u0627\u0643 \u0623\u064a \u0645\u062c\u0627\u0644 \u0644\u0644\u062a\u0633\u0627\u0645\u062d. \u0644\u0642\u062f \u0639\u0627\u0634\u062a \u0625\u064a\u0631\u0627\u0646 \u062d\u064a\u0627\u0629 \u0645\u0644\u064a\u0626\u0629 \u0628\u0627\u0644\u062a\u0642\u0648\u064a\u0636 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629 \u062c\u062f\u064b\u0627\u060c \u0648\u0642\u062f \u062d\u0627\u0646 \u0627\u0644\u0648\u0642\u062a \u0644\u0625\u064a\u0631\u0627\u0646 \u0623\u0646 \u062a\u0631\u062f \u0639\u0644\u0649 \u0643\u0644 \u0630\u0644\u0643 \u0631\u062f\u064b\u0627 \u0642\u0627\u0637\u0639\u064b\u0627.",
                    "author": "@dolken0999",
                    "likes": 1,
                    "publishedAt": "2026-03-01T17:08:28Z"
                }
            ]
        }
    ]
}