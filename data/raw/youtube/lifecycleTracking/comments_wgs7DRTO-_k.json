        {
            "fetchedAt": "20260415_100019",
            "commentCount": 6,
            "comments": [
                {
                    "text": "\u0411\u0420\u0410\u0412\u041e! \u0411\u0420\u0410\u0412\u041e! \u0411\u0420\u0410\u0412\u041e!\n\u0411\u0420\u0410\u0412\u041e \u0422\u0410\u041b\u0410\u041d\u0422\u0423!\n \u041c\u043e\u043b\u043e\u0434\u0435\u0446\u044c!\n\u0413\u0430\u0440\u043d\u043e!",
                    "author": "@YuliiaIvaniuk-d4d",
                    "likes": 0,
                    "publishedAt": "2026-04-15T09:37:47Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0430 \u043f\u0443\u0441\u0442\u044c \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044f  \u0442\u0432\u043e\u044f \u0434\u0443\u0448\u0430 , \u0433\u043e\u043b\u043e\u0441 \u043b\u044c\u0451\u0442\u0441\u044f  \u0437\u0432\u043e\u043d\u043a\u043e , \u0430 \u043f\u0435\u0441\u043d\u044f \u043e\u043a\u0440\u044b\u043b\u044f\u0435\u0442 \u0442\u0435\u0431\u044f  . \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0442\u0430\u043a\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435  , \u0437\u0434\u0435\u0441\u044c \u0442\u0430\u043a\u043e\u0439  \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0447\u0438\u043a .\ud83d\udc9e\u2665\ufe0f\ud83d\ude4f\ud83c\udfb9\ud83e\udd70",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u0421\u0430\u043c\u043e\u0445\u0432\u0430\u043b\u043e\u0432\u0430-\u04314\u044e",
                    "likes": 1,
                    "publishedAt": "2026-04-15T09:32:30Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0412\u0430\u043c \u041c\u0430\u044d\u0441\u0442\u0440\u043e \n\u041e\u0431\u0435\u0440\u0435\u0433\u0430\u0435\u0442 \u0412\u0430\u0441 \u0411\u043e\u0433 \n\u041e\u0442\u043b\u0456\u0447\u043d\u043e \u0441\u0443\u043f\u0435\u0440!!!!",
                    "author": "@\u041c\u0430\u044f\u041a\u0440\u043e\u0442\u044e\u043a",
                    "likes": 1,
                    "publishedAt": "2026-04-15T08:55:05Z"
                },
                {
                    "text": "\u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439!!!\n\u0414\u042f\u041a\u0423\u042e \u043c\u0430\u0435\u0441\u0442\u0440\u043e \u0437\u0430 \u0447\u0443\u0434\u043e\u0432\u0443 \u043f\u0456\u0441\u043d\u044e!!\n\u0411\u0435\u0440\u0435\u0436\u0438 \u0412\u0430\u0441 \u0411\u041e\u0413 \n\u041c\u0456\u0446\u043d\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432'\u044f, \u0449\u0430\u0441\u0442\u044f, \u0434\u043e\u0431\u0440\u0430, \u0443\u0441\u043f\u0456\u0445\u0456\u0432 \u0412\u0430\u043c. \u2764\u2764\u2764",
                    "author": "@Vera-e6q8h",
                    "likes": 1,
                    "publishedAt": "2026-04-15T08:23:06Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0430, \u0442\u0438 \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439 \u043c\u0430\u0439\u0441\u0442\u0435\u0440 \u0441\u0432\u043e\u0454\u0457 \u0441\u043f\u0440\u0430\u0432\u0438! \u0414\u044f\u043a\u0443\u044e \u0442\u043e\u0431\u0456 \u0437\u0430 \u0442\u0432\u043e\u044e \u0442\u0432\u043e\u0440\u0447\u0456\u0441\u0442\u044c, \u0437\u0430 \u0446\u044e \u043f\u0456\u0441\u043d\u044e! \u0421\u043b\u0443\u0445\u0430\u044e \u0437 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u043e\u044e \u043f\u043e\u0432\u0430\u0433\u043e\u044e \u0442\u0430 \u0448\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0434\u043e \u0442\u0435\u0431\u0435 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u043e! \u0423\u0441\u043f\u0456\u0445\u0456\u0432, \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0442\u043e\u0431\u0456 \u0432 \u043f\u043e\u043b\u0430\u043b\u044c\u0448\u043e\u043c\u0443! \u0411\u0435\u0440\u0435\u0436\u0438 \u0441\u0435\u0431\u0435, \u0441\u043e\u043d\u0435\u0447\u043a\u043e, \u0441\u0432\u043e\u044e \u0440\u043e\u0434\u0438\u043d\u0443, \u0441\u0432\u043e\u0457\u0445 \u0434\u0456\u0442\u0435\u0439! \u0429\u0438\u0440\u0456 \u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u043c \u0437 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u043c\u0438 \u043f\u043e\u0431\u0430\u0436\u0430\u043d\u043d\u044f\u043c\u0438!\u2764\ud83c\udf89\ud83d\ude0a\u2764\u2764",
                    "author": "@\u0413\u0430\u043b\u0438\u043d\u0430\u0420\u0438\u043b\u043a\u043e\u0432\u0430",
                    "likes": 1,
                    "publishedAt": "2026-04-15T08:53:01Z"
                },
                {
                    "text": "\u0414\u0443\u0436\u0435 \u0433\u0430\u0440\u043d\u043e \u0441\u0443\u043f\u0435\u0440",
                    "author": "@\u0412\u0430\u0441\u0438\u043b\u044c-\u044a3\u04333\u043d",
                    "likes": 1,
                    "publishedAt": "2026-04-15T09:10:10Z"
                }
            ]
        },
        {
            "fetchedAt": "20260421_074208",
            "commentCount": 23,
            "comments": [
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0456\u0439'\u0414\u044f\u043a\u0443\u044e\u0417\u0430'\u041f\u0456\u0441\u043d\u044e\u0426\u0438\u0433\u0430\u043d\u043e\u0447\u043a\u0430\u0425\u0430\u0439'\u0411\u043e\u0433'\u0422\u043e\u0431\u0456'\u041b\u044e\u0431\u043e\u0432\u0456'\u0417\u0434\u043e\u0440\u043e\u0432\u044f\u0414\u0430\u0435\u0406\u0432\u0441\u0456\u0411\u043b\u0430\u0433\u0423\u0434\u0430\u0447\u0456\u041d\u0430\u0422\u0432\u043e\u044e\u041f\u0440\u0430\u0446\u044e\u0421\u043f\u0430\u0441\u0456\u0431\u0430'\u0422\u043e\u0431\u0456\u0417\u0430\u0417\u043e\u043b\u043e\u0442\u0438\u0439'\u0413\u043e\u043b\u043e\u0441'\u0411\u043e\u0436\u043e\u0457\u041b\u0430\u0441\u043a\u0438\u0429\u0435\u0420\u0430\u0437\u0414\u044f\u043a\u0443\u044e\u2764\u2764\u2764\u2764\u2764",
                    "author": "@\u041e\u043b\u0435\u043d\u0430\u0420\u043e\u0437\u043f\u0443\u0442\u043d\u044f",
                    "likes": 5,
                    "publishedAt": "2026-04-15T15:09:19Z"
                },
                {
                    "text": "\u0424\u0430\u0439\u043d\u0430 \u0447\u0443\u0434\u043e\u0432\u0430 \u043f\u0456\u0441\u043d\u044f  \u0412\u0434\u044f\u0447\u043d\u0430 \u0412\u0430\u043c \u0412\u0430\u043b\u0435\u0440\u0456\u044e \u0437\u0430 \u0433\u0430\u0440\u043d\u0438\u0439 \u043d\u0430\u0441\u0442\u0440\u0456\u0439 \ud83e\udec2\ud83d\ude4f\ud83e\udec2\ud83d\ude4f\ud83e\udec2\ud83d\ude4f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83d\ude4c\ud83d\ude4c\ud83d\ude4c\ud83d\ude4c\ud83d\ude4c\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc83\ud83d\udc83\ud83d\udc83\ud83d\udc83\ud83d\udc83\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc99\ud83d\udc9b\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6",
                    "author": "@\u041a\u0430\u0442\u0435\u0440\u0438\u043d\u0430-\u04313\u043e4\u0448",
                    "likes": 5,
                    "publishedAt": "2026-04-15T12:22:07Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u0454\u043c\u043e \u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439 \u0437\u0430 \u043f\u0456\u0441\u043d\u044e,\ud83d\ude0a\ud83d\ude0a\ud83d\ude0a",
                    "author": "@ahronom333",
                    "likes": 5,
                    "publishedAt": "2026-04-15T10:11:35Z"
                },
                {
                    "text": "\u2764\ufe0f\u0412\u0430\u043b\u0435\u0440\u0456\u0439'\u0421\u043f\u0430\u0441\u0456\u0431\u0430'\u0417\u0430'\u041f\u0456\u0441\u043d\u044e\u042f\u043a\u0430\u041a\u0440\u0430\u0441\u0456\u0432\u0430\u041f\u0456\u0441\u043d\u044f\u0423\u0434\u0430\u0447\u0456'\u0414\u043e\u0431\u0440\u0430\u041c\u0438\u0440\u0443'\u0422\u043e\u0431\u0456\u0425\u0430\u0439'\u0411\u043e\u0433\u0411\u0435\u0440\u0435\u0436\u0435\u0422\u0435\u0431\u0435\u041c\u0456\u0439'\u0421\u0438\u043d\u0443\u041b\u044e\u0431\u043b\u044e\u0422\u0435\u0431\u0435\u0417\u0430\u0422\u0432\u043e\u0457\u041f\u0456\u0441\u043d\u0456'\u0421\u043f\u0430\u0441\u0438\u0406\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0422\u0435\u0431\u0435\u041d\u0430\u041a\u043e\u0436\u043d\u043e\u043c\u0443\u041a\u0440\u043e\u0446\u0456\u0414\u044f\u043a\u0443\u044e\u0429\u0438\u0440\u043e\u2764",
                    "author": "@\u041e\u043b\u0435\u043d\u0430\u0420\u043e\u0437\u043f\u0443\u0442\u043d\u044f",
                    "likes": 3,
                    "publishedAt": "2026-04-15T16:20:31Z"
                },
                {
                    "text": "\u0414\u0430\u0439 \u0411\u043e\u0436\u0435 \u0412\u0430\u043c \u0417\u0434\u043e\u0440\u043e\u0432'\u044f \u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439\u0429\u0438\u0440\u043e \u0414\u044f\u043a\u0443\u044e \u0412\u0410\u041c \u041f\u0410\u041d\u0415 \u0437\u0430 \u0412\u0456\u0434\u0435\u043e \u043d\u0435\u0445\u0430\u0439 \u0429\u0430\u0441\u0442\u0438\u0442\u044c \u0412\u0430\u043c \u0437 \u0411\u043e\u0433\u043e\u043c \u043d\u0435\u0445\u0430\u0439\u0411\u043e\u0433 \u0411\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u043b\u044f\u044e\u0442\u044c \u0412\u0430\u0441 \u0406 \u0412\u0430\u0448\u0443 \u0421\u0456\u043c'\u044e \u0437 \u0411\u043e\u0433\u043e\u043c \u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439 \u2764\u2764\u2764\u2764\u2764\u2764\u2764\u2764\u2764",
                    "author": "@\u041e\u043b\u0435\u043d\u0430\u041a\u0443\u0444\u043b\u0435\u0439",
                    "likes": 3,
                    "publishedAt": "2026-04-15T15:43:39Z"
                },
                {
                    "text": "\u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439!!!\n\u0414\u042f\u041a\u0423\u042e \u043c\u0430\u0435\u0441\u0442\u0440\u043e \u0437\u0430 \u0447\u0443\u0434\u043e\u0432\u0443 \u043f\u0456\u0441\u043d\u044e!!\n\u0411\u0435\u0440\u0435\u0436\u0438 \u0412\u0430\u0441 \u0411\u041e\u0413 \n\u041c\u0456\u0446\u043d\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432'\u044f, \u0449\u0430\u0441\u0442\u044f, \u0434\u043e\u0431\u0440\u0430, \u0443\u0441\u043f\u0456\u0445\u0456\u0432 \u0412\u0430\u043c. \u2764\u2764\u2764",
                    "author": "@Vera-e6q8h",
                    "likes": 4,
                    "publishedAt": "2026-04-15T08:23:06Z"
                },
                {
                    "text": "\u0411\u0420\u0410\u0412\u041e! \u0411\u0420\u0410\u0412\u041e! \u0411\u0420\u0410\u0412\u041e!\n\u0411\u0420\u0410\u0412\u041e \u0422\u0410\u041b\u0410\u041d\u0422\u0423!\n \u041c\u043e\u043b\u043e\u0434\u0435\u0446\u044c!\n\u0413\u0430\u0440\u043d\u043e!",
                    "author": "@YuliiaIvaniuk-d4d",
                    "likes": 3,
                    "publishedAt": "2026-04-15T09:37:47Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0456\u0439 \u0434\u044f\u043a\u0443\u044e \u0437\u0430 \u0433\u0430\u0440\u043d\u0443 \u043f\u0456\u0441\u043d\u044e.\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udcaf\ud83d\udcaf\ud83d\udcaf",
                    "author": "@Olga-gi3tp",
                    "likes": 3,
                    "publishedAt": "2026-04-15T18:03:38Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0430, \u0442\u0438 \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0439 \u043c\u0430\u0439\u0441\u0442\u0435\u0440 \u0441\u0432\u043e\u0454\u0457 \u0441\u043f\u0440\u0430\u0432\u0438! \u0414\u044f\u043a\u0443\u044e \u0442\u043e\u0431\u0456 \u0437\u0430 \u0442\u0432\u043e\u044e \u0442\u0432\u043e\u0440\u0447\u0456\u0441\u0442\u044c, \u0437\u0430 \u0446\u044e \u043f\u0456\u0441\u043d\u044e! \u0421\u043b\u0443\u0445\u0430\u044e \u0437 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u043e\u044e \u043f\u043e\u0432\u0430\u0433\u043e\u044e \u0442\u0430 \u0448\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0434\u043e \u0442\u0435\u0431\u0435 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u043e! \u0423\u0441\u043f\u0456\u0445\u0456\u0432, \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0442\u043e\u0431\u0456 \u0432 \u043f\u043e\u043b\u0430\u043b\u044c\u0448\u043e\u043c\u0443! \u0411\u0435\u0440\u0435\u0436\u0438 \u0441\u0435\u0431\u0435, \u0441\u043e\u043d\u0435\u0447\u043a\u043e, \u0441\u0432\u043e\u044e \u0440\u043e\u0434\u0438\u043d\u0443, \u0441\u0432\u043e\u0457\u0445 \u0434\u0456\u0442\u0435\u0439! \u0429\u0438\u0440\u0456 \u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u043c \u0437 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u043c\u0438 \u043f\u043e\u0431\u0430\u0436\u0430\u043d\u043d\u044f\u043c\u0438!\u2764\ud83c\udf89\ud83d\ude0a\u2764\u2764",
                    "author": "@\u0413\u0430\u043b\u0438\u043d\u0430\u0420\u0438\u043b\u043a\u043e\u0432\u0430",
                    "likes": 4,
                    "publishedAt": "2026-04-15T08:53:01Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0442\u043e\u0431\u0456\u2764\u2764\u2764\u2764\u2764\u2764\u2764",
                    "author": "@\u0421\u0432\u0435\u0442\u043b\u0430\u043d\u0430\u041a\u0440\u044b\u0441\u044e\u043a-\u04487\u0446",
                    "likes": 3,
                    "publishedAt": "2026-04-15T14:50:18Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0412\u0430\u043c \u041c\u0430\u044d\u0441\u0442\u0440\u043e \n\u041e\u0431\u0435\u0440\u0435\u0433\u0430\u0435\u0442 \u0412\u0430\u0441 \u0411\u043e\u0433 \n\u041e\u0442\u043b\u0456\u0447\u043d\u043e \u0441\u0443\u043f\u0435\u0440!!!!",
                    "author": "@\u041c\u0430\u044f\u041a\u0440\u043e\u0442\u044e\u043a",
                    "likes": 3,
                    "publishedAt": "2026-04-15T08:55:05Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0430 \u043f\u0443\u0441\u0442\u044c \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044f  \u0442\u0432\u043e\u044f \u0434\u0443\u0448\u0430 , \u0433\u043e\u043b\u043e\u0441 \u043b\u044c\u0451\u0442\u0441\u044f  \u0437\u0432\u043e\u043d\u043a\u043e , \u0430 \u043f\u0435\u0441\u043d\u044f \u043e\u043a\u0440\u044b\u043b\u044f\u0435\u0442 \u0442\u0435\u0431\u044f  . \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0442\u0430\u043a\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435  , \u0437\u0434\u0435\u0441\u044c \u0442\u0430\u043a\u043e\u0439  \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0447\u0438\u043a .\ud83d\udc9e\u2665\ufe0f\ud83d\ude4f\ud83c\udfb9\ud83e\udd70",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u0421\u0430\u043c\u043e\u0445\u0432\u0430\u043b\u043e\u0432\u0430-\u04314\u044e",
                    "likes": 2,
                    "publishedAt": "2026-04-15T09:32:30Z"
                },
                {
                    "text": "\u0421\u0443\u043f\u0435\u0440 \u043f\u0456\u0441\u043d\u0456 \ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83c\uddfa\ud83c\udde6\ud83d\udcaa\ud83c\uddfa\ud83c\udde6",
                    "author": "@\u041e\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440-\u04423\u04357\u043e",
                    "likes": 2,
                    "publishedAt": "2026-04-15T16:16:41Z"
                },
                {
                    "text": "\u0414\u0443\u0436\u0435 \u0433\u0430\u0440\u043d\u043e \u0441\u0443\u043f\u0435\u0440",
                    "author": "@\u0412\u0430\u0441\u0438\u043b\u044c-\u044a3\u04333\u043d",
                    "likes": 2,
                    "publishedAt": "2026-04-15T09:10:10Z"
                },
                {
                    "text": "\u0412\u0430\u043b\u0435\u0440\u0456\u0439'\u0422\u0438'\u0422\u0430\u043a\u0438\u0439\u041c\u043e\u043b\u043e\u0434\u0447\u0438\u043d\u0430\u0423\u0434\u0430\u0447\u0456'\u0429\u0430\u0441\u0442\u044f\u0417\u0434\u043e\u0440\u043e\u0432\u044f\u041d\u0430\u0412\u0441\u0456\u0412\u0456\u043a\u0438\u0414\u044f\u043a\u0443\u044e\u0406'\u0421\u043f\u0430\u0441\u0456\u0431\u0430\u0417\u0430\u0422\u0432\u0456\u0439'\u041a\u0440\u0430\u0441\u0456\u0432\u0438\u0439'\u0413\u043e\u043b\u043e\u0441\u2764\u2764",
                    "author": "@\u041e\u043b\u0435\u043d\u0430\u0420\u043e\u0437\u043f\u0443\u0442\u043d\u044f",
                    "likes": 2,
                    "publishedAt": "2026-04-15T16:23:27Z"
                },
                {
                    "text": "\u0429\u0438\u0440\u043e \u0414\u044f\u043a\u0443\u044e \u0412\u0410\u041c \u041f\u0410\u041d\u0415 \u0437\u0430 \u0412\u0456\u0434\u0435\u043e \u043d\u0435\u0445\u0430\u0439 \u0429\u0430\u0441\u0442\u0438\u0442\u044c \u0412\u0430\u043c \u041f\u0430\u043d\u0435 \u0412\u0430\u043b\u0435\u0440\u0456\u0439 \u0417\u043e\u043b\u043e\u0442\u0438\u0439 \u0413\u043e\u043b\u043e\u0441 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0437 \u0411\u043e\u0433\u043e\u043c \u0412\u0430\u043c \u0412\u0410\u041b\u0415\u0420\u0406\u0419\u2764\u2764\u2764",
                    "author": "@\u041e\u043b\u0435\u043d\u0430\u041a\u0443\u0444\u043b\u0435\u0439",
                    "likes": 2,
                    "publishedAt": "2026-04-15T15:44:14Z"
                },
                {
                    "text": "Muito bonita can\u00e7\u00e3o.  Obrigada.  \u2764\ud83c\uddfa\ud83c\udde6\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83c\udf39Cantor  sempre super \ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f",
                    "author": "@galynatkachuk5060",
                    "likes": 0,
                    "publishedAt": "2026-04-20T19:35:20Z"
                },
                {
                    "text": "\u041f\u0456\u0434\u043d\u044f\u043b\u0438 \u043d\u0430\u0441\u0442\u0440\u0456\u0439 \u0441\u043f\u0430\u0441\u0438\u0431\u0456",
                    "author": "@\u0422\u0430\u043d\u044f\u041a\u0430\u0440\u043f\u0456\u0432",
                    "likes": 2,
                    "publishedAt": "2026-04-15T15:14:04Z"
                },
                {
                    "text": "\u041a\u0410\u0417\u041a\u041e\u0412\u0415 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f !!!  \u041d\u0410\u0422\u0425\u041d\u0415\u041d\u041d\u042f !!!  \ud83d\udc83\u2728\ufe0f\ud83d\udd7a  \ud83e\uddda\ud83e\uddda\u200d\u2640\ufe0f\ud83e\uddda\u200d\u2642\ufe0f \ud83e\udd29",
                    "author": "@\u0422\u0430\u043d\u044f\u0424\u0456\u043b\u0456\u043c\u043e\u0448\u0438\u043d\u0430",
                    "likes": 0,
                    "publishedAt": "2026-04-19T05:06:19Z"
                },
                {
                    "text": "\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d \u0441\u0438\u043b\u044c\u043d\u043e, \u043f\u043e\u0442\u0443\u0436\u043d\u043e, \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0435\u043d\u043e!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! \u0444\u0430\u0439\u043d\u043e \u0434\u044f\u043a\u0443\u044e!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
                    "author": "@VasiaNaida",
                    "likes": 0,
                    "publishedAt": "2026-04-16T18:17:13Z"
                },
                {
                    "text": "\ud83e\ude75\ud83d\udc9b\ud83e\ude75\ud83d\udc9b\ud83e\ude75\ud83d\udc9b\ud83e\ude75\ud83d\udc9b\ud83e\ude75\ud83d\udc9b\ud83e\ude75",
                    "author": "@Sergii-o7w",
                    "likes": 1,
                    "publishedAt": "2026-04-15T15:46:08Z"
                },
                {
                    "text": "\u041c\u043e\u0436\u043d\u0430 \u0442\u0430\u043a\u0443 \u043f\u0456\u0441\u043d\u044e \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0442\u0456\u043f\u0430 \u0446\u0438\u0433\u0430\u043d\u043e\u0447\u043a\u0430 \u043c\u0430\u0440\u044c\u044f\u043d\u043e \u043c\u043e\u044f \u043c\u043e\u0436\u043d\u0430 \u0442\u0430\u043a \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u043f\u0456\u0441\u043d\u044e \ud83d\ude4f",
