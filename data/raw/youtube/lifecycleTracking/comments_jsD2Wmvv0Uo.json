                },
                {
                    "text": "\u0412\u0441\u0451 \u0436\u0435 \u0448\u043e\u0440\u0442\u0441\u044b \u043d\u0435 \u0434\u043b\u044f \u0412\u0430\u043d\u0438.",
                    "author": "@ulukay",
                    "likes": 9,
                    "publishedAt": "2026-04-15T09:28:38Z"
                },
                {
                    "text": "\u043d\u0435 \u0432\u0438\u043d\u043e, \u0430 \u043a\u0443\u0441\u043e\u043a \u043c\u044f\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441 2018 \u043d\u0430\u0447\u0430\u043b \u0433\u043d\u0438\u0442\u044c \u0438 \u0432\u0441\u0451 \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u0441\u0433\u043d\u0438\u0451\u0442",
                    "author": "@eqqwqryasuomid7099",
                    "likes": 0,
                    "publishedAt": "2026-04-17T09:10:09Z"
                },
                {
                    "text": "\u0412\u0430\u043d\u044c  \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043e\u0440\u043e\u0448\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0448  \ud83d\udc4f\ud83d\udc4f",
                    "author": "@\u0412\u0430\u043b\u0435\u0440\u0430\u0411\u0430\u0431\u0430\u0439\u043b\u043e\u0432",
                    "likes": 1,
                    "publishedAt": "2026-04-15T10:40:37Z"
                },
                {
                    "text": "\u041d\u0443 \u043d\u0435 \u0437\u043d\u0430\u044e, \u043f\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f\u043c \u2014 \u043a\u0430\u043a \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439. \u041f\u0440\u043e\u0441\u0442\u0435\u043d\u044c\u043a\u043e \u043a\u0430\u043a-\u0442\u043e",
                    "author": "@BozarevART2680",
                    "likes": 5,
                    "publishedAt": "2026-04-15T08:58:42Z"
                },
                {
                    "text": "\u041f\u0440\u0438\u043a\u043e\u043b\u044c\u043d\u043e \u043f\u043e\u0437\u0434\u0440\u043e\u0432\u043b\u044f\u044e \u0432\u0430\u0440\u0444\u0435\u0439\u0441",
                    "author": "@\u0424\u0438\u0434\u0430\u043d-\u04398\u0433",
                    "likes": 1,
                    "publishedAt": "2026-04-15T11:14:02Z"
                },
                {
                    "text": "\u041a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438 33?\ud83d\ude05 \u0418 \u0431\u0443\u0434\u0435\u0442 \u043b\u0438 \u0432\u043e\u043e\u0431\u0449\u0435",
                    "author": "@vasya_111",
                    "likes": 2,
                    "publishedAt": "2026-04-15T10:42:30Z"
                },
                {
                    "text": "\u041f\u043e\u0438\u0433\u0440\u0430\u0439 \u0432 \u043d\u0435\u0433\u043e \u043d\u0430 \u0441\u0442\u0440\u0438\u043c\u0435",
                    "author": "@nikitaemelanov3560",
                    "likes": 1,
                    "publishedAt": "2026-04-15T12:49:43Z"
                },
                {
                    "text": "\u041a\u0440\u0443\u0442\u043e \ud83d\ude09\ud83d\udc4d",
                    "author": "@\u0414\u0438\u043c\u043e\u043d-\u043d6\u0445-\u04328\u0440",
                    "likes": 3,
                    "publishedAt": "2026-04-15T08:57:13Z"
                },
                {
                    "text": "\u0423\u0434\u0438\u0432\u043b\u0451\u043d \u0447\u0442\u043e \u0442\u044b \u043f\u0440\u043e \u043d\u0435\u0433\u043e \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b\ud83d\ude05",
                    "author": "@-__kelt__-9306",
                    "likes": 8,
                    "publishedAt": "2026-04-15T09:01:27Z"
                },
                {
                    "text": "\u0418\u0433\u0440\u0430 \u043a\u043e\u0433\u0434\u0430 \u0442\u043e \u0431\u044b\u043b\u0430 \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u0430\u044f, \u0440\u0430\u0434\u0438 \u043d\u0435\u0451 \u044f \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u043b\u0441\u044f \u0440\u0430\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u0448\u043a\u043e\u043b\u043e\u0439 \u0447\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u043f\u0430\u0440\u0443 \u043a\u0430\u0442\u043e\u043a \ud83e\udee1 \u042d\u0445\u0445, \u0432\u0440\u0435\u043c\u044f... \u041d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 16 \u0433\u043e\u0434\u0430 \u043e\u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043a\u0430\u0442\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0435 \u0432 \u0442\u0443 \u0441\u0442\u043e\u0440\u043e\u043d\u0443",
                    "author": "@\u041a\u043e\u0444\u0435\u0444\u0430\u043d",
                    "likes": 6,
                    "publishedAt": "2026-04-15T15:18:36Z"
                },
                {
                    "text": "\u0418\u0433\u0440\u0430\u043b \u0435\u0449\u0451 \u0432 2012-2013 \u0433\u043e\u0434\u0443. \u041f\u043e\u043c\u043d\u044e \u043c\u0430\u043c\u0430 \u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u0435\u043d\u0435\u0433 \u043d\u0430 \u043f\u0440\u043e\u0435\u0437\u0434 \u0441\u043e \u0448\u043a\u043e\u043b\u044b \u0434\u043e \u0434\u043e\u043c\u0430, \u043d\u043e \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u044f \u0448\u0451\u043b \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0441 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u043e\u043c Qiwi \u0438 \u0434\u043e\u043d\u0430\u0442\u0438\u043b \u043e\u0442\u0442\u0443\u0434\u0430 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0430\u043a\u043a\u0430\u0443\u043d\u0442, \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0442 \u043d\u0430 \u043c\u0435\u0441\u044f\u0446, \u0430 \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u043e\u0442\u0438\u043d\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0430\u0432\u0430\u043b\u0438 \u0431\u0443\u0441\u0442 \u043a \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0438 \u043d\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043a\u0430\u0440\u0442\u0430\u0445 \u0437\u0430\u043f\u0440\u044b\u0433\u0438\u0432\u0430\u0442\u044c \u043d\u0430 \u043c\u0435\u0441\u0442\u0430, \u0433\u0434\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u043f\u043e\u0434\u0441\u0430\u0434\u043a\u0430, \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e. \u041d\u0435 \u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0438\u0433\u0440\u0430 \u0431\u044b\u043b\u0430 \u0434\u043e\u043d\u0430\u0442\u043d\u044b\u043c \u0434\u0435\u0440\u044c\u043c\u043e\u043c, \u043c\u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0441\u0430\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u0433\u0440\u044b. \u0410 \u043f\u043e\u0442\u043e\u043c \u043c\u043e\u0439 \u0431\u0440\u0430\u0442 \u0440\u0435\u0448\u0438\u043b, \u0447\u0442\u043e \u043e\u043d \u0445\u043e\u0447\u0435\u0442 \u043f\u043e\u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u0447\u0438\u0442\u0430\u043c\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0438\u0433\u0440\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u044b\u043b\u0430 \u0440\u0430\u0441\u0441\u0430\u0434\u043d\u0438\u043a\u043e\u043c \u0447\u0438\u0442\u0435\u0440\u043e\u0432, \u0430 \u043c\u0435\u043d\u044f \u044d\u0442\u043e \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u043e. \u041a\u0430\u043a \u0438\u0442\u043e\u0433: \u0431\u0430\u043d \u043d\u0430 10 \u043b\u0435\u0442. \u0414\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438 \u0440\u0430\u0437\u0431\u0430\u043d\u0438\u0442\u044c \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u0433\u043e\u0434\u0443, \u043d\u043e \u044f \u0437\u0430\u0431\u044b\u043b \u0434\u0430\u043d\u043d\u044b\u0435.\n\n\u041d\u043e \u043a\u043e\u0433\u0434\u0430 \u044f \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430 10 \u043b\u0435\u0442 \u0441\u043a\u0430\u0447\u0430\u043b \u0438\u0433\u0440\u0443 \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u0433\u043e\u0434\u0443, \u044f \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0438\u0433\u0440\u0430 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u043b\u0443\u0447\u0448\u0435. \u0414\u043e\u043d\u0430\u0442 \u0442\u0435\u043f\u0435\u0440\u044c \u0445\u043e\u0442\u044c \u0438 \u0434\u0430\u0451\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430, \u043d\u043e \u0435\u0433\u043e \u0441\u0442\u0430\u043b\u043e \u0435\u0449\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u043e\u043d \u0441\u0442\u0430\u043b \u0445\u0443\u0436\u0435. \u041f\u043e\u044f\u0432\u0438\u043b\u043e\u0441\u044c \u043c\u043d\u043e\u0433\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u043a, \u0431\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u0433\u0440\u0430 \u0431\u044b\u043b\u0430 \u043b\u0443\u0447\u0448\u0435, \u0442\u0438\u043f\u0430 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0439 \u043e\u0440\u0443\u0436\u0438\u044f, \u0430 \u043c\u0438\u0441\u0441\u0438\u0438 \u0441\u0442\u0430\u043b\u0438 \u0441\u043e\u0432\u0441\u0435\u043c \u0443\u0436 \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438, \u0447\u0442\u043e \u043c\u043d\u0435 \u043d\u0435 \u043e\u0441\u043e\u0431\u043e \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \u0422\u0438\u043f\u0430 \u0440\u0430\u043d\u044c\u0448\u0435 \u0442\u044b \u0431\u044b\u043b \u0447\u043b\u0435\u043d\u043e\u043c \u0427\u0412\u041a \u0438 \u0431\u043e\u0440\u043e\u043b\u0441\u044f \u0441 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0445\u0438\u043c \u0427\u0412\u041a, \u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u0442\u0430\u043c \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u0440\u043e\u0431\u043e\u0442\u044b \u0432 \u041f\u0440\u0438\u043f\u044f\u0442\u0438, \u0437\u043e\u043c\u0431\u0438, \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u041c\u0430\u0440\u0441\u0430 \u0438 \u0442.\u043f. \u041c\u043d\u0435 \u044d\u0442\u043e \u043b\u0438\u0447\u043d\u043e \u043d\u0435 \u0437\u0430\u0448\u043b\u043e.\n\n\u041d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u041f\u0412\u041f \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f. \u0415\u0441\u043b\u0438 \u0440\u0430\u043d\u044c\u0448\u0435 \u043f\u043e\u0431\u0435\u0436\u0434\u0430\u043b \u0442\u043e\u0442, \u0443 \u043a\u043e\u0433\u043e \u0434\u043e\u043d\u0430\u0442 \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u0431\u044b\u043b, \u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u044d\u0442\u043e \u043d\u0435 \u0441\u0438\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c, \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043d\u0430\u0442 \u043c\u043e\u0436\u043d\u043e \u0438 \u0431\u0435\u0437 \u0434\u043e\u043d\u0430\u0442\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c.\n\n\u042d\u0442\u043e \u043c\u043e\u0451 \u043c\u043d\u0435\u043d\u0438\u0435 \u0437\u0430 \u043f\u0430\u0440\u0443 \u0447\u0430\u0441\u043e\u0432 \u0438\u0433\u0440\u044b \u0433\u043b\u0430\u0437\u0430\u043c\u0438, \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0442\u044c, OG \u0438\u0433\u0440\u043e\u043a\u0430. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u044f \u0432 \u0447\u0451\u043c \u0442\u043e \u043d\u0435 \u043f\u0440\u0430\u0432 \u0438 \u043c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u043e \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b \u0432\u0441\u0435\u0445 \u044d\u0442\u0438\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439, \u043c\u0435\u043d\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u0447\u0435\u043c \u043d\u0430 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u043d\u0435 \u0445\u0432\u0430\u0442\u0438\u043b\u043e",
                    "author": "@chuchello9776",
                    "likes": 2,
                    "publishedAt": "2026-04-16T06:38:50Z"
                },
                {
                    "text": "\ud83d\udc4d\ud83d\udc4d",
                    "author": "@\u0414\u0435\u043d\u0438\u0441\u041f\u0430\u043d\u043a\u0440\u0430\u0446-\u04355\u043b",
                    "likes": 1,
                    "publishedAt": "2026-04-15T10:38:24Z"
                },
                {
                    "text": "\ud83d\ude2e\ud83d\ude2e\ud83d\ude2e\ud83d\ude2e\ud83d\ude2e\ud83d\ude2e",
                    "author": "@\u041d\u0438\u043a\u0438\u0442\u0430\u0422\u0438\u0442\u043e\u0432-\u04435\u044d",
                    "likes": 1,
                    "publishedAt": "2026-04-15T12:11:21Z"
                },
                {
                    "text": "\u0410 \u0418\u041d\u0422\u0415\u0420\u0415\u0421\u041d\u041e \u0413\u0414\u0415 \u0416\u0415 \u041c\u041e\u0419 \u041a\u041e\u041c\u0415\u041d\u0422\u0410\u0420\u0418\u0419 ? \u0412\u0410\u0420\u0424\u0415\u0419\u0421 \u0414\u0415\u0420\u042c\u041c\u041e \u042f \u041f\u041e\u0412\u0422\u041e\u0420\u042e\u0421\u042c",
                    "author": "@\u0422\u0432\u043e\u0439\u041e\u0442\u0435\u0446-\u044d1\u0431",
                    "likes": 0,
                    "publishedAt": "2026-04-17T16:04:19Z"
                },
                {
                    "text": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043d\u0435\u0441\u043b\u0438)!?",
                    "author": "@\u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d\u0412\u043e\u043b\u043e\u0431\u0443\u0435\u0432-\u04435\u043a",
                    "likes": 0,
                    "publishedAt": "2026-04-15T19:23:39Z"
                },
                {
                    "text": "\u041a\u0430\u043f\u0435\u0446 \u044f \u0441\u0442\u0430\u0440\u044b\u0439 \u0438 \u0412\u0430\u0440\u0444\u0435\u0439\u0441 \u0442\u043e\u0436\u0435",
                    "author": "@NikitaSemenov26",
                    "likes": 3,
                    "publishedAt": "2026-04-15T09:02:57Z"
                },
                {
                    "text": "\u0412\u0430\u043d\u044c \u043f\u0440\u0438\u0432\u0435\u0442 \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430 \u0432\u044b\u0441\u043e\u0442\u0435",
                    "author": "@vaclavvaicehovcki2942",
                    "likes": 1,
                    "publishedAt": "2026-04-15T11:41:33Z"
                },
                {
                    "text": "\u041a\u0430\u043a\u043e\u0435 \u0436\u0435 \u044d\u0442\u043e \u0432\u0441\u0435 \u0434\u0435\u0440\u044c\u043c\u043e !!!",
                    "author": "@\u0422\u0438\u043c\u043e\u0444\u0435\u0439-\u04437\u0444",
                    "likes": 3,
                    "publishedAt": "2026-04-15T09:57:55Z"
                },
                {
                    "text": "\u041d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u043a\u043e\u043c\u0435\u043d\u0442 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \ud83d\ude02",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0435\u0439\u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u043e\u0432\u0438\u0447-\u04384\u0444",
                    "likes": 1,
                    "publishedAt": "2026-04-16T21:42:25Z"
                },
                {
                    "text": "\u041e\u0445 \u0438 \u043a\u0440\u0438\u043d\u0436",
                    "author": "@NixKant",
                    "likes": 1,
                    "publishedAt": "2026-04-15T10:39:38Z"
                },
                {
                    "text": "\u0422\u044b \u0437\u0430\u0431\u043e\u043b\u0435\u043b \u0447\u0442\u043e-\u043b\u0438, \u0442\u0430\u043a\u0443\u044e \u0434\u0438\u0447\u044c \u0440\u0435\u043a\u043b\u0430\u043c\u0438\u0442\u044c. \u0417\u0430\u043d\u0435\u0441\u043b\u0438 \u0436\u0435 \u044f\u0432\u043d\u043e, \u0442\u044b \u0432 \u044d\u0442\u0443 \u0448\u043b\u044f\u043f\u0443 10 \u043c\u0438\u043d \u043f\u043e\u0438\u0433\u0440\u0430\u043b \u0440\u0430\u0434\u0438 \u0434\u0435\u043d\u0435\u0433, \u0434\u0430\u0436\u0435 \u0440\u0435\u0431\u0451\u043d\u043a\u0443 \u043f\u043e\u043d\u044f\u0442\u043d\u043e",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0435\u0439\u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u043e\u0432\u0438\u0447-\u04384\u0444",
                    "likes": 0,
                    "publishedAt": "2026-04-16T21:41:46Z"
                },
                {
                    "text": "\u0425\u0443\u0434\u0448\u0435\u0433\u043e \u0441\u0442\u0440\u0438\u043c\u0435\u0440\u0430 \u044f \u0435\u0449\u0451 \u043d\u0435 \u0432\u0438\u0434\u0435\u043b!\ud83e\udd2e \u0412\u0435\u0447\u043d\u043e \u043d\u043e\u0435\u0442 \u0438 \u043d\u043e\u0435\u0442! \u0421\u0442\u0438\u043a\u0441\u0430 \u043d\u0435 \u0434\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043b. \u042d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044e \u0435\u043b\u0438 \u0434\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043b\ud83d\ude22\u0438 \u0442\u043e \u043d\u0435 \u0434\u043e\u0438\u0433\u0440\u0430\u043b \u043d\u0435 \u0434\u043e \u043a\u043e\u043d\u0446\u0430. \u0415\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0442\u043e \u0432\u0438\u043d\u043e\u0432\u0430\u0442\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438,\u0430 \u0435\u0441\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0442\u043e \u043e\u043d \u0433\u0435\u0440\u043e\u0439\ud83d\ude05",
                    "author": "@\u0421\u0435\u0440\u0436\u0416\u0443\u0440\u0430\u0432\u043b\u0435\u0432-\u043f1\u043c",
                    "likes": 3,
                    "publishedAt": "2026-04-15T11:01:43Z"
                }
            ]
        }
    ]
}