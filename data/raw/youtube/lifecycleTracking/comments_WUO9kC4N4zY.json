                {
                    "text": "*_\u0412 \u0427\u0415\u0420\u041d\u041e\u0411\u042b\u041b\u0415 \u041f\u041e \u041d\u041e\u0427\u0410\u041c \u041a\u0422\u041e-\u0422\u041e 36\u0401T \u0410\u0422\u041e\u041c\u041d\u042b\u0419 \u0420\u0415\u0410\u041a\u0422\u041e\u0420 \u2620\ufe0f_*",
                    "author": "@DoctorSVO_02",
                    "likes": 25,
                    "publishedAt": "2026-04-29T17:16:40Z"
                },
                {
                    "text": "\u041d\u0438 \u043e\u0434\u043d\u043e\u0439 \u0448\u0443\u0442\u043a\u0438 \u043f\u0440\u043e \u043c\u0430\u0442\u044c \u0413\u0430\u0431\u0435\u043d\u0430... \u0412\u0438\u0434\u0438\u043c\u043e \u0448\u0443\u0442\u043a\u0438 \u043f\u0440\u043e \u043d\u0435\u0435 \u0442\u043e\u0436\u0435 \u0443\u043c\u0435\u0440\u043b\u0438",
                    "author": "@Hi_\u00efG\u00fcR\u00fcm\u00c4",
                    "likes": 10,
                    "publishedAt": "2026-04-29T17:27:52Z"
                },
                {
                    "text": "\u041b\u0443\u0447\u0448\u0430\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u0430 \u0438 \u0438\u0433\u0440\u0430 \u044d\u0442\u043e \u0432\u0435\u0440\u0430 \u0432 \u0411\u043e\u0433\u0430-\u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430!",
                    "author": "@\u0421\u043d\u0438\u043f\u0435\u0440-\u04388\u0435",
                    "likes": 6,
                    "publishedAt": "2026-04-29T17:15:31Z"
                },
                {
                    "text": "\u0422\u0430\u043a\u0440\u043a\u043e\u0432 \u044d\u0442\u043e \u043c\u043e\u0434 \u043d\u0430 \u043a\u0441 \u0437\u0430 10\u043a \u0440\u0443\u0431\u043b\u0435\u0439",
                    "author": "@RIDJIX_Oficialny",
                    "likes": 3,
                    "publishedAt": "2026-04-29T17:25:39Z"
                },
                {
                    "text": "\u0410\u043d\u0430\u043b\u043e\u0433\u0430 \u0412\u0430\u0440\u0445\u0430\u043c\u043c\u0435\u0440 \u043d\u0435\u0442 \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442! \u0423\u0432\u0435\u0440\u0443\u0439\u0442\u0435 \u0432 \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430!",
                    "author": "@\u0414\u0436\u043e\u043d_\u0427\u0438\u043d\u0430",
                    "likes": 1,
                    "publishedAt": "2026-04-29T18:27:23Z"
                },
                {
                    "text": "\u041c\u043e\u043d\u043e\u043b\u0438\u0442 - \u043d\u0430\u0448 \u0441\u0432\u0435\u0442, \u043f\u0443\u0442\u044c, \u043f\u0440\u0430\u0432\u0434\u0430! \u0412\u044b \u0441 \u043d\u0430\u043c\u0438? \u0421 \u0438\u043c\u043f\u0435\u0440\u0438\u0443\u043c\u043e\u043c? \u041e\u0433\u043b\u044f\u043d\u0438\u0442\u0435\u0441\u044c, \u0432\u044b \u043b\u0438\u0448\u044c \u0440\u0430\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0433\u0438\u0431\u0435\u043b\u044c \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0438 \u043e\u0442\u0434\u0430\u0435\u0442 \u043f\u0440\u0438\u043a\u0430\u0437\u044b. \u041c\u044b \u043f\u043e\u043c\u043e\u0433\u043b\u0438 \u043c\u043d\u043e\u0433\u0438\u043c \u0438\u0437 \u0432\u0430\u0441, \u043c\u043d\u043e\u0433\u0438\u043c \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u0433\u043b\u0430\u0437\u0430. \u0418\u0434\u0438\u0442\u0435 \u0438 \u043f\u043e\u043a\u043b\u043e\u043d\u0438\u0442\u0435\u0441\u044c \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443 \u041c\u043e\u043d\u043e\u043b\u0438\u0442\u0443!",
                    "author": "@FirefoxOfficial1",
                    "likes": 0,
                    "publishedAt": "2026-04-29T19:18:26Z"
                },
                {
                    "text": "\u041f\u0430\u043f\u0438\u0447\u0443 \u0431\u043e\u043b\u044c\u0448\u0435 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043b\u0435\u0442\u043e \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c",
                    "author": "@\u0422\u0440\u0430\u0432\u043e\u0436\u0443\u0419\u0447\u0438\u043a-\u04399\u0433",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:19:17Z"
                },
                {
                    "text": "\u041a\u043e\u0433\u0434\u0430 payday \u0432 \u0440\u043e\u043b\u0438\u043a\u0430\u0445",
                    "author": "@folly-er",
                    "likes": 1,
                    "publishedAt": "2026-04-29T17:29:25Z"
                },
                {
                    "text": "\u0415\u0441\u043b\u0438 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0438 \u043e\u0442\u0432\u0435\u0440\u0433\u0430\u0442\u044c \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0441\u0438\u043b\u0443 \u041c\u043e\u043d\u043e\u043b\u0438\u0442\u0430. \u0422\u043e \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u0436\u0438\u0432\u044b\u043c \u0441\u043a\u0435\u043b\u0435\u0442\u043e\u043c \u0442\u0430\u043a\u0438\u043c \u043a\u0430\u043a \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0430 \u0435\u0441\u043b\u0438 \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u041c\u043e\u043d\u043e\u043b\u0438\u0442. \u0422\u043e \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u043c\u043d\u044b\u043c \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c.",
                    "author": "@ghost023-e3q",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:52:01Z"
                },
                {
                    "text": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0432\u0437 \u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b the last of us?",
                    "author": "@\u041a\u0438\u0440\u0438\u043b\u043b\u041a\u043e\u0437\u043b\u043e\u0432\u0441\u043a\u0438\u0439-\u043f\u0435\u043b\u0435\u043c\u0435\u043d\u044c",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:20:48Z"
                },
                {
                    "text": "\u042f \u0445\u043e\u0447\u0443 \u0430\u043d\u0430\u043b\u043e\u0433\u0438 \u0438\u0437 \u0413\u0443\u0433\u043b \u043f\u043b\u044d\u0439 \u0438 \u042f\u043d\u0434\u0435\u043a\u0441 \u0438\u0433\u0440",
                    "author": "@Ivanhoe-o6q",
                    "likes": 0,
                    "publishedAt": "2026-04-29T19:41:48Z"
                },
                {
                    "text": "\u0421\u0434\u0435\u043b\u0430\u0439 \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u043a\u0443 \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u0442\u04442",
                    "author": "@DmitryBond-u7j",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:55:26Z"
                },
                {
                    "text": "\u0423\u0432\u0435\u0440\u0443\u0439\u0442\u0435 \u0432 \u041c\u043e\u043d\u043e\u043b\u0438\u0442",
                    "author": "@monolitovec-d8e",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:12:23Z"
                },
                {
                    "text": "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430: \u043d\u0435\u0442 \u041f\u041a \n\u0420\u0435\u0448\u0435\u043d\u0438\u0435: \u0413\u0422\u0410 \u0441\u0430\u043d \u0410\u043d\u0434\u0440\u0435\u0430\u0441 \u041f\u041a \u043c\u043e\u0434",
                    "author": "@amogus-kh4sh",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:12:13Z"
                },
                {
                    "text": "\u0423 \u041c\u0415\u041d\u042f \u0422\u0415\u041b\u0415\u0424\u041e \u0421\u0410\u041d \u0410\u0414\u0420\u0415\u0421 \u041d\u0415 \u0422\u042f\u041d\u0415\u0422 \u0427\u0422\u041e \u0414\u0415\u041b\u0410\u0422\u042c",
                    "author": "@\u041c\u0443\u0445\u0430\u043c\u043c\u0430\u0434\u041c\u0430\u0433\u043e\u043c\u0435\u0434\u043e\u0432-\u043d1\u044e",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:58:07Z"
                },
                {
                    "text": "\u0411\u0440\u043e! \u0417\u0430 \u0411\u041b \u043b\u0430\u0439\u043a\u043e\u0441!",
                    "author": "@star_rain_official_account",
                    "likes": 0,
                    "publishedAt": "2026-04-29T20:59:09Z"
                },
                {
                    "text": "\u041c\u043e\u043d\u043e\u043b\u0438\u0442 \u0437\u043e\u0432\u0443\u0442!",
                    "author": "@Hollman_Deo",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:25:33Z"
                },
                {
                    "text": "\u0425\u0430\u0430\u0445\u0430\u0445 \u043f\u0440\u043e \u043b\u0435\u0442\u043e",
                    "author": "@Loloshkadan",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:31:08Z"
                },
                {
                    "text": "\u043f\u043e\u0447\u0435\u043c\u0443 \u043f\u0430\u043f\u0438\u0447 \u043d\u0435 \u0441 \u0423\u043b\u044c\u044f\u043d\u043e\u0439",
                    "author": "@\u041b\u0435\u0432\u041a\u0440\u0430\u043a\u043e\u0432\u0441\u043a\u0438\u0439",
                    "likes": 0,
                    "publishedAt": "2026-04-29T19:26:39Z"
                },
                {
                    "text": "\u041a\u0430\u043a \u0443\u0432\u0435\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u0412\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0418\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0435\u0441\u043b\u0438 \u043a\u043e\u043c\u043f \u043d\u0435 \u0442\u044f\u043d\u0435\u0442?",
                    "author": "@Miles_Edgeworthaceattorney",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:58:15Z"
                },
                {
                    "text": "\u0410 \u0447\u0435\u043c Geometry Dash \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c?\n\u0425\u043e\u0442\u044f, \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u041b\u0414\u041c \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c, \u043d\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u043b\u0430\u0433\u0430\u044e\u0442 \u043d\u0430 \u0441\u043b\u0430\u0431\u044b\u0439 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445.",
                    "author": "@TheGuideFromSB",
                    "likes": 0,
                    "publishedAt": "2026-04-29T18:24:13Z"
                },
                {
                    "text": "\u041e \u0434\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043b\u0435\u0442\u043e \u044d\u0442\u043e \u0442\u043e\u0436\u0435 \u0441\u0430\u043c\u043e\u0435",
                    "author": "@SoldierMein",
                    "likes": 0,
                    "publishedAt": "2026-04-29T17:34:32Z"
                },
                {
                    "text": "\u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u044f \u043f\u0440\u043e\u0448\u0451\u043b \u0430\u0442\u043e\u043c\u0438\u043a \u0445\u0430\u0440\u0434 \u043d\u0430 100%",
