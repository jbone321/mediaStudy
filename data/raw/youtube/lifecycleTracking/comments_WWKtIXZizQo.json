                },
                {
                    "text": "\u6c88\u975c\u67d4\u559c\u6b61\u674e\u660e\u54f2\u5427",
                    "author": "@sandy-m7t3h",
                    "likes": 18,
                    "publishedAt": "2026-04-14T15:58:46Z"
                },
                {
                    "text": "\u89ba\u5f97\u5b89\u5a1c\u548c\u5fb7\u98a8\u914d\u5c0d\u597d\u4e86\uff0c\u4ed6\u5011\u5f88\u9069\u5408",
                    "author": "@\u5609\u7433-r1v",
                    "likes": 4,
                    "publishedAt": "2026-04-14T23:59:34Z"
                },
                {
                    "text": "\u9019\u90e8\u6232\u5168\u90e8\u662f\u5c0f\u4e09\uff0c\u975c\u601d\u8eab\u908a\u4e5f\u6709\u4e00\u500b\u5c0f\u4e09\uff0c\u5230\u5e95\u662f\u5728\u6f14\u4ec0\u9ebc\u5287\u60c5\uff0c\u8a72\u4e0b\u6a94\u4e86\uff0c",
                    "author": "@\u7fc1\u947e-h7p",
                    "likes": 7,
                    "publishedAt": "2026-04-14T18:27:56Z"
                },
                {
                    "text": "\u55d1\u5230\u6069\u66e6\u8ddf\u627f\u660a\u4e86 \u8d95\u5feb\u63ed\u7a7f\u8eab\u4e16\u5c31\u53ef\u4ee5\u5728\u4e00\u8d77\u4e86",
                    "author": "@sophialee5708",
                    "likes": 27,
                    "publishedAt": "2026-04-14T17:32:54Z"
                },
                {
                    "text": "\u767e\u5473\u4eba\u751f\u8d85\u597d\u770b\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@\u962e\u4fca\u99d2",
                    "likes": 0,
                    "publishedAt": "2026-04-15T05:47:40Z"
                },
                {
                    "text": "\u6025\u8a3a\u5ba4\u91ab\u751f\u5e6b\u5fd9\u8449\u6587\u7965 \u8521\u79cb\u9999\u727d\u7d05\u7dda\u2764 \u8449\u592a\u592a",
                    "author": "@\u6c92\u6709G7\u4e86",
                    "likes": 6,
                    "publishedAt": "2026-04-14T16:14:18Z"
                },
                {
                    "text": "\u6211\u770b\u53ea\u6709\u856d\u7ea2\u96ea\u8fd9\u4e2a\u574f\u4eba\u660e\u660e\u662f\u81ea\u5df1\u574f\uff0c\u8fd8\u53ef\u4ee5\u8fd9\u4e48\u5927\u58f0\ud83d\ude2e",
                    "author": "@\u9ea6\u7f8e\u8273",
                    "likes": 2,
                    "publishedAt": "2026-04-14T22:46:52Z"
                },
                {
                    "text": "\u5728\u7b49\u79cb\u9999\u548c\u6587\u7965CP\uff0c\u7b49\u660e\u54f2\u548c\u9759\u67d4CP\u9759\u67d4\u559c\u6b22\u8fc7\u660e\u54f2\u5427",
                    "author": "@\u97f3\u4e50-o7j",
                    "likes": 6,
                    "publishedAt": "2026-04-14T15:46:53Z"
                },
                {
                    "text": "\u5176\u5b9e\u51a0\u4f1f\u4e00\u5207\u90fd\u662f\u90b1\u96c5\u82d3\u5bb3\u7684\uff0c\u7136\u540e\u7236\u6bcd\u5077\u60c5\u5bb3\u7684",
                    "author": "@\u97f3\u4e50-o7j",
                    "likes": 1,
                    "publishedAt": "2026-04-15T03:12:52Z"
                },
                {
                    "text": "\u55ac\u5b89\u5a1c\u4f60\u53ef\u4ee5\u53bb\u8d99\u601d\u8ce2\u8ddf\u4ed6\u8aaa\u856d\u7d05\u96ea\u5979\u5728\u9867\u842c\u921e\u90a3\u908a",
                    "author": "@\u9673\u975c\u5cf0-l8b",
                    "likes": 1,
                    "publishedAt": "2026-04-15T05:01:07Z"
                },
                {
                    "text": "\u674e\u660e\u54f2\u5e74\u8f15\u6642 \u5e6b\u52a9\u904e\u5f88\u591a\u4eba \u73fe\u5728\u662f\u63a5\u53d7\u56de\u5831\u7684\u6642\u5019\u4e86\ud83c\udf89\ud83c\udf89\ud83c\udf89\u6709\u9867\u842c\u921e\u7684\u5e6b\u5fd9 \u90a3\u80a1\u529b\u91cf\u5c31\u6703\u5f88\u5927\u4e86",
