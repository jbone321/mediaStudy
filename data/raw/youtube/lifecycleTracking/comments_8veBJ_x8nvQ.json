            "commentCount": 25,
            "comments": [
                {
                    "text": "\u041a\u0430\u043a \u0436\u0435 \u0412\u044b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430!  \u0411\u043b\u0438\u0441\u0442\u0430\u0439\u0442\u0435, \u0441\u0438\u044f\u0439\u0442\u0435, \u0434\u0430\u0440\u0438\u0442\u0435 \u043c\u0438\u0440\u0443 \u0441\u0432\u043e\u0439 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0433\u043e\u043b\u043e\u0441! \u2764",
                    "author": "@vo.marik3726",
                    "likes": 84,
                    "publishedAt": "2026-02-28T18:14:23Z"
                },
                {
                    "text": "\u0412\u044b - \u0427\u0423\u0414\u041e!! \u0421\u0438\u043b\u044c\u043d\u0430\u044f, \u0443\u043c\u043d\u0430\u044f, \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f \u0438 \u041c\u0423\u0414\u0420\u0410\u042f!!!\u2764\u2764\u2764",
                    "author": "@\u0418\u0440\u0438\u043d\u0430\u0420\u043e\u0437\u0435\u043d\u0431\u0435\u0440\u0433-\u04445\u0446",
                    "likes": 68,
                    "publishedAt": "2026-02-28T17:55:39Z"
                },
                {
                    "text": "\u041a\u0430\u043a\u0430\u044f \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e \u0432\u044b\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \u0440\u0443\u0441\u0441\u043a\u0430\u044f \u0440\u0435\u0447\u044c, \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u043c\u0438, \u0432\u044b\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u043e\u0431\u043e\u0440\u043e\u0442\u0430\u043c\u0438, \u0441 \u0431\u043e\u0433\u0430\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u0440\u043d\u044b\u043c \u0441\u043e\u0441\u0442\u0430\u0432\u043e\u043c.  \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430\u044f \u0430\u0440\u0442\u0438\u0441\u0442\u043a\u0430, \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439 \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a. \u0423\u043c\u043d\u0438\u0446\u0430!",
                    "author": "@\u041b\u044e\u0434\u043c\u0438\u043b\u0430\u0415\u043f\u043e\u043d\u0435\u0448\u043d\u0438\u043a\u043e\u0432\u0430",
                    "likes": 81,
                    "publishedAt": "2026-02-28T19:53:14Z"
                },
                {
                    "text": "\u0420\u043e\u0437\u0430 \u0445\u0430\u043d\u044b\u043c, \u0412\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043b\u0438 \u0441\u0432\u043e\u044e \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u0438\u0441\u0441\u0438\u044e \u0412\u044b \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u043b\u0438 \u0432\u0441\u0435 \u043c\u044b\u0441\u043b\u0438\u043c\u044b\u0435 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f.\u0412\u0430\u0448 \u0433\u043e\u043b\u043e\u0441 \u043f\u043e\u043a\u043e\u0440\u0438\u043b \u0441\u0435\u0440\u0434\u0446\u0430 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443, \u0430 \u0442\u0430\u043b\u0430\u043d\u0442 \u0441\u0442\u0430\u043b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043f\u043e\u0434\u0430\u0440\u043a\u043e\u043c \u0434\u043b\u044f \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432.\u0412\u0435\u0441\u044c \u043c\u0438\u0440 \u043f\u043e\u043b\u044e\u0431\u0438\u043b \u0412\u0430\u0441 \u0438 \u044d\u0442\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u043e! \u0423\u0434\u0430\u0447\u0438 \u0412\u0430\u043c \u0441\u0447\u0430\u0441\u0442\u044c\u044f!\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83e\udef6",
                    "author": "@\u0420\u0438\u043c\u043c\u0430\u041a\u0438\u0440\u0430\u043c\u043e\u0432\u0430-\u04452\u044d",
                    "likes": 69,
                    "publishedAt": "2026-02-28T17:55:49Z"
                },
                {
                    "text": "\u0420\u043e\u0437\u043e\u0447\u043a\u0430 ,\u043a\u0430\u043a \u0438\u0434\u0435\u0442 \u0432\u0430\u043c  \u0438\u043c\u044f  \u0420\u043e\u0437\u043e\u0447\u043a\u0430 ,  \u043c\u044b \u043f\u043e\u043b\u044e\u0431\u0438\u043b\u0438 \u0432\u0430\u0441 . \u041f\u0435\u0441\u043d\u0438   \u043a\u043e\u0442\u043e\u0440\u044b\u0435- \u0438\u0441\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0435 \u044d\u0442\u043e \u0448\u0435\u0434\u0435\u0432\u0440. .\u0421\u043f\u0430\u0441\u0438\u0431\u043e",
                    "author": "@\u0413\u0430\u043b\u0438\u043d\u0430\u041d\u0443\u0440\u043c\u0443\u0445\u0430\u043c\u0435\u0434\u043e\u0432\u0430-\u04328\u0432",
                    "likes": 49,
                    "publishedAt": "2026-02-28T16:40:52Z"
                },
                {
                    "text": "\u041a\u0430\u043a\u0430\u044f \u0436\u0435 \u0442\u044b \u0443\u043c\u043d\u0438\u0446\u0430! \u0421\u0447\u0430\u0441\u0442\u044c\u044f \u0442\u0435\u0431\u0435, \u0442\u0432\u043e\u0438\u043c \u0434\u0435\u0442\u044f\u043c! \u041f\u043e\u0431\u043e\u043b\u044c\u0448\u0435 \u0445\u043e\u0440\u043e\u0448\u0438\u0445 \u043f\u0435\u0441\u0435\u043d, \u0447\u0442\u043e\u0431\u044b \u0441\u043b\u0443\u0448\u0430\u043b\u0438 \u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438, \u0438  \u0432 \u0410\u0437\u0435\u0440\u0431\u0430\u0439\u0434\u0436\u0430\u043d\u0435.",
                    "author": "@\u041d\u0438\u043d\u0430\u0413\u0430\u0444\u0430\u0440\u043e\u0432\u0430-\u04375\u0436",
                    "likes": 37,
                    "publishedAt": "2026-02-28T17:50:39Z"
                },
                {
                    "text": "\u0412\u044b \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f",
                    "author": "@ruzizhoniuldashov126",
                    "likes": 35,
                    "publishedAt": "2026-02-28T16:44:31Z"
                },
                {
                    "text": "\u0420\u043e\u0437\u0430 \u0432\u044b \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u043a \ud83d\udc4d\ud83d\udc4d\ud83d\udc4d",
                    "author": "@ludmila1756",
                    "likes": 20,
                    "publishedAt": "2026-02-28T17:32:48Z"
                },
                {
                    "text": "\u0422\u044f\u0436\u0435\u043b\u043e\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043e\ud83d\ude22\n\u0428\u0438\u043a\u0430\u0440\u043d\u0430\u044f \u0436\u0435\u043d\u0449\u0438\u043d\u0430\n\u0413\u0434\u0435 \u0412\u044b \u0431\u044b\u043b\u0438 \u0440\u0430\u043d\u044c\u0448\u0435? (",
                    "author": "@Pubgsyeta",
                    "likes": 28,
                    "publishedAt": "2026-02-28T18:01:55Z"
                },
                {
                    "text": "\u041f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435 \u0420\u043e\u0437\u0430,\u0443 \u0430\u0440\u0442\u0438\u0441\u0442\u0430 \u0442\u043e\u0436\u0435 \u0435\u0441\u0442\u044c \u043c\u0438\u0441\u0441\u0438\u044f. \u0418 \u0447\u0435\u0440\u0435\u0437 \u0430\u0440\u0442\u0438\u0441\u0442\u0430,\u043c\u044b \u0442\u043e\u0436\u0435  \u0443\u0437\u043d\u0430\u0435\u043c ,\u043e \u0441\u0442\u0440\u0430\u043d\u0430\u0445,\u043d\u0430\u0440\u043e\u0434\u0430 \u0438 \u0438\u0445 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435. \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0412\u0430\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0437\u0430 \u0412\u0430\u0448\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e, \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0443 \u0438 \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0441\u0442\u044c.\u041a\u0430\u043a \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u043c \u0434\u0430\u0432\u043d\u043e \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 .\u041e\u0442 \u0432\u0441\u0435\u0433\u043e \u0441\u0435\u0440\u0434\u0446\u0430. \u2764\u2764\u2764 \u041f\u0440\u0438\u0432\u0435\u0442 \u0438\u0437 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438. \u2764",
                    "author": "@Mr756games",
                    "likes": 22,
                    "publishedAt": "2026-02-28T21:01:48Z"
                },
                {
                    "text": "\u041b\u044e\u0431\u0438\u043c\u0430\u044f \u0431\u043b\u043e\u043d\u0434\u0438\u043d\u043a\u0430\ud83d\udda4\n\ud83d\udc4f\ud83c\udffb \u0430\u043f\u043b\u043e\u0434\u0438\u0440\u0443\u044e \u0432\u0430\u0448\u0435\u0439 \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0445\u0440\u0430\u0431\u0440\u043e\u0441\u0442\u0438! \nLublu",
                    "author": "@FlirtyNova",
                    "likes": 19,
                    "publishedAt": "2026-02-28T18:47:23Z"
                },
                {
                    "text": "\u042f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e \u0442\u0443 \u0447\u0435\u0440\u043d\u0435\u043d\u044c\u043a\u0443\u044e \u0434\u0435\u0432\u043e\u0447\u043a\u0443! \u041a\u0430\u043a \u043c\u0438\u043b\u043e! \u0418 \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u0438\u0436\u0443 \u044d\u0442\u0443 \u0448\u0438\u043a\u0430\u0440\u043d\u0443\u044e \u0431\u043b\u043e\u043d\u0434\u0438\u043d\u043a\u0443!",
                    "author": "@ValentinaKozmina",
                    "likes": 15,
                    "publishedAt": "2026-02-28T17:28:53Z"
                },
                {
                    "text": "\u041e\u043d\u0430 \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0431\u0443\u043a\u0432\u044b",
                    "author": "@\u041d\u0438\u043b\u0443\u0444\u0430\u0440-\u043f7\u0438",
                    "likes": 12,
                    "publishedAt": "2026-02-28T19:04:26Z"
                },
                {
                    "text": "\u041c\u0438\u043b\u0430\u044f \u0420\u043e\u0437\u0430 \u043a\u0430\u043a\u043e\u0439 \u0432\u044b \u0434\u043e\u0431\u0440\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a",
                    "author": "@\u0418\u0440\u0438\u043d\u0430\u0422\u0430\u0440\u0430\u0441\u0435\u043d\u043a\u043e-\u04359\u0442",
                    "likes": 11,
                    "publishedAt": "2026-02-28T19:23:24Z"
                },
                {
                    "text": "\u0412\u0441\u0451 \u0432\u0435\u0440\u043d\u043e \u0432\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0438!!! \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0432\u0430\u043c \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0441\u043f\u0435\u0445\u043e\u0432!!!! \u0411\u0440\u0430\u0432\u043e!!!! \u2764",
                    "author": "@\u0418\u0440\u0438\u043d\u0430\u0411\u043e\u0440\u0438\u0441\u043e\u0432\u0430-\u04419\u044f",
                    "likes": 12,
                    "publishedAt": "2026-02-28T18:11:59Z"
                },
                {
                    "text": "\u0423\u043c\u043d\u0438\u0446\u0430, \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430 \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u043e\u043c,\u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0412\u0430\u043c!",
                    "author": "@more12956",
                    "likes": 8,
                    "publishedAt": "2026-02-28T20:21:06Z"
                },
                {
                    "text": "\u041e\u0447\u0435\u043d\u044c \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u0427\u0435\u043b\u043e\u0432\u0435\u043a!!!!",
                    "author": "@OmarSul-zv7ei",
                    "likes": 6,
                    "publishedAt": "2026-02-28T22:12:29Z"
                },
                {
                    "text": "\u041c\u044b \u0442\u043e\u0431\u043e\u0439 \u0433\u043e\u0440\u0434\u0438\u043c\u0441\u044f \u0420\u043e\u0437\u0430 \ud83c\udf39 \u0445\u0430\u043d\u044b\u043c \u2764\ufe0f\ud83c\udde6\ud83c\uddff",
                    "author": "@19677-r",
                    "likes": 16,
                    "publishedAt": "2026-02-28T17:52:19Z"
                },
                {
                    "text": "\u0420\u043e\u0437\u043e\u0447\u043a\u0430.\u0432\u044b \u0442\u0430\u043a\u0430\u044f \u0443\u043c\u043d\u0438\u0446\u0430.\u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430!!!!! \u0414\u043b\u044f \u043c\u0435\u043d\u044f \u0432\u044b \u041e\u0422\u041a\u0420\u042b\u0422\u0418\u0415  \u0413\u041e\u0414\u0410!!!!!",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u0414\u0438\u044f\u043d\u043e\u0432\u0430-\u04355\u043e",
                    "likes": 5,
                    "publishedAt": "2026-02-28T21:07:52Z"
                },
                {
                    "text": "\u041c\u043e\u0439 \u0441\u043c\u044b\u0441\u043b \u0436\u0438\u0437\u043d\u0438, \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0432\u0430\u043c \u0447\u0442\u043e \u0432\u044b \u0435\u0441\u0442\u044c \u0432 \u043c\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \ud83d\ude18\ud83d\udc8b \u041f\u0443\u0441\u0442\u044c \u0432\u0430\u0441 \u0445\u0440\u0430\u043d\u0438\u0442 \u0411\u043e\u0433 \u0438 \u043f\u043e\u0434\u0430\u0440\u0438\u0442 \u0432\u0430\u043c \u0441\u0447\u0430\u0441\u0442\u044c\u0435 \u0438 \u0434\u043e\u043b\u0433\u043e\u043b\u0435\u0442\u0438\u0435!\ud83e\ude77\ud83e\ude77\ud83e\ude77\ud83e\ude77",
                    "author": "@Zara-y9v9f",
                    "likes": 13,
                    "publishedAt": "2026-02-28T18:09:20Z"
                },
                {
                    "text": "\u041a\u0430\u043a \u0438\u0442\u043e\u0433-\u0421\u0438\u043b\u044c\u043d\u0430\u044f \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u0441\u043e \u0441\u0442\u0435\u0440\u0436\u043d\u0435\u043c, \u0441 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043e\u043c. \u0417\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043e\u0442 \u0436\u0438\u0437\u043d\u0438. \u041f\u0440\u043e\u0439\u0434\u044f \u0442\u0430\u043a\u043e\u0439 \u043f\u0443\u0442\u044c. \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439. \u0421\u0438\u043b. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83c\udf39\ud83c\udf39\ud83c\udf39 \u041c\u0430\u0433\u043d\u0438\u0442 \u043c\u043e\u0435\u0439 \u0434\u0443\u0448\u0438. \u041c\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434.",
                    "author": "@\u0438\u043d\u0435\u0441\u0441\u0430\u041e-\u04379\u0448",
                    "likes": 14,
                    "publishedAt": "2026-02-28T17:21:56Z"
                },
                {
                    "text": "\u0420\u041e\u0417\u0410.\u0438 \u044d\u0442\u0438\u043c \u0432\u0441\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e \u2764",
                    "author": "@\u0422\u0430\u0442\u044c\u044f\u043d\u0430\u041b\u0430\u043f\u0430\u0439",
                    "likes": 7,
                    "publishedAt": "2026-02-28T20:19:39Z"
                },
                {
                    "text": "\u0420\u043e\u0437\u0430 \u0432\u0430\u043c \u0432\u0441\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u0434\u0435\u043b\u0430\u0442\u044c! \u0421\u0447\u0430\u0441\u0442\u044c\u044f \u0438 \u043f\u0440\u043e\u0446\u0432\u0435\u0442\u0430\u043d\u0438\u044f \u0412\u0430\u043c!\ud83c\udf39",
                    "author": "@nataliatarabukina",
                    "likes": 5,
                    "publishedAt": "2026-02-28T22:17:33Z"
                },
                {
                    "text": "\u041a\u0430\u043a\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u0441\u043b\u043e\u0432\u0430! \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430\u0448\u0435\u043b \u0441\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u0438 \u0441\u0432\u043e\u044e \u043c\u0438\u0441\u0441\u0438\u044e! \u0421\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0430\u044f \u0436\u0435\u043d\u0449\u0438\u043d\u0430!",
                    "author": "@AA-tc2md",
                    "likes": 1,
                    "publishedAt": "2026-03-01T07:05:24Z"
                },
                {
                    "text": "\u041f\u0440\u0438\u044f\u0442\u043d\u0430\u044f ,\u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f , \u0448\u0438\u043a\u0430\u0440\u043d\u0430\u044f",
                    "author": "@\u0411\u0435\u0440\u043c\u0435\u0442\u0418\u043b\u0430\u043a\u0431\u0430\u0435\u0432\u0430",
                    "likes": 6,
                    "publishedAt": "2026-02-28T18:11:21Z"
                }
            ]
        }
