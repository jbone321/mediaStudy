                },
                {
                    "text": "\u0412\u044b \u0438 \u0432\u0430\u0448\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435\ud83d\ude0a",
