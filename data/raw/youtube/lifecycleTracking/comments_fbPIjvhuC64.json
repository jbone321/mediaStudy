                    "likes": 0,
                    "publishedAt": "2026-05-05T15:41:56Z"
                },
                {
                    "text": "\u0627\u0646\u064a \u0627\u0641\u0636\u0644 \u0627\u0644\u0627\u0645\u0628\u0631\u0637\u0627\u0646\u064a\u0629 \u0628\u0646\u0627\u0621\u0627 \u0639\u0644\u0649 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u064a \u0644\u0641\u0638 \u0627\u0633\u0647\u0644 \u0627\u062e\u062a\u0627\u0631\u0647\ud83d\ude02\u0628\u0633 \u0644\u0644\u0627\u0645\u0627\u0646\u0629 \u0627\u0633\u062a\u0641\u0627\u062f\u064a\u062a \u0644\u0623\u0646 \u062f\u0627\u0626\u0645\u0627 \u062c\u0646\u062a \u0627\u062a\u0633\u0627\u0626\u0644 \u0645\u062b\u0644 \u0643\u0644\u0645\u0629 \u0645\u0635\u0639\u062f \u0644\u0647\u0627 elevator \u0648\u0645\u0631\u0629 left  \u064a\u0627\u0647\u0648 \u0627\u0644\u0635\u062d \u0647\u0633\u0647 \u0639\u0631\u0641\u062a \u062b\u0646\u064a\u0646\u0647\u0645 \u0635\u062d \u0628\u0633 \u0628\u0644\u0647\u062c\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u0643\u0644 \u0638\u0646\u064a \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0628\u0631\u064a\u0637\u0627\u0646\u064a \u0648\u0627\u0644\u0627\u0645\u0631\u064a\u0643\u064a \u0647\u0648 r",
