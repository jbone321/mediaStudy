                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0641\u062f\u0648\u0647 \u0628\u0642\u0647 \u062f\u0631\u0633 \u0628\u0627\u0644\u064a\u0648\u0646\u062a \u0627\u0644\u062b\u0627\u0645\u0646 \u0641\u062f\u0648\u0647 \u0646\u0632\u0644\u0647",
                    "author": "@PpPp-r6p2w",
                    "likes": 0,
                    "publishedAt": "2026-05-05T15:58:43Z"
                },
                {
                    "text": "\u0645\u0646\u0648\u0648\u0648\u0631 \u062f\u0627\u0626\u0645\u0627\u064b \u0627\u0633\u062a\u0627\u0630\u064a \u0627\u0644\u0639\u0632\u064a\u0632 \u0631\u0628\u064a \u064a\u062d\u0641\u0636\u0643 \u0627\u0644\u0623\u062d\u0628\u0627\u0628\u0643 \u0648\u0627\u0644\u0623\u0647\u0644\u0643 \u0648\u064a\u062d\u0641\u0636\u0643 \u0627\u0644\u0646\u0647 \u064a\u0627\u0631\u0628\u0628\u0628 \u0645\u0627\u062a\u0642\u0635\u0631\u0631\u0631\u0631 \u064a\u0627\u0631\u0628\u0628\u0628\u0628 \u064a\u062c\u0627\u0632\u064a\u0643 \u0628\u0644\u062c\u0646\u0647 \u064a\u0627\u0631\u0628\u0628 \ud83e\udd79\ud83d\udc97\ud83d\udc97\ud83d\udc97",
