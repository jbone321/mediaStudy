                    "text": "\u0645\u0640\u0628\u062f\u060f \u062f\u0627\u0626\u0645\u0627\u064b \u0627\u0633\u062a\u0627\u0630 \ud83d\udc99\u2728",
                    "author": "@zainab-c5k1b",
                    "likes": 3,
                    "publishedAt": "2026-05-05T15:49:44Z"
                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0639\u0627\u0641\u064a\u0647 \u0627\u0646\u0631\u064a\u062f \u0645\u0631\u0627\u062c\u0639\u0647 \u0644\u0644\u0648\u0632\u0627\u0631\u064a  \u0633\u0627\u062f\u0633 \u0639\u0644\u0645\u064a \u0645\u0639\u062a\u0645\u062f\u064a\u0646 \u0639\u0644\u064a\u0643 \u0631\u0628\u064a \u064a\u0648\u0641\u0642\u0643 \u0627\u0633\u062a\u0627\u0630 \u0648\u064a\u0631\u0632\u0642\u0643 \u0645\u0646 \u062d\u064a\u062b \u0644\u0627 \u064a\u062d\u062a\u0633\u0628 \u2764\u2764\u0637\u0644\u0627\u0628 \u0635\u0639\u062f\u0648 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u062d\u062a\u0649 \u064a\u0634\u0648\u0641\u0629  \u0644\u0627\u0633\u062a\u0627\u0630  \u0648\u0623\u0643\u0648\u0646 \u0645\u0645\u0646\u0648\u0646 \u2764\u2764",
                    "author": "@\u0633\u0639\u0648\u062f\u0627\u0644\u062c\u062f\u0627\u062f\u064a",
                    "likes": 1,
                    "publishedAt": "2026-05-05T17:45:40Z"
                },
                {
                    "text": "\u064a\u0643\u0644\u064a \ud83c\udf89\u0627\u0646\u062a \u0627\u0644\u0645\u0639\u062c\u0628 \u0668\u0660\ud83c\udf89 \u0647\u0627\u064a \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629 \u0645\u0646 \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628 \u0627\u0648\u0644 \u0645\u0631\u0629 \u0627\u0634\u0648\u0641\u0647\u0627 \ud83d\ude02\u0639\u062c\u0628\u062a\u0646\u064a",
                    "author": "@kingstarsthefirst4705",
                    "likes": 1,
                    "publishedAt": "2026-05-05T15:49:37Z"
                },
                {
                    "text": "\u0634\u0643\u0631\u0622 \u0644\u0643 \u0623\u0633\u062a\u0627\u0630 \u062d\u0641\u0638 \u0627\u0644\u0644\u0647 \u0628\u062d\u0641\u0638\u0647\n\u0648\u0627\u0644\u0644\u0647 \u0634\u0631\u062d\u0643 \u0631\u0648\u0648\u0648\u0648\u0639\u0647 \ud83d\udc4f\ud83d\udc4f",
                    "author": "@Maram-Al-Azzawi",
                    "likes": 0,
                    "publishedAt": "2026-05-05T19:50:00Z"
                },
                {
                    "text": "\u062d\u0644\u0648 \u062a\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \ud83e\udee0",
                    "author": "@BAQER_2008",
                    "likes": 0,
                    "publishedAt": "2026-05-05T23:33:01Z"
                },
                {
                    "text": "\u2764\u2764\u0627\u0644\u0627\u0633\u062a\u0627\u0630 \u0627\u0644\u0645\u0628\u062f\u0639",
                    "author": "@MohamadAuob-o6k8p",
                    "likes": 0,
                    "publishedAt": "2026-05-05T20:27:26Z"
                },
                {
                    "text": "\u0627\u0644\u0644\u0647 \u0627\u062d\u0628 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0627\u0636\u0627\u0641\u064a\u0647 \u0628\u0644\u0627\u0646\u0643\u0644\u064a\u0632\u064a \ud83d\udc96",
