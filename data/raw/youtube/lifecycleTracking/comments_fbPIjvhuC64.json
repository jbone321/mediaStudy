                },
                {
                    "text": "\u0648\u0641\u0642\u0643 \u0627\u0644\u0644\u0647 \u062a\u062d\u064a\u0627\u062a\u0649 \u0645\u0646 \u0644\u064a\u0628\u064a\u0627",
