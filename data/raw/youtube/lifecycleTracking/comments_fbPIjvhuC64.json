                    "likes": 0,
                    "publishedAt": "2026-05-05T21:05:54Z"
                },
                {
                    "text": "\u0627\u0646 \u0634\u0627\u0621\u0627\u0644\u0644\u0647 \u064a\u0627\u0631\u0628 \u062d\u0648\u0631 \u0627\u0637\u0644\u0639 \u0669\u0660 \u0627\u062f\u0639\u0648\u0644\u064a \u0627\u0644\u0643\u0645 \u0628\u0627\u0644\u0645\u062b\u0644",
