                },
                {
                    "text": "\u0627\u062f\u0639\u0648\u0644\u064a \u0627\u0646\u062c\u062d \u0628\u0644\u0648\u0632\u0627\u0631\u064a \u0641\u062f\u0648\u0647\u2764",
