                    "text": "\u0420\u0434\u0440 2, \u043a\u0438\u0431\u0435\u0440\u043f\u0430\u043d\u043a, tlou\ud83d\ude05\ud83d\ude05\ud83d\ude05",
                    "author": "@lane0ff178",
                    "likes": 4,
                    "publishedAt": "2026-03-28T15:54:34Z"
                },
                {
                    "text": "\u041f\u043e\u0441\u043b\u0435 \u0442\u0440\u0438\u043b\u043e\u0433\u0438\u0438 \u041c\u0430\u0441\u0441 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0442\u0430\u043a\u043e\u0435 \u043c\u043e\u0436\u043d\u043e \u0441\u043b\u043e\u0432\u0438\u0442\u044c. \u041f\u0440\u043e\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432\u0441\u0435 \u0447\u0430\u0441\u0442\u0438 \u043e\u0447\u0435\u043d\u044c \u0434\u043e\u043b\u0433\u043e \u043a \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430\u043c \u043f\u0440\u0438\u0432\u044b\u043a\u0430\u0435\u0448\u044c \u043f\u043b\u044e\u0441 \u0435\u0449\u0435 \u0442\u0430\u043a\u0430\u044f \u043c\u0435\u043b\u0430\u043d\u0445\u043e\u043b\u0438\u044f \u0432 3 \u0447\u0430\u0441\u0442\u0438, \u0430 \u0435\u0449\u0435 \u0435\u0441\u043b\u0438 \u0440\u043e\u043c\u0430\u043d \u0442\u0430\u043c \u0437\u0430\u0432\u0435\u043b, \u0441 \u0442\u043e\u0439 \u0436\u0435 \u0422\u0430\u043b\u0438 \u0442\u043e \u0432\u0441\u0435, \u0434\u0435\u043f\u0440\u0435\u0441\u043d\u044f\u043a \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d..",
                    "author": "@ZoLoToi168",
                    "likes": 1,
                    "publishedAt": "2026-03-28T19:37:39Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0442\u0430\u043a \u0441\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0432\u0435\u0434\u044c\u043c\u0430\u043a\u0430. \u041f\u043e\u043b\u043d\u043e\u044f \u043f\u0443\u0441\u0442\u043e\u0442\u0430. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0434\u043e\u043b\u0433\u043e \u043d\u0435 \u043c\u043e\u0433 \u0437\u0430\u0441\u0435\u0441\u0442\u044c \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u044b.",
                    "author": "@LazarusGamkrelidze",
                    "likes": 3,
                    "publishedAt": "2026-03-28T16:02:43Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u043e \u0442\u0430\u043a\u043e\u0435 \u0441 \u043a\u0438\u0431\u0435\u0440\u043f\u0430\u043d\u043a\u043e\u043c, \u0445\u043e\u0442\u044f \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0435\u0441\u0442\u044c",
                    "author": "@DRACKONSKI",
                    "likes": 1,
                    "publishedAt": "2026-03-28T15:20:49Z"
                },
                {
                    "text": "\u0414\u0430 \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0435,\u0434\u0443\u043c\u0430\u043b,\u0447\u0442\u043e \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u043c\u0435\u043d\u044f \u0442\u0430\u043a.",
                    "author": "@alentiy",
                    "likes": 2,
                    "publishedAt": "2026-03-28T15:14:19Z"
                },
                {
                    "text": "\u042f \u043a\u043e\u0433\u0434\u0430 \u0432\u0435\u0434\u044c\u043c\u0430\u043a\u0430 \u043d\u0430 \u043f\u043b\u0430\u0442\u0438\u043d\u0443 \u043f\u0440\u043e\u0448\u0435\u043b \u043f\u043e\u0442\u043e\u043c \u0445\u043e\u0434\u0438\u043b \u0433\u0440\u0443\u0441\u0442\u0438\u043b",
                    "author": "@\u041d\u0438\u043a\u0438\u0442\u0430\u0410\u043d\u0434\u0440\u0435\u0435\u0432-\u04341\u0435",
                    "likes": 0,
                    "publishedAt": "2026-03-28T19:21:21Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0442\u0430\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0441\u043b\u0435 \u0445\u043e\u043b\u043e\u0443 \u041d\u0430\u0439\u0442\u0430 \u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u0438 \u043f\u043e\u0441\u043b\u0435 \u0441\u0438\u043b\u043a\u0441\u043e\u043d\u0433\u0430",
                    "author": "@Silksong-u1b",
                    "likes": 1,
                    "publishedAt": "2026-03-28T18:43:30Z"
                },
                {
                    "text": "\u041f\u043e\u0441\u043b\u0435 cyberpunk \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b, \u043f\u043e\u0442\u043e\u043c \u0442\u0430\u043a\u043e\u0435 \u0436\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043b \u043b\u0438\u0448\u044c \u0432 outlast \u0438 resident evil4",
                    "author": "@Spelot_Barmaley228",
                    "likes": 0,
                    "publishedAt": "2026-03-29T05:22:30Z"
                },
                {
                    "text": "\u042f \u0432\u043c\u0435\u0441\u0442\u0435 \u042f\u043a\u0443\u0431\u043e\u0432\u0438\u0447\u0435\u043c \u0441\u043a\u0430\u0437\u0430\u043b \u0434\u0430 \u043b\u0430\u0434\u043d\u043e",
                    "author": "@liker3310",
                    "likes": 1,
                    "publishedAt": "2026-03-28T15:27:48Z"
                },
                {
                    "text": "\u042f \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u0448\u0435\u043b doom the dark ages,\u0432\u044b\u0448\u0435\u043b \u043d\u0430 \u0443\u043b\u0438\u0446\u0443 \u0438 \u043f\u043e\u0442\u0440\u043e\u0433\u0430\u043b \u0442\u0440\u0430\u0432\u0443 \u0441 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0447\u0442\u043e\u043b\u0438)",
                    "author": "@qwerrtt000",
                    "likes": 0,
                    "publishedAt": "2026-03-29T05:42:16Z"
                },
                {
                    "text": "\u041e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u044f \u043f\u0440\u043e\u0445\u043e\u0436\u0443 \u043a\u0430\u043a\u0443\u044e-\u043d\u0438\u0431\u0443\u0434\u044c \u0438\u0433\u0440\u0443, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0438\u0432\u043b 4 \u0432\u0438\u0430\u0440 \u043f\u0440\u043e\u0448\u0451\u043b \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0442\u0430\u043a\u043e\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u043e\u0441\u0442\u0438, \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u044f.",
                    "author": "@\u0410\u0440\u043b\u044c\u0431\u0435\u0440\u0442\u041e\u0440\u043b\u043e\u0432",
                    "likes": 1,
                    "publishedAt": "2026-03-28T17:31:44Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u043f\u043e\u0441\u043b\u0435 \u0444\u0440\u043e\u0441\u0442\u043f\u0430\u043d\u043a\u0430 \u0442\u0430\u043a\u043e\u0435 \ud83d\ude02 \u0444\u0440\u043e\u0441\u0442\u043f\u0430\u043d\u043a 2 \u043d\u0435 \u0437\u0430\u0448\u0451\u043b. \u041d\u043e \u043d\u0430\u0434\u043e \u0432\u0441\u0435 \u0436\u0435 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0435\u0449\u0451 \u0440\u0430\u0437\u043e\u043a",
                    "author": "@MrJakut88",
                    "likes": 0,
                    "publishedAt": "2026-03-29T06:18:56Z"
                },
                {
                    "text": "\u0412 \u0430\u043d\u0438\u043c\u0435 \u0431\u044b\u043b\u043e",
                    "author": "@toreboy19",
                    "likes": 3,
                    "publishedAt": "2026-03-28T15:17:39Z"
                },
                {
                    "text": "\u0410 \u043f\u043e\u0442\u043e\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u043d\u0435 \u043e \u0447\u0451\u043c \u043d\u0435 \u0436\u0430\u043b\u0435\u0435\u0448\u044c \u0438 \u0435\u0441\u043b\u0438 \u0431\u044b \u043c\u043e\u0433, \u0442\u043e \u0441\u0442\u0451\u0440 \u0431\u044b \u0441\u0435\u0431\u0435 \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043b \u0432\u0441\u0451 \u0441\u043d\u043e\u0432\u0430...\n\u0411\u0435\u0437\u0443\u043c\u0438\u0435... \u041d\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435",
                    "author": "@type-c9780",
                    "likes": 0,
                    "publishedAt": "2026-03-28T19:11:45Z"
                },
                {
                    "text": "\u041f\u043e\u0441\u043b\u0435 the last of us \u0434\u0432\u0443\u0445 \u0447\u0430\u0441\u0442\u0435\u0439 \u0447\u043a\u0432\u0441\u0442\u0432\u043e \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u043e \u043c\u0435\u043d\u044f \u043e\u043a\u043e\u043b\u043e \u043c\u0435\u0441\u044f\u0446\u0430",
                    "author": "@denis_strelkow",
                    "likes": 0,
                    "publishedAt": "2026-03-28T15:29:41Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0442\u0430\u043a \u0441 \u0427\u041f2 \u0431\u044b\u043b\u043e",
                    "author": "@Kurbanovofficiail",
                    "likes": 0,
                    "publishedAt": "2026-03-29T04:43:25Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0441 \u043c\u0430\u0439\u043d\u043a\u0440\u0430\u0444\u0442\u043e\u043c \u0442\u0430\u043a, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441\u0442\u0430\u0440\u044b\u043c",
                    "author": "@EbanatVPraime",
                    "likes": 0,
                    "publishedAt": "2026-03-29T07:23:57Z"
                },
                {
                    "text": "\u0422\u0430\u043a \u0432\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u044f \u043f\u043e\u0441\u043b\u0435 \u043c\u0430\u0439\u043d\u0430 \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440 \u043f\u043e\u043f\u0440\u043e\u0441\u0442\u0443 \u043d\u0435 \u0434\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u044e \u0443\u0436\u0435 \u0438 \u0433\u043d\u0438\u044e \u0432 \u0448\u043e\u0440\u0446\u0430\u0445 \u0438 \u0442\u0442",
                    "author": "@Terst-w4w5o",
                    "likes": 0,
                    "publishedAt": "2026-03-29T06:48:30Z"
                },
                {
                    "text": "1 \u043c\u0435\u0440\u0430 \u044d\u0442\u043e 26.25 \u043b\u0438\u0442\u0440\u043e\u0432",
                    "author": "@Eeddeded",
                    "likes": 0,
                    "publishedAt": "2026-03-28T19:48:49Z"
                },
                {
                    "text": "\u041f\u0440\u043e\u0448\u0435\u043b cyberpunk 3 \u0440\u0430\u0437\u0430 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u043a \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0437",
                    "author": "@\u0410\u043d\u0434\u0440\u0435\u0439\u0411\u0440\u0435\u0436\u043d\u0435\u0432-\u04328\u043c",
                    "likes": 0,
                    "publishedAt": "2026-03-28T21:19:21Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0433\u043e\u0434\u0430\u043c\u0438 \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u0438 \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0451\u043d\u043d\u043e\u0441\u0442\u0438. \u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0441\u043f\u0438\u0448\u044c, \u0441\u043f\u0438\u0448\u044c, \u0441\u043f\u0438\u0448\u044c \u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0441\u043f\u0430\u0442\u044c. \u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0438\u043b\u043e\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0448\u044c \u0441\u0435\u0431\u044f \u0434\u0435\u043b\u0430\u0442\u044c \u043b\u044e\u0431\u043e\u0435 \u0434\u0435\u043b\u043e, \u0430 \u043b\u044e\u0431\u043e\u0435 \u0445\u043e\u0431\u0431\u0438 \u043b\u0438\u0448\u044c \u043f\u0440\u0438\u0442\u0443\u043f\u043b\u044f\u0435\u0442 \u0432\u0441\u0451 \u044d\u0442\u043e.\n\n\u0412\u043e\u0442 \u0442\u0430\u043a \u0438 \u0436\u0438\u0432\u0443. \u0411\u043e\u043b\u043e\u0442\u043e \u0436\u0438\u0437\u043d\u0438.\n\n---\n\nP.S. \u0412\u043e \u0441\u043d\u0435 \u043a\u0430\u043a \u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0449\u0435 \u0436\u0438\u0432\u0451\u0442\u0441\u044f, \u044f \u0442\u0430\u043c \u0443\u0436\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0441\u0432\u043e\u0438\u043b \u043b\u0451\u0442\u043d\u043e\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e \u0438 \u043f\u043e \u0438\u043d\u0435\u0440\u0446\u0438\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e, \u0442\u043e \u043b\u0435\u0442\u0430\u044e \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438(\u0442\u043e\u043b\u044c\u043a\u043e \u0431\u0435\u0441\u0438\u0442, \u0447\u0442\u043e \u043f\u0440\u0438 \u043f\u043b\u043e\u0445\u043e\u043c \u0441\u043d\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044f \u0441\u0438\u043b\u044c\u043d\u043e \u0434\u0430\u0432\u0438\u0442 \u0438\u043d\u043e\u0433\u0434\u0430), \u0442\u043e \u0434\u0435\u043b\u0430\u044e \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0435 \u043f\u0440\u044b\u0436\u043a\u0438... \u0420\u0430\u043d\u044c\u0448\u0435 \u0441\u043a\u043e\u043b\u044c\u0437\u0438\u043b \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0443 \u043d\u043e\u0433\u0430\u043c\u0438, \u043a\u0430\u043a \u043d\u0430 \u0442\u0443\u0440\u0431\u043e-\u043a\u043e\u043d\u044c\u043a\u0430\u0445 \u0438 \u044e\u0437\u0430\u043b \u0442\u0435\u043b\u0435\u043a\u0438\u043d\u0435\u0437, \u043d\u043e \u0432\u0438\u0434\u0438\u043c\u043e, \u043d\u0430\u0434\u043e\u0435\u043b\u043e.\n\n\u0415\u0449\u0451 \u0431\u0435\u0441\u0438\u0442, \u0447\u0442\u043e \u0438 \u0432\u043e \u0441\u043d\u0435 \u0431\u043e\u043b\u043e\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442. \u041a \u043f\u0440\u0438\u043c\u0435\u0440\u0443, \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435\u0434\u0430\u0432\u043d\u043e, \u0432 \u043e\u0434\u043d\u0443 \u043d\u043e\u0447\u044c, \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0441\u043d\u0435, \u043c\u0435\u043d\u044f \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b \u043d\u0438\u0447\u0443\u0442\u044c \u043d\u0435 \u043e\u0442\u0441\u0442\u0430\u0432\u0430\u044f, \u0434\u0430\u0436\u0435 \u0432 \u043f\u043e\u043b\u0451\u0442\u0435, \u043e\u0431\u043e\u0440\u043e\u0442\u0435\u043d\u044c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0438\u0437 \u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u0430\u0440\u0443 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043d\u0430\u0437\u0430\u0434 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b \u043c\u043e\u0434 Mo'Creatures. \u041d\u0435 \u0432\u044b\u0441\u043f\u0430\u043b\u0441\u044f \u0432 \u0438\u0442\u043e\u0433\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e...\n\n\u0422\u0430\u043a \u0442\u043e, \u0443\u0436\u0435 \u043d\u0435 \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439, \u0433\u0434\u0435 \u043f\u043e\u043c\u0438\u043c\u043e \u043c\u0435\u043d\u044f, \u0435\u0449\u0451 \u043a\u0442\u043e \u0442\u043e \u043b\u0435\u0442\u0430\u0435\u0442. \u0415\u0449\u0451 \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0430\u0434 \u0440\u0435\u043a\u043e\u0439 \u043f\u0440\u043e\u043b\u0435\u0442\u0430\u044f \u043f\u043e \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043b\u0435\u0442\u0430\u044e\u0449\u0435\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u043e\u0433\u0430\u043c\u0438, \u043a\u0430\u043a \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u041c\u0430\u0440\u0438\u043e, \u043d\u043e\u0433\u0430\u043c\u0438 \u043f\u043d\u0443\u043b(\u0438\u0431\u043e \u043d\u0435\u0444\u0438\u0433 \u043c\u0435\u043b\u044c\u0442\u0435\u0448\u0438\u0442\u044c)...\u0412 \u0434\u0440\u0443\u0433\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0433\u043e\u0440\u043e\u0434 \u0437\u0430\u043b\u0438\u043b\u043e \u0438 \u0438\u0437 \u0432\u043e\u0434\u044b \u043b\u0435\u0442\u0430\u044e\u0449\u0430\u044f \u0430\u043a\u0443\u043b\u0430 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043b\u0430...\n\n\u0416\u0430\u043b\u044c \u0447\u0442\u043e \u044f \u0432\u0441\u0435 \u0441\u043d\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u044e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0433\u0440\u0430\u0434\u0443\u0441 \u0431\u0435\u0437\u0443\u043c\u0438\u044f \u0437\u0430\u043f\u0440\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0441\u0435\u0433\u0434\u0430.\n\n\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u0440\u043e\u0434\u0435 \u044f \u043d\u0430 \u043f\u043e\u0445\u043e\u0440\u043e\u043d\u0430\u0445 \u0431\u044b\u043b \u0432\u043e \u0441\u043d\u0435, \u0432\u0440\u043e\u0434\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0432\u0441\u0451 \u0431\u044b\u043b\u043e, \u043d\u043e \u0441\u043a\u043e\u0440\u0431\u044f\u0449\u0438\u0435 \u0431\u044b\u043b\u0438 \u043d\u0435 \u043b\u044e\u0434\u044c\u043c\u0438 \u0432\u043e\u0432\u0441\u0435...\u041e\u0434\u0438\u043d \u0438\u0437 \u0441\u043d\u043e\u0432, \u0433\u0434\u0435 \u0432\u0441\u0451 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e.\n\n\u041e\u0431\u044b\u0447\u043d\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u0431\u043b\u043e\u043a\u0431\u0430\u0441\u0442\u0435\u0440 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0435\u0440\u0435\u043f\u043b\u044e\u043d\u0435\u0442 \u0441\u044e\u0436\u0435\u0442\u043e\u043c \u043b\u044e\u0431\u043e\u0439 \u0444\u0438\u043b\u044c\u043c...\n\n\u0418\u043d\u043e\u0433\u0434\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0443\u0441\u0442\u0430\u0451\u0448\u044c \u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0441\u043f\u0430\u0442\u044c. \u0417\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0439 \u043a\u0440\u0443\u0433 \u0441\u043e\u043d\u043d\u043e\u0441\u0442\u0438. \u041d\u043e \u043b\u0443\u0447\u0448\u0435 \u044d\u0442\u043e, \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u043b\u044c\u043d\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.",
                    "author": "@benjiromori",
