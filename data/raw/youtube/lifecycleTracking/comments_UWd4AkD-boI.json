                },
                {
                    "text": "\u2764\u2764 \u0915\u0932 \u0905\u0927\u0942\u0930\u0940 \u0930\u0939 \u0917\u0908, \u0906\u091c \u092a\u0942\u0930\u0940 \u0932\u093f\u0916 \u0926\u0942\u0902 \u0915\u094d\u092f\u093e \ud83c\udf89\ud83c\udf89 \u0924\u0941\u091d\u0947 \u0938\u092e\u091d\u0928\u0947 \u092e\u0947\u0902 \u0926\u093f\u0928 \u091a\u0932\u093e \u0917\u092f\u093e, \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u0930\u093e\u0924 \u092c\u093f\u0924\u093e \u0926\u0942\u0902 \u0915\u094d\u092f\u093e \u2764\u2764 \u0924\u0941\u091d\u0938\u0947 \u0939\u0940 \u0939\u0948\u0902 \u0938\u093e\u0930\u0940 \u0916\u0941\u0936\u093f\u092f\u093e\u0901 \u092e\u0947\u0930\u0940,  \u0924\u0941\u092e \u0915\u0939\u094b \u0924\u094b \u0921\u093e\u092f\u0930\u0940 \u0926\u093f\u0916\u093e \u0926\u0942\u0902 \u0915\u094d\u092f\u093e \ud83c\udf89\ud83c\udf89",
                    "author": "@PankajSitara7668",
                    "likes": 6,
                    "publishedAt": "2026-04-08T14:32:31Z"
                },
                {
                    "text": "\ud83d\udc4f\ud83d\udc4f \u092e\u0947\u0930\u0940 \u092e\u094c\u0924 \u092a\u0930 \u0930\u094b\u0928\u0947 \u092e\u0924 \u0906\u0928\u093e \ud83d\ude22 \u0915\u093f\u0924\u0928\u0940 \u092e\u094b\u0939\u092c\u094d\u092c\u0924 \u0939\u0948 \u092f\u0947 \u091c\u0924\u093e\u0928\u0947 \u092e\u0924 \u0906\u0928\u093e \u2764\ufe0f\u2764\ufe0f \u0914\u0930 \u0906\u091c \u091c\u093f\u0902\u0926\u093e \u0939\u0942\u0902 \u0924\u094b \u0915\u0926\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \ud83d\udd25 \u091c\u092c \u0938\u094b \u091c\u093e\u090a\u0901 \u0924\u094b \u091c\u0917\u093e\u0928\u0947 \u092e\u0924 \u0906\u0928\u093e \ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@PankajSitara7668",
                    "likes": 38,
                    "publishedAt": "2026-04-08T14:32:13Z"
                },
                {
                    "text": "\u0918\u094b\u0930 \u0915\u0932\u092f\u0941\u0917 \u0906 \u0917\u092f\u093e \u0939\u0948 \u0932\u093e\u0916\u094b\u0902 \u0932\u094b\u0917 \u0909\u092a\u0938\u094d\u0925\u093f\u0924 \u0939\u0948\u0902 \u092f\u0947 \u0938\u0940\u0930\u093f\u092f\u0932 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0941\u091d\u0947 \u0928\u0939\u0940\u0902 \u0932\u0917\u0924\u093e \u0915\u094b\u0908 \u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092e\u093e\u0924\u093e \u0930\u093e\u0928\u0940 \u0915\u094b \u0932\u093e\u0907\u0915 \ud83d\ude22\ud83d\ude22\u091c\u092f \u092e\u093e\u0924\u093e \u0926\u0940 \u2764\u2764\u2764",
                    "author": "@\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f\u0938\u0941\u0915\u0932\u093e-\u09082kme3ve",
                    "likes": 46,
                    "publishedAt": "2026-04-08T14:31:23Z"
                },
                {
                    "text": "Bord exam ka result ki kasm jisne mere coment ko like aur subckraib nhi kiya vah exam me fail hogya\ud83d\ude02\ud83c\udf89\ud83c\udf89",
                    "author": "@ShoftNimful",
                    "likes": 3,
                    "publishedAt": "2026-04-08T14:31:25Z"
                },
                {
                    "text": "\u2764\u2764 \u0939\u092e \u091c\u094b \u0924\u0941\u092e\u0938\u0947 \u092e\u093f\u0932\u0947 \u0907\u0924\u094d\u0924\u0947\u092b\u093e\u0915 \u0925\u094b\u0921\u093c\u0940 \u0939\u0948 \ud83c\udf89\ud83c\udf89 \u092e\u093f\u0932\u0915\u0947 \u0924\u0941\u092e\u0915\u094b \u091b\u094b\u0921 \u0926\u0947 \u092e\u091c\u093e\u0915 \u0925\u094b\u0921\u093c\u0940 \u0939\u0948 \ud83d\ude22\ud83d\ude22 \u0905\u0917\u0930 \u0939\u094b\u0924\u0940 \u0924\u0941\u092e\u0938\u0947 \u0926\u094b\u0938\u094d\u0924\u0940 \u0915\u0941\u091b \u0939\u0926 \u0924\u0915 \u0924\u094b \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u2764\u2764 \u092e\u0917\u0930 \u0939\u092e\u093e\u0930\u0940 \u0926\u094b\u0938\u094d\u0924\u0940 \u0915\u093e \u0939\u093f\u0938\u093e\u092c \u0925\u094b\u0921\u093c\u0940 \u0939\u0948 \ud83c\udf89\ud83c\udf89 \u0905\u092c \u0924\u0941\u092e \u0922\u0942\u0902\u0922\u094b\u0917\u0947 \u092e\u0947\u0930\u0940 \u0907\u0938 \u0917\u093c\u091c\u093c\u0932 \u0915\u093e \u091c\u0935\u093e\u092c \u2764\ud83c\udf89 \u092f\u0947 \u092e\u0947\u0930\u0947 \u0926\u093f\u0932 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0939\u0948,  \u0915\u093f\u0924\u093e\u092c \u0925\u094b\u0921\u093c\u0940 \u0939\u0948 \ud83d\ude22\ud83d\ude22\u2764\u2764\ud83c\udf89\ud83c\udf89 \u0932\u0947\u0916\u0915 Pankaj sitara",
                    "author": "@PankajSitara7668",
                    "likes": 14,
                    "publishedAt": "2026-04-08T14:31:43Z"
                }
            ]
