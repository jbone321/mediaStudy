                {
                    "text": "\"\u0907\u0938 \u0936\u094b \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0930 \u0926\u093f\u0928 \u0926\u093f\u0932 \u0915\u094b \u091b\u0942 \u091c\u093e\u0924\u0940 \u0939\u0948, '\u092e\u0928 \u0905\u0924\u093f \u0938\u0941\u0902\u0926\u0930' \u0915\u093e \u0905\u0938\u0932\u0940 \u092e\u0924\u0932\u092c \u0938\u093f\u0916\u093e\u0924\u0940 \u0939\u0948\u0964 \ud83d\udcaf\u2764\ufe0f\"",
                    "author": "@praptishuklaofficial1",
                    "likes": 19,
                    "publishedAt": "2026-04-08T14:35:16Z"
                },
                {
                    "text": "\"\u0938\u091a\u094d\u091a\u093e \u092a\u094d\u092f\u093e\u0930 \u0938\u0942\u0930\u0924 \u0915\u093e \u092e\u094b\u0939\u0924\u093e\u091c \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u0930\u093e\u0927\u094d\u092f\u093e \u0915\u0940 \u0938\u093e\u0926\u0917\u0940 \u0928\u0947 \u0926\u093f\u0932 \u091c\u0940\u0924 \u0932\u093f\u092f\u093e! \u2764\ufe0f\ud83d\udd25\"",
                    "author": "@praptishuklaofficial1",
                    "likes": 29,
                    "publishedAt": "2026-04-08T14:35:28Z"
                },
                {
                    "text": "\"\u0930\u093e\u0927\u094d\u092f\u093e \u0915\u093e \u092d\u094b\u0932\u093e\u092a\u0928 \u0914\u0930 \u092a\u094d\u0930\u0925\u092e \u0915\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938, \u0935\u093e\u0915\u0908 \u0915\u0939\u093e\u0928\u0940 \u0915\u094b '\u092e\u0928 \u0905\u0924\u093f \u0938\u0941\u0902\u0926\u0930' \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948! \u2764\ufe0f\u2728\"",
                    "author": "@praptishuklaofficial1",
                    "likes": 60,
                    "publishedAt": "2026-04-08T14:35:53Z"
                },
                {
                    "text": "\u0905\u0928\u0941\u092d\u0935 \u0914\u0930 \u092a\u094d\u092f\u093e\u0930 \u0915\u093e \u0938\u0902\u0917\u092e \u0939\u0948 \u0928\u093e\u0928\u0940,\n\u0930\u093e\u0927\u094d\u092f\u093e \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092e\u0947\u0902 \u0905\u092c \u092c\u0926\u0932\u0947\u0917\u0940 \u0930\u0935\u093e\u0928\u0940\u0964\n\u092e\u0941\u0938\u0940\u092c\u0924\u094b\u0902 \u0915\u094b \u0905\u092c \u0935\u094b \u0938\u092c\u0915 \u0938\u093f\u0916\u093e\u090f\u0902\u0917\u0940,\n\u0926\u0947\u0916\u0928\u093e '\u092e\u0928 \u0905\u0924\u093f\u0938\u0941\u0902\u0926\u0930' \u092e\u0947\u0902 \u0928\u093e\u0928\u0940 \u0915\u094d\u092f\u093e \u0930\u0902\u0917 \u091c\u092e\u093e\u090f\u0902\u0917\u0940",
                    "author": "@ReemaRanireal",
                    "likes": 39,
                    "publishedAt": "2026-04-08T14:31:33Z"
                },
                {
                    "text": "Ab kahani me naya twist aane vala haii kisko kisko pta haii ki radhya ki nani aane vali haii\ud83d\ude05\ud83d\ude05\ud83d\ude05",
                    "author": "@Akankshavlog0011",
                    "likes": 12,
                    "publishedAt": "2026-04-08T14:34:16Z"
                },
                {
                    "text": "Lekin Aaj ek ummid dikhi h radhya Budhiya Ban k aa Gai ab lag raha hai sach Samne aaega\ud83d\ude02\ud83d\ude02 wait for next episode",
                    "author": "@RaganiKumari-m9k",
                    "likes": 17,
                    "publishedAt": "2026-04-08T14:41:44Z"
                },
                {
                    "text": "\u2764\u2764 \u0936\u094b\u0930 \u092c\u0939\u0941\u0924 \u0939\u0948 \u092e\u0917\u0930 \u0938\u0941\u0928\u093e\u092f\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0917\u093e \ud83c\udf89\ud83c\udf89 \u0926\u093f\u0932 \u0915\u093e \u0926\u0930\u094d\u0926 \u0905\u092c \u091a\u0947\u0939\u0930\u0947 \u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0917\u093e \u2764\u2764 \u090f\u0915 \u0924\u0941\u091d\u0938\u0947 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u091a\u0915\u094d\u0915\u0930 \u092e\u0947\u0902,  \ud83d\ude22\ud83d\ude22 \u092e\u0948\u0902\u0928\u0947 \u0938\u092c\u0938\u0947 \u092c\u093f\u0917\u093e\u0921\u093c \u0932\u0940 \ud83d\ude22\ud83d\ude22 \u0905\u092c \u0924\u094b \u092e\u0947\u0930\u0947 \u0939\u0915 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0917\u0935\u093e\u0939\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0917\u093e \u2764\u2764\ud83c\udf89\ud83c\udf89",
                    "author": "@PankajSitara7668",
                    "likes": 19,
                    "publishedAt": "2026-04-08T14:33:25Z"
                },
                {
                    "text": "\u092f\u0947 \u092e\u094b\u0939\u092c\u094d\u092c\u0924 \u0915\u0947 \u0939\u093e\u0926\u0938\u0947 \u0905\u0915\u094d\u0938\u0930 \u0926\u093f\u0932\u094b\u0902 \u0915\u094b \u0924\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902,  \ud83d\ude22\ud83d\ude22 \u0924\u0941\u092e \u092e\u0902\u091c\u093f\u0932 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u094b,  \u0932\u094b\u0917 \u0930\u093e\u0938\u094d\u0924\u0947 \u092e\u0947\u0902 \u0939\u0940 \u0938\u093e\u0925 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902,  \ud83d\ude22\ud83d\ude22 \u0910 \u091c\u093f\u0902\u0926\u0917\u0940 \u0906\u091c \u0938\u0947 \u090f\u0915 \u0928\u092f\u093e \u092e\u094b\u0921\u093c \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u2764\u2764 \u0915\u093f\u0924\u093e\u092c\u094b\u0902 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0938\u092c \u0915\u0941\u091b \u091b\u094b\u0921 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902",
                    "author": "@Khushbu_kumari22",
                    "likes": 11,
                    "publishedAt": "2026-04-08T14:32:00Z"
                },
                {
                    "text": "\u0928\u093e\u0928\u0940 \u0915\u0940 \u090f\u0902\u091f\u094d\u0930\u0940 \u0938\u0947 \u0915\u0939\u093e\u0928\u0940 \u092e\u0947\u0902 \u0906\u092f\u093e \u0939\u0948 \u0928\u092f\u093e \u092e\u094b\u0921\u093c,\n\u0930\u093e\u0927\u094d\u092f\u093e \u0915\u0940 \u0939\u093f\u092e\u094d\u092e\u0924 \u092c\u0928\u0940\u0902, \u092e\u0941\u0938\u0940\u092c\u0924\u0947\u0902 \u0917\u0908\u0902 \u0905\u092c \u0924\u094b\u0921\u093c\u0964\n\u0905\u0928\u0941\u092d\u0935 \u0915\u0940 \u092e\u0942\u0930\u0924, \u092e\u092e\u0924\u093e \u0915\u093e \u0938\u093e\u0917\u0930 \u0935\u094b \u0915\u0939\u0932\u093e\u090f\u0902,\n'\u092e\u0928 \u0905\u0924\u093f\u0938\u0941\u0902\u0926\u0930' \u092e\u0947\u0902 \u0905\u092c \u0928\u093e\u0928\u0940\u091c\u0940 \u0915\u0947 \u0915\u093f\u0938\u094d\u0938\u0947 \u091b\u093e\u090f\u0902\u0964",
                    "author": "@ReemaRanireal",
                    "likes": 57,
                    "publishedAt": "2026-04-08T14:31:10Z"
                },
                {
                    "text": "\u092f\u0939 \u0938\u0940\u0928 \u0924\u094b \u0930\u093e\u0927\u093e \u092e\u094b\u0939\u0928 \u092e\u0947\u0902 \u092d\u0940 \u0939\u0941\u0906 \u0925\u093e\ud83d\ude22\ud83d\ude22",
                    "author": "@MoniMoni-u5j",
                    "likes": 6,
                    "publishedAt": "2026-04-08T14:46:22Z"
                },
                {
                    "text": "\u092e\u094b\u092c\u093e\u0907\u0932 \u091b\u094b\u0921\u093c\u0915\u0930 \u0915\u0939\u0940\u0902 \u091c\u093e\u0913 \u0924\u094b \u0910\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0947\u0935\u0932 \u0936\u0930\u0940\u0930 \u0938\u093e\u0925 \u0906\u092f\u093e \u0939\u0948,  \u0906\u0924\u094d\u092e\u093e \u092c\u0939\u0940\u0902 \u0930\u0939 \u0917\u092f\u0940 \u0939\u0948\u0902.  \ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83c\udf89",
                    "author": "@PankajSitara7668",
                    "likes": 32,
                    "publishedAt": "2026-04-08T14:33:36Z"
                },
                {
                    "text": "*\u0925\u094b\u0921\u093c\u0947 \u092c\u0939\u0941\u0924 \u0916\u0930\u093e\u092c \u0939\u0948\u0902 \u092c\u0926\u0928\u093e\u092e \u0925\u094b\u0921\u093c\u0940 \u0939\u0948, \u092f\u0947 \u0939\u092e\u093e\u0930\u0940 \u0906\u0901\u0916\u0947\u0902 \u0939\u0948 \u0915\u094b\u0908 \u091c\u093e\u092e \u0925\u094b\u0921\u093c\u0940 \u0939\u0948..*\n\n*\u0924\u0947\u0930\u0947 \u0907\u0936\u093e\u0930\u094b \u092a\u0930 \u0928\u093e\u091a\u0947\u0902\u0917\u0947 \u092f\u0947 \u092c\u0939\u092e \u0939\u0948 \u0924\u0947\u0930\u093e, \u0939\u092e \u0924\u0947\u0930\u0947 \u0906\u0936\u093f\u0915 \u0939\u0948 \u0917\u0941\u0932\u093e\u092e \u0925\u094b\u0921\u093c\u0940 \u0939\u0948...*",
                    "author": "@prapti-Sukla-d6",
                    "likes": 30,
                    "publishedAt": "2026-04-08T14:34:35Z"
                },
                {
                    "text": "\u0915\u094c\u0928-\u0915\u094c\u0928 \u091a\u093e\u0939\u0924\u093e \u0939\u0948 \u0915\u0940 \u092a\u094d\u0930\u0925\u092e radhya \u0915\u094b \u092a\u094d\u0930\u092a\u094b\u091c \u0915\u0930 \u0926\u0947 \ud83d\ude02\ud83d\ude02\ud83e\udd70\ud83e\udd70\ud83e\udd70",
                    "author": "@\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f\u0936\u0941\u0915\u094d\u0932\u093e-s32",
                    "likes": 10,
                    "publishedAt": "2026-04-08T14:31:49Z"
                },
                {
                    "text": "Radhe aur Pratham kitne acche lagte Hain main Sahi bol rahi hun na",
                    "author": "@AdityaKumar-r2u7i",
                    "likes": 8,
                    "publishedAt": "2026-04-08T14:42:06Z"
                },
                {
                    "text": "\u2764\u2764 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u0906\u0902\u0916\u094b\u0902 \u092e\u0947\u0902 \u0905\u0930\u092e\u093e\u0928 \u0939\u0941\u0906 \u0915\u0930\u0924\u0947 \u0925\u0947 \ud83d\ude22\ud83d\ude22 \u0939\u092e \u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0926\u093f\u0932 \u0915\u0947 \u0907\u0915\u0932\u094c\u0924\u0947 \u092e\u0947\u0939\u092e\u093e\u0928 \u0939\u0941\u0906 \u0915\u0930\u0924\u0947 \u0925\u0947 \ud83c\udf89\ud83c\udf89 \u0935\u0915\u093c\u094d\u0924 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948 \u0939\u0930 \u0915\u094b\u0908 \u2764\u2764 \u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \ud83c\udf89\ud83c\udf89 \u092c\u0930\u0928\u093e \u0939\u092e \u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0926\u093f\u0932 \u0915\u0940 \u091c\u093e\u0928 \u0939\u0941\u0906 \u0915\u0930\u0924\u0947 \u0925\u0947 \u2764\u2764 \u0932\u0947\u0916\u0915 - pankaj sitara",
                    "author": "@PankajSitara7668",
                    "likes": 41,
                    "publishedAt": "2026-04-08T14:32:52Z"
                },
                {
                    "text": "\u0939\u0930 \u092d\u0930\u094d\u0924\u0940 \u092b\u0938 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0907\u0932\u093e\u0939\u093e\u0935\u093e\u0926 \u0939\u093e\u0908 \u0915\u094b\u0930\u094d\u091f \u0915\u0947 \u0915\u0947\u0938 \u092e\u0947\u0902\u0964 \u092f\u0915\u0940\u0928 \u0928 \u0939\u094b \u0924\u094b \u092b\u093e\u0930\u094d\u092e \u092d\u0930\u0915\u0947 \u0926\u0947\u0916\u0932\u094b \u0939\u092e\u093e\u0930\u0947 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u0947\u0902\u0964 \ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\u2764\u2764\u2764\u2764\u2764\u2764\u2764\u2764",
                    "author": "@PankajSitara7668",
                    "likes": 14,
                    "publishedAt": "2026-04-08T14:33:13Z"
                },
                {
                    "text": "\u0905\u0917\u0930 radhya \u0914\u0930 \u092a\u094d\u0930\u0925\u092e \u0915\u092d\u0940 \u092d\u0940 \u0938\u0940\u0930\u093f\u092f\u0932 \u091b\u094b\u0921\u093c \u0926\u0947 \u0924\u094b \u092c\u0939\u0941\u0924 \u0932\u094b\u0917 \u0938\u0940\u0930\u093f\u092f\u0932 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f\u0924\u0928\u0947 \u0932\u094b\u0917 \u0938\u0939\u092e\u0924 \u0939\u0948\u0902 \u092e\u0947\u0930\u0940 \u092c\u093e\u0924 \u0938\u0947 \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f\u0936\u0941\u0915\u094d\u0932\u093e-s32",
                    "likes": 587,
                    "publishedAt": "2026-04-08T14:31:09Z"
                },
                {
                    "text": "\ud83d\ude0a*\u0939\u0930 \u0915\u0939\u093e\u0928\u0940 \u092e\u0947\u0902 \u0932\u094b\u0917 \u0906\u0924\u094d\u092e \u0939\u0924\u094d\u092f\u093e \u0932\u094b\u0917 \u0910\u0938\u0947 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0915\u093f\u0938\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0924\u0928\u0947 \u0926\u0941\u0916 \u0939\u094b\u0924\u0947 \u0939\u0948 \u0915\u0940*\n\n*\u092e\u0943\u0924\u094d\u092f\u0941 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u093f\u0938\u0940 \u0938\u0941\u0916 \u091c\u0948\u0938\u0940 \u0932\u0917\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948*",
                    "author": "@prapti-Sukla-d6",
                    "likes": 22,
                    "publishedAt": "2026-04-08T14:35:18Z"
                },
                {
                    "text": "\u091c\u094b \u0915\u094b\u0908 \u092e\u0947\u0930\u093e comment \u092a\u0922 \u0930\u0939\u093e \u0939\u0948 \u092d\u0917\u0935\u093e\u0928 \u0909\u0928\u0915\u0947 \u092e\u093e\u0924\u093e \u092a\u093f\u0924\u093e \u0915\u094b \u0932\u092e\u094d\u092c\u0940 \u0909\u092e\u094d\u0930 \u0926\u0947\ud83d\ude2e\ud83d\ude2e\ud83d\ude2e\ud83c\udf89\ud83c\udf89\ud83c\udf89\u2764\u2764",
                    "author": "@KaifBhai2008",
                    "likes": 8,
                    "publishedAt": "2026-04-08T14:31:11Z"
                },
                {
                    "text": "*\u092e\u0924 \u0915\u0930 \u0924\u092e\u094d\u092e\u0928\u093e \u0915\u093f\u0938\u0940 \u0915\u094b \u092a\u093e\u0928\u0947 \u0915\u0940, \u092c\u0921\u093c\u0940 \u092c\u0947\u0926\u0930\u094d\u0926 \u0928\u093f\u0917\u093e\u0939\u0947\u0902 \u0939\u0948\u0902 \u0907\u0938 \u091c\u092e\u093e\u0928\u0947 \u0915\u0940*\n\n*\u0924\u0942 \u0916\u0941\u0926 \u0915\u094b \u092c\u0928\u093e \u0915\u093e\u092c\u093f\u0932 \u0907\u0938 \u0915\u0926\u0930, \u0915\u0940 \u0932\u094b\u0917 \u0924\u092e\u094d\u092e\u0928\u093e \u0915\u0930\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u093e\u0928\u0947 \u0915\u0940 \"*",
                    "author": "@prapti-Sukla-d6",
                    "likes": 16,
