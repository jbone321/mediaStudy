                {
                    "text": "\u092d\u093e\u0930\u0924 \u0915\u0947 \u0917\u0930\u0940\u092c\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b \u0928\u0939\u0940\u0902\n\u092c\u0932\u094d\u0915\u093f \u0905\u092a\u0928\u0940 \u0906\u0924\u094d\u092e\u093e \u0915\u094b \u092c\u093e\u0902\u0927 \u0930\u0916\u093e \u0939\u0948\u0964\n\u092f\u0947 \u0930\u094b\u0924\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948,\u092d\u0942\u0916\u0940 \u092a\u094d\u092f\u093e\u0938\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u0926\u0930\u094d\u0926 \u0915\u094b \u0938\u0939\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0906\u0902\u0938\u0941\u0913\u0902 \u0915\u093e \u092a\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964\n\u0915\u093e\u0936 \u092f\u0947 \u0935\u093f\u0926\u094d\u0930\u094b\u0939 \u0915\u0930\u0947 \u0913\u0930 \u091c\u093e\u0932\u093f\u092e\u094b\u0902 \u0938\u0947 \u090f\u0915 \u090f\u0915 \u092a\u0932 \u0915\u093e \u0939\u093f\u0938\u093e\u092c \u0932\u0947\u0964",
