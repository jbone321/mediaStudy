                {
                    "text": "\ucf00\ud31d\uc774 \uba38\ub0d0?\uc5b4?\ud55c\uae00 \uc544\ub2c8\ub0d0 \uadf8\ub7f0\ub370 \uc8c4\ub2e4 \uc601\uc5b4\ub85c \uccd0 \ubd80\ub974\ub294\ub370 \uadf8\uac8c \ucf00\ubc25\uc774\ub0d0",
