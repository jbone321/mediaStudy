                },
                {
                    "text": "\uc624\uc138\ud6c8 \ubb3b\uc5b4\uc11c \ubd80\uc815\ud0d4\ub2e4",
                    "author": "@shp6804",
                    "likes": 0,
                    "publishedAt": "2026-03-26T06:05:27Z"
                },
                {
                    "text": "\ube14\ub799\ud551\ud06c\ub294 \uc9c0\ub4e4\uc774 \ud65c\ub3d9 \uc548 \ud55c\uac70\uace0 bts\ub294 \uc774\uc81c \uc2dc\uc791\uc774\uace0. \uc8fc\ub9d0\uc5d0 \uad11\ud654\ubb38 \uadfc\ucc98\uc5d0\ub3c4 \uc548\uac00\ub294 \uac83\ub4e4\uc774 90%\uc774\uc0c1 \uc77c\ud150\ub370 \uc5ec\ub860 \uac81\ub098 \uc548 \uc88b\uac8c \ubab0\uc544\uac00\ub294\uac8c \ub531\ubd10\ub3c4 \uc815\uce58 \ubb3b\uc740\uac70\uc784. \uad11\ud654\ubb38\uc740 \ubc15\uadfc\ud61c \ud0c4\ud575\ub54c\uac00 \ube44\uad50\ub3c4 \uc548\ub420\ub9cc\ud07c \ud6e8\uc52c \uc2ec\ud588\uc5b4.",
                    "author": "@Cyvogue_Franky",
                    "likes": 0,
                    "publishedAt": "2026-03-26T07:15:27Z"
                },
                {
