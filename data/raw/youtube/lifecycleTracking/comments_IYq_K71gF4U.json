                    "likes": 0,
                    "publishedAt": "2026-03-26T02:41:49Z"
                },
                {
                    "text": "\ube14\ub799\ud551\ud06c \ucef4\ubc31\ud588\uc5c8\ub2e8\uac78 \uc5ec\uae30\uc11c \uc54c\uc558\ub124 \u3137\u3137",
                    "author": "@\ubd88\uc2ec\uc73c\ub85c\ub300\ub3d9\ub2e8\uacb0-bud",
