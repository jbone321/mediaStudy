            "comments": [
                {
                    "text": "\u041c\u041e\u0419 \u0422\u0413 \u041a\u0410\u041d\u0410\u041b - https://t.me/humayarena",
                    "author": "@humay342",
                    "likes": 0,
                    "publishedAt": "2026-04-05T09:03:55Z"
                },
                {
                    "text": "\u0420\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u043c\u0435\u0436\u0434\u0443 \u0442\u0430\u0440\u043a\u043e\u0432\u044b\u043c \u0438 \u0430\u0440\u0435\u043d\u043e\u0439\ud83d\ude02\n1 \u043a\u0430\u0442\u043a\u0430 \u0432 \u0422\u0430\u0440\u043a\u043e\u0432\u0435-\u041c\u0435\u043d\u044f \u043f\u043e\u0438\u043c\u0435\u043b \u0441\u043a\u0432\u0430\u0434 \u0431\u043e\u0442\u043e\u0432\n2 \u043a\u0430\u0442\u043a\u0430 -\u043d\u0430\u0448\u0435\u043b \u043c\u043d\u043e\u0433\u043e \u043c\u0443\u0441\u043e\u0440\u0430 \u0438 \u043f\u0430\u0440\u0443 \u0445\u043e\u0440\u043e\u0448\u0438\u0445 \u043e\u0431\u0432\u0435\u0441\u043e\u0432\n3 \u043a\u0430\u0442\u043a\u0430-\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u043b\u0441\u044f \u043f\u043e \u043f\u043e\u043b\u043d\u043e\u0439, \u0441\u0440\u0430\u0437\u0443 \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u0435 \u0432 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u043c \u0434\u043e\u043c\u0435 \u0432\u0438\u0436\u0443 \u0432\u0441\u043f\u044b\u0448\u043a\u0443 \u0438 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0439 \u044d\u043a\u0440\u0430\u043d\n\u0418\u0442\u043e\u0433:\u041c\u0435\u043d\u044f \u043f\u043e\u0438\u043c\u0435\u043b\u0438\ud83d\ude02",
                    "author": "@virustv8705",
                    "likes": 1,
                    "publishedAt": "2026-04-07T01:36:47Z"
                },
                {
                    "text": "\u041f\u0435\u0440\u0432\u0430\u044f \u043a\u0430\u0442\u043a\u0430 \u0442\u0440\u0438 \u043a\u0440\u0430\u0441\u043d\u044b\u0445 \u043d\u0430\u0448\u0451\u043b, \u043f\u043e\u0442\u043e\u043c \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0435\u0431\u044b\u043b\u043e, \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u043b\u0438\u0431\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u0435\u0437 \u043a\u0440\u0430\u0441\u043d\u044b\u0445 \u043d\u043e \u0437\u043e\u043b\u043e\u0442\u0430 \u043c\u043d\u043e\u0433\u043e",
                    "author": "@testosteronpetrov1490",
                    "likes": 2,
                    "publishedAt": "2026-04-05T17:50:33Z"
                },
                {
                    "text": "\u0420\u0435\u0436\u0438\u043c \u043f\u0440\u043e\u0444\u0438\u0442\u043d\u044b\u0439, \u043d\u043e \u044f \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043b \u0442\u0440\u0438 \u043a\u0430\u0442\u043a\u0438 \u0438 \u0441\u043f\u0430\u0442\u044c \u043f\u043e\u0448\u0451\u043b. \u041f\u0440\u0438\u0445\u043e\u0434\u0442\u0441\u044f \u043b\u0443\u0442\u0430\u0442\u044c \u0432\u0441\u0451 \u043f\u043e\u0434\u0440\u044f\u0434, \u043a\u0430\u0436\u0434\u044b\u0439 \u044f\u0449\u0438\u0447\u0435\u043a \u0438 \u0441\u0443\u043c\u043a\u0443, \u0434\u0430\u0436\u0435 \u0431\u043e\u0442\u043e\u0432, \u0442\u0430\u043a \u043a\u0430\u043a \u043a\u043b\u044e\u0447 \u0438 \u0441 \u043d\u0438\u0445 \u0443\u043f\u0430\u0441\u0442\u044c \u043c\u043e\u0436\u0435\u0442. \u0412 \u0438\u0442\u043e\u0433\u0435, \u0437\u0430 \u0442\u0440\u0438 \u043a\u0430\u0442\u043a\u0438 \u0434\u0432\u0435 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438. \u041e\u0434\u043d\u0430 \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043b\u0435\u0434\u0430\u043b\u0430 \u0432 \u044f\u0449\u0438\u0447\u043a\u0435 \u0432 \u0441\u0430\u0440\u0442\u0438\u0440\u0435 \u0432 \u043f\u0440\u043e\u043c\u043a\u0435 \u0432\u043e\u0437\u043b\u0435 \u043f\u043b\u0430\u0442\u043a\u0438.",
                    "author": "@ROZNAX",
                    "likes": 0,
                    "publishedAt": "2026-04-06T22:26:50Z"
                },
                {
                    "text": "\u0417\u0430 \u0441\u0435\u043c\u044c \u0431\u0438\u043b\u0435\u0442\u043e\u0432 \u0432\u044b\u043d\u0435\u0441  9 \u043a\u0440\u0430\u0441\u043d\u0443\u0445, \u043b\u0443\u0442\u0430\u043b \u0432\u0441\u0435 \u0441\u0435\u0439\u0444\u044b \u043d\u0430 \u0414\u043e\u043b\u0438\u043d\u0435. \u0412 \u043f\u0435\u0440\u0432\u0443\u044e \u043a\u0430\u0442\u043a\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 \u043f\u043e\u043f\u0430\u043b\u043e\u0441\u044c \u043d\u0438\u0447\u0435\u0433\u043e \u043a\u0440\u043e\u043c\u0435 \u0437\u043e\u043b\u043e\u0442\u0430, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432 \u043e\u0431\u0449\u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438: \u0442\u0440\u0438 \u043a\u0430\u0442\u043a\u0438 \u043f\u043e \u043f\u043e \u0434\u0432\u0435 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438 \u0438 \u0442\u0440\u0438 \u043f\u043e \u043e\u0434\u043d\u043e\u0439. \u041d\u0435\u043f\u043b\u043e\u0445\u043e, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0447\u0442\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0432\u0435\u0437\u043b\u043e",
                    "author": "@alexchicozz2234",
                    "likes": 12,
                    "publishedAt": "2026-04-05T11:34:35Z"
                },
                {
                    "text": "\u043e\u0442\u043d\u0438\u043c\u0430\u0439 \u043e\u0442 \u043e\u0431\u0449\u0435\u0439 \u0441\u0443\u043c\u043c\u044b \u043f\u043e\u043b\u043b\u044f\u043c\u0430, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u044d\u043a\u0432\u0438\u043f \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0435\u0431\u0435 \u0434\u0430\u044e\u0442 \u0438\u0434\u0435\u0442 \u0432 \u0437\u0430\u0447\u0435\u0442",
                    "author": "@\u0414\u0435\u043d\u0438\u0441\u0413\u0440\u0430\u0431\u043e\u0432\u0441\u043a\u0438\u0439-\u044d4\u0448",
                    "likes": 0,
                    "publishedAt": "2026-04-06T21:55:49Z"
                },
                {
                    "text": "\u041d\u0443, \u043d\u0435 \u0437\u043d\u0430\u044e \u043a\u0430\u043a \u0432\u044b, \u043d\u043e \u044f \u0432\u044b\u043d\u0435\u0441 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442(\u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0430) \u0432 4 \u043a\u0430\u0442\u043a\u0435 \u043b\u0435\u0436\u0430\u043b\u0430 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0432 \u0441\u0435\u0439\u0444\u0435",
                    "author": "@ki_starkov",
                    "likes": 0,
                    "publishedAt": "2026-04-06T12:17:28Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0432 \u0441\u0443\u043c\u043c\u0435 24.5 \u043b\u044f\u043c\u043e\u0432 \u043c\u043d\u0435 \u043a\u0440\u0430\u0441\u043d\u044b\u0445 \u043c\u043d\u043e\u0433\u043e \u043f\u0430\u0434\u0430\u043b\u043e, \u0438 \u043a\u043b\u044e\u0447\u0435\u0439 \u043d\u0430\u0448\u043b\u0430 \u043d\u0430 5 \u043b\u044f\u043c\u043e\u0432",
                    "author": "@Elleonora_22",
                    "likes": 0,
                    "publishedAt": "2026-04-07T06:48:09Z"
                },
                {
                    "text": "7 \u043a\u0430\u0442\u043e\u043a \u043f\u043e \u043b\u044f\u043c\u0443 \u043c\u0443\u0441\u043e\u0440\u043e\u043c \u043d\u0438 \u0437\u043e\u043b\u043e\u0442\u0443\u0445 \u043d\u0438 \u043a\u0440\u0430\u0441\u043d\u0443\u0445",
                    "author": "@\u0413\u0440\u0438\u0433\u043e\u0440\u0438\u0439\u041a\u043e\u043d\u0430\u0440\u0435\u0432-\u04475\u044a",
                    "likes": 8,
                    "publishedAt": "2026-04-05T12:57:42Z"
                },
                {
                    "text": "\u0423\u0442\u043e\u043f\u0438\u044f , 8 \u043a\u0440\u0430\u0441\u043d\u0443\u0445. \u0427\u0435\u0442\u043a\u043e",
                    "author": "@ezikstar",
                    "likes": 0,
                    "publishedAt": "2026-04-07T01:55:11Z"
                },
                {
                    "text": "\u0437\u0430 7 \u043a\u0430\u0442\u043e\u043a \u043e\u0431\u043b\u0443\u0442\u0430\u0432 \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u043f\u043e 12 \u0441\u0435\u0439\u0444\u043e\u0432 \u0432\u044b\u043f\u043e\u043b\u0430 1 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0430, \u0435\u0441\u043b\u0438 \u0432\u0437\u044f\u0442\u044c \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0442\u043e \u0437\u0430 \u0440\u0435\u0439\u0434 1,5\u043a\u043a \u0438 1 \u0440\u0430\u0437 3.3 \u0441 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u043e\u0439",
                    "author": "@Gran1t_122",
                    "likes": 0,
                    "publishedAt": "2026-04-06T21:05:45Z"
                },
                {
                    "text": "3 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438, 0 \u043a\u043b\u044e\u0447\u0435\u0439, \u043c\u0430\u043b\u043e \u0437\u043e\u043b\u043e\u0442\u044b\u0445, \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043e\u0434\u043d\u0438 \u0444\u0438\u043e\u043b \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b",
                    "author": "@jonadaprons8999",
                    "likes": 0,
                    "publishedAt": "2026-04-06T14:17:46Z"
                },
                {
                    "text": "\u042f \u0432 \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043a\u0430\u0442\u043a\u0443 \u0432 \u043f\u0432\u0435 \u0432\u044b\u043d\u0435\u0441 12 \u043b\u044f\u043c\u043e\u0432, \u0442.\u0435. \u0443\u0442\u043e\u043f\u0438\u044e \u0438 \u043a\u043b\u044e\u0447 \u043e\u0442 \u0433\u043b\u0430\u0432\u043a\u0438 \u0432 \u043c\u043e\u0442\u0435\u043b\u0435 \u0438 \u0435\u0449\u0435 \u0437\u043e\u043b\u043e\u0442\u0443\u0448\u043a\u0438",
                    "author": "@mr.peter8906",
                    "likes": 0,
                    "publishedAt": "2026-04-07T06:49:37Z"
                },
                {
                    "text": "\u0427\u0438\u0441\u0442\u043e \u043c\u0443\u0441\u043e\u0440\u0430 \u043d\u0430\u0441\u043e\u0431\u0438\u0440\u0430\u043b \u0431\u0435\u0437 \u043f\u043b\u0430\u0442\u043e\u043a. \u0420\u0435\u0436\u0438\u043c \u0432\u043e!",
                    "author": "@CblHMaTePu",
                    "likes": 0,
                    "publishedAt": "2026-04-06T08:43:18Z"
                },
                {
                    "text": "\u0417\u0430 \u0432\u0441\u0435 \u043a\u0430\u0442\u043a\u0438 \u0432\u044b\u043f\u0430\u043b\u043e 2 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438\n\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u043b \u0432\u0441\u0435 \u043a\u0435\u0439\u0441\u044b \u0438 6 \u043a\u043b\u044e\u0447\u0435\u0439",
                    "author": "@\u041c\u0430\u043a\u0441\u0438\u043c\u0427\u0443\u043c\u0430\u043a-\u043f7\u043c",
                    "likes": 0,
                    "publishedAt": "2026-04-07T06:42:06Z"
                },
                {
                    "text": "\u0427\u0438\u0441\u0442\u043e \u043c\u0443\u0441\u043e\u0440 \u043d\u0430\u0441\u044b\u043f\u0430\u043b\u043e. \u0412\u043e \u0432\u0442\u043e\u0440\u043e\u043c \u0440\u0435\u0439\u0434\u0435 \u043d\u0430\u0448\u0435 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0443, \u043f\u043e\u0442\u043e\u043c \u0432 \u0442\u0440\u0435\u0442\u044c\u0435\u043c \u0448\u0430\u0445\u043c\u0430\u0442\u044b, \u0430 \u043f\u043e\u0442\u043e\u043c \u0447\u0438\u0441\u0442\u043e \u0444\u0438\u043e\u043b\u043a\u0438 \u0441\u044b\u043f\u0430\u043b\u043e \u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044f \u0432\u0441\u0435 \u0441\u0435\u0439\u0444\u044b \u043d\u0430 \u043a\u0430\u0440\u0442\u0435 \u043b\u0443\u0442\u0430\u043b (\u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435).\n\u041f\u044b\u043b\u0435\u0441\u043e\u0441\u0438\u043b \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0432\u0441\u044e \u043c\u0430\u043f\u0443, \u0430\u0441\u0435 \u043f\u043b\u044e\u0441 \u043c\u0438\u043d\u0443\u0441 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u044f\u0449\u0438\u043a\u0438 (\u043a\u0443\u0440\u0442\u043a\u0438, \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u044b, \u043a\u0435\u0439\u0441\u044b, \u044f\u0449\u0438\u043a\u0438 \u0441 \u043f\u0430\u0442\u0440\u043e\u043d\u0430\u043c\u0438 etc), \u043d\u043e \u0443\u0432\u044b.\n\u0414\u0430\u0436\u0435 \u0437\u043e\u043b\u043e\u0442\u0430 \u043c\u0430\u043b\u043e \u0434\u0430\u0432\u0430\u043b\u0438, 2 \u0438\u043b\u0438 3 \u0437\u0430 \u0440\u0435\u0439\u0434.",
                    "author": "@meowlymeow7485",
                    "likes": 0,
                    "publishedAt": "2026-04-06T19:32:41Z"
                },
                {
                    "text": "\u0412\u0447\u0435\u0440\u0430 \u0432 \u044d\u0442\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 2 \u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u0438 \u043a\u043b\u044e\u0447\u0438\u043a \u043e\u0442 \u0434\u0432\u043e\u0440\u0430 \u043d\u0443\u0430\u0440\u0430 \u043d\u0430\u0448\u0435\u043b",
                    "author": "@alecsxi6293",
                    "likes": 0,
                    "publishedAt": "2026-04-06T07:42:07Z"
                },
                {
                    "text": "\u0411\u043e\u043b\u0435\u0435 13 \u043a\u043a \u0437\u0430 7 \u043a\u0430\u0442\u043e\u043a ) \u0444\u0430\u0440\u0442\u0430\u043d\u0443\u043b\u043e",
                    "author": "@kenmalein2649",
                    "likes": 0,
                    "publishedAt": "2026-04-06T17:05:01Z"
