            "comments": [
                {
                    "text": "\u041f\u0456\u0441\u043d\u044f \u043f\u0440\u0438\u0441\u0432\u044f\u0447\u0435\u043d\u0430 \u0432\u0441\u0456\u043c \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u0440\u044f\u043c, \u044f\u043a\u0456 \u043d\u0435 \u0434\u043e\u0447\u0435\u043a\u0430\u043b\u0438\u0441\u044f \u0441\u0432\u043e\u0457\u0445 \u0441\u0438\u043d\u0456\u0432 \u0434\u043e\u0434\u043e\u043c\u0443\u2026 \u041a\u0430\u043b\u0438\u043d\u0430 \u043f\u0430\u043c\u2019\u044f\u0442\u0430\u0454 \u0457\u0445\u043d\u0456 \u0456\u043c\u0435\u043d\u0430, \u0430 \u0431\u0456\u043b\u044c \u043c\u0430\u0442\u0435\u0440\u0456\u0432 \u0437\u0432\u0443\u0447\u0438\u0442\u044c \u0443 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0440\u044f\u0434\u043a\u0443. \u0421\u0432\u0456\u0442\u043b\u0430 \u043f\u0430\u043c\u2019\u044f\u0442\u044c \u0413\u0435\u0440\u043e\u044f\u043c \u0456 \u0432\u0456\u0447\u043d\u0430 \u0448\u0430\u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u044f\u043c, \u0449\u043e \u0432\u0442\u0440\u0430\u0442\u0438\u043b\u0438 \u043d\u0430\u0439\u0434\u043e\u0440\u043e\u0436\u0447\u0435.",
                    "author": "@fantom2112KVO",
                    "likes": 18,
                    "publishedAt": "2026-04-24T09:33:50Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0430 \u0423\u0441\u0456\u043c \u041c\u0430\u0442\u0435\u0440\u044f\u043c \u0423\u043a\u0440\u0430\u0457\u043d\u0438!",
                    "author": "@oksanik0904",
                    "likes": 19,
                    "publishedAt": "2026-04-24T09:35:24Z"
                },
                {
                    "text": "\u0412\u0456\u0447\u043d\u0430 \u043f\u0430\u043c'\u044f\u0442\u044c \u0456 \u0441\u043b\u0430\u0432\u0430 \u0433\u0435\u0440\u043e\u044f\u043c \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u0441\u043f\u0456\u0432\u0447\u0443\u0442\u0442\u044f \u0440\u0456\u0434\u043d\u0438\u043c \u0456 \u0431\u043b\u0438\u0437\u044c\u043a\u0438\u043c",
                    "author": "@Valentina-q4w5n",
                    "likes": 0,
                    "publishedAt": "2026-04-24T20:23:10Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0437\u0430 \u043f\u0456\u0441\u043d\u044e, \u043f\u0440\u044f\u043c\u043e \u0432 \u0441\u0435\u0440\u0434\u0435\u043d\u044c\u043a\u043e\ud83d\udc94",
                    "author": "@\u0438\u0440\u0430\u0435\u0440\u043e\u0444\u0435\u0435\u0432\u0430-\u04461\u0439",
                    "likes": 0,
                    "publishedAt": "2026-04-24T20:07:15Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0437\u0430 \u0442\u0430\u043a\u0443 \u0449\u0435\u043c\u043b\u0438\u0432\u0443 \u043f\u0456\u0441\u043d\u044e !\n\u042f\u043a\u0438\u0439 \u0431\u0456\u043b\u044c, \u044f\u043a\u0438\u0439 \u0441\u043c\u0443\u0442\u043e\u043a  \u0440\u043e\u0434\u0438\u043d\u0430\u043c \u0437\u0430\u0433\u0438\u0431\u043b\u0438\u0445 \u0432\u043e\u0457\u043d\u0456\u0432.\n\u0417 \u043d\u0435\u0442\u0435\u0440\u043f\u0456\u043d\u043d\u044f\u043c \u0447\u0435\u043a\u0430\u0454\u043c\u043e \u043d\u0430 \u043f\u043e\u0432\u043d\u0443 \u0432\u0435\u0440\u0441\u0456\u044e \u043f\u0456\u0441\u043d\u0456.\n\u0421\u043b\u0430\u0432\u0430 \u0417\u0421\u0423 !!! \u0421\u043b\u0430\u0432\u0430 \u041d\u0410\u0426\u0406\u0407 !!!",
                    "author": "@user-nv9qh1ud8x",
                    "likes": 16,
                    "publishedAt": "2026-04-24T11:16:25Z"
                },
                {
                    "text": "\u0428\u0430\u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u044f\u043c \u0413\u0435\u0440\u043e\u0457\u0432. \n\u0412\u0456\u0447\u043d\u0430 \u0456 \u0441\u0432\u0456\u0442\u043b\u0430 \u043f\u0430\u043c'\u044f\u0442\u044c \u0413\u0435\u0440\u043e\u044f\u043c, \u044f\u043a\u0456 \u0432\u0456\u0434\u0434\u0430\u043b\u0438 \u0441\u0432\u043e\u0454 \u0436\u0438\u0442\u0442\u044f \u0437\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0443",
                    "author": "@alesiababy3933",
                    "likes": 9,
                    "publishedAt": "2026-04-24T13:23:05Z"
                },
                {
                    "text": "\u0420\u0432\u0435 \u0434\u0443\u0448\u0443.\ud83d\ude2d\ud83d\ude2d",
