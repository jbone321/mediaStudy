                },
                {
                    "text": "\u041f\u0456\u0441\u043d\u044f \u043f\u0440\u0438\u0441\u0432\u044f\u0447\u0435\u043d\u0430 \u0432\u0441\u0456\u043c \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u043c \u043c\u0430\u0442\u0435\u0440\u044f\u043c, \u044f\u043a\u0456 \u043d\u0435 \u0434\u043e\u0447\u0435\u043a\u0430\u043b\u0438\u0441\u044f \u0441\u0432\u043e\u0457\u0445 \u0441\u0438\u043d\u0456\u0432 \u0434\u043e\u0434\u043e\u043c\u0443\u2026 \u041a\u0430\u043b\u0438\u043d\u0430 \u043f\u0430\u043c\u2019\u044f\u0442\u0430\u0454 \u0457\u0445\u043d\u0456 \u0456\u043c\u0435\u043d\u0430, \u0430 \u0431\u0456\u043b\u044c \u043c\u0430\u0442\u0435\u0440\u0456\u0432 \u0437\u0432\u0443\u0447\u0438\u0442\u044c \u0443 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0440\u044f\u0434\u043a\u0443. \u0421\u0432\u0456\u0442\u043b\u0430 \u043f\u0430\u043c\u2019\u044f\u0442\u044c \u0413\u0435\u0440\u043e\u044f\u043c \u0456 \u0432\u0456\u0447\u043d\u0430 \u0448\u0430\u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u044f\u043c, \u0449\u043e \u0432\u0442\u0440\u0430\u0442\u0438\u043b\u0438 \u043d\u0430\u0439\u0434\u043e\u0440\u043e\u0436\u0447\u0435.",
                    "author": "@fantom2112KVO",
                    "likes": 24,
                    "publishedAt": "2026-04-24T09:33:50Z"
                },
                {
                    "text": "\u0428\u0430\u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u044f\u043c \u0413\u0435\u0440\u043e\u0457\u0432. \n\u0412\u0456\u0447\u043d\u0430 \u0456 \u0441\u0432\u0456\u0442\u043b\u0430 \u043f\u0430\u043c'\u044f\u0442\u044c \u0413\u0435\u0440\u043e\u044f\u043c, \u044f\u043a\u0456 \u0432\u0456\u0434\u0434\u0430\u043b\u0438 \u0441\u0432\u043e\u0454 \u0436\u0438\u0442\u0442\u044f \u0437\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0443",
                    "author": "@alesiababy3933",
                    "likes": 18,
                    "publishedAt": "2026-04-24T13:23:05Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0412\u0410\u041c \u0437\u0430 \u043f\u0456\u0441\u043d\u044e. \ud83d\udc9b\ud83d\udc99\ud83d\udcaa\ud83d\udc4a\ud83d\udc4c\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6",
                    "author": "@StasLevchenko-f1v",
                    "likes": 4,
                    "publishedAt": "2026-04-25T13:29:59Z"
                },
                {
                    "text": "\u0412\u0456\u0447\u043d\u0430 \u043f\u0430\u043c'\u044f\u0442\u044c \u0456 \u0441\u043b\u0430\u0432\u0430 \u0433\u0435\u0440\u043e\u044f\u043c \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u0441\u043f\u0456\u0432\u0447\u0443\u0442\u0442\u044f \u0440\u0456\u0434\u043d\u0438\u043c \u0456 \u0431\u043b\u0438\u0437\u044c\u043a\u0438\u043c",
                    "author": "@Valentina-q4w5n",
                    "likes": 3,
                    "publishedAt": "2026-04-24T20:23:10Z"
                },
                {
                    "text": "\u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0443\u043a\u043b\u0456\u043d  \u041f\u043e\u0434\u044f\u043a\u0430 \u0432\u0441\u0456\u043c \u041c\u0430\u043c\u0430\u043c \u0437\u0430 \u0441\u0438\u043d\u0456\u0432, \u0434\u043e\u043d\u044c\u043e\u043a \u042f\u043a\u0456 \u0432\u0456\u0434\u0434\u0430\u043b\u0438 \u0436\u0438\u0442\u0442\u044f \u0437\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0443, \u0443\u043a\u0440\u0430\u0457\u043d\u0446\u0456\u0432 \u0422\u0440\u0438\u043c\u0430\u0439\u0442\u0435\u0441 \u043c\u0438\u043b\u0456 \u043c\u0430\u043c\u0438, \u0442\u0430\u043a\u0430 \u0432 \u043d\u0430\u0441 \u0434\u043e\u043b\u044f  \u043e\u043f\u043b\u0430\u043a\u0443\u0432\u0430\u0442\u0438, \u0445\u043e\u0440\u043e\u043d\u0438\u0442\u0438, \u0433\u043e\u0440\u0434\u0438\u0442\u0438\u0441\u044f \u0441\u0432\u043e\u0457\u043c\u0438 \u0434\u0456\u0442\u044c\u043c\u0438  \u2764\ud83d\ude22",
                    "author": "@\u0410\u043b\u043b\u043e\u041b\u043e\u0437\u043e\u0432\u0430",
                    "likes": 12,
                    "publishedAt": "2026-04-24T11:51:19Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0437\u0430 \u043f\u0456\u0441\u043d\u044e, \u043f\u0440\u044f\u043c\u043e \u0432 \u0441\u0435\u0440\u0434\u0435\u043d\u044c\u043a\u043e\ud83d\udc94",
                    "author": "@\u0438\u0440\u0430\u0435\u0440\u043e\u0444\u0435\u0435\u0432\u0430-\u04461\u0439",
                    "likes": 5,
                    "publishedAt": "2026-04-24T20:07:15Z"
                },
                {
                    "text": "\u041f\u0456\u0441\u043d\u044f \u0440\u043e\u0437\u0440\u0438\u0432\u0430\u0454 \u0441\u0435\u0440\u0446\u0435 \u0456 \u0434\u0443\u0448\u0443! \u041d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0440\u043e\u0431\u0430\u0447\u0438\u043c\u043e \u0430\u0433\u0440\u0435\u0441\u0456\u0457 \u0440\u043e\u0441\u0456\u0457,  \u043d\u0456\u043a\u043e\u043b\u0438!!!!!!",
                    "author": "@lyudmilapolyschuk5100",
                    "likes": 7,
                    "publishedAt": "2026-04-24T14:34:38Z"
                },
                {
                    "text": "\u0421\u0435\u0440\u0446\u0435 \u0440\u043e\u0437\u0456\u0440\u0432\u0430\u043b\u043e\u0441\u044c.",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u041f\u0438\u0440\u043e\u0433\u043e\u0432\u0430-\u04346\u0442",
                    "likes": 13,
                    "publishedAt": "2026-04-24T11:18:16Z"
                },
                {
                    "text": "\u041c\u043e\u0440\u0434\u0435\u0440 \u044f\u043a \u043c\u0438 \u0432\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0438\u043c\u043e \u0437\u043d\u0430\u0435 \u0442\u0456\u043b\u044c\u043a\u0438 \u0411\u043e\u0433.",
                    "author": "@\u0410\u043d\u0430\u0442\u043e\u043b\u0456\u0439\u041c\u0438\u0445\u0430\u0439\u043b\u043e\u0432-\u04478\u044b",
                    "likes": 6,
                    "publishedAt": "2026-04-24T13:40:34Z"
                },
                {
