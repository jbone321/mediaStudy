                    "likes": 8,
                    "publishedAt": "2026-03-06T22:03:03Z"
                },
                {
                    "text": "\u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u0437\u043d\u0430\u043b \u043f\u0440\u043e \u044d\u0442\u0443 \u043f\u0435\u0441\u043d\u044e \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0442\u0440\u0435\u043a \u0431\u043b\u0430\u0434\u0445\u0430\u043d\u0434 \u0433\u0430\u043d\u0433 \u0441 \u043f\u0440\u0438\u043f\u0435\u0432\u043e\u043c \u0438\u0437 \u044d\u0442\u043e\u0439 \u043f\u0435\u0441\u043d\u0438",
                    "author": "@stanis_yt",
                    "likes": 18,
                    "publishedAt": "2026-03-06T15:54:31Z"
                },
                {
                    "text": "\u041d\u0443, \u0434\u0430, \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u0414\u044e\u0440\u0430\u043d \u0443\u0439\u043c\u0430 \u0445\u0438\u0442\u043e\u0432, \u0430 \u0443 \u044d\u0442\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u043e\u0434\u0438\u043d. One hit wonder. \ud83d\ude05",
                    "author": "@Forever-y4h",
                    "likes": 6,
                    "publishedAt": "2026-03-06T22:56:50Z"
                },
                {
                    "text": "\u0411\u043b\u0438\u043d. \u0427\u0435\u043b. \u042f \u0442\u0435\u0431\u044f \u043e\u0431\u043e\u0436\u0430\u044e. \u0422\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0448\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0438 \u043f\u043e \u0434\u0435\u043b\u0443. \u0418 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0431\u0435\u0437 \u0438\u0437\u043b\u0438\u0448\u043d\u0438\u0445 \u043f\u043e\u043d\u0442\u043e\u0432.\n\n\u041e\u0431\u0438\u0434\u043d\u043e \u0447\u0442\u043e \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u0442\u0430 \u0442\u0435\u0431\u044f \u043d\u0435 \u0431\u0430\u043b\u0443\u0435\u0442. \u041d\u0443 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c.",
                    "author": "@Hobbitangle",
                    "likes": 3,
                    "publishedAt": "2026-03-06T22:09:46Z"
                },
                {
                    "text": "\u043f\u043e\u0442\u0440\u044f\u0441\u0430\u044e\u0449\u0435, \u044f \u043a\u0430\u043c",
                    "author": "@ADOLFuBaHoBu4",
                    "likes": 0,
                    "publishedAt": "2026-03-07T07:58:09Z"
                },
                {
                    "text": "\u041e\u0431\u043e\u0436\u0430\u044e \u044d\u0442\u0443 \u043f\u0435\u0441\u043d\u044e, \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0435\u0451 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432 \u0441\u0435\u0440\u0438\u0430\u043b\u0435 Miami Vice 1984 \u0433\u043e\u0434\u0430, \u043d\u0435 \u0434\u0443\u043c\u0430\u043b \u0447\u0442\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f)",
                    "author": "@SouthWolf84",
                    "likes": 3,
                    "publishedAt": "2026-03-06T21:00:09Z"
                },
                {
                    "text": "\u0413\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u0437\u0432\u0443\u0447\u0438\u0442 \u043e\u0433\u043e\u043d\u044c, \u043a\u0441\u0442\u0430\u0442\u0438)",
                    "author": "@fozcel",
                    "likes": 0,
                    "publishedAt": "2026-03-06T21:47:34Z"
                },
                {
                    "text": "\u0421\u0442\u0430\u0441 \u0410\u0439 \u041a\u0430\u043a \u041f\u0440\u043e\u0441\u0442\u043e  \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u043b \u043f\u0430\u0440\u0442\u0438\u044e \u0443\u0434\u0430\u0440\u043d\u044b\u0445",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u041a\u043e\u0440\u0437\u0438\u043d\u043d\u0438\u043a\u043e\u0432-\u04352\u043e",
                    "likes": 25,
