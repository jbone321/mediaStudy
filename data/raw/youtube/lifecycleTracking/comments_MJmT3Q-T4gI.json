                {
                    "text": "\ud83d\udc94\ud83d\udc94:\u09a8\u09cc\u0995\u09be \u09af\u09a4\u0987 \u09a6\u09be\u09ae\u09bf \u09b9\u09cb\u0995 \u09ae\u09be\u099d\u09bf \u099b\u09be\u09dc\u09be \u0997\u09a4\u09bf \u09a8\u09c7\u0987 \u09a8\u09c7\u0987 \u09aa\u09c1\u09b0\u09c1\u09b7 \u09ae\u09be\u09a8\u09c1\u09b7 \u09af\u09a4\u0987 \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u09b9\u09cb\u0995 \u099f\u09be\u0995\u09be \u099b\u09be\u09dc\u09be \u0995\u09cb\u09a8\u09cb \u09ae\u09c2\u09b2\u09cd\u09af \u09a8\u09c7\u0987...\ud83d\ude05\ud83d\ude05",
