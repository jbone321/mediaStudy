            "comments": [
                {
                    "text": "\u0395\u03af\u03c3\u03c4\u03b5 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03bf\u03af \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03b4\u03b9\u03b1\u03c3\u03ba\u03b5\u03b4\u03b1\u03c3\u03c4\u03b9\u03ba\u03bf\u03af. \u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c4\u03b5 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03ad\u03c4\u03c3\u03b9 \u03b1\u03c5\u03b8\u03b5\u03bd\u03c4\u03b9\u03ba\u03bf\u03af \u03c4\u03b5\u03c3\u03c4\u03bf\u03c3\u03c4\u03b5\u03c1\u03bf\u03bd\u03ac\u03c4\u03bf\u03b9 \u03c7\u03c9\u03c1\u03af\u03c2 \u03b1\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2.",
                    "author": "@sjvlecwokrtqamp",
                    "likes": 2,
                    "publishedAt": "2026-03-01T10:09:13Z"
                },
                {
                    "text": "\u0386\u03bb\u03bb\u03bf \u03ad\u03bd\u03b1 \u03b2\u03af\u03bd\u03c4\u03b5\u03bf \u03c0\u03bf\u03c5 \u03be\u03ad\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b1 \u03bb\u03b5\u03c0\u03c4\u03ac \u03b8\u03b1 \u03c0\u03ac\u03b5\u03b9 \u03ba\u03b1\u03bb\u03ac! \n\n\u03a3\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03b8\u03ad\u03bc\u03b1\u03c4\u03bf\u03c2, \u03bc\u03b5\u03c4\u03ac\u03bd\u03b9\u03c9\u03c3\u03b1 \u03c3\u03c4\u03b1 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 ,\u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac day one Tekken 7 \u03ba\u03b1\u03b9 \u03c0\u03b9\u03bf \u03b1\u03c1\u03b3\u03ac \u03c4\u03bf Alan Wake Remastered \u03b3\u03b9\u03b1 PS4. \u03a4\u03ad\u03bb\u03bf\u03c2 \u03ad\u03bd\u03b1 \u03ac\u03bb\u03bb\u03bf (\u03ba\u03bf\u03c5\u03bb\u03c4\u03bf\u03cd\u03c1\u03b1 \u03bd\u03b1 \u03c6\u03cd\u03b3\u03bf\u03c5\u03bc\u03b5) \u03c0\u03bf\u03c5 \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5 \u03bd\u03b1 \u03bc\u03b5 \u03b1\u03c1\u03ad\u03c3\u03b5\u03b9 , \u03ae\u03c4\u03b1\u03bd \u03c4\u03bf The Last Guardian, \u03bc\u03b5 \u03c4\u03bf\u03bd \u03b1\u03bd\u03b1\u03b8\u03b5\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c0\u03bb\u03ac\u03c3\u03bc\u03b1 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf\u03bd Trico (\u03ba\u03ac\u03c0\u03c9\u03c2 \u03ad\u03c4\u03c3\u03b9 \u03bd\u03bf\u03bc\u03af\u03b6\u03c9 \u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9) \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03ad\u03ba\u03b1\u03bd\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03cc\u03c4\u03b9 \u03ae\u03b8\u03b5\u03bb\u03b5 \u03ba\u03b1\u03b9 \u03cc\u03c0\u03bf\u03c4\u03b5 \u03ae\u03b8\u03b5\u03bb\u03b5. \u039a\u03ac\u03c0\u03bf\u03b9\u03bf\u03b9 \u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1 \u03c6\u03b1\u03bd\u03b1\u03c4\u03b9\u03ba\u03bf\u03af , \u03c4\u03b7\u03bd \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03bb\u03bf\u03b3\u03bf\u03cd\u03c3\u03b1\u03bd \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03b4\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 , \u03bc\u03b5 \u03c4\u03bf \u03ac\u03bb\u03bb\u03bf\u03b8\u03b9 \u03cc\u03c4\u03b9 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03bb\u03ac\u03c3\u03bc\u03b1 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b5\u03af \u03bc\u03b5 \u03c4\u03bf \u03c0\u03b1\u03b9\u03b4\u03af \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u03bf\u03c6\u03b5\u03af\u03bb\u03b5\u03c4\u03b1\u03b9 \u03bf \u03ba\u03b1\u03ba\u03cc\u03c2 \u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c4\u03bf\u03c5... \n\n\u03a3\u03c4\u03bf 1\u03bf \u03ae\u03c4\u03b1\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac \u03b5\u03c0\u03b9\u03c0\u03cc\u03bb\u03b1\u03b9\u03b1 \u03bc\u03b9\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03c0\u03b1\u03af\u03b6\u03c9 \u03c4\u03ad\u03c4\u03bf\u03b9\u03b1 games , \u03b1\u03c0\u03bb\u03ac \u03ae\u03b8\u03b5\u03bb\u03b1 \u03bd\u03b1 \u03ad\u03c7\u03c9 \u03ad\u03bd\u03b1 fighting , \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03b1\u03c0\u03cc \u03c4\u03bf Tekken 3 \u03b5\u03af\u03c7\u03b1 \u03bd\u03b1 \u03c0\u03b1\u03af\u03be\u03c9 ,  \u03bc\u03bf\u03c5 \u03c6\u03ac\u03bd\u03b7\u03ba\u03b5 \u03bb\u03b9\u03b3\u03cc\u03c4\u03b5\u03c1\u03bf \u03b5\u03bd\u03c4\u03c5\u03c0\u03c9\u03c3\u03b9\u03b1\u03ba\u03cc \u03b2\u03b1\u03c3\u03b9\u03ba\u03ac \u03b1\u03c0\u03cc \u03cc\u03c4\u03b9 \u03c4\u03bf \u03c0\u03b5\u03c1\u03af\u03bc\u03b5\u03bd\u03b1 , \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03b1\u03c1\u03ba\u03b5\u03c4\u03ac \u03c6\u03c4\u03c9\u03c7\u03cc \u03b3\u03b9\u03b1 \u03ba\u03ac\u03c0\u03bf\u03b9\u03bf \u03bb\u03cc\u03b3\u03bf... \n\n\u0397 2\u03b7 \u03b1\u03b3\u03bf\u03c1\u03ac \u03ae\u03c4\u03b1\u03bd \u03c4\u03bf Alan Wake Remastered, \u03c0\u03bf\u03c5 \u03ad\u03c0\u03b5\u03c3\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c6\u03ac\u03ba\u03b1 \u03b3\u03b9\u03b1\u03c4\u03af \u03b5\u03af\u03c7\u03b1 \u03b1\u03ba\u03bf\u03cd\u03c3\u03b5\u03b9 \u03c4\u03cc\u03c3\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03bf story \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b5\u03bd \u03c4\u03ad\u03bb\u03b5\u03b9 \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1 \u03bd\u03b1 \u03c0\u03b1\u03bb\u03b5\u03cd\u03c9 \u03bc\u03b5 \u03c8\u03c5\u03b3\u03b5\u03af\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03c0\u03bf\u03c5\u03bb\u03bd\u03c4\u03cc\u03b6\u03b5\u03c2, \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03b5\u03bd\u03ac\u03c1\u03b9\u03bf \u03b1\u03bb\u03bb\u03cc\u03ba\u03bf\u03c4\u03bf \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03bc\u03cc \u03c0\u03bf\u03c5 \u03bc\u03b5 \u03bd\u03b5\u03c5\u03c1\u03af\u03b1\u03c3\u03b5. \u03a4\u03bf \u03b1\u03b3\u03cc\u03c1\u03b1\u03c3\u03b1 \u03bc\u03cc\u03bb\u03b9\u03c2 \u03ba\u03c5\u03ba\u03bb\u03bf\u03c6\u03cc\u03c1\u03b7\u03c3\u03b5 full price, \u03bf\u03c0\u03cc\u03c4\u03b5 \u03ba\u03ac\u03b8\u03b9\u03c3\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03ad\u03c0\u03b1\u03b9\u03be\u03b1 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03bf \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03bb\u03bf\u03b3\u03ae\u03c3\u03c9 \u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac.",
                    "author": "@GeorgePatsonas",
                    "likes": 1,
                    "publishedAt": "2026-03-01T10:57:01Z"
                },
                {
                    "text": "\u0391\u03c0\u03bf \u03c4\u03b1 \u03ba\u03b1\u03bb\u03c5\u03c4\u03b5\u03c1\u03bf \u03c3\u03b1\u03c2 \u03b2\u03b9\u03bd\u03c4\u03b5\u03bf.\u039a\u03b1\u03bb\u03bf \u03bc\u03b7\u03bd\u03b1 \u03c3\u03b5 \u03bf\u03bb\u03bf\u03c5\u03c2.",
                    "author": "@adamadiosfl7181",
                    "likes": 1,
                    "publishedAt": "2026-03-01T10:03:46Z"
                },
                {
                    "text": "\u039a\u03b1\u03bb\u03b7\u03bc\u03ad\u03c1\u03b1 \u03bc\u03ac\u03b3\u03ba\u03b5\u03c2. \u03a6\u03bf\u03b2\u03b5\u03c1\u03bf\u03af \u03b3\u03b9\u03b1 \u03ac\u03bb\u03bb\u03b7 \u03bc\u03b9\u03b1 \u03c6\u03bf\u03c1\u03ac..",
                    "author": "@NickZama4",
