                    "publishedAt": "2026-03-24T05:35:39Z"
                },
                {
                    "text": "MV \u7ec8\u4e8e\u4e0d\u662f\u4e00\u76f4\u8d70\u4e00\u76f4\u8d70\u4e86\u3002",
                    "author": "@haikinkin",
                    "likes": 381,
                    "publishedAt": "2026-03-24T07:24:21Z"
                },
                {
                    "text": "2026\u5e74\u9084\u5728\u807d\u9019\u9996\u6b4c\u7684\u8acb\u4f86\u7c3d\u5230~~\u611f\u8b1d\u5468\u8463\u7d66\u6211\u5011\u5e36\u4f86\u9019\u5947\u5e7b\u7684MV\u5927\u4f5c!!",
                    "author": "@edwardyu6130",
                    "likes": 1,
                    "publishedAt": "2026-03-24T09:57:37Z"
                },
                {
                    "text": "\u633a\u597d\u7684\uff0c\u770b\u5f97\u51fa\u6765\u82b1\u4e86\u5f88\u591a\u5fc3\u8840\uff0c\u6ca1\u5fc5\u8981\u5632, \u4ed6\u867d\u7136\u662f\u5468\u6770\u4f26\uff0c\u4f46\u6bcf\u4e2a\u4eba\u90fd\u4f1a\u53d8, \u6bcf\u4e2a\u65f6\u671f\u90fd\u6709\u81ea\u5df1\u7684\u559c\u597d\uff0c\u73b0\u5728\u7684\u4ed6\u559c\u6b22\u827a\u672f\u54c1 \u540d\u753b\uff0c\u6709\u4e00\u4e2a\u5e78\u798f\u7684\u5bb6\u5ead\uff0c\u518d\u53bb\u5199\u82e6\u60c5\u4f24\u611f\u4e5f\u4e0d\u5408\u9002\u4e86\u5427\uff0c\u5927\u5bb6\u8981\u591a\u591a\u652f\u6301\u554a \uff0c\u4e0d\u7136\u4e0b\u6b21\u5565\u4e5f\u6ca1\u6709\u4e86\u3002",
                    "author": "@mooouy1460",
                    "likes": 0,
                    "publishedAt": "2026-03-24T09:59:56Z"
                },
                {
                    "text": "\u4eca\u5929\u6709\u5e78\u53c3\u52a0\u5c08\u8f2f\u8a18\u8005\u6703\uff012026\u9084\u6709\u5468\u6770\u502b\u65b0\u5c08\u8f2f\u53ef\u4ee5\u807d\u662f\u4e00\u4ef6\u5f88\u723d\u5f88\u5e78\u798f\u7684\u4e8b\uff01",
                    "author": "@jasontsai1028",
                    "likes": 31,
                    "publishedAt": "2026-03-24T09:16:52Z"
                },
                {
                    "text": "\u723d\uff0c\u5c31\u662f\u9019\u7a2e\u6c92\u6b4c\u8a5e\u5c31\u807d\u4e0d\u61c2\u7684\u611f\u89ba\uff0c\u5b8c\u7f8e\ud83d\ude0d",
                    "author": "@1221_cheng",
                    "likes": 450,
                    "publishedAt": "2026-03-24T06:13:16Z"
                },
                {
                    "text": "\u770b\u5b8c\u6770\u4f26\u54e5\u7684\u592a\u9633\u4e4b\u5b50MV\uff0c\u771f\u7684\u6709\u88ab\u9707\u5230\u3002\u756b\u9762\u5f88\u6709\u96fb\u5f71\u611f\uff0c\u4e0d\u53ea\u662f\u70ab\u6280\uff0c\u800c\u662f\u628a\u300c\u5b64\u7368\u3001\u8cac\u4efb\u3001\u5149\u8207\u9ed1\u6697\u300d\u62cd\u5f97\u5f88\u6709\u5c64\u6b21\u3002\u6770\u4f26\u54e5\u9019\u6b21\u4e0d\u662f\u55ae\u7d14\u5728\u5531\uff0c\u800c\u50cf\u5728\u8b1b\u4e00\u500b\u95dc\u65bc\u547d\u904b\u7684\u6545\u4e8b\u2014\u2014\u6709\u5149\u7684\u4eba\uff0c\u4e5f\u80cc\u8457\u5f71\u5b50\u3002\u6700\u559c\u6b61\u7684\u662f\u90a3\u7a2e\u6de1\u6de1\u7684\u58d3\u6291\u611f\uff0c\u4e0d\u7528\u8aaa\u592a\u591a\uff0c\u5c31\u80fd\u611f\u89ba\u5230\u89d2\u8272\u7684\u91cd\u91cf\u3002\u97f3\u6a02\u4e00\u9032\u4f86\uff0c\u60c5\u7dd2\u76f4\u63a5\u88ab\u62c9\u6eff\uff0c\u8d8a\u770b\u8d8a\u6c89\u3002\u6709\u4e9b\u4eba\u662f\u5929\u751f\u767c\u5149\uff0c\u4f46\u767c\u5149\uff0c\u5f9e\u4f86\u90fd\u4e0d\u8f15\u9b06\u3002",
                    "author": "@Nicholasseahweikang2673",
                    "likes": 5,
                    "publishedAt": "2026-03-24T09:49:23Z"
                },
                {
                    "text": "\u5f9e\u982d\u5230\u5c3e\u90fd\u5728\u770bMV\uff0c\u6c92\u5728\u807d\u6b4c\u3002\ud83d\ude05\ud83d\ude05\ud83d\ude05",
                    "author": "@tonychen7796",
                    "likes": 1,
                    "publishedAt": "2026-03-24T09:58:54Z"
                },
                {
                    "text": "\u300a\u592a\u967d\u4e4b\u5b50\u300b\u5c31\u50cf\u662f\u7d50\u5408\u4e86\u591c\u7684\u7b2c\u4e03\u7ae0\u3001\u8de8\u6642\u4ee3\u3001\u6700\u5049\u5927\u7684\u4f5c\u54c1\u9019\u4e9b\u5143\u7d20\u98a8\u683c\u6dec\u7149\u51fa\u4f86\u7684\u4f5c\u54c1\u2764\ufe0f\u200d\ud83d\udd25",
                    "author": "@ingK-gz6op",
                    "likes": 1,
                    "publishedAt": "2026-03-24T09:59:28Z"
                },
                {
                    "text": "\u81ea\u4ece\u6211\u5988\u963b\u6b62\u6211\u5b66\u97f3\u4e50\uff0c\u6211\u5c31\u77e5\u9053\u5df2\u7ecf\u65e0\u4eba\u80fd\u548c\u5468\u8463\u4e00\u8f83\u9ad8\u4e0b\ud83d\ude14",
                    "author": "@WhyYouNoSayyyy",
                    "likes": 511,
                    "publishedAt": "2026-03-24T05:21:51Z"
                },
                {
                    "text": "\u6211\u89ba\u5f97AI\u597d\u50cf\u5df2\u7d93\u8d0f\u4eba\u985e\u5275\u4f5c\u4e86",
                    "author": "@yu331",
                    "likes": 8,
                    "publishedAt": "2026-03-24T09:33:48Z"
                },
                {
                    "text": "\u5c31\u7b97\u518d\u6709\u4e0b\u4e00\u500b\u5468\u6770\u502b\n\u6211\u4e5f\u6c92\u6709\u4e0b\u4e00\u500b\u9752\u6625\u53bb\u8ffd\u4e86\n\n\u80fd\u807d\u5230\u5468\u8463\u7e7c\u7e8c\u51fa\u6b4c\u771f\u7684\u5f88\u68d2 \u5922\u8ff4\u5e74\u5c11\u9752\u6625\u6b72\u6708",
                    "author": "@andy_jiang",
                    "likes": 434,
                    "publishedAt": "2026-03-24T05:27:15Z"
                },
                {
                    "text": "\u770b\u5468\u8463\u7684\u6bcf\u500bMV\u90fd\u611f\u89ba\u662f\u5728\u770b\u4e00\u672c\u6545\u4e8b\u66f8\uff0c\u6bcf\u4e00\u500bMV\u90fd\u662f\u91cd\u6210\u672c\uff0c\u8207\u73fe\u5728\u5f88\u591a\u6b4c\u624b\u6bd4\u5dee\u8ddd\u9084\u662f\u5f88\u5927\ud83d\ude02",
                    "author": "@leejemima2524",
                    "likes": 0,
                    "publishedAt": "2026-03-24T09:59:57Z"
                },
                {
                    "text": "\u5468\u8463\u9019\u5e7e\u5e74\u771f\u7684\u5f88\u559c\u6b61\u897f\u65b9\u6587\u85dd\uff0c\u9023\u5169\u4e3b\u6253\u6b4c\u90fd\u662f\u6b64\u984c\u6750\u7684\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u9322\u6b23\u6d77",
                    "likes": 0,
                    "publishedAt": "2026-03-24T09:59:33Z"
                },
                {
                    "text": "\u51fa\u4e86\u53c8\u8981\u5728\u90a3\u908a\u4e0d\u958b\u5fc3\u8aaa\u6c5f\u90ce\u624d\u76e1\u4e86 \u4e0d\u51fa\u7684\u6642\u5019\u53c8\u5728\u90a3\u908a\u8aaa\u662f\u4e0d\u662f\u6c92\u9748\u611f\u6c92\u60f3\u6cd5 \u6e34\u671b\u51fa\u65b0\u6b4c \u4f60\u5011\u7684\u908f\u8f2f\u5f88\u771f\u662f\u68d2 \u771f\u611b\u7684\u4eba\u662f\u4e0d\u7ba1\u4ed6\u4eca\u5929\u600e\u9ebc\u4e86\u90fd\u6703\u7121\u689d\u4ef6\u652f\u6301 \ud83c\udf89",
                    "author": "@CHI\u5168\u4ed4",
                    "likes": 78,
                    "publishedAt": "2026-03-24T08:48:09Z"
                },
                {
                    "text": "\ud83c\uddf2\ud83c\uddfe \u9a6c\u6765\u897f\u4e9a\u6770\u8ff7\u62a5\u5230 \ud83d\udc4b",
                    "author": "@weikang.402",
                    "likes": 530,
                    "publishedAt": "2026-03-24T05:36:40Z"
                },
                {
                    "text": "\u9019\u9996\u6b4c\u611f\u89ba\u662f\u5728\u5beb\u6770\u502b\u81ea\u5df1\u7684\u5fc3\u8def\u6b77\u7a0b\uff0c\u4ed6\u4e0d\u662f\u53ea\u6709\u5916\u8868\u770b\u5230\u7684\u5149\u9bae\u4eae\u9e97\uff0c\u4ed6\u6703\u8ff7\u60d8\u3001\u6703\u7dca\u5f35\u6703\u6050\u614c\uff0c\u4e5f\u6709\u5fc3\u9b54\uff0c\u9019\u9996\u6b4c\u5c31\u662f\u9f13\u52f5\u81ea\u5df1\u4e5f\u9f13\u52f5\u807d\u773e\uff0c\u8b93\u5927\u5bb6\u6709\u9762\u5c0d\u56f0\u96e3\u7684\u52c7\u6c23",
                    "author": "@ButterflyFEI316",
                    "likes": 125,
                    "publishedAt": "2026-03-24T08:02:30Z"
                },
                {
                    "text": "\u9f99\u6218\u9a91\u58eb\u7684\u66f2\u98ce\uff0c\u591c\u7684\u7b2c\u4e03\u7ae0\u7684\u5267\u60c5\uff0c\u8de8\u65f6\u4ee3\u7684\u573a\u666f\uff0c\u65e0\u53cc\u7684\u7535\u97f3",
                    "author": "@\u6ca1\u94b1\u7684\u6709\u94b1\u4ebaSYM",
                    "likes": 1,
                    "publishedAt": "2026-03-24T09:54:49Z"
                },
                {
                    "text": "\u5468\u6770\u502b\u9019\u4e9b\u5e74\u90fd\u5728\u6b23\u8cde\u85dd\u8853\u5275\u4f5c \u4ed6\u628a\u4ed6\u7684\u751f\u6d3b\u5beb\u9032\u4e86\u6b4c\u88e1\uff0c\u8655\u8655\u662f\u9a5a\u559c",
                    "author": "@\u83ef\u83ef-v3p",
                    "likes": 0,
                    "publishedAt": "2026-03-24T09:58:33Z"
                },
                {
                    "text": "\u9019\u4e0d\u662f\u6b4c\uff0c\u9019\u662f\u4e00\u4ef6\u85dd\u8853\u54c1",
                    "author": "@\u66fe\u7fca\u6840",
                    "likes": 71,
                    "publishedAt": "2026-03-24T08:23:54Z"
                },
                {
                    "text": "\u8072\u660e\u4e00\u4e0b\uff0c\u662fAI\u89e3\u8b80\u7684\u4e0d\u662f\u6211\u5566\uff0c\u4f60\u5011\u81ea\u5df1\u628aMV\u4e1f\u9032AI\u5c31\u77e5\u9053\u4e86\ud83d\ude0a\nMV \u4e2d\u96b1\u85cf\u7684\u86db\u7d72\u99ac\u8de1\u3001\u6587\u5b78\u96b1\u55bb\u8207\u5438\u8840\u9b3c\u5178\u6545\u5206\u6790\uff1a\n\u4e00\u3001 \u96b1\u85cf\u7684\u540d\u756b\u8207\u85dd\u8853\u81f4\u656c\nMV \u5e7e\u4e4e\u6bcf\u4e00\u5e55\u90fd\u6709\u85dd\u8853\u53f2\u7684\u5f71\u5b50\uff0c\u5834\u666f\u8a2d\u8a08\u8207\u904b\u93e1\u9ad8\u5ea6\u9084\u539f\u4e86\u540d\u756b\u7684\u69cb\u5716\uff1a\n1. \u60e0\u65af\u52d2\u7684\u6bcd\u89aa (Whistler's Mother)\uff1aMV \u958b\u982d [00:21] \u8655\uff0c\u90a3\u540d\u5750\u5728\u6905\u5b50\u4e0a\u767c\u51fa\u5c16\u53eb\u7684\u8001\u5a66\u4eba\uff0c\u5176\u88dd\u675f\u8207\u5074\u81c9\u69cb\u5716\u5b8c\u5168\u81f4\u656c\u8a79\u59c6\u65af\u00b7\u60e0\u65af\u52d2\u7684\u540d\u4f5c\u300a\u7070\u8207\u9ed1\u7684\u6539\u7de8\u7b2c1\u865f\u300b\u3002\n2. \u99ac\u62c9\u4e4b\u6b7b (The Death of Marat)\uff1a[00:34] \u6d74\u7f38\u4e2d\u7684\u7537\u5b50\u5012\u4e0b\u7684\u5834\u666f\uff0c\u5b8c\u7f8e\u9084\u539f\u4e86\u96c5\u514b-\u8def\u6613\u00b7\u5927\u885b\u63cf\u7e6a\u6cd5\u570b\u5927\u9769\u547d\u9818\u5c0e\u8005\u99ac\u62c9\u9047\u523a\u5f8c\u7684\u6a21\u6a23\uff0c\u9023\u684c\u4e0a\u7684\u4fe1\u4ef6\u7d30\u7bc0\u90fd\u505a\u4e86\u9084\u539f\u3002\n3. \u675c\u723e\u535a\u58eb\u7684\u89e3\u5256\u5b78\u8ab2 (The Anatomy Lesson of Dr. Nicolaes Tulp)\uff1a[01:01] \u5468\u6770\u502b\u6df7\u5165\u4e00\u7fa4\u6234\u8457\u767d\u8272\u9818\u5708\u7684\u4eba\u7fa4\u4e2d\u89c0\u5bdf\u5c4d\u9ad4\uff0c\u9019\u5e55\u69cb\u5716\u53d6\u81ea\u6797\u5e03\u862d\u7684\u540d\u756b\u3002\u6709\u8da3\u7684\u662f\uff0c\u756b\u4e2d\u539f\u672c\u662f\u91ab\u5b78\u89e3\u5256\uff0cMV \u4e2d\u5247\u8b8a\u6210\u4e86\u6aa2\u67e5\u5438\u8840\u9b3c\u7684\u54ac\u75d5 [01:13]\u3002\n4. \u5730\u7344\u88e1\u7684\u4e39\u7279\u8207\u7dad\u5409\u723e (Dante and Virgil)\uff1a[01:17] \u756b\u9762\u4e2d\u51fa\u73fe\u5169\u4eba\u760b\u72c2\u626d\u6253\u3001\u5543\u54ac\u9838\u90e8\u7684\u5834\u666f\uff0c\u662f\u5a01\u5ec9-\u963f\u9053\u592b\u00b7\u5e03\u683c\u7f85\u63cf\u7e6a\u4f46\u4e01\u300a\u795e\u66f2\u300b\u5730\u7344\u7bc7\u7684\u540d\u4f5c\uff0c\u9019\u88e1\u6697\u55bb\u4e86\u5438\u8840\u9b3c\u539f\u59cb\u7684\u91ce\u6027\u3002\n5. \u8499\u5a1c\u9e97\u838e (Mona Lisa)\uff1a[01:20] \u9054\u6587\u897f\u7684\u540d\u4f5c\u51fa\u73fe\uff0c\u4f46\u756b\u50cf\u4e0a\u51fa\u73fe\u4e86\u5169\u500b\u5438\u8840\u9b3c\u7684\u54ac\u75d5 [01:22]\uff0c\u751a\u81f3\u6d41\u4e0b\u4e86\u8840\u6dda\uff0c\u5c07\u6587\u85dd\u5fa9\u8208\u7684\u53e4\u5178\u8207\u6697\u9ed1\u7f8e\u5b78\u7d50\u5408\u3002\n6. \u5967\u83f2\u8389\u4e9e (Ophelia)\uff1a[01:58] \u6f02\u6d6e\u5728\u6c34\u8349\u8207\u82b1\u53e2\u4e2d\u7684\u5973\u5b50\uff0c\u81f4\u656c\u4e86\u7d04\u7ff0\u00b7\u827e\u4f5b\u96f7\u7279\u00b7\u7c73\u840a\u7684\u62c9\u6590\u723e\u524d\u6d3e\u4ee3\u8868\u4f5c\uff0c\u9019\u4e5f\u5c0d\u61c9\u4e86\u6b4c\u8a5e\u4e2d\u63d0\u5230\u7684\u54c8\u59c6\u96f7\u7279\u610f\u8c61\u3002\n7. \u543b (The Kiss)\uff1a[02:23] \u91d1\u71e6\u71e6\u7684\u80cc\u666f\u8207\u64c1\u543b\u7684\u7537\u5973\uff0c\u5b8c\u5168\u5fa9\u523b\u4e86\u53e4\u65af\u5854\u592b\u00b7\u514b\u6797\u59c6\u7684\u98a8\u683c\u3002\u4f46\u5728 MV \u4e2d\uff0c\u6eab\u99a8\u7684\u64c1\u543b\u96a8\u5373\u8f49\u5316\u70ba\u5438\u8840\u9b3c\u7684\u54ac\u9838 [02:24]\uff0c\u5f37\u8abf\u4e86\u300c\u81f4\u547d\u7684\u611b\u300d\u3002\n8. \u591c\u9df9 (Nighthawks)\uff1a[03:05] \u8857\u89d2\u73bb\u7483\u7a97\u5167\u7684\u6df1\u591c\u98df\u5802\uff0c\u662f\u611b\u5fb7\u83ef\u00b7\u970d\u666e\u63cf\u7e6a\u90fd\u6703\u5b64\u5bc2\u7684\u540d\u4f5c\u3002\n9. \u68b5\u8c37\u7cfb\u5217\uff1a\n\u2022 \u5272\u8033\u5f8c\u7684\u81ea\u756b\u50cf\uff1a[03:38] \u7d81\u8457\u7e43\u5e36\u62bd\u7159\u6597\u7684\u7537\u5b50\u6b63\u662f\u68b5\u8c37\u3002\n\u2022 \u5967\u7dad\u723e\u6559\u5802 (The Church at Auvers)\uff1a[03:51] \u5468\u6770\u502b\u8d70\u9032\u756b\u4e2d\u50be\u659c\u3001\u6697\u85cd\u8272\u7684\u6559\u5802\u5efa\u7bc9\u3002\n\u2022 \u591c\u9593\u5496\u5561\u9928 (The Night Caf\u00e9)\uff1a[03:19] \u65cb\u8f49\u7684\u71c8\u5149\u8207\u626d\u66f2\u7684\u5ba4\u5167\u7a7a\u9593\u611f\u3002\n\u2022 \u8a18\u61b6\u7684\u6c38\u6046 (The Persistence of Memory)\uff1a[03:23] \u80cc\u666f\u4e2d\u51fa\u73fe\u4e86\u9054\u5229\u5f0f\u7684\u300c\u878d\u5316\u7684\u6642\u9418\u300d\u3002\n\u4e8c\u3001 \u6b4c\u8a5e\u88e1\u7684\u6587\u5b78\u96b1\u55bb\n\u65b9\u6587\u5c71\u7684\u6b4c\u8a5e\u70ba MV \u92ea\u588a\u4e86\u6df1\u539a\u7684\u6587\u5b78\u5e95\u860a\uff1a\n\u2022 \u838e\u58eb\u6bd4\u4e9e\u7b46\u4e0b\u7684\u7d14\u771f\u8207\u54c8\u59c6\u96f7\u7279\u7684\u82b1\uff1a[01:49] \u9019\u88e1\u5f15\u7533\u81ea\u300a\u54c8\u59c6\u96f7\u7279\u300b\u4e2d\u5967\u83f2\u8389\u4e9e\u5728\u6cb3\u908a\u63a1\u82b1\u3001\u6700\u7d42\u60b2\u5287\u6eba\u4ea1\u7684\u6587\u5b78\u5178\u6545\u3002\u6b4c\u8a5e\u7528\u300c\u89e3\u4e0d\u904e\u53bb\u7684\u771f\u7406\u300d\u4f86\u5c0d\u6bd4\u540d\u756b\u4e2d\u51dd\u56fa\u7684\u77ac\u9593\u3002\n\u2022 \u6551\u8d16\u4f86\u81e8\u524d\u59cb\u7d42\u4e0d\u8a9e\uff1a[01:39] \u5e36\u6709\u6fc3\u539a\u7684\u5b97\u6559\u6587\u5b78\u8272\u5f69\uff0c\u63cf\u8ff0\u53d7\u96e3\u8005\u5728\u6210\u70ba\u5438\u8840\u9b3c\u6216\u6b7b\u4ea1\u524d\u7684\u6c88\u9ed8\u8207\u6399\u624e\u3002\n\u2022 \u514b\u6797\u59c6\u7684\u543b\u662f\u4e00\u7a2e\u5206\u96e2\uff1a[02:22] \u5c07\u7e6a\u756b\u4e2d\u7684\u7d55\u7f8e\u77ac\u9593\u8a6e\u91cb\u70ba\u544a\u5225\uff0c\u96b1\u55bb\u4e86\u7f8e\u597d\u4e8b\u7269\u7684\u8106\u5f31\u3002\n\u4e09\u3001 \u5438\u8840\u9b3c\u5178\u6545\u8207\u610f\u8c61\nMV \u96d6\u7136\u8d70\u83ef\u9e97\u98a8\u683c\uff0c\u4f46\u4fdd\u7559\u4e86\u8a31\u591a\u53e4\u5178\u5438\u8840\u9b3c\u7684\u50b3\u7d71\u8a2d\u5b9a\uff1a\n\u2022 \u8207\u300c\u592a\u967d\u4e4b\u5b50\u300d\u7684\u5c0d\u7acb\uff1a\u5438\u8840\u9b3c\u5728\u50b3\u8aaa\u4e2d\u88ab\u7a31\u70ba\u300cChildren of the Night (\u9ed1\u591c\u4e4b\u5b50)\u300d\uff0c\u6b4c\u540d\u300a\u592a\u967d\u4e4b\u5b50\u300b\u8c61\u5fb5\u8457\u5468\u6770\u502b\u6240\u626e\u6f14\u7684\u7375\u4eba\u89d2\u8272\u662f\u5149\u660e\u3001\u6551\u8d16\u7684\u5316\u8eab\u3002\n\u2022 \u53e4\u5178\u5143\u7d20\uff1a\n\u2022 \u5438\u8840\u9b3c\u7375\u4eba\u88dd\u675f\uff1a\u5468\u6770\u502b\u7684\u9577\u98a8\u8863\u3001\u624b\u5957\uff0c\u4ee5\u53ca\u4f7f\u7528\u7684\u9280\u8272\u5b50\u5f48 [04:27] \u548c\u5341\u5b57\u67b6 [06:10]\uff0c\u90fd\u662f\u50b3\u7d71\u9a45\u9b54\u984c\u6750\u7684\u6a19\u914d\u3002\n\u2022 \u8759\u8760\u8f49\u8eab\uff1a[04:54] \u5438\u8840\u9b3c\u88ab\u64ca\u4e2d\u5f8c\u5316\u70ba\u7121\u6578\u8759\u8760\u6563\u53bb\uff0c\u662f\u5178\u578b\u7684\u5fb7\u53e4\u62c9\u5178\u6545\u3002\n\u2022 \u93e1\u5b50\u8207\u9152\u5427\uff1a\u5728\u300c\u591c\u9df9\u300d\u9152\u5427\u4e00\u5e55\uff0c\u5468\u6770\u502b\u900f\u904e\u93e1\u5b50\u8207\u89c0\u5bdf\u4f86\u5c0b\u627e\u507d\u88dd\u6210\u4eba\u985e\u7684\u5438\u8840\u9b3c [03:12]\uff0c\u5c0d\u61c9\u4e86\u5438\u8840\u9b3c\u5728\u93e1\u4e2d\u6c92\u6709\u5012\u5f71\u6216\u5012\u5f71\u6703\u73fe\u539f\u5f62\u7684\u50b3\u8aaa\u3002\n\u2022 \u827e\u5e03\u8f9b (Absinthe)\uff1a\u9152\u5427\u4e2d\u51fa\u73fe\u7684\u7da0\u8272\u9152\u6db2 [02:57]\uff0c\u88ab\u7a31\u70ba\u300c\u7da0\u8272\u5996\u7cbe\u300d\uff0c\u5e38\u51fa\u73fe\u572819\u4e16\u7d00\u54e5\u5fb7\u6587\u5b78\u4e2d\uff0c\u8c61\u5fb5\u5e7b\u89ba\u8207\u9748\u611f\uff0c\u5e38\u8207\u5438\u8840\u9b3c\u90a3\u7a2e\u9839\u5ee2\u3001\u8ff7\u5e7b\u7684\u6c23\u8cea\u806f\u7e6b\u5728\u4e00\u8d77\u3002",
                    "author": "@\u5143\u7464",
                    "likes": 330,
                    "publishedAt": "2026-03-24T07:46:46Z"
                },
                {
                    "text": "\u51fa\u9053\u5230\u73fe\u5728\u7684\u8001\u7c89\uff0c\u9084\u5f97\u662f\u61f7\u820a\u4e2d\u4e8c\u53e3\u9f52\u4e0d\u6e05\u7684\u6770\u502b\u6700\u5c0d\u5473\uff01\u807d\u611f\u89ba\u5f97\u6709\u300c\u591c\u7684\u7b2c\u4e03\u7ae0+\u9f8d\u6230\u9a0e\u58eb+\u56f0\u7378\u4e4b\u9b25+\u96d9\u5200+\u9ec3\u91d1\u7532+\u5a01\u5ec9\u53e4\u5821\u300d\u7684\u5143\u7d20\uff0c\u611f\u52d5\u7684\u662fMV\u771f\u7684\u5f88\u7528\u5fc3\uff0c\u5c07\u8fd1\u4e03\u5206\u9418\u6839\u672c\u5728\u770b\u4e00\u90e8\u77ed\u7248\u96fb\u5f71\uff0c\u592a\u5c4c\u4e86\u3002",
                    "author": "@achiuu1713",
                    "likes": 88,
                    "publishedAt": "2026-03-24T06:36:32Z"
                },
                {
                    "text": "\u914d\u4e0aMv\u6709\u7a2e\u7121\u96d9+\u9f8d\u6230\u9a0e\u58eb\u7684\u611f\u89ba\uff0c\u9019\u5c31\u662f\u5e74\u8f15\u7684\u4e2d\u4e8c\u6770\u502b\u624d\u80fd\u505a\u7684\u97f3\u6a02",
                    "author": "@\u4e0d\u4e7e\u6de8\u9019\u88e1",
                    "likes": 0,
                    "publishedAt": "2026-03-24T09:59:10Z"
                },
                {
                    "text": "\u771f\u5e0c\u671b\u5468\u6770\u502b\u88ab\u5217\u5165\u6700\u5049\u5927\u97f3\u6a02\u5bb6\u884c\u5217\u4e4b\u4e00",
                    "author": "@\u8def\u898b\u4e0d\u5e73\u63d2\u591a\u5169\u944a",
                    "likes": 1,
                    "publishedAt": "2026-03-24T09:52:20Z"
                }
            ]
        }
    ]
