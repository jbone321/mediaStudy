                    "text": "\u0928\u092e\u0938\u094d\u0915\u093e\u0930 \u0926\u094b\u0938\u094d\u0924\u094b\u0902\u2026\ud83d\ude4f\n\n\u0915\u092d\u0940-\u0915\u092d\u0940 \u092e\u0902\u091a \u092a\u0930 \u092f\u093e \u0938\u092c\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092c\u094b\u0932\u0924\u0947 \u0938\u092e\u092f \u0918\u092c\u0930\u093e\u0939\u091f \u092e\u0947\u0902 \u0936\u092c\u094d\u0926 \u0909\u0932\u091f-\u092a\u0941\u0932\u091f \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0938\u093e\u0927\u093e\u0930\u0923 \u092c\u093e\u0924 \u092d\u0940 \u0938\u0941\u0928\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u093e\u0938\u094d\u092f \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939\u0940 \u0907\u0938 \u092a\u094d\u0930\u0938\u0902\u0917 \u092e\u0947\u0902 \u092d\u0940 \u0939\u0941\u0906 \u2014 \u091c\u0939\u093e\u0901 \u091c\u0928\u094d\u092e \u0935\u0930\u094d\u0937 \u092c\u0924\u093e\u0928\u0947 \u092e\u0947\u0902 \u0910\u0938\u0940 \u092d\u0942\u0932 \u0939\u0941\u0908 \u0915\u093f \u0909\u092e\u094d\u0930 \u0915\u093e \u0939\u093f\u0938\u093e\u092c \u0939\u0940 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964\n\n\u0910\u0938\u0940 \u091b\u094b\u091f\u0940 \u0918\u091f\u0928\u093e\u090f\u0901 \u092f\u0939 \u092d\u0940 \u092c\u0924\u093e\u0924\u0940 \u0939\u0948\u0902 \u0915\u093f \u092e\u0928 \u091c\u092c \u091c\u0932\u094d\u0926\u0940 \u092e\u0947\u0902 \u0939\u094b\u0924\u093e \u0939\u0948 \u0924\u094b \u0938\u094b\u091a \u0914\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u0925 \u0928\u0939\u0940\u0902 \u091a\u0932 \u092a\u093e\u0924\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u0930\u0932\u0924\u093e \u092f\u0939\u0940 \u0939\u0948 \u0915\u093f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0940 \u092d\u0942\u0932 \u092a\u0930 \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e \u0938\u0915\u0947\u0964\n\n\u0918\u092c\