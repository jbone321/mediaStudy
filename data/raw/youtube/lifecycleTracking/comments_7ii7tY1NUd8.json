                {
                    "text": "\u0647\u0627\u064a \u0634\u0646\u0648 \u0635\u0631\u0646\u0627 \u0642\u062f\u064a\u0645\u064a\u0646 \ud83d\ude42\u064a\u0644\u0647 \u0628\u0639\u062f\u0646\u0627 \u062f\u0627 \u0646\u0642\u0631\u0627 \u0639\u0644\u064a\u0643 \u0645\u0627 \u0635\u0631\u0646\u0627 \u0642\u062f\u064a\u0645\u064a\u0646 \u0643\u0644\u0634 \u0628\u0633 \u0627\u0633\u062a\u0627\u0630 \u062f\u062e\u064a\u0644\u0643 \u062e\u0644\u0635\u0644\u0646\u0627 \u0645\u0627\u0628\u0642\u0649 \u0634\u064a \u062a\u0641\u0627\u062a\u064a\u0644 \u0648\u0646\u062e\u0644\u0635 \u0627\u0644\u0645\u0627\u062f\u0629 \u0648\u0645\u0646\u062a\u0638\u0631\u064a\u0646 \u0645\u0631\u0627\u062c\u0639\u0629 \u0644\u0644\u0627\u062f\u0628 \u0646\u0641\u0633 \u062a\u0635 \u0627\u0644\u0633\u0646\u0629 \u062c\u0627\u0646\u062a \u0627\u062d\u0644\u0627 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0634\u0648\u0641\u0647\u0627 \u0643\u0644\u0634 \u0627\u0633\u062a\u0641\u0627\u062f\u064a\u062a \u062a\u0642\u0633\u064a\u0645\u0647\u0627 \u0643\u0644\u0634 \u0631\u0627\u0642\u064a",
