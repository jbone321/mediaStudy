                {
                    "text": "\u0645\u0627\u0634\u0627\u0621\u0627\u0644\u0644\u0647 \u0639\u0644\u0648\u0627\u0647 \u0644\u0648 \u0648\u064a\u0627\u0643\u0645 \u0627\u0646\u064a \u0644\u0648 \u0645\u062f\u0631\u0633\u062a\u0646\u0627 \u0645\u062b\u0644\u0643\u0645 \u0627\u062d\u0646\u0627 \u0644\u062d\u062f \u0647\u0633\u0647 \u062f\u0646\u0645\u062a\u062d\u0646 \u0627\u0644\u0646\u0648\u0628 \u0637\u0627\u0642\u0629 \u0645\u0627\u0643\u0648 \u0628\u0639\u062f \u062f\u0646\u0633\u062d\u0644 \u0628\u0631\u0648\u062d\u0646\u0627 \u0633\u062d\u0644 \u0627\u0644\u0644\u0647 \u064a\u0639\u064a\u0646\u0646\u0627 \u0628\u0633",
                    "author": "@MaryamRaad-p7n",
