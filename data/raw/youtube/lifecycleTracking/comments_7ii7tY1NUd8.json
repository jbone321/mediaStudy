                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0627\u0634\u0643\u0631\u0643 \u0647\u0648\u0627\u064a \u0637\u0644\u0639\u062a \u0627\u0639\u0641\u0627\u0621 \u0628\u0627\u0644\u0627\u0646\u0643\u0644\u064a\u0632\u064a \u0628\u0645\u0639\u062f\u0644 98%",
