                {
                    "text": "\u062f\u0639\u0648\u0644\u064a \u0627\u0645\u0627\u0646\u0647 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0627\u0637\u0644\u0639 \u0627\u0639\u0641\u0627\u0621 \u0639\u0627\u0645 \u0628\u0627\u0644\u062e\u0627\u0645\u0633 \u0639\u0644\u0645\u064a",
