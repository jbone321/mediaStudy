                {
                    "text": "\u0634\u0643\u0631\u0627 \u0627\u0633\u062a\u0627\u0630 \u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u062e\u0627\u0645\u0633 \u0627\u0628\u062a\u062f\u0627\u0626\u064a \u0627\u0644\u062d\u062f \u0647\u0633\u0629 \u0623\u0642\u0631\u0647 \u0639\u0644\u064a\u0643 \u0648\u0643\u0644 \u0645\u0631\u0647 \u0627\u0641\u062a\u0647\u0645 \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0648\u0627\u062c\u0627\u0648\u0628 \u0628\u064a \u0648\u0644\u0644\u0647 \u0627\u0646\u062a \u0627\u062d\u0633\u0646 \u0627\u0633\u062a\u0627\u0630 \u0627\u0646\u0643\u0644\u064a\u0632\u064a \u0628\u062d\u064a\u062b \u064a\u0648\u0635\u0644 \u0627\u0644\u0641\u0643\u0631\u0629 \u0645\u0648 \u0628\u0633 \u064a\u062d\u0644 \u2764",
