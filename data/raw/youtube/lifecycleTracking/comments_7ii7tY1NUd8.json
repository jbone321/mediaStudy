                    "author": "@REORR",
                    "likes": 2,
                    "publishedAt": "2026-04-06T15:09:55Z"
                },
                {
                    "text": "\u0627\u062e\u0630\u0648 \u0634\u0639\u0628\u062a\u0646\u0627 \u0634\u0639\u0628\u0629 \u0627\u0644\u0633\u062c\u0627\u062f \u0639\u0644\u064a\u0647 \u0627\u0633\u0644\u0627\u0645 \u0627\u0646 \u0634\u0627\u0621 \u0627\u0644\u0644\u0647 \u0646\u0628\u064a\u0636 \u0648\u062c\u0647\u0643 \u0627\u0633\u062a\u0627\u0630\u0646\u0627 \u2764",
                    "author": "@_Sn6768",
                    "likes": 4,
                    "publishedAt": "2026-04-05T06:06:02Z"
                },
                {
                    "text": "\u062f\u0639\u0648\u0644\u064a \u0627\u0645\u0627\u0646\u0647 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0627\u0637\u0644\u0639 \u0627\u0639\u0641\u0627\u0621 \u0639\u0627\u0645 \u0628\u0627\u0644\u062e\u0627\u0645\u0633 \u0639\u0644\u0645\u064a",
                    "author": "@user-313gd",
                    "likes": 8,
                    "publishedAt": "2026-04-04T19:14:16Z"
                },
                {
                    "text": "\u0627\u0644\u062d\u0628\u064a\u0628 \u0648\u0627\u0644\u062c\u0645\u064a\u0644 \u0627\u0633\u062a\u0627\u0630 \u0639\u0644\u064a \u0627\u0646\u0627\u0631 \u0627\u0644\u0644\u0647 \u062f\u0631\u0628\u0643 \u0627\u0646\u064a \u0637\u0627\u0644\u0628 27 \u0648\u062a\u0639\u062f\u064a\u0644 \u062f\u0631\u062c\u062a \u0627\u0644\u0627\u0646\u0643\u0644\u064a\u0632 \u0628\u0627\u0644\u0643\u0648\u0631\u0633 \u0627\u0644\u062b\u0627\u0646\u064a \u0635\u0627\u0631 \u0628\u0633\u0628\u0628\u0643 \u0641\u0634\u0643\u0631\u0627\u064b \u0644\u062c\u0647\u0648\u062f\u0643 \u0648\u0644\u0643 \u0627\u062d\u0646\u0647 \u0646\u0631\u064a\u062f \u062a\u0635\u0648\u0631\u0644\u0646\u0647 \u0645\u062d\u0627\u0636\u0631\u0627\u062a \u0644\u0637\u0644\u0627\u0628\u0643 \u0628\u0627\u0644\u064a\u062a\u064a\u0648\u0628 \u0648\u064a\u0643\u0648\u0646 \u0634\u0631\u062d \u0635\u0628\u0648\u0631\u0647 \ud83e\udd0d\ud83d\udd25",
                    "author": "@mopt22",
                    "likes": 0,
                    "publishedAt": "2026-04-07T21:25:47Z"
                },
                {
                    "text": "\u0635\u0648\u062a\u0643 \u0627\u064a\u0642\u0648\u0646\u0629",
                    "author": "@Shaun_27_y",
                    "likes": 2,
                    "publishedAt": "2026-04-05T11:53:55Z"
                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0643\u0645\u0644 \u0633\u0627\u062f\u0633 \u0639\u0644\u0645\u064a \u0645\u062d\u062a\u0627\u062c\u064a\u0646\u0643 \u0627\u0633\u062a\u0639\u062c\u0644 \u0641\u062f\u0648\u0647 \u0627\u0633\u062a\u0639\u062c\u0644 \u0628\u062d\u0644 \u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0634\u0648\u064a\u0647 \u0628\u0627\u0642\u064a \u0627\u0633\u062a\u0627\u0630 \u062a\u0633\u062a\u0639\u062c\u0644 \u0639\u062f\u0646\u0627 \u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a",
                    "author": "@Esa.A-i1j",
                    "likes": 2,
                    "publishedAt": "2026-04-04T21:45:17Z"
                },
                {
                    "text": "\u0645\u0627\u0634\u0627\u0621\u0627\u0644\u0644\u0647 \u0639\u0644\u0648\u0627\u0647 \u0644\u0648 \u0648\u064a\u0627\u0643\u0645 \u0627\u0646\u064a \u0644\u0648 \u0645\u062f\u0631\u0633\u062a\u0646\u0627 \u0645\u062b\u0644\u0643\u0645 \u0627\u062d\u0646\u0627 \u0644\u062d\u062f \u0647\u0633\u0647 \u062f\u0646\u0645\u062a\u062d\u0646 \u0627\u0644\u0646\u0648\u0628 \u0637\u0627\u0642\u0629 \u0645\u0627\u0643\u0648 \u0628\u0639\u062f \u062f\u0646\u0633\u062d\u0644 \u0628\u0631\u0648\u062d\u0646\u0627 \u0633\u062d\u0644 \u0627\u0644\u0644\u0647 \u064a\u0639\u064a\u0646\u0646\u0627 \u0628\u0633",
                    "author": "@MaryamRaad-p7n",
                    "likes": 4,
                    "publishedAt": "2026-04-05T10:04:17Z"
                },
                {
                    "text": "\u0631\u0628\u064a \u064a\u062d\u0641\u0638\u0643 \u0648\u064a\u0648\u0641\u0642\u0643",
                    "author": "@umduaa6505",
                    "likes": 3,
                    "publishedAt": "2026-04-04T19:48:22Z"
                },
                {
                    "text": "\u0623\u0633\u062a\u0627\u0630 \u0627\u0645\u0648\u062a \u0639\u0644\u064a\u0643 \u0648\u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u062d\u0633\u0646 \u0627\u0644\u0645\u062f\u0631\u0633\u064a\u0646 \u0628\u0627\u0644\u0627\u0646\u06af\u0644\u064a\u0632\u064a \ud83e\udd0d",
                    "author": "@SLY_7E",
                    "likes": 2,
