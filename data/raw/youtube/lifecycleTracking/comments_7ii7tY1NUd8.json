                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630\u0646\u0627 \u0627\u0644\u063a\u0627\u0644\u064a \u0645\u0646\u0648\u0631 \u2764\ud83d\ude0a\ud83d\ude0a",
