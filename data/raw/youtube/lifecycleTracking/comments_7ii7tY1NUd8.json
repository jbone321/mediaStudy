                },
                {
                    "text": "\u0635\u0648\u062a\u0643 \u0637\u0631\u0628 \u0648\u0645\u062d\u062a\u0648\u0649 \u0631\u0627\u0642\u0649 \u062c\u062f\u0627 \u0627\u0633\u062a\u0627\u0630 \u0639\u0644\u064a \u0627\u0644\u0648\u0631\u062f\u0629",
