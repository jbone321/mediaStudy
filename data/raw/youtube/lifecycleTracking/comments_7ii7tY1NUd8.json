                    "publishedAt": "2026-04-04T19:14:16Z"
                },
                {
                    "text": "\u064a\u0628\u0648\u0648 \u0648\u0627\u062d\u0646\u0647 \u062d\u0627\u0644\u0641\u064a\u0646 \u064a\u0645\u062a\u062d\u0646\u0648\u0646\u0647 \u0634\u0647\u0631 \u062b\u0627\u0646\u064a",
                    "author": "@Noxnn7",
                    "likes": 0,
                    "publishedAt": "2026-04-04T21:49:51Z"
                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0643\u0645\u0644 \u0633\u0627\u062f\u0633 \u0639\u0644\u0645\u064a \u0645\u062d\u062a\u0627\u062c\u064a\u0646\u0643 \u0627\u0633\u062a\u0639\u062c\u0644 \u0641\u062f\u0648\u0647 \u0627\u0633\u062a\u0639\u062c\u0644 \u0628\u062d\u0644 \u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0634\u0648\u064a\u0647 \u0628\u0627\u0642\u064a \u0627\u0633\u062a\u0627\u0630 \u062a\u0633\u062a\u0639\u062c\u0644 \u0639\u062f\u0646\u0627 \u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a",
                    "author": "@Esa.A-i1j",
                    "likes": 0,
                    "publishedAt": "2026-04-04T21:45:17Z"
                },
                {
                    "text": "\u0627\u0633\u062a\u0627\u0630 \u0627\u0634\u0643\u0631\u0643 \u0647\u0648\u0627\u064a \u0637\u0644\u0639\u062a \u0627\u0639\u0641\u0627\u0621 \u0628\u0627\u0644\u0627\u0646\u0643\u0644\u064a\u0632\u064a \u0628\u0645\u0639\u062f\u0644 98%",
                    "author": "@BdorNew-p3f",
                    "likes": 1,
                    "publishedAt": "2026-04-04T19:47:19Z"
                },
                {
                    "text": "\u0637\u0628\u0639\u0627 \u0635\u062f\u0643 \u0627\u0646\u0635\u062d \u0628\u0647\u0630\u0627 \u0627\u0644\u0645\u062f\u0631\u0633 \u0627\u0646\u064a \u0635\u0631\u0627\u062d\u0629 \u0645\u0627 \u0627\u0642\u0631\u0629 \u0639\u0644\u064a \u0628\u0633 \u064a\u0648\u0645 \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646 \u0648\u0645\u0627 \u0634\u0627\u0621 \u0627\u0644\u0644\u0647 \u0634\u0631\u062d\u0629 \u064a\u062c\u0646\u0646 \u0648\u0648\u0635\u0644 \u0627\u0644\u0641\u0643\u0631\u0629 \u0648\u064a\u062d\u0641\u0638\u0643 \u0627\u0644\u0641\u0643\u0631\u0629 \u0648\u0627\u0646\u062a \u0628\u0633 \u0645\u062c\u0631\u062f \u062a\u0631\u0627\u062c\u0639 \u0648\u0627\u0644\u0644\u0647 \u064a\u0648\u0641\u0642\u0647 \u0648\u064a\u0648\u0641\u0642 \u0627\u0644\u062c\u0645\u064a\u0639 \u0644\u0627\u0646 \u0635\u062f\u0643 \u064a\u0633\u062a\u0627\u0647\u0644",
                    "author": "@\u0645\u0631\u064a\u0645\u0645\u062c\u064a\u062f-\u06347\u06422\u062b",
                    "likes": 0,
                    "publishedAt": "2026-04-04T20:33:15Z"
                },
                {
                    "text": "\u0628\u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0627\u0646 \u0634\u0627\u0621 \u0627\u0644\u0644\u0647",
