                {
                    "text": "\ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude4f\ud83d\ude4f\u2764\u2764\u2764",
                    "author": "@\u0415\u043b\u0435\u043d\u0430\u0423\u0448\u0430\u043a\u043e\u0432\u0430-\u043f5\u0432",
                    "likes": 0,
                    "publishedAt": "2026-04-25T03:30:28Z"
                },
                {
                    "text": "\u0422\u0443\u0442 \u0433\u043e\u043b\u043e\u0441 \u0437 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u043e\u0457, \u0434\u0435 \u043a\u043e\u0436\u043d\u0430 \u043d\u0456\u0447 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u044e, \u0430\u043b\u0435 \u043d\u0430\u0434\u0456\u044f \u0432\u0441\u0435 \u0449\u0435 \u0436\u0438\u0432\u0430.",
                    "author": "@fantom2112KVO",
                    "likes": 36,
                    "publishedAt": "2026-04-20T18:42:17Z"
                },
                {
                    "text": "\u0411\u043e\u0436\u0435....\u0431\u0435\u0440\u0435\u0436\u0438 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043d\u0430\u0448\u043e\u0433\u043e \u0432\u043e\u0457\u043d\u0430 \u0445\u0430\u0439 \u0437\u0430\u043a\u0456\u043d\u0447\u0438\u0442\u044c\u0441\u044f \u0446\u044f \u043a\u043b\u044f\u0442\u044e\u0449\u0430 \u0432\u0456\u0439\u043d\u0430",
                    "author": "@nataliyaaldin2006",
                    "likes": 52,
                    "publishedAt": "2026-04-20T18:57:17Z"
                },
                {
                    "text": "\u0413\u043e\u0441\u043f\u043e\u0434\u0438 \u0431\u0435\u0440\u0435\u0436\u0456 \u043d\u0430\u0448\u0438\u0445 \u0432\u043e\u0457\u043d\u0456\u0432.\n\u042f\u043a\u0430 \u0442\u044f\u0436\u043a\u0430 \u0434\u043e\u043b\u044f \u0443 \u043d\u0430\u0448\u0438\u0445 \u0432\u043e\u0457\u043d\u0456\u0432 \u0456\u0437-\u0437\u0430 \u0441\u043c\u0435\u0440\u0434\u044e\u0447\u0438\u0445\ud83d\ude22\ud83d\ude22\ud83d\ude22\ud83d\ude22\n\u0414\u044f\u043a\u0443\u0435\u043c\u043e \u0437\u0430 \u0432\u0430\u0448\u0443 \u0441\u0442\u0456\u0439\u043a\u0456\u0441\u0442\u044c,\u0442\u0430 \u043b\u044e\u0431\u043e\u0432\u044c \u0434\u043e \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u2764\u2764\u2764",
                    "author": "@tetyanabiletska1239",
                    "likes": 30,
                    "publishedAt": "2026-04-21T04:34:02Z"
                },
                {
                    "text": "...\u043d\u0435 \u0436\u0438\u0432\u0438\u043c, \u0442\u0430\u043a \u043c\u0435\u0440\u0442\u0432\u0438\u043c... \u0437\u0435\u043c\u043d\u0438\u0439 \u0443\u043a\u043b\u0456\u043d \u041e\u043b\u0435\u043a\u0441\u0456\u044e \u042e\u043a\u043e\u0432\u0443 \u0442\u0430 \u0439\u043e\u0433\u043e \u0445\u043b\u043e\u043f\u0446\u044f\u043c \u2764\ud83d\ude4f",
