                    "likes": 53,
                    "publishedAt": "2026-04-21T04:34:02Z"
                },
                {
                    "text": "...\u043d\u0435 \u0436\u0438\u0432\u0438\u043c, \u0442\u0430\u043a \u043c\u0435\u0440\u0442\u0432\u0438\u043c... \u0437\u0435\u043c\u043d\u0438\u0439 \u0443\u043a\u043b\u0456\u043d \u041e\u043b\u0435\u043a\u0441\u0456\u044e \u042e\u043a\u043e\u0432\u0443 \u0442\u0430 \u0439\u043e\u0433\u043e \u0445\u043b\u043e\u043f\u0446\u044f\u043c \u2764\ud83d\ude4f",
                    "author": "@\u041c\u0430\u0440\u0438\u043d\u0430\u041d\u0438\u043a\u043e\u043b\u0430\u0435\u0432\u0430-\u04436\u044a",
                    "likes": 31,
                    "publishedAt": "2026-04-21T10:51:01Z"
                },
                {
                    "text": "\u041f\u0456\u0441\u043d\u044f \u0422\u0456\u043c\u0443\u0440\u0430 \u041c\u0443\u0446\u0443\u0440\u0430\u0454\u0432\u0430, \u043f\u0440\u043e \u0432\u0456\u0439\u043d\u0443 \u0432 \u0427\u0435\u0447\u043d\u0456, \u043f\u0435\u0440\u0435\u043a\u043b\u0435\u0434\u0435\u043d\u0430 \u043d\u0430 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0443.",
                    "author": "@\u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440-\u04407\u04468\u0442",
                    "likes": 26,
                    "publishedAt": "2026-04-20T19:10:00Z"
                },
                {
                    "text": "\u0422\u0443\u0442 \u0433\u043e\u043b\u043e\u0441 \u0437 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u043e\u0457, \u0434\u0435 \u043a\u043e\u0436\u043d\u0430 \u043d\u0456\u0447 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u044e, \u0430\u043b\u0435 \u043d\u0430\u0434\u0456\u044f \u0432\u0441\u0435 \u0449\u0435 \u0436\u0438\u0432\u0430.",
                    "author": "@fantom2112KVO",
                    "likes": 42,
                    "publishedAt": "2026-04-20T18:42:17Z"
                },
                {
                    "text": "\u0411\u043e\u0436\u0435! \u0417\u0431\u0435\u0440\u0435\u0436\u0438 \u043d\u0430\u0448\u0438\u0445 \u0437\u0430\u0445\u0438\u0441\u043d\u0438\u043a\u0456\u0432!",
                    "author": "@\u041c\u0430\u0440\u0438\u043d\u0430\u0417\u043e\u0442\u043a\u0456\u043d\u0430",
                    "likes": 12,
                    "publishedAt": "2026-04-25T08:04:35Z"
                },
                {
                    "text": "\u041f\u0456\u0441\u043d\u044f \u043e\u0431'\u0454\u0434\u043d\u0443\u0454 \u0432\u0441\u0456\u0445 \u043d\u0430\u0441 \u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0456 \u043f\u0440\u043e\u0442\u0438 \u0432\u043e\u0440\u043e\u0433\u0430 \u041d\u0430\u043c \u0432\u0456\u0439\u043d\u0430 \u043d\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430  \u0426\u0435 \u0431\u0456\u0437\u043d\u0435\u0441 \u043d\u0430 \u043a\u0440\u043e\u0432\u0456 \u0443\u043a\u0440\u0430\u0457\u043d\u0446\u0456\u0432 \u041c\u0438\u0440 \u0434\u043b\u044f \u043d\u0430\u0448\u043e\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u0456\u043b\u044c\u043a\u0438 \u043c\u0438\u0440\u2764",
                    "author": "@Marianna-y2h",
                    "likes": 6,
                    "publishedAt": "2026-04-25T16:07:00Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e, \u0437\u0430 \u043c\u0430\u043c\u0443! \u041d\u0430\u0448\u0456 \u043c\u0430\u043c\u0438,  \u0446\u0435 , \u0449\u043e\u0441\u044c \u043d\u0435\u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0435. \u041d\u0435 \u0445\u043e\u0447\u0443, \u043f\u043e\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u0442\u0438 \u0437 \u0432\u0456\u0434\u044c\u043c\u0430\u043c\u0438, \u0432\u0430\u043b\u044c\u043a\u0456\u044f\u0440\u0438\u043c\u0438. \u0422\u0430, \u043d\u0435\u043c\u0430\u0454 \u0446\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0456\u0432, \u0437 \u044f\u043a\u0438\u043c\u0438, \u043d\u0430\u0448\u0438\u0445 \u043c\u0430\u043c - \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0442\u0438!",
                    "author": "@user-ep2bl1hy2u",
                    "likes": 5,
                    "publishedAt": "2026-04-25T20:36:59Z"
                },
                {
                    "text": "\u041f\u043e\u0431\u0456\u043b\u044c\u0448\u0435 \u0442\u0432\u043e\u0457\u0445 \u043f\u0456\u0441\u0435\u043d\u044c,\u0431\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430",
                    "author": "@\u0420\u0430\u0438\u0441\u0430\u0413\u0435\u0440\u0430\u0441\u0438\u043c\u043e\u0432\u0430-\u04389\u0436",
                    "likes": 16,
                    "publishedAt": "2026-04-22T09:51:05Z"
                },
                {
                    "text": "\ud83d\ude22\ud83d\ude22\ud83d\ude22,\u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0435\u0440\u0434\u0446\u0435 \u0440\u0430\u0437\u0440\u0438\u0432\u0430\u0435.",
                    "author": "@\u0422\u0430\u043c\u0430\u0440\u0430\u041d\u0430\u0433\u043e\u0440\u043d\u0430\u044f-\u043d7\u0446",
                    "likes": 22,
                    "publishedAt": "2026-04-24T10:49:57Z"
                },
                {
                    "text": "\u0414\u0435 \u0437\u043d\u0430\u0439\u0442\u0438 \u043f\u043e\u0432\u043d\u0443 \u0432\u0435\u0440\u0441\u0456\u044e ?",
                    "author": "@\u0412\u0430\u0441\u0438\u043b\u044c\u041a\u0430\u0447\u0430\u043d-\u044f7\u044e",
                    "likes": 5,
                    "publishedAt": "2026-04-23T01:45:16Z"
                },
                {
                    "text": "\u0411\u043e\u0436\u0435, \u043f\u0440\u043e\u0441\u0442\u0438 \u043c\u0435\u043d\u0435,\u0449\u043e \u043d\u0435 \u043c\u043e\u0436\u0443 \u043e\u0442\u0438\u0445 \u043d\u0435\u043b\u044e\u0434\u0456\u0432 \u043f\u0440\u043e\u0431\u0430\u0447\u0438\u0442\u0438\ud83d\ude1e",
                    "author": "@\u0410\u043b\u043b\u0430\u0413\u043e\u043b\u043e\u0432\u0447\u0435\u043d\u043a\u043e-\u044f7\u0438",
                    "likes": 3,
                    "publishedAt": "2026-04-25T21:27:43Z"
                },
                {
                    "text": "\u0426\u0435 \u0456 \u0454 \u0433\u0430\u043b\u0433\u043e\u0444\u0444\u0430...\u0442\u0456\u043b\u044c\u043a\u0438 \u0432 \u0441\u0435\u0440\u0446\u0456 \u043a\u043e\u0436\u043d\u043e\u0457 \u043c\u0430\u043c\u0438  \u0447\u0438\u0439 \u0441\u0438\u043d \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0441\u0432\u043e\u044e \u0411\u0430\u0442\u044c\u043a\u0456\u0432\u0449\u0438\u043d\u0443..",
                    "author": "@\u0415\u043b\u0438\u043d\u0430\u0421\u0443\u0442\u044f\u0433\u0438\u043d\u0430",
                    "likes": 4,
                    "publishedAt": "2026-04-25T13:23:13Z"
                },
                {
                    "text": "\u0417\u0430 \u0441\u0435\u0440\u0446\u0435 \u0431\u0435\u0440\u0435!!!!\u0431\u0440\u0430\u0432\u043e \u0437\u0430 \u043f\u0456\u0441\u043d\u044e,\u0440\u0435\u0432\u0435\u0442\u044c \u0445\u043e\u0447\u0435\u0442\u044c\u0441\u044f",
                    "author": "@\u0413\u0435\u043d\u0430\u041a\u043e\u043d\u0442\u0435\u0441\u043e\u0432",
                    "likes": 4,
                    "publishedAt": "2026-04-25T13:12:27Z"
                },
                {
                    "text": "\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83d\udcaa\ud83d\udcaa\ud83d\udcaa\ud83d\udcaa\ud83d\udcaa\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83c\uddfa\ud83c\udde6\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f",
                    "author": "@viktoriyaossipov6493",
                    "likes": 4,
                    "publishedAt": "2026-04-23T00:06:01Z"
                },
                {
                    "text": "\u0413\u043e\u0441\u043f\u043e\u0434\u0438 \u0432\u0441\u0456 \u043b\u044e\u0434\u0438 \u041c\u0438\u0440\u0443 \u043c\u043e\u043b\u044f\u0442\u044c \u0442\u0435\u0431\u0435 \u043f\u0440\u043e \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u043d\u0435\u043d\u0430\u0432\u0435\u0441\u043d\u043e\u0457 \u0432\u0456\u0439\u043d\u0438...",
                    "author": "@valentinakorotun2398",
                    "likes": 2,
                    "publishedAt": "2026-04-25T13:20:34Z"
                },
                {
                    "text": "\u0410\u0436 \u0434\u043e \u043c\u0443\u0440\u0430\u0445 \u043f\u0440\u043e\u0431\u0438\u0440\u0430\u0454....",
                    "author": "@\u042e\u0440\u0438\u0439\u041a\u0443\u0448\u043a\u043e-\u04479\u0432",
                    "likes": 30,
                    "publishedAt": "2026-04-20T19:15:38Z"
                },
                {
                    "text": "\u0411\u0440\u0430\u0442\u0435 . \u0411\u043e\u0433 \u043d\u0430\u0441 \u043b\u044e\u0431\u0435\u2764 \u0422\u0440\u0438\u043c\u0430\u0439\u0441\u044f \u2764",
                    "author": "@\u0410\u043d\u0434\u0440\u0435\u0439\u0421\u0442\u0440\u0438\u0436\u0430\u043a-\u04439\u044a",
                    "likes": 0,
                    "publishedAt": "2026-04-25T22:49:05Z"
                },
                {
                    "text": "\u0413\u043e\u0441\u043f\u043e\u0434\u0438 \u0437\u0430\u043a\u0456\u043d\u0447\u0438 \u0432\u0436\u0435 \u0446\u0456 \u0432\u0456\u0439\u043d\u0438!",
                    "author": "@\u042f\u0440\u043e\u0441\u043b\u0430\u0432\u0410\u043b\u0435\u043a\u0441\u0435\u0435\u043d\u043a\u043e-\u04491\u0442",
                    "likes": 0,
                    "publishedAt": "2026-04-25T20:35:00Z"
                },
                {
                    "text": "\u0426\u044e \u043f\u0456\u0441\u043d\u044e \u043d\u0430\u043f\u0438\u0441\u0430\u0432 \u0422\u0456\u043c\u0443\u0440 \u041c\u0443\u0446\u0443\u0440\u0430\u0454\u0432 \u0432\u0456\u0434 \u0456\u043c\u0435\u043d\u0456 \u0440\u043e\u0441\u0456\u044f\u043d\u0441\u044c\u043a\u043e\u0433\u043e \u0441\u043e\u043b\u0434\u0430\u0442\u0430 \u0432 \u0432\u0456\u0439\u043d\u0456 \u043f\u0440\u043e\u0442\u0438 \u0427\u0435\u0447\u0435\u043d\u0441\u044c\u043a\u043e\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u0412\u0456\u043d \u0441\u043b\u0443\u0436\u0438\u0432 \u0432 \u0432\u0456\u0439\u0441\u044c\u043a\u0430\u0445 \u0414\u0436\u043e\u0445\u0430\u0440\u0430 \u0414\u0443\u0434\u0430\u0454\u0432\u0430 , \u0439\u043e\u0433\u043e \u043f\u0456\u0441\u043d\u0456 \u0441\u043b\u0443\u0445\u0430\u043b\u0438 \u0439\u043e\u0433\u043e \u0432\u043e\u0440\u043e\u0433\u0438 , \u0440\u043e\u0441\u0456\u044f\u043d\u0438.",
                    "author": "@\u041e\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440-\u04475\u044f6\u043b",
                    "likes": 0,
                    "publishedAt": "2026-04-26T06:56:02Z"
                },
                {
                    "text": "\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude2d",
                    "author": "@\u0410\u043d\u0442\u0438\u043a\u043e\u0440-\u044e2\u0442",
                    "likes": 0,
                    "publishedAt": "2026-04-25T22:40:22Z"
                },
