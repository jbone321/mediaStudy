                    "likes": 245,
                    "publishedAt": "2026-04-05T08:01:17Z"
                },
                {
                    "text": "\u0995\u09a4 \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u098f\u0995\u099f\u09be \u09a8\u09be\u09ae \u09b6\u09c1\u09a8\u09b2\u09c7\u0987, \n\u0995\u09b2\u09bf\u099c\u09be  \u09a0\u09be\u09a8\u09cd\u09a1\u09be \u09b9\u09df\u09c7 \u09af\u09be\u09df,\n\n\u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09a6 \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09df\u09be\u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae\u0964",
                    "author": "@\u0989\u09aa\u09a6\u09c7\u09b7\u09cd\u099f\u09be\u0986\u09b8\u09bf\u09ab",
                    "likes": 109,
                    "publishedAt": "2026-04-05T08:01:50Z"
                },
                {
                    "text": "\u098f\u0987 \u09a4\u09c7\u09b2 \u09b8\u0982\u0995\u099f \u098f\u09b0 \u09b8\u09ae\u09af\u09bc \u09b0\u09be\u0995\u09bf\u09ac \u09b9\u09be\u09b8\u09be\u09a8 \u09ad\u09be\u0987 \u09af\u09a6\u09bf \u098f\u0996\u09a8 \u0997\u09bf\u09af\u09bc\u09c7 \u09a4\u09c7\u09b2\u09c7\u09b0 \u09aa\u09be\u09ae\u09cd\u09aa\u09c7 \u099a\u09be\u09a8\u09cd\u09a6\u09be\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7 \u09a4\u09be\u09b9\u09b2\u09c7 \u09a4\u09be\u09b0 \u0996\u09ac\u09b0 \u0986\u099b\u09c7\u0964 \ud83e\udd23",
                    "author": "@HeronVlog",
                    "likes": 31,
                    "publishedAt": "2026-04-05T08:01:33Z"
                },
                {
                    "text": "\u0995\u09c7 \u0995\u09c7 \u099c\u09be\u09ae\u09be\u09a4 \u0995\u09c7 \u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09df \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u09a8\u2764\u2764\u2764",
                    "author": "@SNSohag06",
                    "likes": 12,
                    "publishedAt": "2026-04-05T09:02:37Z"
                },
                {
                    "text": "\u09b8\u09bf\u0997\u09be\u09b0\u09c7\u099f\u09c7\u09b0 \u099b\u09be\u09dc\u09be \u09aa\u09c3\u09a5\u09bf\u09ac\u09c0 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0987,, \u0995\u09c7 \u0995\u09c7 \u09b9\u09be\u09a4 \u09a4\u09c1\u09b2\u09c1\u09a8\ud83d\udd90\ufe0f",
                    "author": "@Assalamualaikumbd",
                    "likes": 16,
                    "publishedAt": "2026-04-05T08:42:24Z"
                },
                {
                    "text": "\u0987\u09b8\u09b2\u09be\u09ae\u09bf \u0996\u09bf\u09b2\u09be\u09ab\u09be\u09b9\u09cd \u09b6\u09be\u09b8\u09a8 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u0995\u09c7 \u0995\u09c7 \u099a\u09be\u09a8 \u09b8\u09be\u09b0\u09be \u09a6\u09bf\u09a8",
                    "author": "@morshedulislam969",
                    "likes": 14,
                    "publishedAt": "2026-04-05T09:21:24Z"
                },
                {
                    "text": "\u0995\u09c7 \u0995\u09c7 \u09ac\u0989 \u099b\u09be\u09dc\u09be \u09aa\u09c3\u09a5\u09bf\u09ac\u09c0 \u099a\u09be\u09a8 \ud83d\ude02\ud83d\ude02",
                    "author": "@belmasum",
                    "likes": 3,
                    "publishedAt": "2026-04-05T09:40:44Z"
                },
                {
                    "text": "\u09ab\u09cd\u09af\u09be\u09ae\u09bf\u09b2\u09bf \u098f\u09a8\u09cd\u099f\u09be\u09b0\u099f\u09c7\u0987\u09a8\u09ae\u09c7\u09a8\u09cd\u099f \u09ae\u09be\u09a8\u09c7\u0987 \u09b8\u09c7\u09b0\u09be \ud83d\ude02\u2764\u2764",
                    "author": "@aliHossain-z6v",
                    "likes": 16,
                    "publishedAt": "2026-04-05T08:52:25Z"
                },
                {
                    "text": "\u0995\u09c7\u0995\u09c7 \u0997\u09cd\u09af\u09be\u09b8 \u099b\u09be\u09a1\u09bc\u09be \u09aa\u09c3\u09a5\u09bf\u09ac\u09c0 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u09a8?",
                    "author": "@HM.AZMIVICTOR_Khabiruddin-w9i",
                    "likes": 33,
                    "publishedAt": "2026-04-05T08:07:35Z"
                },
                {
                    "text": "\u09b0\u09be\u0995\u09bf\u09ac \u09ad\u09be\u0987 \u0986\u09b0 \u099c\u09bf\u09b8\u09be\u09a8 \u09ad\u09be\u0987 \u09ae\u09be\u09a8\u09c7\u0987 \u0986\u09b2\u09be\u09a6\u09be \u09ac\u09bf\u09a8\u09cb\u09a6\u09a8\u0964 \ud83d\ude01\u2764\ufe0f",
                    "author": "@HMSaidulIslamHMSaidulIslam",
                    "likes": 13,
                    "publishedAt": "2026-04-05T08:20:13Z"
                },
                {
                    "text": "\u09a8\u09cc\u0995\u09be \u0986\u09b0 \u09a7\u09be\u09a8\u09c7\u09b0 \u09b6\u09c0\u09b7 \n\u09a6\u09c1\u0987 \u09b8\u09be\u09aa\u09c7\u09b0 \u098f\u0995\u09bf \u09ac\u09bf\u09b7 \ud83d\udc09",
                    "author": "@Bangladesh4m",
                    "likes": 3,
                    "publishedAt": "2026-04-05T09:22:33Z"
                },
                {
                    "text": "\u09a4\u09c7\u09b2 \u099b\u09be\u09a1\u09bc\u09be \u09aa\u09c3\u09a5\u09bf\u09ac\u09c0\u2764 \u098f\u09b0\u0995\u09ae \u098f\u0995\u099f\u09be \u09ad\u09bf\u09a1\u09bf\u0993 3 \u09ac\u099b\u09b0 \u0986\u0997\u09c7 14 \u0986\u0997\u09b8\u09cd\u099f \u2764\u099b\u09be\u09a1\u09bc\u099b\u09bf\u09b2\u09cb \u0995\u09be\u09b0 \u0995\u09be\u09b0 \u09ae\u09a8\u09c7 \u0986\u099b\u09c7 \u0995\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c7 \u09af\u09be\u09a8\u2764",
                    "author": "@mehedi1bro",
                    "likes": 37,
                    "publishedAt": "2026-04-05T08:04:26Z"
                },
                {
                    "text": "\u09b9\u09af\u09b0\u09a4 \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09a6 ( \u09b8\u09be\u0983) \u09eb\u09e6\u09e6\u09e6 \u09ad\u0995\u09cd\u09a4 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0987 \u09b2\u270b\u270b",
                    "author": "@hasanislam-g2n",
                    "likes": 5,
                    "publishedAt": "2026-04-05T08:51:38Z"
                },
                {
                    "text": "\u09aa\u09c3\u09a5\u09bf\u09ac\u09c0\u09b0 \u09b8\u09ac\u099a\u09c7\u09df\u09c7 \u09a6\u09be\u09ae\u09c0 \u09ac\u09be\u0995\u09cd\u09af :\n\u09b2\u09be \u0987\u09b2\u09be\u09b9\u09be \u0987\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6\u09c1\u09b0 \u09b0\u09be\u09b8\u09c1\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 (\u09b8\u09be:)",
                    "author": "@Urmila-h6w",
                    "likes": 38,
                    "publishedAt": "2026-04-05T08:01:32Z"
                },
                {
                    "text": "\u09ac\u09b9\u09c1\u09a6\u09bf\u09a8 \u09a5\u09c7\u0995\u09c7 \u098f\u09ae\u09a8 \u09a8\u09be\u099f\u0995\u09c7\u09b0 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09bf\u0964 \u0995\u09a4 \u09a6\u09bf\u09a8 \u09aa\u09b0\u09c7 \u098f\u09ae\u09a8 \u098f\u0995\u099f\u09be \u09a8\u09be\u099f\u0995\u09c7\u09b0 \u09b8\u09cd\u09ac\u09be\u09a6 \u09aa\u09c7\u09b2\u09be\u09ae\u0964 \ud83d\ude0a\ud83d\ude24\u2764\u2764\ud83d\udc9c",
                    "author": "@AsadRafi-b8g5i",
                    "likes": 2,
                    "publishedAt": "2026-04-05T09:40:44Z"
                },
                {
                    "text": "\u09b8\u09be\u0983 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09df\u09be\u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09b8\u09ae\u09df \u0985\u09b2\u09cd\u09aa \u09b8\u09ac\u09be\u0987 \u09a6\u09c1\u09b0\u09c1\u09a6 \u09aa\u09b0\u09bf \u09ac\u09c7\u09b6\u09bf",
                    "author": "@Tohwidislam-p6p",
                    "likes": 5,
                    "publishedAt": "2026-04-05T09:10:01Z"
                },
                {
                    "text": "\"\u09a6\u09bf\u09b2\u09cd\u09b2\u09bf\u09b0 \u0986\u0997\u09cd\u09b0\u09be\u09b8\u09a8 \n\u09b0\u09c1\u0996\u09c7 \u09a6\u09be\u0993 \u099c\u09a8\u0997\u09a3\"\n\u09b6\u09b0\u09c0\u09ab \u0989\u09b8\u09ae\u09be\u09a8 \u09ac\u09bf\u09a8 \u09b9\u09be\u09a6\u09c0 \u09b0\u09b9\u0983 \u2764",
                    "author": "@Bangladesh4m",
                    "likes": 5,
                    "publishedAt": "2026-04-05T09:23:39Z"
                },
                {
                    "text": "\u0986\u09ae\u09be\u09b0 \u09ae\u09a4\u09cb \u0995\u09c7 \u0995\u09c7 \u09ad\u09bf\u09a1\u09bf\u0993 \u099c\u09a8\u09cd\u09af \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c7\u09a8",
                    "author": "@Dj-ze9iz",
                    "likes": 3,
                    "publishedAt": "2026-04-05T08:03:02Z"
                },
                {
                    "text": "\u099c\u09cd\u099e\u09be\u09a8 \u09b6\u09c7\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2-\u0995\u09cb\u09b0\u0986\u09a8 \u0996\u09c1\u09b2\u09b2\u09c7 \u09af\u09a5\u09c7\u09b7\u09cd\u099f",
                    "author": "@MdSolaimam-qr1uj",
                    "likes": 29,
                    "publishedAt": "2026-04-05T08:02:14Z"
                },
                {
                    "text": "10:21 \u0987\u099e\u09cd\u099c\u09bf\u09a8 \u09a6\u09bf\u09df\u09c7 \u09a4\u09cb \u098f\u0995\u099f\u09c1 \u0995\u09be\u09b2\u09be \u09a7\u09c1\u09df\u09be \u09ac\u09be\u0987\u09b0 \u0993\u09ac\u0987 \u0987\u099e\u09cd\u099c\u09bf\u09a8 \u09aa\u09c1\u09b0\u09be\u09a8 \u09b9\u09df\u09c7 \u0997\u09c7\u099b\u09c7 \u09a8\u09be\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@AlviHasan-o3b",
                    "likes": 6,
