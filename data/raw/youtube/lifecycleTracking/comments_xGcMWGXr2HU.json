                },
                {
                    "text": "\u0995\u09be\u09b0\u09be \u0995\u09be\u09b0\u09be \u09b6\u09b9\u09c0\u09a6 \u09b6\u09b0\u09c0\u09ab \u0993\u09b8\u09ae\u09be\u09a8 \u09b9\u09be\u09a6\u09c0 \u09b9\u09a4\u09cd\u09af\u09be\u09b0 \u09ac\u09bf\u099a\u09be\u09b0 \u099a\u09be\u09a8",
