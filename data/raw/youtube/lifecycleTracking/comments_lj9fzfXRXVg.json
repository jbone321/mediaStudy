            "comments": [
                {
                    "text": "\u09aa\u09be\u09b8\u09be \u09ad\u09be\u0987\u0995\u09c7 \u09a6\u09c7\u0996\u09bf \u099a\u09be\u099a\u09bf \u09ac\u09be\u09a8\u09be\u0987 \u09a6\u09bf\u099b\u09c7 \ud83d\ude02\ud83d\ude02",
                    "author": "@SumaiyaKhatunEva",
                    "likes": 19,
                    "publishedAt": "2026-03-27T08:40:54Z"
                },
                {
                    "text": "-\u0986\u099c \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09b6\u09c1\u0995\u09cd\u09b0\u09ac\u09be\u09b0, \u0986\u09b2\u09b9\u09be\u09ae\u09a6\u09c1\u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9...\u0964\n-\u09b8\u09be\u09b2\u09be\u09a4 \u0995\u09be\u09df\u09c7\u09ae \u0995\u09b0\u09cb..!\ud83d\udc93",
                    "author": "@MdMonzurulislam-hc2nt",
                    "likes": 9,
                    "publishedAt": "2026-03-27T09:16:07Z"
                },
                {
                    "text": "\u0997\u09a4\u0995\u09be\u09b2 \u09ac\u09be\u09b8 \u09a6\u09c2\u09b0\u09cd\u0998\u099f\u09a8\u09be\u09df \u09a8\u09bf\u09b9\u09a4 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09aa\u09be\u0995 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u09a8\u09b8\u09bf\u09ac \u0995\u09b0\u09c1\u0995\u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09ac\u09bf\u09aa\u09a6 \u09a5\u09c7\u0995\u09c7 \u09b0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\ud83e\udd32\ud83e\udd32\ud83d\ude0a",
                    "author": "@Urmila-h6w",
                    "likes": 153,
                    "publishedAt": "2026-03-27T08:00:53Z"
                },
                {
                    "text": "\u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09b8\u09be\u0995\u09cd\u09b7\u09c0  \u09ae\u09c1\u09b8\u09b2\u09ae\u09be\u09a8\u09b0\u09be \u0995\u0996\u09a8\u09cb \u09b9\u09be\u09b0\u09c7\u09a8\u09bf,,,\u098f\u0995\u09a6\u09bf\u09a8 \u09b9\u09b2\u09c7\u0993 \u099c\u09df \u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0987 \u09b9\u09ac\u09c7,, \u0987\u09a8\u09b6\u09be\u0986\u09b2\u09cd\u09b2\u09be\u09b9",
                    "author": "@MD.Mozahid-w9c",
                    "likes": 4,
                    "publishedAt": "2026-03-27T08:10:22Z"
                },
                {
                    "text": "\u0995\u09be\u0989\u0995\u09c7 \u09ac\u09be\u09b0 \u09ac\u09be\u09b0 \u09a1\u09be\u0995\u09b2\u09c7,\n\u09b8\u09c7 \u09b0\u09be\u0997 \u09b9\u09af\u09bc..!!\n\u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0995\u09c7 \u09ac\u09be\u09b0\u09ac\u09be\u09b0 \u09a1\u09be\u0995\u09b2\u09c7,\n\u09a4\u09bf\u09a8\u09bf \u0996\u09c1\u09b6\u09bf \u09b9\u09a8..!!\n_ \u09b8\u09c1\u09ac\u09b9\u09be\u09a8\u0986\u09b2\u09cd\u09b2\u09be\u09b9 _(\u2764\ufe0f\u2764\ufe0f)",
                    "author": "@RifatIslam-100",
                    "likes": 57,
                    "publishedAt": "2026-03-27T08:08:18Z"
                },
                {
                    "text": "\u09e9\u09e6 \u099f\u09be \u09b0\u09cb\u099c\u09be \u0995\u09c7 \u0995\u09c7 \u09b0\u09be\u0996\u099b\u09c7\u09a8 \u2764",
                    "author": "@DraSiyam-l4h7i",
                    "likes": 39,
                    "publishedAt": "2026-03-27T08:01:47Z"
                },
                {
                    "text": "\u0986\u09ae\u09be\u09b0 \u09ae\u09a4\u09cb \u0995\u09c7 \u0995\u09c7 \u09b6\u09c1\u09df\u09c7 \u09b6\u09c1\u09df\u09c7 \u09a6\u09c7\u0996\u099b\u09c7\u09a8\u0964",
                    "author": "@Urmila-h6w",
                    "likes": 36,
                    "publishedAt": "2026-03-27T08:01:47Z"
                },
                {
                    "text": "\u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09df \u09ad\u09be\u09b2 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u0995\u09cb\u09a8 \u09a6\u09be\u09ae \u09a8\u09c7\u0987, \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09b7\u09cd\u099f\u09c7\u09b0 \u09b6\u09c7\u09b7  \u09a8\u09be\u0987 \u0986\u09b0 \u09a4\u09be\u09b0\u09be \u09ac\u09c7\u099a\u09c7\u0993 \u09a5\u09be\u0995\u09c7\u09a8\u09be \u09ac\u09c7\u09b6\u09bf \u09a6\u09bf\u09a8 \u0995\u09c7 \u0995\u09c7 \u098f\u0995\u09ae\u09a4?",
                    "author": "@ayra4v",
                    "likes": 10,
                    "publishedAt": "2026-03-27T08:25:58Z"
                },
                {
                    "text": "\u09b0\u09be\u0995\u09bf\u09ac \u09ad\u09be\u0987\u09df\u09c7\u09b0 \u0985\u09ad\u09bf\u09a8\u09df \u09aa\u09c1\u09b0\u09be\u0987 \u0985\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \ud83d\ude06\ud83d\ude06",
                    "author": "@MdRakibIslam-l8m8i",
                    "likes": 6,
                    "publishedAt": "2026-03-27T08:06:46Z"
                },
                {
                    "text": "\u0985\u09b6\u09cd\u09b2\u09c0\u09b2\u09a4\u09be \u09ae\u09c1\u0995\u09cd\u09a4 \u098f\u0995\u099f\u09bf \u099c\u09a8\u09aa\u09cd\u09b0\u09bf\u09df \u099a\u09cd\u09af\u09be\u09a8\u09c7\u09b2\u2764\u2764",
                    "author": "@emranhosen414M",
                    "likes": 7,
                    "publishedAt": "2026-03-27T08:03:52Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09b9\u09a0\u09be\u09ce \u09ac\u09a1\u09bc \u09a7\u09b0\u09a8\u09c7\u09b0 \u0995\u09cb\u09a8 \u09ac\u09bf\u09aa\u09a6 \u09a5\u09c7\u0995\u09c7 \u09b9\u09c7\u09ab\u09be\u099c\u09a4 \u0995\u09b0\u09c1\u09a8,,, \u0986\u09ae\u09c0\u09a8 \u0986\u09ae\u09c0\u09a8",
                    "author": "@Mdsahahin-oe1dx",
                    "likes": 8,
                    "publishedAt": "2026-03-27T08:03:54Z"
                },
                {
                    "text": "\u09af\u09be\u09b0\u09be \u09af\u09be\u09b0\u09be \u09ac\u09be\u09b8 \u09a6\u09c1\u09b0\u09b0\u09cd\u0998\u099f\u09a8\u09be\u09af\u09bc \u09ae\u09be\u09b0\u09be \u0997\u09c7\u099b\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09a4\u09be\u09b2\u09be \u09af\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09ac\u09be\u09b8\u09c0 \u0995\u09b0\u09c7 \u09b8\u09ac\u09be\u0987 \u09ac\u09b2\u09bf \u0986\u09ae\u09bf\u09a8 \u2764\u2764",
                    "author": "@zabedgazi3193",
                    "likes": 29,
                    "publishedAt": "2026-03-27T08:05:44Z"
                },
                {
                    "text": "\u09b0\u09ae\u099c\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7 \u0988\u09a6 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09af\u09a4 \u09ae\u09be\u09a8\u09c1\u09b7 \u098f\u0995\u09cd\u09b8\u09bf\u09a1\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c7 \u09ae\u09be\u09b0\u09be \u0997\u09c7\u099b\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09df\u09be\u09b2\u09be \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09ac\u09c7\u09b9\u09c7\u09b8\u09cd\u09a4 \u09a8\u09b8\u09bf\u09ac \u0995\u09b0\u09c1\u0995 \ud83e\udd7a\ud83e\udd32",
                    "author": "@Sigma_male_of_the_BD",
                    "likes": 18,
                    "publishedAt": "2026-03-27T08:05:29Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09be\u09ae\u099f\u09be \u09af\u09c7 \u09b2\u09be\u0987\u0995 \u09a6\u09bf\u09ac\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u0986\u09b2\u09be \u09a4\u09be\u09b0 \u09ae\u09a8\u09c7\u09b0 \u0986\u09b6\u09be \u09af\u09c7 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c7 \u09a6\u09c7\u09af\u09bc \u0986\u09ae\u09c0\u09a8 \ud83d\ude0a\ud83d\ude0a",
                    "author": "@zabedgazi3193",
                    "likes": 12,
                    "publishedAt": "2026-03-27T08:04:45Z"
                },
                {
                    "text": "\u09ae\u09b9\u09be\u09a8 \u09b0\u09ac\u09c7\u09b0, \r\n\u098f\u0987 \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u099f\u09c1\u0995\u09c1 \u09b8\u09b0\u09cd\u09ac\u09a6\u09be \u09b8\u09b0\u09a3 \u09b0\u09be\u0996\u09c1\u09a8.......\r\n\u09af\u09be\u0995\u09c7 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae \u09a5\u09c7\u0995\u09c7 \u09a6\u09c2\u09b0\u09c7 \u09b0\u09be\u0996\u09be \u09b9\u09ac\u09c7 \r\n\u098f\u09ac\u0982 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be\u09a8\u09cb \u09b9\u09ac\u09c7, \r\n\u09b8\u09c7-\u0987 \u09b8\u09be\u09ab\u09b2\u09cd\u09af \u09b2\u09be\u09ad \u0995\u09b0\u09ac\u09c7\u0964",
                    "author": "@ThepPathOfLife520",
                    "likes": 3,
                    "publishedAt": "2026-03-27T08:04:12Z"
                },
                {
                    "text": "\u2764\u2764\u2764\u2764\u2764\u2764\u2764\u2764\u2764\n\u09b8\u09ac\u09be\u0987 \u0995\u09c7 \u099c\u09c1\u09ae\u09cd\u09ae\u09be \u09ae\u09cb\u09ac\u09be\u09b0\u0995",
                    "author": "@khanahmjuwel92",
                    "likes": 5,
                    "publishedAt": "2026-03-27T08:50:47Z"
                },
                {
                    "text": "\u09b8\u09ac\u09be\u0987\u0995\u09c7 \u099c\u09c1\u09ae\u09cd\u09ae\u09be \u09ae\u09cb\u09ac\u09be\u09b0\u0995,,,, \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09c1\u09ae\u09cd\u09ae\u09be \u09b8\u09be\u09b2\u09b2\u09bf \u0986\u09b2\u09be \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6\u09bf\u09a8\u09bf\u09a8 \u09a8\u09be\u09ac\u09bf\u09df\u09cd\u09af\u09bf\u09b2 \u0989\u09ae\u09ae\u09bf\u09b9\u09bf \u0993\u09df\u09be\u09b2\u09be \u0986\u09b2\u09bf\u09b9\u09bf \u0993\u09df\u09be \u0986\u09b8\u09b9\u09be\u09ac\u09bf\u09b9\u09bf \u0993\u09df\u09be \u09b8\u09be\u09b2\u09b2\u09bf\u09ae \u09a4\u09be\u09b8\u09b2\u09bf\u09ae\u09be\u2764\u2764\u2764",
                    "author": "@MD.Mozahid-w9c",
                    "likes": 4,
                    "publishedAt": "2026-03-27T08:03:42Z"
                },
                {
                    "text": "\u0987\u09af\u09bc\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09c1\u09ae\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u0997\u099c\u09ac \u09a6\u09bf\u09af\u09bc\u09cb \u09a8\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0964 \u098f\u0987 \u0988\u09a6\u09c7 \u0985\u09a8\u09c7\u0995 \u09a6\u09c1\u09b0\u09cd\u0998\u099f\u09a8\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 ( \u09ac\u09be\u09b8 \u09a6\u09c1\u09b0\u09cd\u0998\u099f\u09a8\u09be , \u09b2\u099e\u09cd\u099a \u099a\u09be\u09aa\u09be \u09aa\u09a1\u09bc\u09c7 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 , \u09b8\u09c7\u09a4\u09c1 \u09ad\u09c7\u0999\u09c7 4 \u09b6\u09bf\u09b6\u09c1\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 , \u099f\u09cd\u09b0\u09c7\u09a8\u09c7\u09b0 \u09ac\u0997\u09bf\u09a4\u09c7 \u0986\u0997\u09c1\u09a8 , \u09b8\u09bf\u09b2\u09bf\u09a8\u09cd\u09a1\u09be\u09b0 \u09ac\u09bf\u09b8\u09cd\u09ab\u09cb\u09b0\u09a3 \u0986\u09b0\u09cb \u0985\u09a8\u09c7\u0995 \u09a6\u09c1\u09b0\u09cd\u0998\u099f\u09a8\u09be ) \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09c1\u09ae\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09ae\u09be\u09ab \u0995\u09b0\u09cb \u0964 \u0986\u09b0 \u098f\u0987 \u09b8\u0995\u09b2 \u09a6\u09c1\u09b0\u09cd\u0998\u099f\u09a8\u09be\u09af\u09bc \u09af\u09be\u09af\u09bc \u0995\u09b0\u09be \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09ac\u09b0\u09a3 \u0995\u09b0\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09a4\u09c1\u09ae\u09bf \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u09a8\u09b8\u09bf\u09ac \u0995\u09b0\u09bf\u0993 \u0964 \u0986\u09ae\u09bf\u09a8 \u2764",
                    "author": "@mahinbro01",
                    "likes": 3,
                    "publishedAt": "2026-03-27T08:08:38Z"
                },
                {
                    "text": "\u0987\u09b0\u09be\u09a8 \u099c\u09af\u09bc\u09c0 \u09b9\u09b2\u09c7 \u0995\u09c7 \u0995\u09c7 \u0996\u09c1\u09b6\u09bf \u09b9\u09a4\u09c7\u09a8",
                    "author": "@ayshakhan-k8h",
                    "likes": 162,
                    "publishedAt": "2026-03-27T08:01:05Z"
                },
                {
                    "text": "\u09a6\u09cb\u09b2\u09cb\u09a6\u09bf\u09af\u09bc\u09be \u09ab\u09c7\u09b0\u09bf\u0998\u09be\u099f\u09c7 \u09af\u09be\u09b0\u09be \u09a8\u09bf\u09b9\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09a7\u09c8\u09b0\u09cd\u09af \u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09be\u09b0 \u09a4\u09cc\u09ab\u09bf\u0995 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb \u0986\u09ae\u09bf\u09a8\u0964",
                    "author": "@\u09b0\u09be\u099c\u0995\u09a8\u09cd\u09af\u09be-\u0997\u09e8\u09a3",
                    "likes": 2,
                    "publishedAt": "2026-03-27T09:24:04Z"
                },
                {
                    "text": "\u098f\u09a4 \u098f\u09a4 \u09a6\u09c2\u09b0\u09cd\u0998\u099f\u09a8\u09be\u09af\u09bc \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09b9\u09c7\u09ab\u09be\u099c\u09a4\u09c7 \u09b0\u09be\u0996\u09c1\u09a8 \ud83e\udd79\ud83e\udd32\ud83c\udffb",
                    "author": "@ExMridul",
                    "likes": 3,
                    "publishedAt": "2026-03-27T08:03:41Z"
                },
                {
                    "text": "\u0986\u09ac\u09c1 \u09b9\u09c1\u09b0\u09be\u09af\u09bc\u09b0\u09be (\u09b0\u09be.) \u09a5\u09c7\u0995\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4\u2014\n\u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 (\u09b8\u09be.) \u09ac\u09b2\u09c7\u099b\u09c7\u09a8, \u201c\u09aa\u09be\u09a8\u09bf\u09a4\u09c7 \u09a1\u09c1\u09ac\u09c7 \u09ae\u09c3'\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09b6\u09b9\u09c0\u09a6\u0964\u201d\n\n\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u0995\u09c7 \u09a7\u09c8\u09b0\u09cd\u09af \u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \ud83e\udd32\ud83c\udfff",
                    "author": "@\u09a6\u09cd\u09ac\u09c0\u09a8\u09c7\u09b0\u09a6\u09be\u0993\u09af\u09bc\u09be\u09b999",
                    "likes": 14,
                    "publishedAt": "2026-03-27T08:03:51Z"
                },
                {
                    "text": "\u0996\u09c1\u09b2\u09a8\u09be \u099c\u09c7\u09b2\u09be \u09a5\u09c7\u0995\u09c7 \u09a6\u09c7\u0996\u099b\u09bf, \u09ad\u09be\u0987 \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993 \u0996\u09c1\u09ac \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u09b2\u09be\u0997\u09c7\u0964 \u09a6\u09cb\u09df\u09be \u0995\u09b0\u09bf \u0986\u09aa\u09a8\u09be\u09b0\u09be \u0986\u09b0\u09cb \u0985\u09a8\u09c7\u0995 \u09a6\u09c2\u09b0 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\u0964",
                    "author": "@Cokhedekhogalpo_2025",
                    "likes": 5,
                    "publishedAt": "2026-03-27T08:01:32Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09be\u09b0 \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u09b2\u09bf\u0996\u099b\u09c7\u09a8 \u09a4\u09be\u09b0 \u09b8\u09c7\u0996\u09be\u09a8\u09c7\u0987 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u09b9\u09ac\u09c7 \u0986\u09ae\u09b0\u09be \u09b8\u09c7\u0987 \u09a6\u09cc\u09b2\u09a6\u09bf\u09af\u09bc\u09be \u0998\u09be\u099f\u09c7\u09b0 \u09b6\u0995\u09cd\u09a4\u09bf \u09b6\u09cb\u0995\u09be\u09b9\u09a4 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u099c\u09be\u09a8\u09be\u0987 \u0986\u09a8\u09cd\u09a4\u09b0\u09bf\u0995 \u09b8\u09ae\u09ac\u09c7\u09a6\u09a8\u09be",
