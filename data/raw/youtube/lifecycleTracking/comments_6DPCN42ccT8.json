                {
                    "text": "\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d\ud83e\udd0d",
                    "author": "@GagauzArmanMorman",
                    "likes": 0,
                    "publishedAt": "2026-03-24T14:06:37Z"
                },
                {
                    "text": "\u062a\u0631\u062c\u0645\u0629 \u0633\u0631\u064a\u0639\u0629 :\n\n\u0627\u0634\u062a\u0642\u062a \u0625\u0644\u064a\u0643 \u064a\u0627 \u0639\u0632\u064a\u0631 \u0627\u0644\u0642\u0644\u0648\u0628 \n\u0623\u0646\u062a \u0633\u062d\u0627\u0628\u0629 \u0627\u0644\u0631\u062d\u0645\u0629 \u064a\u0627 \u0646\u0628\u064a .\n\u0627\u0633\u0645\u0643 \u0627\u0644\u062c\u0645\u064a\u0644 \u0639\u0644\u0649 \u0644\u0633\u0627\u0646\u064a  \n\u0623\u0646\u062a \u0646\u0648\u0631 \u0627\u0644\u0642\u0644\u0648\u0628 \u064a\u0627 \u0646\u0628\u064a \n\n\u062c\u0626\u062a \u0644\u0644\u0645\u062f\u064a\u0646\u0629 \u0644\u0631\u0624\u064a\u062a\u0643 .. \u0644\u0643\u0646 \u0644\u0645 \u0623\u062c\u062f\u0643  \u0648\u0644\u0645 \u0623\u0644\u062a\u0642 \u0628\u0643 \u0642\u0627\u0644\u0648\u0627 \u0623\u0646\u0643 \u0644\u0645 \u062a\u0639\u062f \u0647\u0646\u0627 \u0644\u0642\u062f \u0631\u062d\u0644\u062a \u0644\u0644\u0631\u0628 \u0627\u0644\u0639\u0644\u064a .\n\u0628\u0643\u064a\u062a \u0644\u0631\u062d\u064a\u0644\u0643  \n\u0627\u0633\u0645\u0643 \u0627\u0644\u062c\u0645\u064a\u0644 \u0644\u0627 \u064a\u063a\u064a\u0628 \n\u064a\u0627 \u0646\u0648\u0631 \u0627\u0644\u0642\u0644\u0648\u0628 \u0641\u062f\u064a\u062a\u0643 \u064a\u0627 \u0646\u0628\u064a .\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014-\n\u0627\u0644\u0644\u0647\u0645 \u0635\u0644 \u0648\u0633\u0644\u0645 \u0648\u0628\u0627\u0631\u0643 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 \u0648\u062d\u0628\u064a\u0628\u0646\u0627 \u0648\u0634\u0641\u064a\u0639\u0646\u0627 \u0645\u062d\u0645\u062f \u0648\u0639\u0644\u0649 \u0622\u0644\u0647 \u0648\u0635\u062d\u0628\u0647 \u0623\u062c\u0645\u0639\u064a\u0646",
