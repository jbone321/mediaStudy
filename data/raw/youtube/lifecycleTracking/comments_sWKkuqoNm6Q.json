                {
                    "text": "\u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8 \u099a\u09be\u09b0\u09a6\u09bf\u0995\u09c7 \u098f\u09a4\u09cb \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u0996\u09c1\u09a8-\u0996\u09be\u09b0\u09be\u09aa\u09bf\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993 \u09a6\u09c7\u0996\u09b2\u09c7 \u09ae\u09a8\u099f\u09be \u09ad\u09be\u09b2\u09cb \u09b9\u09df,  \u0995\u09c7 \u0995\u09c7 \u098f\u09a6\u09c7\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993\u09b0 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be\u09df \u099b\u09bf\u09b2\u09c7\u09a8\n\ud83d\udc47\ud83d\udc47\ud83d\udc47",
                    "author": "@Urmila-h6w",
                    "likes": 99,
                    "publishedAt": "2026-04-28T08:01:08Z"
                },
                {
                    "text": "\u0986\u099c\u0995\u09c7\u09b0 \u09a5\u09c7\u0995\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09ac\u09a8\u09ac\u09c0 \u09ae\u09cb\u09b9\u09be\u09ae\u09cd\u09ae\u09a6 \u09b8\u09be:\u0995\u09c7 \u09a8\u09bf\u09df\u09c7 \u0995\u09cb\u09a8 \u0995\u099f\u09c1\u0995\u09cd\u09a4\u09bf \u099a\u09b2\u09ac\u09c7 \u09a8\u09be \u2764\u2764\u2764\u2764",
                    "author": "@MForMesba",
                    "likes": 71,
                    "publishedAt": "2026-04-28T08:01:22Z"
                },
                {
                    "text": "\u098f\u0987 \u099a\u09cd\u09af\u09be\u09a8\u09c7\u09b2\u099f\u09be \u09aa\u09c1\u09b0\u09cb \u09ab\u09cd\u09af\u09be\u09ae\u09bf\u09b2\u09bf \u09a8\u09bf\u09df\u09c7 \u09a6\u09c7\u0996\u09be\u09b0 \u09ae\u09a4\u09cb \ud83d\ude04\n\u09ae\u099c\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u09b2\u09cb \u09ae\u09c7\u09b8\u09c7\u099c\u0993 \u09a5\u09be\u0995\u09c7\nRespect for such \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u0995\u09a8\u099f\u09c7\u09a8\u09cd\u099f \ud83d\udc4f",
                    "author": "@Sadekvaicomedyking",
                    "likes": 31,
                    "publishedAt": "2026-04-28T08:01:27Z"
                },
                {
                    "text": "\u0998\u09c1\u09b7\u09c7\u09b0 \u099f\u09be\u0995\u09be\u09df \u09b9\u099c\ud83d\udeab\n\u09b9\u09be\u09a6\u09bf\u09df\u09be\u09b0 \u099f\u09be\u0995\u09be\u09df \u09b9\u099c\u2705\ud83d\ude02",
                    "author": "@SadiMahmud-s1i",
                    "likes": 63,
                    "publishedAt": "2026-04-28T08:01:21Z"
                },
                {
                    "text": "\u0986\u09b0 \u09b9\u09a0\u09be\u09ce \u09b9\u09a0\u09be\u09ce \u09ab\u09cd\u09af\u09be\u09ae\u09bf\u09b2\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u0995\u09c3\u09b7\u09bf \u0995\u09be\u09b0\u09cd\u09a1 \u09a1\u09be\u09af\u09bc\u09be\u09ac\u09c7\u099f\u09bf\u09b8 \u0995\u09be\u09b0\u09cd\u09a1 \u09aa\u09c1\u099f\u0995\u09bf\u09ae\u09be\u09b0\u09be \u0995\u09be\u09b0\u09cd\u09a1 \u098f\u09b8\u09ac \u09a6\u09bf\u09af\u09bc\u09c7 \u0995\u09bf\u099b\u09c1 \u098f\u0995\u099f\u09be \u09ac\u09be\u09a8\u09be\u0993  \ud83d\ude0e\ud83d\ude38",
                    "author": "@SarderAbdullah9999m",
                    "likes": 17,
                    "publishedAt": "2026-04-28T08:04:07Z"
                },
                {
                    "text": "\u0985\u09b6\u09cd\u09b2\u09c0\u09b2\u09a4\u09be \u099b\u09be\u09dc\u09be\u0993 \u09af\u09c7 \u09a8\u09be\u099f\u0995 \u0995\u09b0\u09be \u09af\u09be\u09df \u098f\u09b0\u09be\u0987 \u09ac\u09be\u09b8\u09cd\u09a4\u09ac \u09aa\u09cd\u09b0\u09ae\u09be\u09a3",
                    "author": "@AbdurRAHMAN-z8h2f",
                    "likes": 16,
                    "publishedAt": "2026-04-28T08:26:08Z"
                },
                {
                    "text": "\u0995\u09be\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u0985\u099f\u09cb\u09ae\u09c7\u099f\u09bf\u0995\u09b2\u09bf \u09ad\u09bf\u09a1\u09bf\u0993\u09a4\u09c7 \u099a\u09b2\u09c7 \u098f\u09b8\u09c7\u099b\u09c7\ud83c\udf89\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@RakibHassin-r8b",
                    "likes": 28,
                    "publishedAt": "2026-04-28T08:02:23Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09c1\u09ae\u09cd\u09ae\u09be \u09b8\u09b2\u09cd\u09b2\u09bf \u0993\u09df\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09bf\u09ae \u0986\u09b2\u09be \u09a8\u09be\u09ac\u09bf\u09df\u09cd\u09af\u09bf\u09a8\u09be \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09a6 ( \ufdfa) \ud83e\ude77",
                    "author": "@islamiclife7464",
                    "likes": 10,
                    "publishedAt": "2026-04-28T08:03:03Z"
                },
                {
                    "text": "\u0998\u09c1\u09b6\u09c7\u09b0 \u099f\u09be\u0995\u09be\u0987 \u09b9\u099c\u274e\n\u09b8\u09c1\u09a6\u09c7\u09b0 \u099f\u09be\u0995\u09be\u09b0 \u09b9\u099c\u274e\n\u099a\u09be\u09a8\u09cd\u09a6\u09be\u09ac\u09be\u099c\u09bf \u09a7\u09be\u09a8\u09cd\u09a6\u09be\u09ac\u09be\u099c\u09bf\u09b0 \u099f\u09be\u0995\u09be\u0987 \u09b9\u099c\u2705",
                    "author": "@MdNaeem-n2x8d",
                    "likes": 7,
                    "publishedAt": "2026-04-28T08:55:41Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09eb\u09e6\u09e6 \u099f\u09be \u09ad\u0995\u09cd\u09a4 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0987 \u2764 \u2764",
                    "author": "@siamahmed7814",
                    "likes": 22,
                    "publishedAt": "2026-04-28T08:04:14Z"
                },
                {
                    "text": "\u09b9\u099c\u09c7 \u09af\u09be\u099a\u09cd\u099b\u09c7\u09a8 \u099c\u09be\u09b2\u09c7\u09ae \u09ad\u09be\u0987\ud83d\ude02\ud83d\ude02",
                    "author": "@MD.SUMON_50",
                    "likes": 7,
                    "publishedAt": "2026-04-28T08:04:47Z"
                },
                {
                    "text": "\u0995\u09c7 \u0995\u09c7 \u2764\"\u09ac\u09be\u09b8 \u09a1\u09be\u0995\u09be\u09a4\u09bf\u09b0 \u09aa\u09be\u09a0-\u09e9\" \u099a\u09be\u09a8?\ud83c\udf89",
                    "author": "@MoonPiyas",
                    "likes": 18,
                    "publishedAt": "2026-04-28T08:02:33Z"
                },
                {
                    "text": "\u099f\u09be\u0995\u09be \u09aa\u09df\u09b8\u09be, \u0996\u09cd\u09af\u09be\u09a4\u09bf \u098f\u0997\u09c1\u09b2\u09cb \u09af\u09c7\u09ae\u09a8 \u09b8\u09c1\u0996 \u09a8\u09bf\u09df\u09c7 \u0986\u09b8\u09c7 \u09a4\u09c7\u09ae\u09a8\u09bf \u09ac\u09bf\u09dc\u09ae\u09cd\u09ac\u09a8\u09be \u0993 \u09a4\u09c8\u09b0\u09c0 \u0995\u09b0\u09c7\u0964 \u09a4\u09bf\u09a8 \u09ad\u09be\u0987 \u0986\u099c \u0986\u09b2\u09be\u09a6\u09be \u09b9\u09df\u09c7 \u0997\u09c7\u099b\u09c7 \ud83d\udc94 \u09ae\u09be\u09b8\u09c1\u09a6 \u09ad\u09be\u0987\u09df\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0995 \u09b9\u09df\u09c7 \u09af\u09be\u09a8 \u09ad\u09be\u0987 \ud83d\ude4f \u09ac\u09dc \u09ad\u09be\u0987\u09df\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09b8\u09be\u09ae\u09be\u09a8\u09cd\u09af \u099b\u09cb\u099f \u09b9\u09df\u09c7 \u09b9\u09b2\u09c7\u0993 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ae\u09bf\u099f\u09bf\u09df\u09c7 \u09ab\u09c7\u09b2\u09c1\u09a8 \u09a4\u09be\u09a4\u09c7 \u0995\u09b0\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09df \u0993 \u09b6\u09be\u09a8\u09cd\u09a4\u09bf \u09aa\u09b0\u0995\u09be\u09b2\u09c7\u0993 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u09aa\u09be\u09ac\u09c7\u09a8 \u09ad\u09be\u0987 \u2764",
                    "author": "@somosamoyik2.0",
                    "likes": 11,
                    "publishedAt": "2026-04-28T08:12:15Z"
                },
                {
                    "text": "6:03 \u0986\u0999\u09cd\u0997\u09c1\u09b2 \u09a8\u09be\u09dc\u09be\u09a8\u09cb\u099f\u09be \u0985\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \ud83d\ude02\ud83d\ude02",
                    "author": "@voiceofquran-b8j",
                    "likes": 4,
                    "publishedAt": "2026-04-28T09:07:29Z"
                },
                {
                    "text": "\u0998\u09c1\u09b7\u09c7\u09b0 \u099f\u09be\u0995\u09be \u2705\n\u09b9\u09be\u09a6\u09bf\u09df\u09be\u09b0 \u099f\u09be\u0995\u09be \u274c\n\ud83d\ude05\ud83d\ude05\ud83d\ude05",
                    "author": "@kheladhulasports18",
                    "likes": 6,
                    "publishedAt": "2026-04-28T08:11:54Z"
                },
                {
                    "text": "\u09b9\u09c7 \u09b0\u09ac \u09e8\u09e6\u09e8\u09ec \u09af\u09be\u09b0\u09be \u09b9\u099c\u09cd\u099c\u09c7 \u09af\u09be\u09ac\u09c7\u09a8, \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u0995\u09b2\u09c7\u09b0 \u09b9\u099c\u09cd\u09ac\u0995\u09c7 \u0986\u09aa\u09a8\u09bf \u0995\u09ac\u09c1\u09b2 \u0995\u09b0\u09c1\u09a8, \u098f\u09ac\u0982 \u098f\u09a6\u09c7\u09b0 \u0989\u099b\u09bf\u09b2\u09be\u09df \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c1\u09a8,",
                    "author": "@muhammadsuhel207",
                    "likes": 4,
                    "publishedAt": "2026-04-28T08:03:07Z"
                },
                {
                    "text": "\u0995\u09be\u09b0\u09be \u0995\u09be\u09b0\u09be \u09a8\u09a4\u09c1\u09a8 \u09ad\u09bf\u09a1\u09bf\u0993\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u099b\u09bf\u09b2\u09c7\u09a8?",
                    "author": "@HM.AZMIVICTOR_Khabiruddin-w9i",
                    "likes": 12,
                    "publishedAt": "2026-04-28T08:01:48Z"
                },
                {
                    "text": "\u0996\u09c1\u09ac \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u09ac\u09be\u09b8\u09cd\u09a4\u09ac \u099c\u09c0\u09ac\u09a8\u09c7\u09b0 \u0998\u099f\u09a8\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ae\u09bf\u09a4 \u09b9\u09af\u09bc\u0964\u2764\u2764\u2764",
                    "author": "@AIMSworld-b2k",
                    "likes": 5,
                    "publishedAt": "2026-04-28T08:11:52Z"
                },
                {
                    "text": "\u0998\u09c1\u09b7\u09c7\u09b0 \u099f\u09be\u0995\u09be\u09df \u09b9\u099c \u274c\n\u09b9\u09be\u09a6\u09bf\u09df\u09be\u09b0 \u099f\u09be\u0995\u09be\u09df \u09b9\u099c \u2705",
                    "author": "@typowith_nadia.official",
                    "likes": 7,
                    "publishedAt": "2026-04-28T08:12:43Z"
                },
                {
                    "text": "\u09af\u09c7 \u09b8\u09ae\u09df \u09ad\u09bf\u09a1\u09bf\u0993 \u099f\u09be \u0985\u09a8 \u0995\u09b0\u09ac\u09cb \u09a0\u09bf\u0995 \u0990 \u09b8\u09ae\u09df \u09ac\u09bf\u09a6\u09cd\u09af\u09c1\u09ce \u099a\u09b2\u09c7 \u0997\u09c7\u09b2 \u09ae\u09c7\u099c\u09be\u099c \u098f\u09a4\u09cb \u0996\u09be\u09b0\u09be\u09aa \u09b9\u09df\u09c7 \u0997\u09c7\u099b\u09bf\u09b2\n\u0986\u09b2\u09b9\u09be\u09ae\u09a6\u09c1\u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9 \u098f\u0995\u099f\u09c1 \u09aa\u09b0\u09c7 \u09ac\u09bf\u09a6\u09cd\u09af\u09c1\u09ce \u099a\u09b2\u09c7 \u0986\u09b8\u09b2 \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993 \u099f\u09be \u09a6\u09c7\u0996\u09a4\u09c7\u099b\u09bf \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6",
                    "author": "@islamicdowa24",
                    "likes": 4,
                    "publishedAt": "2026-04-28T08:11:12Z"
                },
                {
                    "text": "\u09a6\u09c7\u09b6\u09c0 \u09ac\u09be\u09b8 \u09a1\u09be\u0995\u09be\u09a4\u09bf \u09aa\u09be\u09b0\u09cd\u099f \u09e9 \u099a\u09be\u0987 \u0964 \u0995\u09c7 \u0995\u09c7 \u098f\u0995\u09ae\u09a4?",
                    "author": "@btsarmyot7-nzr",
                    "likes": 5,
                    "publishedAt": "2026-04-28T08:13:59Z"
                },
                {
                    "text": "\u099c\u09be\u09b2\u09c7\u09ae \u09ad\u09be\u0987\ud83d\ude05\ud83d\ude02\ud83d\ude02",
                    "author": "@MDARIFULISLAM-2030",
                    "likes": 2,
                    "publishedAt": "2026-04-28T09:13:56Z"
                },
                {
                    "text": "\u0996\u09c1\u09ac \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u098f\u0995\u099f\u09be \u09ad\u09bf\u09a1\u09bf\u0993 \u09ad\u09be\u0987 \u0985\u09a8\u09c7\u0995 \u09ad\u09be\u09b2\u09cb \u09b2\u09be\u0997\u099b\u09c7 \ud83d\udc9e\ud83e\udd70\ud83d\udc98",
                    "author": "@alaminmajumder1079",
                    "likes": 3,
                    "publishedAt": "2026-04-28T09:16:45Z"
                },
                {
                    "text": "\u099c\u09be\u09b2\u09bf\u09ae \u09ad\u09be\u0987\n\u09b9\u099c \u0995\u09be\u09b0\u09cd\u09a1 \u098f\u09b0 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u099a\u09be\u0987\u0964",
                    "author": "@kawsarmahmud523",
