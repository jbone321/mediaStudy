                {
                    "text": "\u041e\u0432\u043e\u0437 \u0431\u0443\u043d\u0447\u0430 \u0435\u043a\u0438\u043c\u043b\u0438 \u0418\u0436\u0440\u043e \u0437\u0443\u0440",
