                    "likes": 0,
                    "publishedAt": "2026-04-12T17:43:21Z"
                },
                {
                    "text": "\u041c\u043e\u043d\u0441\u0442\u0440 \u0438\u0437 \u0442\u0430\u043d\u043a \u043b\u0430\u0439\u0444 \u0432 \u0433\u0435\u0440\u0430\u043d\u0434\u0435 ._.",
                    "author": "@Wartanks242",
                    "likes": 1,
