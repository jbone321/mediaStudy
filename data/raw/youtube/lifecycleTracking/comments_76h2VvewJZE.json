                },
                {
                    "text": "\u043c\u043d\u0435 \u0441\u0442\u0430\u043b\u043e \u0436\u0430\u043b\u043a\u043e \u043c\u043e\u043d\u0441\u0442\u0440\u0430 \u0421\u0421\u0421\u0420 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0437\u0434\u0430\u043b\u0438",
