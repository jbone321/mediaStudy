                },
                {
                    "text": "-\u0422-\u0442-\u0442\u044b \u0436\u0438-\u0436",
                    "author": "@\u0433\u043b\u0430\u0432\u043d\u044b\u0439\u043e\u0446\u0435\u043d\u0449\u0438\u043a\u043f\u0430\u0440\u0442\u0438\u0438\u041b\u0438\u0441\u0438\u0447\u043a\u0430",
                    "likes": 1,
                    "publishedAt": "2026-04-12T06:42:57Z"
                },
                {
                    "text": "\u0422\u0443\u0442 \u043d\u0443\u0436\u043d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0434\u043e\u0433\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0448\u0443\u0442\u043a\u043e\u0439 \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u0435 \u0430\u043f\u0440\u0435\u043b\u044f. \u0410 \u0447\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0432 \u0441\u0435\u0440\u044c\u044f\u043b\u0435",
