                {
                    "text": "\uc0bc\uc0c9\ubcfc\ud39c\ub4e4\uc774 \uc0dd\uac01\ub09c\ub2e4..!!!\uadfc\ub370 \ubaa9\uc18c\ub9ac \ub108\ubb34 \ub9e4\ub825\uc801\uc778\uac70 \uc544\ub2d9\ub2c8\uae4c...",
                    "author": "@TRT_Member_scar",
