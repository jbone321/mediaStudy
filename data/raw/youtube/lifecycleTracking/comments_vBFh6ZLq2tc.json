                },
                {
                    "text": "\u2764\u2764\u2764\u2764",
                    "author": "@\uc724\uc11c-d7wyx",
                    "likes": 0,
                    "publishedAt": "2026-02-28T22:46:08Z"
                },
                {
                    "text": "\uc2dc\uc6d0\ub2d8, \uc774\ud2c0 \ub4a4\uba74 \uc81c\uac00 \uc2dc\uc6d0\ub2d8\uc744 \uc88b\uc544\ud55c \uc9c0 100\uc77c\uc774 \ub3fc\uc694.\ud83c\udf37\ucc98\uc74c\uc5d0\ub294 \uadf8\ub0e5 \ub178\ub798\uac00 \uc88b\uc544\uc11c \ub4e3\uae30 \uc2dc\uc791\ud588\ub294\ub370, \uc5b4\ub290 \uc21c\uac04\ubd80\ud130\ub294 \uc81c \ud558\ub8e8\uc5d0 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc2a4\uba70\ub4e4\uc5b4 \uc788\uc5c8\uc5b4\uc694. \ub4f1\uad50\ud558\uba74\uc11c, \uacf5\ubd80\ud558\ub2e4\uac00 \uc7a0\uae50 \uc26c\ub294 \uc2dc\uac04\uc5d0, \uad1c\ud788 \ub9c8\uc74c\uc774 \ubcf5\uc7a1\ud55c \ub0a0\uc5d0\u2026 \uadf8\ub807\uac8c \uc81c \uc77c\uc0c1 \uc18d\uc5d0 \uc870\uc6a9\ud788 \uc790\ub9ac \uc7a1\uc740 \uac8c \uc2dc\uc6d0\ub2d8 \ub178\ub798\uc600\uc5b4\uc694.\ud83c\udfb8\u2728 \uc774 100\uc77c \ub3d9\uc548 \uc2dc\uc6d0\ub2d8 \ub178\ub798\ub97c \ub4e4\uc73c\uba74\uc11c \ucc38 \ub2e4\uc591\ud55c \uac10\uc815\uc744 \ub290\uaf08\ub358 \uac83 \uac19\uc544\uc694. \uae30\ubd84\uc774 \uc88b\uc740 \ub0a0\uc5d4 \uadf8 \uae30\ubd84\uc774 \ub354 \uc624\ub798 \uac00\uac8c \ud574\uc92c\uace0, \uc870\uae08 \uc9c0\uce58\uac70\ub098 \uc18d\uc0c1\ud55c \ub0a0\uc5d4 \uad1c\ud788 \uc704\ub85c\ubc1b\ub294 \ub290\ub08c\uc774 \ub4e4\uc5c8\uc5b4\uc694.\ud83c\udf3f \uac19\uc740 \ub178\ub798\ub97c \uc5ec\ub7ec \ubc88 \ub4e4\uc5b4\ub3c4 \uc9c8\ub9ac\uc9c0 \uc54a\uace0, \uc624\ud788\ub824 \ub4e4\uc744\uc218\ub85d \ub354 \uc88b\uc544\uc9c0\ub294 \uac8c \uc2e0\uae30\ud588\uc5b4\uc694. \uadf8\ub798\uc11c \uc81c \ud558\ub8e8\uc758 \ubc30\uacbd\uc74c\uc545 \uac19\uc740 \uc874\uc7ac\uc608\uc694.\ud83d\udcad\ud83c\udfb6\n\uadf8\ub9ac\uace0 \ud56d\uc0c1 \ub313\uae00\uc5d0 \ub2f5\ud574\uc8fc\uc154\uc11c \uc815\ub9d0 \uac10\uc0ac\ud574\uc694.\ud83e\udef6 \ub9ce\uc740 \uc0ac\ub78c\ub4e4 \uc911 \ud55c \uba85\uc77c \ud150\ub370\ub3c4, \uadf8 \ud55c \uba85\uc744 \uc18c\uc911\ud558\uac8c \ub300\ud574 \uc8fc\uc2dc\ub294\uac8c \ub290\uaef4\uc838\uc11c \ub354 \uc624\ub798 \uc751\uc6d0\ud558\uace0 \uc2f6\uc5b4 \uc84c\uc5b4\uc694. \ub313\uae00 \ud558\ub098\uc5d0 \ud558\ub8e8 \uae30\ubd84\uc774 \uc88b\uc544\uc9c0\ub294 \uc0ac\ub78c\uc774 \uc5ec\uae30 \uc788\ub2e4\ub294 \uac83\ub3c4 \uaf2d \uc54c\uc544\uc8fc\uc168\uc73c\uba74 \uc88b\uaca0\uc5b4\uc694.\u2601\ufe0f \n\uadf8\ub9ac\uace0 \uac00\ub054\uc740 \u201c\ub0b4\uac00 \uc65c \uc774\ub807\uac8c\uae4c\uc9c0 \uc2dc\uc6d0\ub2d8 \ub178\ub798\ub97c \uc88b\uc544\ud558\uc9c0?\u201d \ud558\uace0 \uc2a4\uc2a4\ub85c \uc0dd\uac01\ud574 \ubcf8 \uc801\ub3c4 \uc788\ub294\ub370, \uacb0\uad6d \ub2f5\uc740 \ud56d\uc0c1 \uac19\uc558\uc5b4\uc694. \uadf8\ub0e5, \uc2dc\uc6d0\ub2d8 \ub178\ub798\uac00 \uc81c \ub9c8\uc74c\uc5d0 \ub2ff\uc558\uae30 \ub54c\ubb38\uc778 \uac83 \uac19\uc544\uc694. \ub9d0\ub85c \uc815\ud655\ud788 \uc124\uba85\ud558\uae30\ub294 \uc5b4\ub835\uc9c0\ub9cc, \ubaa9\uc18c\ub9ac\uc5d0\uc11c \ub290\uaef4\uc9c0\ub294 \uc9c4\uc2ec\uc774 \uc788\uc5b4\uc11c \ub354 \uc624\ub798 \ub4e3\uac8c \ub418\ub294 \uac83 \uac19\uc544\uc694.\ud83c\udfa7\n\uadf8\ub9ac\uace0 \uc2dc\uac04\uc774 \uc9c0\ub098\ub3c4 \ubcc0\ud558\uc9c0 \uc54a\ub294 \uadf8 \ubd84\uc704\uae30, \uadf8 \uac10\uc131 \ub355\ubd84\uc5d0 \ub354 \ubbff\uace0 \ub4e3\uac8c \ub418\ub294 \uac83 \uac19\uc544\uc694. \uc720\ud589\ucc98\ub7fc \uc2a4\uccd0\uac00\ub294 \ub178\ub798\uac00 \uc544\ub2c8\ub77c, \uc81c \uae30\uc5b5 \uc18d\uc5d0 \uc624\ub798 \ub0a8\ub294 \ub178\ub798\ub77c\uc11c \ub354 \uc18c\uc911\ud574\uc694.\ud83e\udd0d \uc2dc\uc6d0\ub2d8 \ub355\ubd84\uc5d0 \uc81c \ud558\ub8e8\ud558\ub8e8\uac00 \uc870\uae08 \ub354 \ub530\ub73b\ud574\uc84c\uc5b4\uc694. \uc2dc\uc6d0\ub2d8 \ub178\ub798\uac00 \ub204\uad70\uac00\uc758 \ud558\ub8e8\ub97c \ubc14\uafb8\uace0 \uc788\ub2e4\ub294 \uac78, \uadf8\ub9ac\uace0 \uadf8 \ub204\uad70\uac00 \uc911 \ud55c \uba85\uc774 \uc800\ub77c\ub294 \uac78 \uaf2d \uae30\uc5b5\ud574 \uc8fc\uc138\uc694.\ud83c\udfb6 \uc81c \ud50c\ub808\uc774\ub9ac\uc2a4\ud2b8 1\ubc88\uc740 \uc5ec\uc804\ud788, \uadf8\ub9ac\uace0 \uc55e\uc73c\ub85c\ub3c4 \uc2dc\uc6d0\ub2d8\uc785\ub2c8\ub2e4.\u2b50\ufe0f\ud83d\udcab\ud83c\udfb5\ud56d\uc0c1 \uc88b\uc740 \ubaa9\uc18c\ub9ac\ub85c \uc88b\uc740 \ub178\ub798 \ub4e4\ub824\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4.\ud83c\udf19\n\n+\uc624\ub9ac \ub108\ubb34 \uadc0\uc5ec\uc6cc\uc694\ud83d\udc25\u263a\ufe0f\ud83d\udc9b",
                    "author": "@janji-12",
                    "likes": 9,
                    "publishedAt": "2026-02-28T10:55:17Z"
                },
                {
                    "text": ",...\u2764",
                    "author": "@\ucf69\ud3210073",
                    "likes": 0,
                    "publishedAt": "2026-03-01T02:02:23Z"
                },
                {
                    "text": "\uc6b0\uc544\u2026 \uc9c4\uc9dc \uc798 \ubd80\ub974\uc2dc\ub124\uc694\u2026 \ubaa9\uc18c\ub9ac\ub3c4 \ub108\ubb34 \uc88b\uace0\u2026.",
                    "author": "@\uc18c\ud53c\uc544_320",
                    "likes": 0,
                    "publishedAt": "2026-02-28T22:22:11Z"
                },
                {
                    "text": "\ub178\ub798 \uc62c\ub824\uc904 \ub54c\ub9c8\ub2e4 \uad1c\ud788 \uc124\ub808\uc694\u2026!\ud83e\udef6\n\uc774 \ub178\ub798 \uc774\ub807\uac8c \ubd80\ub974\uba74 \ubc18\uce59 \uc544\ub2cc\uac00\uc694\u2026?\u2764\ud83d\ude22",
                    "author": "@sori_0303",
                    "likes": 0,
                    "publishedAt": "2026-02-28T12:19:10Z"
                },
                {
                    "text": "\ub460\uce6b\ub460\uce6b",
                    "author": "@dok_Ponyo",
                    "likes": 1,
                    "publishedAt": "2026-02-28T11:06:13Z"
                },
                {
                    "text": "\ud83d\ude43",
                    "author": "@\uc774\uc0ac\uc5d0",
                    "likes": 0,
                    "publishedAt": "2026-02-28T13:10:30Z"
                },
                {
                    "text": "\uc624\ub298 \uc2dc\uc6d0\ub2d8 \uc601\uc0c1 \ubcf4\uae30\uc2dc\uc791\ud55c \ud32c\uc774\uc5d0\uc694 ..! \uc544\ub9c8\n\uc624\ub298 \ubd80\ud130 , \uc2dc\uc6d0\ub2d8\uc744 \uc88b\uc544\ud558\uac8c\ub418\uc9c0.. \uc54a\uc744\uae4c ?\u314e\n\uc2f6\uc5b4\uc694 ! \uc9c4\uc9dc\ub85c \uc624\ub298 \ucc98\uc74c \uc2dc\uc6d0\ub2d8 \uc601\uc0c1\uc744 \ubd24\ub294\ub370\n\uc9c4\uc9dc.. \uc5b4\ub5bb\uac8c \uc774\ub7f0\ubd84\uc774 \uacc4\uc2dc\ub294\uc9c0.. \uc774\uc81c \uc54c\uac8c\ub41c\uac8c\n\ub108\ubb34 \uc18d\uc0c1\ud558\uae30\ub3c4 \ud558\ub354\ub77c\uad6c\uc694.. \uadf8\ub798\ub3c4 \uc601\uc0c1\uc744\ubcf4\ub2c8\n\ub418\uac8c.. \ub178\ub798 \ub4e3\ub294\uac74\ub370 \uc124\ub808\ub354\ub77c\uad6c\uc694..\ud83c\udf37\uc774\ub807\uac8c\n\uc545\uae30 \uc5f0\uc8fc\ud558\uba70 \ub178\ub798\ud558\ub294 \uc0ac\ub78c\uc744 \ub531\ud788 \uc88b\uc544\ud574\ubcf8\uc801\uc774 \n\uc5c6\uc5c8\ub294\ub370 .. \uccab\ubc88\uc9f8\ub85c \uc2dc\uc6d0\ub2d8\uc774 \ub420\uac70 \uac19\uc544\uc694 , \ub9e4\ubc88.. \n\ub531 \ubcf8\uc778 \uc2a4\ud0c0\uc77c\ub85c \uc0c9\ub2e4\ub978 \ub290\ub08c\uc73c\ub85c \ubd88\ub7ec\uc8fc\uc154\uc11c ..\u3160\n\ub354\uc6b1 \ub354 \uae30\uc5b5\uc5d0 \ub0a8\uc544\uc694 ,, \uc81c\uac00 \uc624\ub298 \ud32c\uc774 \ub418\uc5b4\uc11c !\n\uc2dc\uc6d0\ub2d8\uc744 \uc88b\uc544\ud558\uac8c\ub41c\uc9c0 1\uc77c\ucc28\ub77c\uc11c \ub108\ubb34\ub108\ubb34 \ub73b\uae4a\uace0 \n\uae30\ubed0\uc694 ! \uc704\uc5d0\uc11c.. \ub9d0\ud55c\uac83 \ucc98\ub7fc \uc774\ub807\uac8c \uc545\uae30\ub97c \uc5f0\uc8fc\n\ud558\uba70 \ub178\ub798\ub97c \ubd80\ub974\ub294 \uc0ac\ub78c\ub4e4 \uc911\uc5d0 \uc88b\uc544\ud574\ubcf8\uac8c.. \uc624\ub298\uc774 \n\ucc98\uc74c\uc774\uc5d0\uc5d0\uc694 ,, \uc55e\uc73c\ub85c\ub3c4 \ud3c9\uc0dd \uacc4\uc18d \uc88b\uc544\ud560\uac8c\uc694.. ><\n\uc9c4\uc9dc \uc624\ube60 \ub118 \uc0ac\ub791\ud574\uc694  ,,\ud83d\udc97 \uadf8\ub0e5 \uadf8\ub807\ub2e4\uad6c\uc694 ..\ud83e\udd7a \n\uadf8\ub0e5 \uc800\uc758 \uc9c4\uc2ec\uc744 \uc804\ud574\ubd24\uc5b4\uc694 ! \uc624\ub298\ubd80\ud130 \ub9ce\uc774 \uc751\uc6d0\n\ud560\uac8c\uc694 !\ud83c\udf89 \uc55e\uc73c\ub85c\ub3c4 \uac19\uc774 100\uc77c 1000\uc77c\uae4c\uc9c0 ,\n\uac00\ubd05\uc2dc\ub2f9 ..! \uadf8\ub0e5 \uc800\ub97c \uac00\uc838\uc918\uc694 (?) \uc9c4\uc9dc\ub85c ..\u3160 \n\u201c\uc18c\uc728\u201d \uc81c \uc774\ub984\uc744 \uae30\uc5b5\ud574 \uc8fc\uc2dc\uae38..!\u2728 \uc624\ube60\uac19\uc740\n\uc0ac\ub78c\uc774 \ub0a8\uce5c\uc774\uba74 \uc88b\uaca0\uc5b4\uc694 ,, \uc9c4\uc9dc \uc0ac\ub791\ud574\uc694..\ud83e\udef6\n+ \uc2dc\uc6d0\ub2d8 \uc624\ub298 \ud558\ub8e8\ub3c4 \ub108\ubb34 \uc218\uace0 \ub9ce\uc73c\uc168\uc5b4\uc694 !\n\ub530\ub73b\ud558\uac8c \uc798 \uc8fc\ubb34\uc2dc\uae38 \ubc14\ub798\uc694 ,, \ud83c\udf40",
                    "author": "@Y_ui.13",
                    "likes": 3,
                    "publishedAt": "2026-02-28T13:54:44Z"
                },
                {
                    "text": "\uc800\ub294 \ub2e4\uc74c\uc0dd\uc5d4 \uc800 \uae30\ud0c0\ub85c \ud0dc\uc5b4\ub0a0\ub798\uc694",
                    "author": "@opoit33",
                    "likes": 3,
                    "publishedAt": "2026-02-28T13:33:29Z"
                },
                {
                    "text": "\uba4b\uc9c0\uad70",
                    "author": "@\ub958\uc2dc\uc544-k6p",
                    "likes": 0,
                    "publishedAt": "2026-02-28T13:28:45Z"
                },
                {
                    "text": "\ud55c\uad6d \ub3cc\uc544\uc624\uc790\ub9c8\uc790 \ub4e3\ub294 \uc2dc\uc6d0\ub2d8 \ub178\ub798\ub77c\ub2c8,,\ud589\ubcf5\ud574\uc9c0\uae30\ud83e\udee0\uc774\ubc88 \ub178\ub798\ub294 \ucc98\uc74c \ub4e4\uc5b4\ubcf4\ub294\ub370 \uc9f1\uc88b..\ud83c\udfa7\ud83c\udfb5\uc2dc\uc6d0\ub2dd \uc74c\uc0c9\uc5d0 \ub2e4\uc2dc \ubc18\ud574\ubc84\ub824\uc694 \uc9c4\uc9dc\ud83e\udef6\n\uc624\ub298\ub3c4 \uc798 \ub4e3\uace0 \uac00\uc694!!",
                    "author": "@\ub9ac\uc548-g9i",
                    "likes": 0,
                    "publishedAt": "2026-02-28T11:07:12Z"
                },
                {
                    "text": "\uc774\uac8c \uc774\ub807\uac8c \uac10\ubbf8\ub85c\uc6b4 \ub178\ub798\uc600\ub098.. \uac1c\uc88b\ub2e4\uac4d",
                    "author": "@\ud669\uc8fc\uc601-u8x",
                    "likes": 0,
                    "publishedAt": "2026-02-28T11:55:42Z"
                },
                {
                    "text": "\uc624\uc624..! \uc2dc\uc6d0\ub2d8\uc774 \ubd80\ub974\uc2dc\ub2c8\uae4c \ubb54\uac00 \uc0c8\ub85c\uc6b4 \ub178\ub798 \ub290\ub08c\uc774\uc5d0\uc694..!\u314e\u314e\n\uc2dc\uc6d0\ub2d8\uc774 \ubd88\ub7ec\uc8fc\uc2e0 \ubc84\uc804\uc774 \ub354 \uc81c \ucde8\ud56d\uc774\uc5d0\uc694. .\u2764\u2764\n\uadf8\ub9ac\uad6c \ub0a0\uc528\uac00 \ub9ce\uc774 \ub530\ub4ef\ud574\uc84c\ub354\ub77c\uad6c\uc694!\ud83d\ude2e\n\uc2dc\uc6d0\ub2d8 \ub355\ubd84\uc5d0 \uc81c \uc138\uc0c1\uc774 \ub530\ub4ef\ud574\uc9c0\ub294 \ub290\ub08c\uc774\uc5d0\uc694\u314e\u314e\n\uc624\ub298\ub3c4 \uc798\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4!\u2764\u2764",
                    "author": "@zcsglover",
                    "likes": 0,
                    "publishedAt": "2026-02-28T10:36:29Z"
                },
                {
                    "text": "\u3139\u3147 \ub108\ubb34 \uc88b\ub2e4...",
                    "author": "@SKZDAY6ADP",
                    "likes": 0,
                    "publishedAt": "2026-02-28T13:58:57Z"
                },
                {
                    "text": "\ub118 \uc88b\ub2e4",
                    "author": "@lenmo_0",
                    "likes": 0,
                    "publishedAt": "2026-02-28T12:25:03Z"
                },
                {
                    "text": "\ud55c\ub3d9\uc548 \uc54c\uace0\ub9ac\uc998\uc5d0 \uadf8 \uc0bc\uc0c9 \ubcfc\ud39c \ud615\ub2d8\ub4e4(?) \ubc16\uc5d0 \uc548 \ub098\uc628 \uc801\uc774 \uc788\ub294\ub370 \uadf8\ub798\uc11c \uc774 \ub178\ub798\ub9cc \ub4e4\uc73c\uba74 \ucda4\ucdb0\uc57c \ud560 \uac83 \uac19\uc544\uc694\u314b\u314b\ud83e\udee0\ud83e\udee0 \uadf8\ub7f0\ub370 \uc774\ub807\uac8c \uc2dc\uc6d0\ub2d8 \ubc84\uc804\uc73c\ub85c \ub4e4\uc73c\ub2c8 \ub610 \ub2e4\ub978 \ub290\ub08c\uc774\ub124\uc694\u263a\ufe0f\u263a\ufe0f \uc6d0\uace1\uc740 \uc544 \uc2e0\ub098!! \uc774 \ub290\ub08c\uc774\ub77c\uba74 \uc2dc\uc6d0\ub2d8\uc740 \uac10\ubbf8\ub86d\uace0 \uc73c\uc74c~~ \uc2e0\ub098\ub294\uad70~~ \uc774 \ub290\ub08c\uc774\ub784\uae4c!!\ud83d\ude0e\ud83d\ude0e  \ub458 \ub2e4 \ub2e4\ub978 \ub9e4\ub825\uc774\uad70\ub1e8\ud83d\ude09\ud83d\ude09 \uc544\ubb34\ud2bc \uc624\ub298\ub3c4 \uc88b\uc740 \ub178\ub798 \uac10\uc0ac\ud558\uad6c \ub530\ub4ef\ud558\uac8c \uc798\uc790\uc694!!\ud83d\ude34\ud83d\ude34",
                    "author": "@jeii._.12",
                    "likes": 1,
                    "publishedAt": "2026-02-28T14:16:39Z"
                },
                {
                    "text": "\uc624\ub298\ub530\ub77c \uae30\ud0c0 \ubc18\uc8fc\uac00 \ub118 \uc88b\uc740\ub370\uc694\uc624\ud83d\ude2e \uac10\ubbf8\ub85c\uc6b4 \ubaa9\uc18c\ub9ac \uc798 \ub4e4\uc5c8\uc2b4\ub2e4! \uc624\ub9ac\ub450 \uadc0\uc5fd\ub124\uc694\ud83d\ude17",
                    "author": "@ouo_29",
                    "likes": 0,
                    "publishedAt": "2026-02-28T10:50:03Z"
                },
                {
                    "text": "\u3158 \ubaa9\uc18c\ub9ac \ub178\ub798\ub791 \ub108\ubb34 \uc798\ub9de\uc544\uc694",
                    "author": "@\ub85c\ud37c\ub2d8\uae30\ub9cc\ud558\uc9c0\ub9c8\ub77c",
                    "likes": 0,
                    "publishedAt": "2026-02-28T15:50:12Z"
                },
                {
                    "text": "\uc9c4\uc9dc \ubaa9\uc18c\ub9ac\uac00 \u3139\u3148\u3137 \uc190\uc774 \ub108\ubb34 \u3139\u3148\u3137.\n\uadf8\ub0e5 \ub108\ubb34 \ub2e4 \ub808\uc804\ub4dc.. \ub108\ubb34 \uc9c0\ub824.... \ubbf8\ucce4\uc5b4.(p)\n\uadf8\ub0e5 \ub098\ub97c \uac00\uc838\uc694\u3160\u3160\u3160 \ud83d\ude49\ud83e\udef6",
                    "author": "@\uae34\uc720\ub2c8",
                    "likes": 0,
                    "publishedAt": "2026-02-28T12:12:46Z"
                },
                {
                    "text": "\uc624\ub298 \ubbf8\uce5c\uac83\uc544\ub2d9\ub2c8\uaebc.....\u2764\uc624\ub298 \uc9c4\uc9dc \u3139\u3148\u3137\uc778\ub370\uc694....\u2764 \uc624\ub298 \uc800 \uc774\uac70 \uc9c4\uc9dc \ub118 \ub0b4\uac00 \uc2a4\ud0c0\uc77c.....\u2764\uc624\ube60\uac00 \ubd80\ub974\ub2c8\uae4c \uc794\uc794\ud558\uba74\uc11c \uae54\ub054\ud558\uac8c \uc815\ub9ac\ub41c \ub290\ub08c\uc774\ub77c \ub118 \uc870\uc544\uc694..... \uc6d0\ub798 \uc6d0\uace1\uc740 \uc57d\uac04 \uc2dc\ub044\ub7ec\uc6b4 \ub290\ub08c\uc774\uc5c7\ub294\ub370 (\uadf8\uac70\ub300\ub85c \ub9e4\ub825\uc787\uc8e0) \uadfc\ub370 \uc2dc\uc6d0\uc624\ube60\ub77c \uadf8\ub7f0\uac00(?) \ub09c \uc2dc\uc6d0\uc624\ube60\uac00 \ub354 \uc88b\u3147....\uc544\uc774\uac1c \uc544\ub2c8\uc9c0(?) \uc544 \uc5ec\ud2bc (\ud07c\ud07c)\uc2dc\uc6d0\uc624\ube60!! \uc800\ubc88\uc5d0 \uc704\ub85c \ub118\ub118 \uac10\uc0ac\ud588\uc624\uc694!! \ud56d\uc0c1 \ubc1d\uace0 \uc88b\uc740 \ub313\uae00\ub9cc \ub2ec\uc544\uc8fc\uc2dc\ub358 \ubd84\uc774 \uadf8\ub7f0\uba74\ub3c4, \uadf8\ub7f0 \uc2dc\uc808\ub3c4 \uc788\uc73c\uc168\uad6c\ub098 \ud558\ub294 \ub9c8\uc74c\uacfc \uc88b\uc9c0 \ubabb\ud55c \ub0b4\uc6a9\uc774\uc5c8\uc74c\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc815\uc131\uc2a4\ub7fd\uac8c \ub2f5\uae00 \ub2ec\uc544\uc8fc\uc154\uc11c \uc644\uc8e4 \uac10\ub369...\ud83d\ude22 \uc800 \uc9c4\uc9dc \uc6b8\uc5c7\uc796\uc544\uc694\uc624......\u3160\u3161\u3160 \ub118\ub118 \uac10\uc0ac\ud574\uc694\ud83e\udd70\ud83e\udd2d \uc73c\uc73d\u3160 \uc73c\uaddc\u3160(?) \uc624\ube60 \uc800 \uc5b4\uc81c \ud559\uc6d0\uc5d0 4\uc2dc\uac04 \uc788\uc5c8\uc5b4\uc694\uc624.....\uc73c\uc73d\u3160 \uc544\ub2c8 \uc81c\uac00 \ucc99\ucd94\uce35\ub9cc\uc99d\uc774 \uc788\uac70\ub4e0\uc694...? \uc6d0\ub798 \ubcf4\ud1b5 \uc0ac\ub78c\uc740 \ucc99\ucd94\uac00 S\uc790\uace0 \uc800\ub294 \ubc18\ub300 \uc5d0\uc2a4\uc790 \uc778\uac74\ub370 \uadf8\ub798\uc11c 2\uc2dc\uac04\uc774 \ub118\uc5b4\uac00\uba74 \ud5c8\ub9ac\uac00 \ubf40\uac1c\uc9c8\uac83 \uac19\uc740\ub370 \uc624\ub798 \uc549\uc544\uc788\uc5c7\uc5b4\uc11c \uadf8\ub7f0\uc9c0 \u3160 \uc544 \uc9c4\uc9dc \ud5c8\ub9ac \uc9c4\uc9dc \ubf40\uac1c\uc9c8\uac70 \uac19\uc544\uc5ec\uc5b4.....\u3160 \uc0e4\uac08 \uc624\ud0c0\ub85c \ub2e4\ub97c \ub300\u314f\ub85c \uc798\ubabb\ubcf4\ub0c8\ub294\ub370 \ucc57\uc528\uac00 \uc800 \uadc0\uc5fd\ub300\uc694(?) \ubb50\uc9c0 \ud50c\ub7ec\ud305\ud558\ub294\uac74\uac00 \uadfc\ub370 \ub09c \uc774\ubbf8 \uc784\uc790\uc787\ub294\ub370\uc5d0...... \uc2dc\uc6d0\uc624\ube60 \uaec0\ub370\uc5d0....\u2661 \uc544\uc624 \u3147\u3148\u3139. \uc815\ud655\ud788\ub294 \uc624\ube60\uac00 \uc81c\uaebc\uc8e0. \ud0bc\u314b\u314b\ud0bc\u314b\u314b\u314b \uc81c\uac00 \uc800\ubc88\uc5d0 \uc9c4\uc9c0\ud558\uac8c \uac1c\uc18c\ub9ac \uc798\ud55c\ub2e4\uad6c \ud587\uc790\ub098\uc694 \u314b\u314b\u314b \uc544 \ub9de\uc544 \ubcd1 \uac19\uc740\uac70 \ub098\uc640\uc11c \ud558\ub294 \ub9d0\uc778\ub370 \uc2dc\uc6d0\uc624\ube60\ub294 \uac00\uc9c0\uace0 \uacc4\uc2e0 \uacf5\ud3ec\uc99d\uc774\ub098 \ubcd1 \uac19\uc740\uac70 \uc5c6\uc73c\uc138\uc5ec(?) \uc774\ub807\uac8c \ub9d0\ud558\ub2c8\uae4c \uba3c\uac00 \uc774\uc0c1\ud558\uae34\ud55c\ub370. \uc800\ub294 \uc880 \ud2b9\uc774\ud55c\ub370 \uac00\uc9c0\uace0 \uc788\ub294 \uc0ac\ub78c \uaf64\ub9ce\ub354\ub77c\uad6c\uc694?!! \uc77c\ub2e8 \uc800\ub294 \uad6c\ud1a0 \uacf5\ud3ec\uc99d\uc774 \uc788\uad6c\uc694.... \uc2ec\ud574 \uacf5\ud3ec\uc99d\uc774 \uc788\uad6c\uc694.... \uc800 \uc800\uc7a5 \uac15\ubc15\uc99d\ub3c4 \uc788\uc5b4\uc694.... \uadfc\ub370 \uc0dd\uac01\ubcf4\ub2e4 \uad6c\ud1a0 \uacf5\ud3ec\uc99d\uac00\uc9c0\uace0 \uc788\ub294\uc0ac\ub78c \uaf64 \ub9ce\ub354\ub77c\uad6c\uc694....\uc544\uc6b0 \uc800\ub294 \uad6c\ud1a0 \uacf5\ud3ec\uc99d \ubd80\uc815\uae30\ub97c \uac70\uce58\uace0(?) \uc778\uc815\ud588\uc2b4\ub2c8\ub2e4... \uc99d\uc0c1\uc774 \ub108\ubb34 \ub611\uac19\ub354\ub77c\uad6c\uc694.... \uc2dc\uc6d0\ub2d8\uc740 \uc774\ub7f0\uac70 \uc787\uc73c\uc138\uc694....? \uc9c0\uae08\uc740 \uadf8\ub098\ub9c8 \uad1c\ucc2e\uc740\ub370 \uc5b4\ub838\uc744\ub54c \uc800\uc7a5 \uac15\ubc15\uc99d\uc774 \uc9c4\uc9dc \uc2ec\ud588\uc5b4\uc11c \uc5b4\ud6c4;;; \ud83d\ude05 \uadfc\ub370 \uad6c\ud1a0 \uacf5\ud3ec\uc99d\uc740 \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \uc9c0\uc7a5\uc774 \uac08 \uc815\ub3c4\ubaac \uc5b4\uce74\uc8e0.... \uadf8\ub7f0 \uc0c1\ud669\uc774 \uc5c6\uc73c\uba74 \uad1c\ucc2e\uc740\ub370.....\uadf8\ub7f4\uc218 \ub9cc\uc740 \uc5c6\uc73c\ub2c8\uae4c.....\ud760 \uadfc\ub370 \uc9c0\uae08\uae4c\uc9c0 \uc5b4\ucc0c\uc800\ucc0c \ud558\uba74\uc11c \uc798 \uc0b4\uc544\uc653\uc2b4\ub2c8\ub2e4(?)\ud83d\udc4d \uc800 \uc624\ub298 \uc7a0\uc744 5\uc2dc\uac04 \ubc18 \uc7a3\uc5b4\uc694....\u3160\u3160 \uadf8\ub0e5 \uc790\uc9c0 \ub9d0\uaec4(?) \uc800\ub294 \uc560\ub9e4\ud558\uac8c \uc790\uba74 \uc9c4\uc9dc \ud53c\uace4\ud55c \uc2a4\ud0c0\uc77c\uc774\ub77c \uc544\uc608 1\uc2dc\uac04\ub9cc \uc790\uac70\ub098 \uc548\uc790\ub294\uac8c \ud3b8\ud558\ub4dc\ub77c\uad6c\uc694 \uc624\ub298\uc740 \uc560\uba54\ud558\uac8c \uc790\ubc84\ub9bc....!! \uc624\ube60 \ud639\uc2dc \ubcf8\uc5c5\uc774 \uc5b4\ub5bb\uac8c \ub418\uc138\uc694?? \uc548\uc54c\ub824\uc8fc\uc2dc\uace0 \uc2dc\ud504\uba74 \uc548\uc54c\ub824\uc8fc\uc154\ub3c4 \ub311\ub2c8\ub2e4! \uc800...\uc5f0\ud558\ud55c\ud14c \ubc84\ub9bc\ubc1b\uc740\uc370 \ud480\uc5b4\ub4dc\ub9b4\uac8c\uc694(?) \uc9c4\uc9dc \uac1c\uc6c3\uae30\uac70\ub4e0\uc5ec \uc544\ub2c8 \uc81c\uac00 \uce74\ud398\uc5d0\uc11c \uacf5\ubd80\uc911\uc774\uc5c8\ub294\ub370 \uc81c \ud544\ud1b5\uc774 \ub098\uc774\uc5d0 \ub9de\uc9c0\uc54a\uac8c \uc778\ud615\ud544\ud1b5\uc778\ub370(\uc544\uc880\ubd80\ub044\ub7fd\ub124\ud83d\ude33) \uc544\ub2c8 \uac11\uc790\uae30 (\uac54\uac00 \uc606\uc790\ub9ac\uc600\uc74c) \uc81c \ud544\ud1b5\uc744 \ube64\ud788 \ubcf4\ub354\ub2c8 \ub9cc\uc838\ub3c4 \ub3fc\ub0d0\uace0 \uc774\ub7ec\ub294\uac70\uc5d0\uc6ac!!!!!!! \ud5d0 \uadf8\ub798\uc11c \uc5c4\ub9c8\ubbf8\uc18c \uc9c4\uc9dc \ud83d\ude0a\uc774\uac70\ub791 \ub611!\uac19\uc740 \ubbf8\uc18c\ub85c \uc751 \u314e\u314e \ub9ce\uc838\ub3c4 \ub3fc \u314e\u314e \uc774\ub7ec\uba74\uc11c \uac54 \ucabd\uc73c\ub85c \ud544\ud1b5\uc744 \ubc00\uc5b4\uc92c\ub294\ub370 \uae30\uc5fd\uac8c \uaf2c\ubb3c\uac70\ub9ac\uba74\uc11c \ub9cc\uc9c0\ub294 \uac70\uc5d0\uc694!!!!!!!!! \uc9c4\uc9dc \uadf8\ub798\uc18c \ub098\uc774 \ubb3c\uc5b4\ubcf4\uad6c \ubb50 \uc774\ub7f0\uc800\ub7f0 \uc598\uae30 \ud558\ub2e4\uac00 \ub2e4\uc74c\uc5d0\ub3c4 \uc628\ub2e4\ub294\uac70\uc5d0\uc694 \uadf8\ub798\uc18c \ub2e4\uc74c\uc8fc\uc5d0 \ub4e4\ub72c\ub9c8\uc74c\uc73c\ub85c \uac14\ub294\ub370........ \uc624\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.........\uc5f0\ub77d\ub3c4 \ub9cc\ub09c\ub0a0 \ube7c\uace0 \ubc25\uba39\uc5b4\uc57c\ud55c\ub2e4\uace0 \uc870\uae08\uc788\ub2e4\uac00 \ub2e4\uc2dc \uc5f0\ub77d\ud558\uc790\uace0 \ud574\ub193\uace0 \ub2e4\uc74c \uc8fc\ub3c4 \uc548\ub098\uc654\uc2b5\ub2c8\ub2e4......\uadf8\ub807\uac8c 2\uc8fc\ub3d9\uc548 \uc804 \uc5f0\ud558\uc5d0\uac8c \ubc84\ub9bc\ubc1b\uc558\ub2e4\uace0, \uc7a0\uc218\ub2f9\ud588\ub2e4\uace0\u00a0 \uc0dd\uac01\ud558\uace0 \uc624\ub298 \uac14\ub294\ub370 \uc788\ub294\uac70\uc5d0\uc6ac!!!!!!!!!!!!! \uc544 \uc9c4\uc9dc \uc5ec\uc804\ud558 \uc81c \ud544\ud1b5 \ub9cc\uc9c0\uc791\uac70\ub9ac\uad6c\u3160\u3160 \ub118 \uae30\uc5ec\uc6cc\uc11c \ubbf8\uce58\uac2f\uc74c \u3160\u3161\u315c \uac08\ub54c\ub3c4 \uc798\uac00 \ub098\uba3c\uc800 \uac08\uaed8 \uc774\ub7ec\uad6c\u3160\u3160\u3160 \ub0a8\uc790\uc598\uae30\ub97c \uc9c8\ud22c\ub098\uac8c \uc65c \ud558\ub0d0\uad6c\uc694?(\uc2dc\uc6d0\uc624\ube60 \ub9c8\uc74c \ub9d8\ub300\ub85c \ud310\ub2e8\ud574\ubc84\ub9ac\uae30) \uadf8 \uce6d\uad6c \uc5ec\uc790\uac70\ub4e0\uc694 \u314e\u314e \uc544 \uc800 \ub3d9\uc131\uc560\uc790 \uc544\ub2c8\uad6c\uc694(?) \uadf8 \uce5c\uad6c \ub9ce\uc774 \uc5b4\ub824\uc694. \ub124. \ub098\ub791 \uc5f0\uc560\ud560 \ub098\uc774\uac00 \uc544\ub2c8\uc5ec. \ud070\uc77c \ub098. \uace0\ub0e5 \uadf8\uce5c\uad6c\ub294 \uc81c \ud544\ud1b5\uc774 \ub9d8\uc5d0 \ub4e4\uc5c7\uace0 \uc804 \uadf8\uce5c\uad6c\uac00 \uadc0\uc5ec\uc6df\ub358\uac83 \ubfd0\uc785\ub2c8\ub2e4.\ud558\ud558......\ud558....\uc330\uac08. \ub299\uc5c7\ub124\uc694. \uc544\ub2c8 \ub313\uae00 \uc774\uc058\uac8c \ub2ec\uc544\uc8fc\uc2dc\ub294\ubd84 \uc6f0\ucf00 \ub9ce\uc544\uc694.....? \uac11\uc790\uae30 \ub0b4\uac00 \ub108\ubb34 \ub098\ub304\uac83 \uac19\uc74c. \ub2e4\uc74c\ubd80\ud134 \uc608\uc804\uc5d0 \ud558\uc728\ub85c \ub3cc\uc544\uc640\uc11c \uc774\uc05c \ub313\uae00 \ub2ec\uc544\ub4dc\ub9b4\uae68\uc694.\ub2e4\ub4e4 \uc624\ub298\uc774 \uc88b\uc544\ud558\uc2e0\uc9c0 \uba70\uce60\uc774\ub77c\uace0 \ud558\uc2dc\ub358\ub370 \uc624\ub298\uc774 100\uc77c\uc774\uc2e0 \ubd84 \uc788\ub354\ub77c\uad6c\uc694.....\u2665\ufe0f \uc644\uc8e4 \uc758\ubbf8\uc787\ub294 \uc2dc\uac04\uc774\uc2e4\ub4ef\u2665\ufe0f....\uc800\ub294 \uc544\ub9c8\ub3c4 \uace1\ubd80\ud130 \ub313\uae00\uc744 \ub2ec\uc558\ub354\ub77c\uad6c\uc694 \uadf8\ub54c \ub2e4\ub978\uc601\uc0c1\uc744 \ubcf4\ub2e4\uac00 \uc815\uc8fc\ud589,\uc5ed\uc8fc\ud589 \ud587\ub294\ub370 \uacc4\uc0b0\ud574\ubcf4\ub2c8\uae4c \uc624\ub298\uae4c\uc9c0\ud558\uba74 67\uc77c \uc774\ub354\ub77c\uad6c\uc694....\u2665\ufe0f \uc55e\uc73c\ub85c \ub354 \ub9ce\uc774 \uc54c\uc544\uac08 \uae38\uc774 \uc788\uc5c8\uc73c\uba74 \uc88b\uac9f\uad6c.....\uc800 \ubb54\uac00 \ub2e4\ub974\ub2e4\uace0 \ub290\uaf07\ub294\ub370 \uc81c \ubd80\uc871\ud55c \uc74c\uc545\uc801 \uc2dc\uac01\uacfc \uc5b4\ud718\ub825\ub54c\ubb38\uc5d0 \ub300\ucda9 \ubc1c\uc131\ubc95 \ubc14\ub00c\uc167\ub0d0\uace0 \ubb3c\uc5b4\ubd23\uc744\ub54c \ub9de\ucdb0\uc11c \uac31\uc7a5\ud788 \ub180\ub78f\ub358.....!! \ud83d\ude33 \uc2dc\uc6d0\ub2d8 \ubaa9\uc18c\ub9ac\uc0c1\ud0dc \uccb4\ud06c\ud558\ub294 \uad6c\ub3c5\uc790 \uc5b4\ub5a4\ub370 \u314b\u314b\u314b\u314e\u314b\u314e\u314b\u314e\u314e \ub9e4\ub2c8\uc800 \uc548\ud544\uc694\ud558\uc138\uc5ec \uc800 \ub2f9\uc7a5 \ub2ec\ub824\uac08\uaed8\uc694. \u314b\u314b\u314e\u314b\u314e\u314e\u314b \uc544 \uc624\ub298 \uc880 \uae34\uac00....\uc544\ub2cc\uac00....\uc624\ub298 \uc8fc\uc811 \ub4e4\uc5b4\uc8fc\uc154\uc11c \uac10\uc0ac\ud574\uc694\ud83d\udc9b....\ub2e4\uc74c\uc5d4 \uc8fc\uc811\ube7c\uace0 \ucd08\ubc18\uc758 \ud558\uc728\ub85c \ub3cc\uc544\uc640\uc11c \uc0ac\ub791\ub9cc \uac00\ub4dd \uafb9\uafb9 \ub20c\ub7ec\uc11c \ud55c\ubc14\uac00\uc9c0 \ub4e4\uace0\uc63f\uac8c\uc6a9....\u2665\ufe0f \uc624\ube60 \uc55e\uc73c\ub85c \uc6b0\ub9ac \uc55e\uc73c\ub85c \ub354 \ub9ce\uc774, \uc790\uc8fc \ub9cc\ub098\uc694.....\u2665\ufe0f \uc624\ube60....\uc0ac\ub791..\ud569\ub2c8\ub2e4...\uadf8\ub0e5 \uadf8\ub807\ub2e4\uad6c\uc694....\ud83d\ude33\u2665\ufe0f",
                    "author": "@\uc720\ub9ac0607",
                    "likes": 5,
                    "publishedAt": "2026-02-28T12:31:56Z"
                },
                {
                    "text": "\uc624\ub298\uc740 \uccab\ubc88\uc9f8\ub85c \uc654\uc5b4\uc694!!\ud5e4\ud5e4\noddloop\ub124\uc694!!\ud83d\ude33\n\uc5c4\uccad \uc2e0\ub098\ub294 \ub178\ub798\ub3c4 \uc774\ub807\uac8c\n\uc794\uc794\ud558\uace0 \uac10\ubbf8\ub85c\uc6b4 \ub178\ub798\ub85c\ub3c4\n\ubc14\ub014 \uc218 \uc788\ub294\uac70\uc600\uad70\uc694..\ud83d\ude16\ud83e\udd0d\n\uc9c4\uc9dc \ub118 \uc88b\uc544\uc694..\ud83d\udcab\n\uc800\ub141\uc5d0\uc11c \uc0c8\ubcbd \uc0ac\uc774\uc5d0\n\ub4dc\ub294 \uc0dd\uac01\uacfc \uac10\uc815\uc744 \ud45c\ud604\ud55c \ub4ef\ud55c\n\ub290\ub08c\uc774\ub784\uae4c\uc694..\ud83e\udd14\n\uc9c4\uc9dc \uc2dc\uc6d0\ub2d8\uc740 \ub9e4\ubc88 \ubcf8\uc778\ub9cc\uc758\n\uc2a4\ud0c0\uc77c\ub85c \uace1\uc744 \ud574\uc11d\ud558\uace0\n\uc0c9\ub2e4\ub974\uac8c \ubc14\uafd4\uc11c \ucee4\ubc84\ud574\uc8fc\uc2dc\ub294\uac8c\n\ub118 \uc88b\uc544\uc694..\u2728\ufe0f \uc5c4\uccad \ud2b9\ubcc4\ud558\ub2ec\uae4c\uc694\ud83e\udd7a\n\ub2e4\ub978 \ucee4\ubc84\uc5d0\uc11c\ub294 \ub290\ub084 \uc218 \uc5c6\ub294\n\uac10\uc131\uacfc \ubaa9\uc18c\ub9ac\uac00..\uc9c4\uc9dc..\n\uacc4\uc18d \ub1cc\uc5d0 \uba64\ub3cc\uc544\uc694..\u263a\ufe0f\n\uc548 \uc88b\uc544\ud560 \uc218\uac00 \uc5c6\ub294 \uc2dc\uc6d0\ub2d8..\u2728\ufe0f\n\uc624\ub298\ub3c4 \ub118 \uc798 \ub4e3\uace0 \uac00\uc694!\ud83e\udd2d\ud83e\udd0d",
                    "author": "@piece._.10",
                    "likes": 0,
                    "publishedAt": "2026-02-28T10:34:49Z"
                },
                {
                    "text": "\ucd5c\uadfc\uc5d0 \uc778\uc2a4\ud0c0 \ub9cc\ub4e4\uc5b4\uc11c \uac00\uc7a5 \uba3c\uc800 \uc2dc\uc6d0\ub2d8 \ud314\ub85c\uc6b0\ud588\uc5b4\uc694\ud5ff\ud5e4 \uae30\ud0c0\ub9d0\uace0 \ub2e4\ub978 \uc57d\uac04 \ub2e4\ub978 \ub958\uc758 \uc601\uc0c1\ub3c4 \uc62c\ub824\uc8fc\uc2e4\uc218\uc788\ub098\uc694??\ubb3c\ub860 \ubb58 \ud574\ub3c4 \ub108\ubb34 \uc88b\uc9c0\ub9cc\uc6a9\u2764\ud56d\uc0c1 \ub178\ub798 \ub108\ubb34 \uc798\ub4e3\uace0\uc788\uc5b4\uc694!!\u2764\u2764",
                    "author": "@\uae40\uc608\uc9c0-r1f",
                    "likes": 0,
                    "publishedAt": "2026-02-28T14:57:25Z"
                },
                {
                    "text": "\uc544\ub2c8 \uc800\uae30 \uc624\ub9ac \ubb50\uc5d0\uc694\u2026.// \ub108\ubb34 \uadc0\uc5fd\uc796\uc544\uc694//",
                    "author": "@strawberrycat-c2m",
                    "likes": 0,
                    "publishedAt": "2026-03-01T04:03:59Z"
                }
            ]
        }
