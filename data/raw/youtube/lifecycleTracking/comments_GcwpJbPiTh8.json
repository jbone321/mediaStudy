                    "publishedAt": "2026-04-07T09:08:50Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u0430  \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u044f  \u043f\u0435\u0441\u043d\u044f  \u043a\u043b\u0430\u0441\u0441\ud83c\udf89",
                    "author": "@\u0422\u0430\u0442\u044c\u044f\u043d\u0430-\u04461\u04333\u0445",
                    "likes": 0,
                    "publishedAt": "2026-04-07T18:42:42Z"
                },
                {
                    "text": "\u041a\u0440\u0430\u0441\u0438\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f.  \u041b\u044e\u0431\u043e\u0432\u044c \u0438 \u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u0440\u043e\u0437\u044b, \u0441\u0442\u0440\u0430\u0441\u0442\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c.\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83c\udf39\ud83c\udf39",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u0410\u043b\u0435\u043a\u0441\u0435\u0435\u0432\u0430-\u043b5\u0433",
                    "likes": 0,
                    "publishedAt": "2026-04-07T14:29:44Z"
                },
                {
                    "text": "\u041e\u0447\u0435\u043d\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u043e \u0441\u043d\u044f\u0442 \u0440\u043e\u043b\u0438\u043a.\n\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u0439 \u0431\u0443\u043a\u0435\u0442 \u0440\u043e\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u0435\u0442\n\u0432\u0435\u0441\u044c \u043f\u043e\u0440\u0442\u0440\u0435\u0442. \u041f\u0435\u0441\u043d\u044f \u0441\u0443\u043f\u0435\u0440.",
                    "author": "@\u042f\u043d\u0430\u041c\u0435\u0434\u0438\u043d\u0441\u043a\u0430\u044f",
                    "likes": 0,
                    "publishedAt": "2026-04-07T11:25:12Z"
                },
                {
                    "text": "\u2764\ud83c\udf89\u2764\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e \u0432\u0430\u0441 \u0437\u0430\u2764\u2764\u0447\u0443\u0434\u0435\u0441\u043d\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u0438 \u0420\u043e\u0437\u044b\u2764\u2764\u2764\ud83c\udf89\u2764\u2764\ud83c\udf89\u2764\u2764\ud83c\udf89\u2764\u2764",
                    "author": "@\u041d\u0410\u0422\u0410\u041b\u042c\u042f-\u043f8\u044f8\u044d",
                    "likes": 0,
                    "publishedAt": "2026-04-07T17:46:23Z"
                },
                {
                    "text": "\u041f\u0415\u0421\u041d\u042f. \u0421\u0423\u041f\u0415\u0420 \ud83d\udc83\ud83d\udc4b\ud83c\udf3a\ud83c\udf3a\ud83d\udd25\ud83e\udef5\ud83d\udc4c\ud83d\udc4d",
                    "author": "@\u041b\u044e\u0431\u0430\u041f\u0430\u0432\u043b\u0435\u043d\u043a\u043e",
                    "likes": 0,
                    "publishedAt": "2026-04-07T08:48:13Z"
                },
                {
                    "text": "\u041a\u043b\u0430\u0441\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f",
                    "author": "@AlinaBagmanyn",
                    "likes": 0,
                    "publishedAt": "2026-04-08T07:22:33Z"
                },
                {
                    "text": "\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u2764\u2764\u2764\u2764\u2764\u2764\u2764",
                    "author": "@\u041e\u043b\u044c\u0433\u0430\u0414\u0432\u043e\u0440\u0430\u043a-\u044a5\u044c",
                    "likes": 0,
                    "publishedAt": "2026-04-07T10:58:33Z"
                },
                {
                    "text": "\u041f\u0440\u0438\u0432\u0435\u0442\u0438\u043a. \u041b\u044e\u0431\u043e\u0432\u044c. \u0421. \u041f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0437\u0433\u043b\u044f\u0434\u0430. \u0414\u0430\u0440\u0443\u0435\u043c\u0430\u044f. \u0412\u0441\u0435\u0432\u044b\u0448\u043d\u0438\u043c. \u0410. \u0415\u0441\u043b\u0438. \u042d\u0442\u043e. \u0412\u0437\u0430\u0438\u043c\u043d\u0430\u044f. \u042d\u0442\u043e. \u0421\u0443\u043f\u0435\u0440. \ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\ud83d\ude4f\u2665\ufe0f\u2665\ufe0f\u2665\ufe0f",
                    "author": "@\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d\u0430\u041d\u043e\u0436\u0435\u0432\u043d\u0438\u043a\u043e\u0432\u0430-\u04476\u0445",
                    "likes": 0,
                    "publishedAt": "2026-04-07T11:53:27Z"
                },
                {
                    "text": "\u0416\u0430\u043b\u044c \u0447\u0442\u043e \u043c\u043e\u043b\u043e\u0434\u044b\u0435 \u0433\u043e\u0434\u044b \u0443\u0431\u0435\u0436\u0430\u043b\u0438 \u0432 \u0434\u0430\u043b\u044c \u0438 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043b\u044e\u0431\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u043c \u043c\u043e\u043b\u043e\u0434\u044b\u043c \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435\u043c. \u0418 \u0440\u0430\u0434\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u043d\u0438\u0445 \u0438 \u0436\u0435\u043b\u0430\u0442\u044c \u0438\u043c \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u043e\u0439 \u0441\u0443\u0434\u044c\u0431\u044b \u0438 \u043c\u0438\u0440\u0430 \u043d\u0430\u0434 \u0433\u043e\u043b\u043e\u0432\u043e\u0439. \u041d\u0430\u0448\u0438 \u0433\u043e\u0434\u044b \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043e\u0434\u043d\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435.",
                    "author": "@\u041d\u0430\u0434\u0435\u0436\u0434\u0430\u041a\u043e\u0441\u0442\u044e\u043a-\u043f8\u043a",
                    "likes": 0,
                    "publishedAt": "2026-04-07T09:07:46Z"
                },
                {
                    "text": "\u0417\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f.",
                    "author": "@\u041c\u0430\u0440\u0433\u0430\u0440\u0438\u0442\u0430-\u043a8\u043f4\u0448",
                    "likes": 1,
                    "publishedAt": "2026-04-07T10:14:32Z"
                },
                {
                    "text": "\u041e\u0431\u044f\u0437\u0430\u043d\u044b \u0432\u0441\u0435 \u0434\u0435\u043b\u0430\u0442\u044c \u0434\u043e\u0431\u0440\u043e \u0443\u043b\u044b\u0431\u043a\u043e\u0439. \u041f\u0435\u0432\u0435\u0446 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a  \u043e\u043d \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0432\u043c\u0435\u0441\u0442\u0435 \u0432\u0441\u0435\u0445 \u043d\u0430\u0440\u043e\u0434\u043e\u0432 \u0441\u043b\u0443\u0448\u0430\u0439\u0442\u0435\u2764\u2764\u2764\u2764",
                    "author": "@ERNA78-r1d",
                    "likes": 0,
                    "publishedAt": "2026-04-07T14:08:04Z"
                },
                {
                    "text": "\u0421\u0443\u043f\u0435\u0440! \ud83d\ude2d",
                    "author": "@\u0418\u0440\u0438\u043d\u0430\u0421\u0438\u043d\u044f\u043a\u043e\u0432\u0430-\u04438\u0436",
                    "likes": 0,
                    "publishedAt": "2026-04-07T08:59:32Z"
                },
                {
                    "text": "\u041f\u0435\u0441\u043d\u044f \u0448\u0435\u043a\u0430\u0440\u043d\u0430\u044f \u0431\u0443\u043a\u0435\u0442 \u0440\u043e\u0437\u0438 \u043b\u044e\u0431\u043e\u0432\u044c \u043e\u0433\u043e\u043d\u044c \u043b\u044e\u0431\u0432\u0438 \u2764 \u0434\u043e\u0447\u044c \u043d\u0435\u0431\u0435\u0441\u043d\u0430\u044f \u0441\u0432\u0435\u0442\u043b\u0430\u043d\u0430",
