                },
                {
                    "text": "\u6700\u5f8c\u767d\u3044\u888b\u307f\u305f\u3044\u306e\u3092\u3044\u3063\u3071\u3044\u4ed8\u3051\u3066\u308b\u306e\u306f\u4f55\u3067\u3057\u3087\u3046\u304b",
