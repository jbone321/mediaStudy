                },
                {
                    "text": "\u3053\u306e\uff13\u6bb5\u7532\u677f\u3092\u5168\u901a\u306b\u6539\u88c5\u3057\u3066\u3044\u308b\u9593\u306b\u65e5\u4e2d\u6226\u4e89\u304c\u52c3\u767a\u3057\u3066\u3001\u6226\u4e89\u5e8f\u76e4\u306b\u6d3b\u8e8d\u3057\u305f\u306e\u306f\u5148\u306b\u5168\u901a\u5b8c\u4e86\u3057\u3066\u3044\u305f\u52a0\u8cc0\u3060\u3063\u305f\u3068\u3044\u3046\u306e\u304c\u7121\u5ff5\u306a\u3068\u3053\u308d\u3002",
                    "author": "@\u9dc2\u3088\u3081\u306a\u3044\u3068\u308a",
                    "likes": 0,
                    "publishedAt": "2026-03-29T06:28:52Z"
                },
                {
                    "text": "2\u6bb5\u76ee\u306f\u4e3b\u7832\u5854\u3068\u30b4\u30f3\u30c9\u30e9\u5f0f\u8266\u6a4b\u306e\u9699\u9593\u304b\u3089\u51fa\u308b\u8a33\u3067\u3057\u3087\u3002\u6c17\u6d41\u306f\u8352\u308c\u305d\u3046\u3060\u3057\u7d76\u5bfe\u7684\u306b\u77ed\u3059\u304e\u308b\u3057\u3001\u3053\u306e\u5f62\u306e\u307e\u307e\u3060\u3063\u305f\u3089\u300cSuicide deck\u300d\u3068\u304b\u547c\u3070\u308c\u305f\u3093\u3060\u308d\u306a\u3002",
                    "author": "@ybb-papa",
                    "likes": 0,
                    "publishedAt": "2026-03-29T11:46:58Z"
                },
                {
                    "text": "\u4e00\u679a\u767a\u7740\u7532\u677f\u3082\u30a2\u30f3\u30b0\u30eb\u30c9\u30c7\u30c3\u30ad\u3082\u30a4\u30ae\u30ea\u30b9\u306a\u3093\u3060\u3088\u306a\u3042\u3002",
