                    "text": "\u3082\u3046\u5c11\u3057\u3001\u98db\u884c\u7532\u677f\u306e\u88dc\u5f37\u3092\u3059\u308c\u3070\u30015\u30c8\u30f3\u3092\u8d85\u3059\u65b0\u578b\u6a5f\u4f53\u3092\u904b\u7528\u3067\u304d\u305f\u304b\u3082\u3057\u308c\u306a\u3044\u3002",
