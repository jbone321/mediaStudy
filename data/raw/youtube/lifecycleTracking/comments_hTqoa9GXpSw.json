                },
                {
                    "text": "\u4eca\u306a\u30892\u6bb5\u7a7a\u6bcd\u4f5c\u308c\u308b\u304b\u3082\u306d",
                    "author": "@\u6cb3\u91ce\u62d3\u54c9-x6q",
