                {
                    "text": "\u307f\u3093\u306a\u304c\u6301\u3063\u3066\u308b\u30bf\u30aa\u30eb\u304c\u305d\u308c\u305e\u308c\u4eca\u307e\u3067\u306e\u30e9\u30a4\u30d6\u306e\u30de\u30d5\u30e9\u30fc\u30bf\u30aa\u30eb\u306a\u306e\u597d\u304d\uff01",
