            "commentCount": 18,
            "comments": [
                {
                    "text": "\u041f\u0440\u0438\u044f\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0438 \u043e\u0442 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430",
                    "author": "@komissartv",
                    "likes": 12,
                    "publishedAt": "2026-05-01T08:41:25Z"
                },
                {
                    "text": "\u0421\u043f\u043e\u0441\u0438\u0431\u043e. \u0421\u0447\u0430\u0441\u0442\u044c\u044f \u0432\u0430\u043c. \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e.",
                    "author": "@\u0410\u0440\u043c\u0430\u043d\u0418\u043b\u044c\u044f\u0441\u043e\u0432-\u04424\u0443",
                    "likes": 3,
                    "publishedAt": "2026-05-03T08:47:43Z"
                },
                {
                    "text": "\u0421\u041f\u0410\u0421\u0418\u0411\u041e \u0412\u0410\u041c \u2764\u2764\u2764\u2764",
                    "author": "@\u041e\u043a\u0441\u0430\u043d\u0430\u0413\u043e\u043b\u043e\u0431\u043e\u0440\u043e\u0434\u044c\u043a\u043e-\u04408\u0444",
                    "likes": 3,
                    "publishedAt": "2026-05-03T06:36:17Z"
                },
                {
                    "text": "\u041a\u043e\u043c\u0438\u0441\u0441\u0430\u0440 - \u044d\u0442\u043e \u0433\u0440\u0443\u043f\u043f\u0430 \u0432\u043d\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.",
                    "author": "@\u0421\u0435\u0440\u0433\u0435\u0439\u0424\u0440\u0430\u043d\u0438\u0447",
                    "likes": 1,
                    "publishedAt": "2026-05-03T11:38:36Z"
                },
                {
                    "text": "\u0410 \u0442\u0435\u043f\u0435\u0440\u044c \u0442\u044b \u043d\u0435\u0436\u043d\u0430\u044f - \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430 \u0441\u043d\u0435\u0436\u043d\u0430\u044f...",
                    "author": "@\u0415\u0432\u0433\u0435\u043d\u0438\u0439-\u044e9\u04489\u0444",
                    "likes": 5,
                    "publishedAt": "2026-05-01T14:40:04Z"
                },
                {
                    "text": "\u0412\u0430\u043c \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443  \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0442\u0430\u0445 \u0432\u0438\u0434\u0435\u043e! \u2764\u2764\u2764\u2764\u2764 \u0412\u0441\u0451 \u0437\u0434\u043e\u0440\u043e\u0432\u043e, \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u043e, \u044d\u043d\u0435\u0440\u0433\u0438\u0447\u043d\u043e - \u0437\u0430\u0436\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e!  \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0412\u0410\u041c!!!! \ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udc8b\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83e\udd17\ud83e\udd17\ud83e\udd17\ud83e\udd17\ud83e\udd17\ud83e\udd17\ud83e\udd17 \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u044f, \u043d\u043e\u0432\u044b\u0445 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0439, \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0430\u043d\u0438\u0439 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439!!!!!!",
                    "author": "@\u0410\u043b\u0451\u043d\u0430-\u043c\u0438\u0440\u0432\u0430\u043c",
                    "likes": 1,
                    "publishedAt": "2026-05-04T08:35:40Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u044c \u044d\u0445... \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0441\u043b\u0443\u0448\u0430\u044e \u0441\u0438\u0434\u0438 \u0434\u0438\u0441\u043a\u0438.\ud83d\ude02",
                    "author": "@\u0410\u043d\u0434\u0440\u0435\u0439\u0411\u0430\u0439\u043a\u0430\u043b\u043e\u0432-\u04437\u0441",
                    "likes": 9,
                    "publishedAt": "2026-05-01T11:34:40Z"
                },
                {
                    "text": "\u0421 1 \u043c\u0430\u044f \u0432\u0441\u0435 \u043c\u044b \u043f\u043e\u0441\u0442\u043e\u0440\u0435\u043b\u0438, \u043d\u043e \u043c\u044b \u0443\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0430\u0448\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0435 \u043c\u044b\u0436 \u0431\u043e\u043b\u0434\u0435\u043b\u0438 \u0432\u0441\u0435\u043c\u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435, \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u2764",
                    "author": "@AndrejMakarewitsch-f1u9i",
                    "likes": 3,
                    "publishedAt": "2026-05-01T20:18:00Z"
                },
                {
                    "text": "\u041a\u043e\u043c\u0438\u0441\u0441\u0430\u0440\u2764\u2764",
                    "author": "@\u0412\u0435\u0440\u043e\u043d\u0438\u043a\u0430\u042f\u0440\u0430\u043d\u0446\u0435\u0432\u0430-\u04498\u043b",
                    "likes": 4,
                    "publishedAt": "2026-05-01T17:37:20Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0430\u0448\u0438 \u043f\u0435\u0441\u043d\u0438...\u044d\u0442\u043e \u043c\u043e\u044f \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u044c\u2764",
                    "author": "@Zloy_Saxa-888",
                    "likes": 10,
                    "publishedAt": "2026-05-01T08:53:54Z"
                },
                {
                    "text": "\u0412\u044b \u043b\u0443\u0447\u0448\u0438\u0435... \u0441\u043b\u0443\u0448\u0430\u044e \u0432\u0430\u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u2764....\u0436\u0430\u043b\u044c \u0432\u044b \u0432 \u041b\u0430\u0442\u0432\u0438\u044e \u043d\u0438 \u0435\u0434\u0438\u0442\u0435 \ud83d\ude22",
                    "author": "@proviteljstvoderjmo",
                    "likes": 2,
                    "publishedAt": "2026-05-01T18:01:46Z"
                },
                {
                    "text": "\u041f\u043e\u0441\u0442\u0430\u0440\u0435\u043b \u041b\u0451\u0445\u0430, \u043f\u043e\u0441\u0442\u0430\u0440\u0435\u043b. \u041d\u043e \u0435\u0433\u043e \u043f\u0435\u0441\u043d\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044e\u0442 \u043c\u0435\u043d\u044f \u0432 \u044e\u043d\u043e\u0441\u0442\u044c.",
                    "author": "@SsD407VZ",
                    "likes": 2,
                    "publishedAt": "2026-05-01T17:53:38Z"
                },
                {
                    "text": "\u041a\u043e\u043a\u043e\u0439 \u043f\u0435\u0441\u043d\u044f\u2764",
                    "author": "@\u0441\u044b\u0440-\u04342\u044b",
                    "likes": 2,
                    "publishedAt": "2026-05-01T21:12:37Z"
                },
                {
                    "text": "\u0421\u0443\u043f\u0435\u0440\u0441\u043a\u0430\u044f \u0432\u0438\u0434\u0435\u043e\u043e\u0431\u0437\u043e\u0440\u043e\u0447\u043a\u0430! \u041a\u043e\u043d\u0446\u0435\u0440\u0442 \u0432 \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u0445. \u0418 \u0443\u0436\u0415 \u0435\u0441\u0442\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0447\u0442\u043e \u0438 \u043a\u0430\u043a \u0431\u044b\u043b\u043e \ud83d\udc4d\ud83d\udc4d\ud83d\udc4d",
                    "author": "@liudmilaguskova",
                    "likes": 1,
                    "publishedAt": "2026-05-03T15:59:29Z"
                },
                {
                    "text": "\u0414\u0438\u0441\u043a\u043e \ud83d\udd7a\ud83d\udd7a\ud83d\udd7a\u043a\u0430\u043a \u0432\u0441\u043f\u043e\u043c\u043d\u044e \u0441\u0432\u043e\u044e \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u044c\ud83d\ude0e\ud83e\udd23, \u0441\u043f\u0430\u0441\u0438\u0431\u043e, \u041a\u0430\u043c\u0438\u0441\u0430\u0440,\u044d\u0442\u0438 \u043f\u0435\u0441\u043d\u0438 \u043c\u0430\u0448\u0438\u043d\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442 \u0432\u0441\u0435\u0445 \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u0432 90\u044b\u0435",
                    "author": "@\u0442\u0443\u0440\u043e\u043f-\u043c\u044d\u043d",
                    "likes": 2,
                    "publishedAt": "2026-05-01T22:16:04Z"
                },
                {
                    "text": "\ud83d\udcaf\ud83d\udc4d\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f",
                    "author": "@\u0413\u0435\u043e\u0440\u0433\u0438\u0439-\u044e8\u04324\u0443",
                    "likes": 3,
                    "publishedAt": "2026-05-01T09:14:45Z"
                },
                {
                    "text": "\u041d\u0435 \u0432\u0438\u0434\u0435\u043b \u0435\u0433\u043e \u0440\u0430\u043d\u044c\u0448\u0435..",
                    "author": "@\u0414\u043c\u0438\u0442\u0440\u0438\u0439\u0418\u0432\u0430\u043d\u043e\u0432-\u04361\u04343\u0432",
                    "likes": 1,
                    "publishedAt": "2026-05-01T18:01:39Z"
                },
                {
                    "text": "\u041c\u044b \u0436\u0438\u043b\u0438 \u0441\u0441\u0441\u0440 \u0437\u043d\u0430\u0435\u043c \u044d\u0442\u043e\u043c\u0443 \u043f\u0435\u0441\u043d\u044f \ud83d\udcaf",
