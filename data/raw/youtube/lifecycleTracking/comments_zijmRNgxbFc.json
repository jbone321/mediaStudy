                },
                {
                    "text": "\ud83d\udcaf\ud83d\udc4d\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f",
                    "author": "@\u0413\u0435\u043e\u0440\u0433\u0438\u0439-\u044e8\u04324\u0443",
                    "likes": 2,
                    "publishedAt": "2026-05-01T09:14:45Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0430\u0448\u0438 \u043f\u0435\u0441\u043d\u0438...\u044d\u0442\u043e \u043c\u043e\u044f \u043c\u043e\u043b\u043e\u0434\u043e\u0441\u0442\u044c\u2764",
                    "author": "@Zloy_Saxa-888",
                    "likes": 2,
                    "publishedAt": "2026-05-01T08:53:54Z"
                },
                {
                    "text": "\u041e\u0425\u0445\u0445\u0445, \u043a\u0430\u043a\u0430\u044f \u0442\u0451\u043f\u043b\u0430\u044f \u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0447\u043a\u0430 \u0432\u0438\u0434\u043e\u0441\u0438\u043a\u043e\u0432\u203c\ufe0f\ud83e\udda2\ud83d\udc07\ud83e\udda2\ud83d\udc07\ud83e\udda2\ud83d\udc07\ud83d\udd4a\ud83d\udd4a\ud83d\udd4a\ud83d\udd4a\ud83d\udc26\u200d\ud83d\udd25\ud83e\udd9c\ud83d\udc26\u200d\ud83d\udd25\ud83e\udd9c\ud83c\udf1e\ud83c\udf1e\ud83c\udf1e\ud83c\udf1e\n\u042d\u0442\u043e \u0432\u044b \u0432 \u0447\u0435\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043a\u0430 \u0440\u0435\u0448\u0438\u043b\u0438 \u043d\u0430\u0441 \u043f\u043e\u0431\u0430\u043b\u043e\u0432\u0430\u0442\u044c\u2049\ufe0f\u2764\ufe0f\u200d\ud83d\udd25\u2764\ufe0f\u200d\ud83e\ude79\ud83d\udc94\u2763\ufe0f\ud83d\udc94\u2763\ufe0f\ud83d\udc94\n\u0410\u0430\u0430\u0430... \u041f\u043e\u043d\u044f\u0442\u043d\u0435\u043d\u044c\u043a\u043e... \u042d\u0442\u043e \u0442\u044b \u0438\u043c\u0435\u043b \u0432 \u0432\u0438\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u043b: \" \u043d\u0435 \u0432\u0441\u0451 \u0441\u0440\u0430\u0437\u0443 \"... \u041e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u0442\u0435\u0431\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c,  \u0442\u044b \u0441\u0434\u0435\u043b\u0430\u043b \u041c\u043e\u0439 \u0414\u0435\u043d\u044c , \u0434\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u044e\u0434\u0435\u0439 \u0442\u043e\u0436\u0435. \n \u2600\u2600\u2600\u2600\u2600\u2600  \u042d\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u203c\ufe0f\u203c\ufe0f\u203c\ufe0f\u203c\ufe0f",
                    "author": "@\u0415\u043b\u0435\u043d\u0430\u0421\u043e\u043b\u043d\u0435\u0447\u043d\u0430\u044f55555",
                    "likes": 2,
