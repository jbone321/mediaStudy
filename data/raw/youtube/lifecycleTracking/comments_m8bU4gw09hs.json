                {
                    "text": "\u0986\u09af\u09bc\u09be\u09a4\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0996\u09be\u09ae\u09c7\u09a8\u09bf\u09b0  \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a4\u09c7 \u0995\u09c7 \u0995\u09c7 \u0995\u09b7\u09cd\u099f \u09aa\u09c7\u09af\u09bc\u09c7\u099b\u09c7\u09a8 \ud83d\ude22",
                    "author": "@BDSamim-g2n5k",
                    "likes": 120,
                    "publishedAt": "2026-03-01T08:54:04Z"
                },
                {
                    "text": "\u0987\u09b0\u09be\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c0 \u0986\u09af\u09bc\u09be\u09a4\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0996\u09be\u09ae\u09c7\u09a8\u09bf\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a4\u09c7 \u0995\u09b7\u09cd\u099f \u09aa\u09c7\u09df\u09c7\u099b\u09c7\u09a8, \u09a4\u09be\u09a6\u09c7\u09b0 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0987, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09c7\u09a8 \u09a4\u09be\u0995\u09c7 \u09ac\u09c7\u09b9\u09c7\u09b8\u09cd\u09a4 \u09a8\u09b8\u09bf\u09ac \u0995\u09b0\u09c7\u09a8 \u0986\u09ae\u09bf\u09a8",
                    "author": "@alauddinkazi6542",
                    "likes": 1085,
                    "publishedAt": "2026-03-01T06:31:48Z"
                },
                {
                    "text": "\u099f\u09cd\u09b0\u09be\u09ae\u09cd\u09aa \u0993 \u09a8\u09c7\u09a4\u09be\u09a8\u09bf\u09df\u09be\u09b9\u09c1 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u0995\u09c7 \u0995\u09c7 \u0995\u09be\u09ae\u09a8\u09be \u0995\u09b0\u09c7\u09a8\u0964",
                    "author": "@ebadali9372",
                    "likes": 103,
                    "publishedAt": "2026-03-01T07:15:20Z"
                },
                {
                    "text": "\u09ac\u09be\u09ac\u09be\u09b0 \u0985\u09ad\u09bf\u09a8\u09df \u09a6\u09c7\u0996\u09c7 \u0995\u09be\u09a8\u09cd\u09a8\u09be \u099a\u09b2\u09c7 \u0986\u09b8\u09b2,,\u09a6\u09c1\u099c\u09a8\u09c7\u09b0 \u0985\u09ad\u09bf\u09a8\u09df \u09ac\u09b2\u09be\u09b0 \u09ac\u09be\u0987\u09b0\u09c7\ud83d\ude2d\ud83d\ude2d",
                    "author": "@MdRafsanAhmedRafi-n3r",
                    "likes": 17,
                    "publishedAt": "2026-03-01T08:21:32Z"
                },
                {
                    "text": "\u0995\u09c7 \u0995\u09c7 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be\u09df \u099b\u09bf\u09b2\u09c7\u09a8 \u0986\u09ae\u09be\u09b0 \u09ae\u09a4\u09cb",
                    "author": "@SujonMazi-t2g",
                    "likes": 13,
                    "publishedAt": "2026-03-01T06:34:22Z"
                },
                {
                    "text": "\u0996\u09be\u09ae\u09bf\u09a8\u09bf\u09b0 \u09ad\u0995\u09cd\u09a4\u09a6\u09c7\u09b0 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0987 \u2764\u2764\u2764",
                    "author": "@MdRokonislam-md6ri",
                    "likes": 373,
                    "publishedAt": "2026-03-01T06:02:07Z"
                },
                {
                    "text": "\u0986\u099c\u0995\u09c7 \u09b8\u09ac\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u0987\u09b0\u09be\u09a8\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09a8\u09c7\u09a4\u09be \u0986\u09af\u09bc\u09be\u09a4\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09b2 \u0996\u09be\u09ae\u09c7\u09a8\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09cb\u09af\u09bc\u09be \u099a\u09be\u0987 \u09a4\u09be\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a4\u09c7 \u0986\u09ae\u09b0\u09be \u0997\u09ad\u09c0\u09b0\u09ad\u09be\u09ac\u09c7 \u09b6\u09cb\u0995\u09be\u09b9\u09a4",
                    "author": "@KhairulVaiOfficeal",
                    "likes": 337,
                    "publishedAt": "2026-03-01T06:01:55Z"
                },
                {
                    "text": "\u09e7\u09ee\u09e6 \u0995\u09cb\u099f\u09bf \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u0995\u09b2\u09bf\u099c\u09be\u09b0 \u099f\u09c1\u0995\u09b0\u09be \u09b9\u09b2\u09c7\u09a8 \u09b9\u09af\u09b0\u09a4 \u09ae\u09cb\u09b9\u09be\u09ae\u09cd\u09ae\u09a6 (\u09b8\u09be\u0983) \ud83e\udeb4\ud83c\udf3f\u2764\ufe0f",
                    "author": "@JamilaMedia1",
                    "likes": 276,
                    "publishedAt": "2026-03-01T06:04:26Z"
                },
                {
                    "text": "\u0996\u09be\u09b2\u09bf\u09a6 \u09b8\u09be\u09b9\u09c7\u09ac \u09af\u09c7 \u0996\u09be\u09df\u09b0\u09c1\u09b2\u09c7\u09b0 \u09ac\u09be\u09ac\u09be \u098f\u0987 \u0995\u09a5\u09be\u0997\u09c1\u09b2\u09cb \u09a8\u09bf\u09aa\u09be\u09b0 \u09ae\u09be \u0986\u09dc\u09be\u09b2 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c1\u09a8\u09b2\u09c7 \u09ad\u09be\u09b2\u09cb \u09b9\u09a4\u09cb\u0964",
                    "author": "@ObaidulIslamOfficial-r5b",
                    "likes": 109,
                    "publishedAt": "2026-03-01T06:52:38Z"
                },
                {
                    "text": "\u0986\u09ae\u09be\u09b0 \u09ae\u09a4\u09cb \u0995\u09c7 \u0995\u09c7 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be\u09df \u099b\u09bf\u09b2\u09c7\u09a8\ud83d\ude0a",
                    "author": "@MDZUBARAJ",
                    "likes": 8,
                    "publishedAt": "2026-03-01T07:31:31Z"
                },
                {
                    "text": "\u0987\u09b0\u09be\u09a8\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09a8\u09c7\u09a4\u09be \u0986\u09af\u09bc\u09be\u09a4\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09b2 \u0996\u09be\u09ae\u09c7\u09a8\u09bf\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a4\u09c7 \u0995\u09be\u09b0\u09be \u0995\u09be\u09b0\u09be \u0995\u09b7\u09cd\u099f \u09aa\u09c7\u09af\u09bc\u09c7\u099b\u09c7\u09a8?",
                    "author": "@Forhad721",
                    "likes": 174,
                    "publishedAt": "2026-03-01T06:29:40Z"
                },
                {
                    "text": "\u0996\u09be\u0987\u09b0\u09c1\u09b2\u09c7\u09b0 \u09b8\u09ab\u09b2\u09a4\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u0993\u09af\u09bc\u09be \u09ae\u09be\u09a8\u09c1\u09b7 \u0997\u09c1\u09b2\u09cb \u0995\u09cb\u09a5\u09be\u09af\u09bc  \u09b8\u09be\u09a1\u09bc\u09be \u09a6\u09bf\u09a8",
                    "author": "@mdhelalparvez808",
                    "likes": 55,
                    "publishedAt": "2026-03-01T06:07:17Z"
                },
                {
                    "text": "\u09ad\u09be\u0987 \u09a8\u09be\u099f\u0995\u099f\u09bf \u09a6\u09c7\u0996\u09c7 \u099a\u09cb\u0996 \u09a6\u09bf\u09af\u09bc\u09c7 \u09aa\u09be\u09a8\u09bf \u099a\u09b2\u09c7 \u098f\u09b8\u09c7\u099b\u09c7 \ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@FarabiJr",
                    "likes": 5,
                    "publishedAt": "2026-03-01T09:27:26Z"
                },
                {
                    "text": "\u0995\u09be\u09b0\u09be \u09b8\u09ac\u099f\u09bf \u09b0\u09cb\u099c\u09be \u09b0\u09be\u0996\u099b\u09c7\u09a8 \u098f\u09ac\u0982  \u0986\u09b0\u09cb \u09e7\u09ef \u099f\u09be \u09b0\u09cb\u099c\u09be \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4",
                    "author": "@RjMahimkane",
                    "likes": 15,
                    "publishedAt": "2026-03-01T06:15:32Z"
                },
                {
                    "text": "\u099a\u09b2\u09c7 \u0986\u09b8\u09b2\u09be\u09ae \u09a6\u09c7\u09a8\u09be \u09aa\u09be\u0993\u09a8\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u0986\u09ae\u09be\u09b0 \u09ae\u09a4 \u0995\u09c7 \u0995\u09c7 \u0986\u099b\u09c7\u09a8 \u09a6\u09c7\u0996\u09a4\u09c7",
                    "author": "@sagorkhan2363",
                    "likes": 16,
                    "publishedAt": "2026-03-01T06:01:57Z"
                },
                {
                    "text": "\u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u098f\u0995\u099c\u09a8 \u0985\u09ad\u09bf\u09a8\u09c7\u09a4\u09be \u09a4\u09be\u09b0 \u09a8\u09be\u09ae \u09b9\u099a\u09cd\u099b\u09c7 \u0996\u09be\u0987\u09b0\u09c1\u09b2 \u09af\u09be\u09b0 \u09a8\u09be\u099f\u0995 \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u09a6\u09c7\u0996\u09c7 \u09aa\u09cd\u09b0\u09c7\u09ae\u09c7 \u09aa\u09a1\u09bc\u09c7 \u0997\u09c7\u099b\u09bf \u0995\u09be\u09b0\u09be \u0995\u09be\u09b0\u09be \u0986\u099b\u09c7\u09a8 \u0986\u09ae\u09be\u09b0 \u09ae\u09a4 \u09b9\u09be\u09a4 \u09a4\u09cb\u09b2\u09c7\u09a8",
                    "author": "@KhairulVaiOfficeal",
                    "likes": 49,
                    "publishedAt": "2026-03-01T06:01:23Z"
                },
                {
                    "text": "\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09c7\u09a8 \u0989\u09a8\u09be\u0995\u09c7 \u09ac\u09c7\u09b9\u09c7\u09b8\u09cd\u09a4 \u09a8\u09b8\u09bf\u09ac \u0995\u09b0\u09c7\u09a8 \u0986\u09ae\u09bf\u09a8",
                    "author": "@ShekFarid-w7r",
                    "likes": 7,
                    "publishedAt": "2026-03-01T07:00:03Z"
                },
                {
                    "text": "Dena pawna natok e sohidul islamm selim ar dinarer ovinoy oshadharon",
                    "author": "@nadirachowdhury8944",
                    "likes": 0,
                    "publishedAt": "2026-03-01T08:13:28Z"
                },
                {
                    "text": "*\u0986\u09df\u09a4\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u0996\u09be\u09ae\u09c7\u09a8\u09bf\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a4\u09c7 \u0986\u09ae\u09b0\u09be \u09b6\u09cb\u0995\u09be\u09b9\u09a4*",
                    "author": "@nupurislam5525",
                    "likes": 23,
                    "publishedAt": "2026-03-01T06:16:15Z"
                },
                {
                    "text": "\u0995\u09be\u09b0\u09be \u09b8\u09ac\u099f\u09bf \u09b0\u09cb\u099c\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u09a8 \u09b9\u09be\u09a4 \u09a4\u09c1\u09b2\u09c7 \u09af\u09be\u09a8 \u0986\u09ae\u09bf \u0987\u09a8\u09cd\u09a1\u09bf\u09af\u09bc\u09be\u09a8 \u09a4\u09cd\u09b0\u09bf\u09aa\u09c1\u09b0\u09be \u0989\u09a6\u09af\u09bc\u09aa\u09c1\u09b0 \u09a5\u09c7\u0995\u09c7  \u0964\u0964",
                    "author": "@renubhai1680",
                    "likes": 95,
                    "publishedAt": "2026-03-01T06:00:54Z"
                },
                {
                    "text": "\u09b6\u09b9\u09bf\u09a6\u09c7\u09b0 \u09ac\u09be\u09aa\u0995\u09c7 \u09a8\u09bf\u09b0\u09be\u09b6 \u0995\u09b0\u09be \u09af\u09be\u09ac\u09c7\u09a8\u09be,,\u0995\u09be\u09b0\u09a8 \u0996\u09be\u09df\u09b0\u09c1\u09b2\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09a4\u09be\u09b0 \u09ad\u09be\u09b2\u09cb\u09ac\u09be\u09b8\u09be \u0985\u09a8\u09c7\u0995 \u09ac\u09c7\u09b6\u09bf,,\u09a4\u09be\u0987 \u0996\u09be\u09df\u09b0\u09c1\u09b2 \u09af\u09c7\u09a8 \u09a4\u09be\u09b0 \u0995\u09be\u099b\u09c7\u0987 \u09a5\u09be\u0995\u09c7",
                    "author": "@abdulmonnaf9510",
                    "likes": 31,
                    "publishedAt": "2026-03-01T06:29:52Z"
                },
                {
                    "text": "\u09a8\u09be\u099f\u0995\u09c7 \u0993 \u0995\u09be\u09a8\u09cd\u09a8\u09be \u0995\u09b0\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6 \u09a8\u09be\u099f\u0995\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u09b8\u0995\u09b2\u0995\u09c7\u2764\u2764\u2764",
                    "author": "@WazedOpu",
                    "likes": 0,
                    "publishedAt": "2026-03-01T07:44:23Z"
                },
                {
                    "text": "\u0986\u09ae\u09bf \u098f\u0995 \u09b8\u09be\u09aa\u09cd\u09a4\u09be\u09b9 \u09a6\u09b0\u09c7 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be\u09df \u0986\u099b\u09bf  \u09a8\u09be\u099f\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09b0 \u09ae\u09a4 \u0995\u09c7 \u0995\u09c7 \u0986\u099b\u09bf\u09b2\u09c7\u09a8 \u0986\u09ae\u09bf \u099c\u09be\u09a8\u09a4\u09c7 \u099a\u09be\u09df",
                    "author": "@Raselkhan-v6k",
                    "likes": 13,
                    "publishedAt": "2026-03-01T06:13:29Z"
                },
                {
                    "text": "\u0987\u09a4\u09bf\u09b9\u09be\u09b8\u09c7 \u09b2\u09c7\u0996\u09be \u09a5\u09be\u0995\u09ac\u09c7 \u09ee\u09e6 \u098a\u09b0\u09cd\u09a7\u09cd\u09ac \u09ac\u09df\u09b8\u09c0 \u0996\u09cb\u09ae\u09c7\u09a8\u09bf \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u09b8\u09c1\u09aa\u09be\u09b0 \u09aa\u09be\u0993\u09df\u09be\u09b0\u09a6\u09c7\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u09ae\u09be\u09a5\u09be \u0989\u099a\u09c1 \u0995\u09b0\u09c7 \u098f\u0995\u09be\u0987 \u09a6\u09be\u09dc\u09bf\u09df\u09c7 \u099b\u09bf\u09b2\u09c7\u09a8\u0964",
                    "author": "@dinduniyakhan",
                    "likes": 87,
                    "publishedAt": "2026-03-01T06:04:27Z"
                },
                {
                    "text": "\u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7 \u09e9 \u09aa\u09b0\u09cd\u09ac \u0995\u09b0\u09c7 \u09a8\u09be \u09a6\u09bf\u09b2\u09c7 \u09a8\u09be\u099f\u0995\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0986\u0997\u09cd\u09b0\u09b9 \u0995\u09ae\u09c7 \u09af\u09be\u09af\u09bc \ud83c\udf89\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@HafejmdnaseruddinHafej",
                    "likes": 19,
                    "publishedAt": "2026-03-01T06:06:11Z"
                }
            ]
        }
