            "comments": [
                {
                    "text": "\u0645\u0646 \u0632\u0645\u0646 \u0627\u0644\u062c\u0627\u0647\u0644\u064a\u0629 \ud83d\ude02\u2764",
                    "author": "@kaiser_isg",
                    "likes": 49,
                    "publishedAt": "2026-03-29T17:04:30Z"
                },
                {
                    "text": "\u0628\u0633 \u0645\u0639 \u0627\u0644\u0648\u0642\u062a \u0628\u064a\u0635\u062f\u0648\u0627 \u0627\u0630\u0627 \u0645\u0627 \u0634\u0645\u0639\u062a\u0647\u0645 \u0628\u0627\u0644\u0639\u0633\u0644",
                    "author": "@ota3t",
                    "likes": 17,
                    "publishedAt": "2026-03-29T18:31:14Z"
                },
                {
                    "text": "\u0645\u0627\u0632\u0646 \u0623\u0646\u0635\u062d\u0643 \u062a\u062c\u0631\u0628 \u0647\u0630\u064a \u0627\u0644\u0645\u0648\u062f\u0627\u062a:\ninfinite trading>\u062a\u0642\u0627\u064a\u0636 \u0644\u0627 \u0646\u0647\u0627\u0626\u064a\neasy_totem_recipe>\u064a\u062a\u064a\u062d \u0644\u0643 \u0627\u0646\u0643 \u062a\u0635\u0646\u0639 \u0627\u0644\u062a\u0648\u062a\u0645\ntrade cycling> \u0628\u062f\u0644 \u0627\u0646\u0643 \u062a\u0643\u0633\u0631 \u0622\u0644\u0629 \u0627\u0644\u0642\u0631\u0648\u064a \u0639\u0634\u0627\u0646 \u064a\u063a\u064a\u0631 \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u0627\u062a \u0641\u064a\u0643 \u0627\u0646\u0643 \u0628\u0643\u0628\u0633\u0629 \u0632\u0631 \u062a\u063a\u064a\u0631\u0647\u0627\nAnther furniture>\u0628\u064a\u0636\u064a\u0641 \u0623\u062b\u0627\u062b\nCarry on>\u0628\u064a\u062e\u0644\u064a\u0643 \u062a\u062d\u0645\u0644 \u0627\u0644\u0643\u0627\u0626\u0646\u0627\u062a \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629\nDo a barrel roll>\u064a\u062c\u0639\u0644 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0641\u064a \u0627\u0644\u0625\u0644\u064a\u062a\u0631\u0627 \u0623\u0641\u0636\u0644\nGrave stones>\u0625\u0630\u0627 \u0645#\u062a\u062a \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629 \u064a\u062d\u0637 \u0644\u0643 \u0642\u0628\u0631 \u0641\u064a\u0643 \u062a\u0643\u0633\u0631\u0647 \u0648 \u064a\u0639\u0637\u064a\u0643 \u0623\u063a\u0631\u0627\u0636\u0643\nGuard villagers>\u064a\u0636\u064a\u0641 \u0642\u0631\u0648\u064a\u064a\u0646 \u064a\u062d\u0645\u0648\u0627 \u0627\u0644\u0642\u0631\u064a\u0629",
                    "author": "@Abdullah_iktd",
                    "likes": 21,
                    "publishedAt": "2026-03-29T16:59:23Z"
                },
                {
                    "text": "\u0645\u0627\u0630\u0627 \u064a\u0631\u064a\u062f \u062a\u0631\u062f \u0639\u0644\u064a \u0627\u0646\u0627 \u0645\u062a\u0627\u0628\u0639\u0643 \u0645\u0646 \u0627\u0648\u0644 \u0645\u0627 \u0641\u062a\u062d\u062a \u0627\u0644\u0642\u0646\u0627\u0647 \u0627\u0633\u062a\u0645\u0631\u064a \u064a\u0647\u0631\u062c \u0627\u0644\u0628\u0637\u0644",
                    "author": "@JoeCool-r2s",
                    "likes": 1,
                    "publishedAt": "2026-03-29T21:15:49Z"
                },
                {
                    "text": "\u0628\u0633 \u0627\u0646\u062a\u0628\u0647 \u064a\u0627 \u0645\u0627\u0632\u0646 \u0627\u0646\u062a \u062d\u0627\u0637\u0637 \u062a\u0644\u0627\u062a \u0637\u0628\u0642\u0627\u062a \u0645\u0646 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0637\u0628\u0642\u0629 \u0627\u0644\u0627\u062e\u064a\u0631\u0629 \u0645\u0627 \u064a\u0648\u0635\u0644\u0648\u0644\u0647\u0627 \u0644\u0627\u0646\u0647\u0645 \u0645\u0627 \u064a\u0642\u062f\u0631\u0648\u0627 \u064a\u0641\u062a\u062d\u0648\u0627 \u063a\u064a\u0631 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0644\u064a \u0639\u0627\u0631\u062a\u0641\u0627\u0639 \u0628\u0644\u0648\u0643\u0629 \u0627\u0648 \u062a\u0646\u062a\u064a\u0646",
                    "author": "@yaman1769",
                    "likes": 5,
                    "publishedAt": "2026-03-29T18:49:02Z"
                },
                {
                    "text": "\u0645\u0627\u0632\u0646 \u0645\u0628\u0631\u0648\u0643 \u062c\u0631\u0628\u0629 \u0634\u0639\u0648\u0631 \u0627\u0645\u062a\u0644\u0627\u0643 \u0639\u0628\u064a\u062f \u2764\u2764",
                    "author": "@KING-TOP-1S",
                    "likes": 1,
                    "publishedAt": "2026-03-29T19:28:49Z"
                },
                {
                    "text": "\u0634\u0643\u0631\u0627 \u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 . \u0644\u0648\u0644\u0627\u0643 \u0643\u0627\u0646\u062a \u0645\u0627\u064a\u0646\u0643\u0631\u0627\u0641\u062a \u0631\u0627\u062d \u062a\u062e\u0628\u064a \u0639\u0644\u064a\u0646\u0627 \u0647\u0627\u062f \u0627\u0644\u0633\u0631 \ud83d\ude02",
                    "author": "@MHMDRDN0-0",
                    "likes": 0,
                    "publishedAt": "2026-03-29T19:46:52Z"
                },
                {
                    "text": "\u0628\u0633 \u0623\u0639\u0637\u064a\u0647\u0645 \u0639\u0633\u0644 \u0639\u0634\u0627\u0646 \u0645\u0627 \u064a\u0635\u062f\u0648\u0646",
                    "author": "@madara-p2c",
                    "likes": 2,
                    "publishedAt": "2026-03-29T19:33:47Z"
                },
                {
                    "text": "\u064a\u0627 \u0645\u0627\u0632\u0646 \u0634\u0645\u0639\u0647\u0645 \u0628\u0627\u0644\u0639\u0633\u0644 \u0639\u0634\u0627\u0646 \u0645\u0639 \u0644\u0648\u0642\u062a \u0628\u064a\u062a\u0635\u062f\u0648 \u0648\u064a\u0635\u064a\u0631\u0648 \u0645\u0627 \u064a\u062a\u062d\u0631\u0643\u0648",
                    "author": "@oussama-ouou",
                    "likes": 3,
                    "publishedAt": "2026-03-29T17:01:40Z"
                },
                {
                    "text": "\u062c\u064a\u062a \u0628\u062f\u0631\u064a \u0627\u0644\u062d\u0645\u062f\u0627\u0644\u0644\u0647\ud83d\udd2a\ud83e\udd1a\u2728\u2728\u2728 \u0623\u0646\u0627 \u0644\u0627\u064a\u0643 \u0631\u0642\u0645 92",
                    "author": "@KSA501-B_52",
                    "likes": 1,
                    "publishedAt": "2026-03-29T17:01:19Z"
                },
                {
                    "text": "\u0627\u062e\u0627\u0641 \u0627\u0642\u0648\u0644\u0643 \u0627\u0646\u0647\u0645 \u0631\u0627\u062d \u064a\u062e\u0631\u0628\u0648\u0644\u0643 \u0627\u0644\u0628\u0648\u0643\u0633\u0627\u062a \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@Smile-fl7tj",
                    "likes": 0,
                    "publishedAt": "2026-03-29T21:08:47Z"
                },
                {
                    "text": "\u0627\u062e\u064a\u0631\u0627 \u0644\u0642\u064a\u062a \u0634\u064a \u0627\u0633\u062a\u0639/\u0628\u062f\u0647 \u063a\u064a\u0631 \u0627\u0644\u0642\u0631\u0648\u064a\u064a\u0646",
                    "author": "@anmarmohanad8666",
                    "likes": 1,
                    "publishedAt": "2026-03-29T20:09:38Z"
                },
                {
                    "text": "\u0648\u0627\u0644\u0644\u0647 \u064a\u0627 \u0645\u0627\u0632\u0646 \u0627\u062d\u0633 \u0627\u0646\u0643 \u06a8\u0627\u0639\u062f \u062a\u062a\u0637\u0648\u0631 \u0643\u0644 \u0645\u0631 \u0623\u0643\u062b\u0631 \ud83d\udda4",
                    "author": "@SPARKEXE.1",
                    "likes": 1,
                    "publishedAt": "2026-03-29T21:38:03Z"
                },
                {
                    "text": "\u0645\u0627 \u0623\u062a\u0648\u0642\u0639 \u0623\u0646\u0643 \u0645\u0633\u062a\u0648\u0639\u0628 \u0644\u0623\u064a \u062f\u0631\u062c\u0629 \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0645\u0627\u064a\u0646 \u0643\u0631\u0627\u0641\u062a \u0628\u0637\u064a\u0626\u0629\ud83d\ude05",
                    "author": "@omegafatato",
                    "likes": 0,
                    "publishedAt": "2026-03-29T18:21:09Z"
                },
                {
                    "text": "\u0645\u0646 \u0632\u0645\u0627\u0627\u0627\u0627\u0627\u0627\u0646\u0646\u0646\u0646\u0646\u0646 \u0646\u0639\u0631\u0641\u0647\u0647 \u0635\u0627\u0631 \u062a\u062d\u062f\u064a\u062b\u064a\u0646 \u062c\u062f\u062f \u0648\u062a\u0647 \u0628\u0639\u062f\u0643 \u0628\u0647\u0627\u0630\u0627",
                    "author": "@Fjfhtbtb",
                    "likes": 1,
                    "publishedAt": "2026-03-29T20:02:35Z"
                },
                {
                    "text": "\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u062a\u0637\u0648\u0631 \u0628\u0633 \u0627\u0644\u062c\u0648\u062f\u0629 \u062a\u0628\u0639 \u0627\u0644\u0634\u0648\u0631\u062a\u0633 \u0643\u062a\u064a\u0631 \u0633\u064a\u0626\u0629 \u0635\u0631\u0627\u062d\u0629",
                    "author": "@OX1D-only",
                    "likes": 0,
                    "publishedAt": "2026-03-29T19:18:34Z"
                },
                {
                    "text": "\u0648\u0627\u0644\u0644\u0647 \u0625\u0646\u0643 \u0627\u0635\u0637\u0648\u0631 \u0643\u0645\u0644 \ud83d\ude0a\ud83d\ude0a\ud83d\ude0a",
                    "author": "@\u064a\u0648\u0646\u0633\u0631\u0627\u0634\u062f",
                    "likes": 1,
                    "publishedAt": "2026-03-29T18:37:51Z"
                },
                {
                    "text": "\u0645\u0627\u0632\u0646 \u0648\u0631\u064a\u0646\u0627 \u0643\u0644 \u0627\u0644\u0645\u0648\u062f\u0627\u062a \u0648 \u0627\u0644\u0631\u064a\u0633\u0648\u0631\u0633 \u0628\u0627\u0643\u0627\u062a \u0625\u0644\u064a \u062a\u0633\u062a\u0639\u0645\u0644\u0647\u0627 \u0641\u064a \u0639\u0627\u0644\u0645\u0643",
                    "author": "@MahdiAlisalih",
                    "likes": 1,
                    "publishedAt": "2026-03-29T18:23:46Z"
                },
                {
                    "text": "\u0646\u0639\u0631\u0641 \u0645\u0646 \u0632\u0645\u0627\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646\u0646",
                    "author": "@\u062d\u0633\u0627\u0645\u062d\u062c\u064a-\u06329\u062f",
                    "likes": 1,
                    "publishedAt": "2026-03-29T19:17:56Z"
                },
                {
                    "text": "\u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0644\u0648 \u0641\u064a \u0635\u0646\u0627\u062f\u064a\u0642 \u0643\u062b\u064a\u0631 \u0628\u062a\u062c\u064a\u0647 \u062c\u0644\u0637\u0629",
                    "author": "@-AliHsyan",
                    "likes": 0,
                    "publishedAt": "2026-03-29T21:26:14Z"
                },
                {
                    "text": "\u064a\u0627 \u0645\u0627\u0632\u0646 \u062c\u064a\u0628 \u0634\u0643\u0644 \u0627\u0644\u0648\u0631\u062f\u0646 \u0644\u062f\u0631\u0648\u0639\u0643 \u2764\u2764",
                    "author": "@\u0635\u0647\u064a\u0628\u0623\u0633\u0627\u0645\u0629-\u062a6\u062f",
                    "likes": 1,
                    "publishedAt": "2026-03-29T22:15:55Z"
                },
                {
                    "text": "\u0645\u0627\u0632\u0646 \u0627\u0644\u0639\u0628 \u0644\u0639\u0628\u062a \u0627\u0628\u0644\u064a\u0633 \u0627\u0644\u064a\u0639\u062c\u0628\u062a\u0647 \u0627\u0644\u0641\u0643\u0631\u0629 \u064a\u0636\u0639\u0644\u064a\u0643 \u0639\u0634\u0627 \u0646 \u064a\u062a\u0644\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\ud83d\ude05\u2764\u0628\u0623\u0633 \u0628\u062f\u064a \u0627\u0633\u0627\u0644 \u0633\u0624\u0627\u0644 \u0645\u0627\u0632\u0646 \u0644\u064a\u0634 \u0634\u0644\u062d\u062a \u0627\u0644\u062e\u062a\u0645 \u0627\u0644\u0632\u0648\u062c \u0627\u0646\u0627 \u0648\u0646\u0646\u0628\u0647 \u0645\u0646 \u0632\u0645\u0627\u0646  \u0627\u0646\u0627 \u0634\u0643\u0627 \u0627\u0646\u0643 \u0645\u0646 \u0641\u0633\u0644\ud83d\ude05",
                    "author": "@\u0644\u064a\u0644\u0649-\u062f9\u06316\u0628",
                    "likes": 2,
                    "publishedAt": "2026-03-29T18:20:33Z"
                },
                {
                    "text": "\u0645\u0631\u062d\u0628\u0627 \u0645\u0627\u0632\u0646 \u0627\u0646\u062a \u0646\u0632\u0644\u062a \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0628\u0633 \u0647\u0630\u0648\u0644 \u0627\u0644\u0627\u0634\u062e\u0627\u0635 \u0645\u0634 \u0645\u0648\u062c\u0648\u062f\u064a\u0646 \u0627\u0628\u0631\u0647 \u0628\u0648\u0644\u062a \u0627\u0644\u0634\u064a\u0633\u062a \u0645\u0634 \u0645\u0648\u062c\u0648\u062f\u064a\u0646 \u0627\u0646\u062a \u0645\u0634 \u062d\u0627\u0637\u0637 \u0628\u0627\u0644\u0644\u0642\u0637\u0647",
                    "author": "@JoeCool-r2s",
                    "likes": 1,
                    "publishedAt": "2026-03-29T21:14:57Z"
                },
                {
                    "text": "\u064a\u0627 \u062d\u0628\u064a\u0628\u064a \u0627\u0639\u0645\u0644 \u0633\u0643\u0646 \ud83d\ude02",
