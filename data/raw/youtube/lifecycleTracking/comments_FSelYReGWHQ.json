                    "publishedAt": "2026-03-19T18:27:53Z"
                },
                {
                    "text": "\u0410 \u0435\u0441\u0442\u044c \u0442\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u0441 \u0444\u0438\u0442\u043f\u043c\u0438 \u043a\u0430\u043a \u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0445 ?",
                    "author": "@HavchikRB",
                    "likes": 0,
                    "publishedAt": "2026-03-19T19:33:29Z"
                },
                {
                    "text": "\u044d\u0442\u043e \u0421\u0421\u0420, \u0434\u043b\u044f \u043d\u0438\u0445 \u044d\u0442\u043e \u043d\u043e\u0440\u043c\u0430",
                    "author": "@vlad30125",
                    "likes": 1,
                    "publishedAt": "2026-03-20T13:37:50Z"
                },
                {
                    "text": "\u0412\u043e \u043c\u043b\u044f. \u041a\u043e\u043b\u044f \u0447\u0442\u043e \u0442\u044b \u043d\u0430\u0434\u0435\u043b\u0430\u043b? \u041d\u0443 \u043d\u0430\u043a\u0440\u0435\u043d\u0430?!",
                    "author": "@\u041c\u0430\u043a\u0441\u0438\u043c\u041a\u0430\u043b\u0438\u043d\u0438\u043d-\u04462\u0431",
                    "likes": 0,
                    "publishedAt": "2026-03-20T12:01:24Z"
                },
                {
                    "text": "\u0422\u043e\u0435\u0441\u0442\u044c \u0438\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u0431\u0430\u0433\u0430 \u043a\u0430\u043a\u043e\u0439 \u043d\u0438\u0431\u0443\u0434\u044c \u0447\u0435\u043b \u043c\u043e\u0436\u0435\u0442 \u0432\u0437\u044f\u0442\u044c, \u043d\u0430\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u0432\u0438\u043d\u043e\u0432 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0438\u043c \u043f\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432, \u043f\u043e\u0442\u043e\u043c \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0432\u044b\u043b\u043e\u0436\u0438\u0442\u044c \u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0443 \u043b\u044e\u0431\u0443\u044e \u0445\u0440\u0435\u043d\u044c \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u044f\u0440\u0434\u043e\u0432 \u0438 \u043a\u0443\u043f\u0438\u0442\u044c \u044d\u0442\u0443 \u0445\u0440\u0435\u043d\u044c \u043d\u0430 \u0442\u0432\u0438\u043d\u0430\u0445, \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430 \u0442\u0432\u0438\u043d\u0430\u0445 \u0432 \u043c\u0438\u043d\u0443\u0441 \u0443\u0439\u0434\u0443\u0442, \u043d\u0443 \u0438 \u0447\u0442\u043e, \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u043e\u0432\u044b\u0445 \u0442\u0432\u0438\u043d\u043e\u0432 \u0434\u0435\u043b\u0430\u0435\u0442",
                    "author": "@gamelol4345",
                    "likes": 0,
                    "publishedAt": "2026-03-20T02:13:27Z"
                },
                {
                    "text": "\u0425\u044b.",
                    "author": "@NevrologiLive",
                    "likes": 1,
                    "publishedAt": "2026-03-19T18:14:13Z"
                },
                {
                    "text": "\u0425\u0430. \u0420\u0430\u0441\u0441\u043a\u0430\u0436\u0438 \u0426\u0426\u041f \u0437\u0430\u0431\u0440\u0430\u043b\u0438 \u0438\u0441\u043a\u0438?",
                    "author": "@\u0410\u0440\u0442\u0443\u0440-\u044f4\u044f7\u0445",
                    "likes": 1,
                    "publishedAt": "2026-03-19T18:22:14Z"
                },
                {
                    "text": "\u0427\u0442\u043e \u044d\u0442\u043e \u0437\u0430 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043a\u0430?",
                    "author": "@Gorchik5222",
                    "likes": 0,
                    "publishedAt": "2026-03-19T18:26:34Z"
                },
                {
                    "text": "\u0422\u0430\u043a \u0430 \u0447\u0442\u043e \u0437\u0430 \u043c\u0438\u0441\u0441\u0438\u0438 \u0438 \u0433\u0434\u0435 \u0434\u0435\u043b\u0430\u0442\u044c ?",
                    "author": "@vitalbez7967",
