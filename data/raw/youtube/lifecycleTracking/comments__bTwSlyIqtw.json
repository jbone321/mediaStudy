                },
                {
                    "text": "\ud83d\udc98\"\u09ac\u09bf\u09a6\u09be\u09df\u09c7\u09b0 \u09b6\u09c7\u09b7 \u09aa\u09be\u09a8\u09cd\u09a4\u09c7...\ud83e\udd8b \u09aa\u09cd\u09b0\u09bf\u09df \u09b0\u09ae\u09be\u09a6\u09be\u09a8 \u09ae\u09be\u09b8...\ud83c\udf19",
