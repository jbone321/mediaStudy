                    "likes": 94,
                    "publishedAt": "2026-03-18T08:01:11Z"
                },
                {
                    "text": "\u0995\u09be\u09b0 \u0995\u09be\u09b0 \u09ae\u09a8\u09c7 \u09b9\u0987\u09a4\u09c7\u099b\u09c7 \u098f\u09ac\u09be\u09b0 \u09b0\u09ae\u099c\u09be\u09a8 \u0996\u09c1\u09ac \u09a4\u09be\u09a1\u09bc\u09be\u09a4\u09be\u09a1\u09bc\u09bf \u0997\u09c7\u099b\u09c7 \ud83d\ude22\u2764",
                    "author": "@MD.SaifulAlam-d1n",
                    "likes": 76,
                    "publishedAt": "2026-03-18T08:01:22Z"
                },
                {
                    "text": "\u09af\u09be\u09b0\u09be \u0988\u09a6 \u09aa\u09c7\u09af\u09bc\u09c7 \u0996\u09c1\u09b6\u09bf \u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09bf \u0986\u09b2\u09b9\u09be\u09ae\u09a6\u09c1\u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9 \u2764\ud83d\udd4c",
                    "author": "@MdMijan-d1s",
                    "likes": 129,
                    "publishedAt": "2026-03-18T08:00:54Z"
                },
                {
                    "text": "\u0987\u09b0\u09be\u09a8 \u099c\u09af\u09bc\u09c0 \u09b9\u09b2\u09c7 \u0995\u09c7 \u0995\u09c7 \u0996\u09c1\u09b6\u09bf \u09b9\u09ac\u09c7\u09a8 \u2764",
                    "author": "@ayshakhan-k8h",
                    "likes": 41,
                    "publishedAt": "2026-03-18T08:02:32Z"
                },
                {
                    "text": "\u09e8 \u09ae\u09be\u09b8 \u09af\u09be\u09ac\u09ce \u0996\u09c1\u09ac\u0987 \u0985\u09b8\u09c1\u09b8\u09cd\u09a5\ud83d\ude2d\ud83d\ude2d\u0964\u0964 \u09b8\u09ac\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09a6\u09cb\u09df\u09be \u099a\u09be\u0987\u0964\u0964 \u0995\u09be\u09a4\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \ud83c\udde7\ud83c\udde9\u2764\ufe0f\ud83c\udde7\ud83c\udded\ud83d\ude4f\ud83d\ude4f",
                    "author": "@MDsumonUddin-q6k",
                    "likes": 16,
                    "publishedAt": "2026-03-18T08:39:14Z"
                },
                {
                    "text": "\u09a4\u09bf\u09a8 \u09ad\u09be\u0987\u09df\u09c7\u09b0 \u09ad\u09bf\u09a4\u09b0\u09c7 \u099b\u09cb\u099f \u09ad\u09be\u0987\u09df\u09c7\u09b0 \u0985\u09ad\u09bf\u09a8\u09df\u099f\u09be \u09b8\u09c7\u0987 \u09b9\u09df\u09c7\u099b\u09c7\u0964 \u0985\u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09b2\u09bf\u09af\u09bc\u09be \u098f\u09a4\u09a6\u09bf\u09a8 \u0986\u099b\u09c7  \u09ae\u09a8\u09c7 \u09b9\u09af\u09bc\u09a8\u09bf \u09ac\u09be \u09aa\u09cd\u09b0\u09a5\u09ae \u0985\u09ad\u09bf\u09a8\u09df \u09ae\u09a8\u09c7 \u09b9\u09df\u09a8\u09bf\u0964\u09b8\u09be\u09ac\u09b2\u09c0\u09b2 \u0985\u09ad\u09bf\u09a8\u09af\u09bc \u09b9\u09df\u09c7\u099b\u09c7\u0964",
                    "author": "@shishirarup1731",
                    "likes": 18,
                    "publishedAt": "2026-03-18T08:42:48Z"
                },
                {
                    "text": "\u098f\u09a4 \u09a4\u09be\u09b0\u09be\u09a4\u09be\u09b0\u09bf \u09b0\u09ae\u099c\u09be\u09a8 \u09b6\u09c7\u09b7 \u09b9\u09df\u09c7 \u09af\u09be\u09ac\u09c7 \u09ad\u09be\u09ac\u09a4\u09c7\u0987 \u0985\u09ac\u09be\u0995 \u09b2\u09be\u0997\u09c7\u0964\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09c7\u09a8 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b0\u09cb\u099c\u09be \u0997\u09c1\u09b2\u09be\u0995\u09c7 \u0995\u09ac\u09c1\u09b2 \u0995\u09b0\u09c7\u09a8,\u09b8\u0995\u09b2\u09c7 \u09ac\u09b2\u09bf \u0986\u09ae\u09bf\u09a8\u0964\u09b8\u09ac\u09be\u0987\u0995\u09c7 \u0988\u09a6 \u09ae\u09cb\u09ac\u09be\u09b0\u0995\u0964",
                    "author": "@NahidHasan20-l9x",
                    "likes": 16,
                    "publishedAt": "2026-03-18T08:21:15Z"
                },
                {
                    "text": "\u0995\u09a4\u0987 \u09a8\u09be \u09ad\u09be\u09b2\u09cb \u09b9\u09a4\u09cb \u09af\u09a6\u09bf \u09b8\u0982\u09b8\u09a6\u09c7\u09b0 \u0986\u09b8\u09a8\u09c7 \u09b6\u09b0\u09c0\u09ab \u0993\u09b8\u09ae\u09be\u09a8 \u09b9\u09be\u09a6\u09bf \u09a5\u09be\u0995\u09a4\u09cb\ud83d\ude22",
                    "author": "@Js-animation-e9z",
                    "likes": 8,
                    "publishedAt": "2026-03-18T08:59:10Z"
                },
                {
                    "text": "\u09af\u09be\u09b0 \u09b8\u09ac \u09b0\u09cb\u099c\u09be \u09b0\u09c7\u0996\u09c7\u099b\u09bf \u09ac\u09b2\u09bf \u0986\u09b2\u09b9\u09be\u09ae\u09a6\u09c1\u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9 \u2764",
                    "author": "@Sukhproshitumi-k2y",
                    "likes": 9,
                    "publishedAt": "2026-03-18T09:13:00Z"
                },
                {
                    "text": "\u0985\u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09b2\u09bf\u09df\u09be\u09a8 \u09ac\u09df\u09c7\u09b0 \u09a1\u09be\u09df\u09b2\u0997\u0997\u09c1\u09b2\u09be \u099c\u09cb\u09b8 \u099b\u09bf\u09b2",
                    "author": "@Abdur-Rahim2023",
                    "likes": 10,
                    "publishedAt": "2026-03-18T08:15:24Z"
                },
                {
                    "text": "\u0986\u099c\u0995\u09c7 \u09e8\u09ee \u09b0\u09cb\u099c\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09af\u09be\u09b0\u09be \u098f\u0995\u099f\u09be \u09b0\u09cb\u099c\u09be \u0993 \u09ae\u09bf\u09b8 \u0995\u09b0\u09cb \u09a8\u09be\u0987 \u09a4\u09be\u09b0\u09be\u0987 \u09ac\u09b2\u09bf \u0986\u09b2\u09b9\u09be\u09ae\u09a6\u09c1\u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9 \ud83e\udd70",
                    "author": "@MdNurnobiIslam-m6u",
                    "likes": 21,
                    "publishedAt": "2026-03-18T08:01:39Z"
                },
                {
                    "text": "\u09b8\u09ac\u09be\u0987\u0995\u09c7 \u0987\u09a6 \u09ae\u09cb\u09ac\u09be\u09b0\u0995\u2764\u2764",
                    "author": "@wearehadi-s26",
                    "likes": 54,
                    "publishedAt": "2026-03-18T08:01:54Z"
                },
                {
                    "text": "\u09ad\u09c7\u0999\u09cd\u0997\u09c7 \u09aa\u09dc\u09cb\u09a8\u09be, \u09a8\u09bf\u09b0\u09be\u09b6 \u09b9\u09df\u09cb\u09a8\u09be, \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0986\u09b8\u09ac\u09c7\u0987, \u098f\u099f\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0993\u09df\u09be\u09a6\u09be\u0964 \u099c\u09c7\u09a8\u09c7 \u09b0\u09c7\u0996\u09cb \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0985\u09a4\u09bf \u09a8\u09bf\u0995\u099f\u09c7!\" [\u09b8\u09c2\u09b0\u09be \u09ac\u09be\u0995\u09be\u09b0\u09be,\n\n\u0986\u09df\u09be\u09a4: \u09e8\u09e7\u09ea]",
                    "author": "@\u0989\u09aa\u09a6\u09c7\u09b7\u09cd\u099f\u09be\u0986\u09b8\u09bf\u09ab",
                    "likes": 18,
                    "publishedAt": "2026-03-18T08:02:19Z"
                },
                {
                    "text": "i like your video",
                    "author": "@NICEEXPRESS-j1j",
                    "likes": 1,
                    "publishedAt": "2026-03-18T08:11:29Z"
                },
                {
                    "text": "\u09ae\u09be\u09b6\u09be\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09ad\u09be\u0987\u09af\u09bc\u09be \u0985\u09a8\u09c7\u0995 \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993, \u0996\u09c1\u09ac \u09ad\u09be\u09b2\u09cb \u09b2\u09be\u0997\u09b2\u09cb",
                    "author": "@mimmedia742",
                    "likes": 3,
                    "publishedAt": "2026-03-18T08:23:00Z"
                },
                {
                    "text": "\u0995\u09a4 \u09ae\u09be\u09a8\u09c1\u09b7 \u098f\u0987 \u0996\u09c1\u09b6\u09bf\u09b0 \u0988\u09a6\u09c7\u0993 \u0996\u09c1\u09b6\u09bf \u09a5\u09be\u0995\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09a8\u09be \n\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0 \u0996\u09c1\u09b6\u09bf \u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u0995",
                    "author": "@FatamaKhatun-h5m",
                    "likes": 2,
                    "publishedAt": "2026-03-18T09:50:33Z"
                },
                {
                    "text": "\u09b0\u09be\u0995\u09bf\u09ac \u09ad\u09be\u0987 \u09a6\u09c0\u09b0\u09cd\u0998\u099c\u09c0\u09ac\u09bf \u09b9\u09cb\u0995 \u0986\u09ae\u09bf\u09a8 \u2764\u2764",
                    "author": "@Reactionhridoy420",
                    "likes": 4,
                    "publishedAt": "2026-03-18T08:04:43Z"
                },
                {
                    "text": "\u09ac\u09be\u0982\u09b2\u09be\u09a6\u09c7\u09b6\u09c7\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u098f\u0995\u099f\u09bf \u0987\u0989\u099f\u09bf\u0989\u09ac \u099a\u09cd\u09af\u09be\u09a8\u09c7\u09b2 \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u0995\u09cb\u09a8 \u0985\u09b6\u09cd\u09b2\u09c0\u09b2\u09a4\u09be \u09a8\u09c7\u0987",
                    "author": "@MdRabbi-x6e4y",
                    "likes": 7,
                    "publishedAt": "2026-03-18T08:42:34Z"
                },
                {
                    "text": "\u0986\u09ae\u09b0\u09be \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09ad\u09bf\u0989\u09af\u09bc\u09be\u09b0 \u2764\u2764",
                    "author": "@Tamim-u2q",
                    "likes": 10,
                    "publishedAt": "2026-03-18T08:02:37Z"
                },
                {
                    "text": "\u0996\u09c1\u09ac \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09ad\u09be\u0987\u09af\u09bc\u09be\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09ac\u09bf\u09a8\u09cb\u09a6\u09a8 \u09ae\u09c1\u09b2\u0995 \u09ad\u09bf\u09a1\u09bf\u0993 \u0996\u09c1\u09ac \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0",
                    "author": "@MsUrmi-j6w",
                    "likes": 4,
                    "publishedAt": "2026-03-18T08:44:49Z"
                },
                {
                    "text": "\u09ac\u09bf\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u09b6\u09c7\u09b7 \u09aa\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09c7 \u09b0\u09ae\u099c\u09be\u09a8 \u09ae\u09be\u09b8..!\n\u09ac\u09c7\u0981\u099a\u09c7 \u09a5\u09be\u0995\u09b2\u09c7 \u0986\u09ac\u09be\u09b0 \u09a6\u09c7\u0996\u09be \u09b9\u09ac\u09c7\"\u09b9\u09c7\n\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09b0\u09ae\u09be\u09a6\u09be\u09a8..!)\n\u0987\u09a8\u09b6\u09be\u0986\u09b2\u09cd\u09b2\u09be\u09b9\"\u2764\ufe0f\ud83e\udd32",
                    "author": "@MdNurnobiIslam-m6u",
                    "likes": 11,
                    "publishedAt": "2026-03-18T08:02:13Z"
                },
                {
                    "text": "\u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0995\u09be\u09b0\u09be \u0995\u09be\u09b0\u09be \u0988\u09a6 \u0995\u09b0\u09ac\u09be \u098f\u09ac\u09be\u09b0 \ud83d\udd4c",
                    "author": "@MdMijan-d1s",
                    "likes": 4,
                    "publishedAt": "2026-03-18T08:01:51Z"
                },
                {
                    "text": "\u09b8\u09ac \u09b8\u09ae\u09af\u09bc \u09ab\u09cd\u09af\u09be\u09ae\u09bf\u09b2\u09bf \u098f\u09a8\u09cd\u099f\u09be\u09b0\u099f\u09c7\u0987\u09a8\u09ae\u09c7\u09a8\u09cd\u099f \u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a5\u09be\u0995\u09a4\u09c7 \u099a\u09be\u0987\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02",
