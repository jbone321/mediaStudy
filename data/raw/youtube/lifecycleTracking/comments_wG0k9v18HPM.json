                {
                    "text": "\u041c\u0438\u043b\u043b\u0438\u0439 \u0440\u0430\u049b\u0441\u043b\u0430\u0440\u0438\u043c\u0438\u0437 \u049b\u0430\u043d\u0438 \u0422\u0430\u043c\u0430\u0440\u0430\u0445\u043e\u043d\u0438\u043c\u043b\u0430\u0440 \u049b\u0430\u043d\u0438",
                    "author": "@\u041c\u0430\u043d\u0437\u0443\u0440\u0430\u041a\u0430\u0440\u0430\u043c\u043e\u0432\u0430-\u044b3\u043f",
                    "likes": 0,
                    "publishedAt": "2026-04-27T06:37:24Z"
                },
                {
                    "text": "\u042d\u0439 \u043e\u0442\u0430 \u043e\u043d\u0430\u043b\u0430\u0440 \u0431\u0438\u0441\u043c\u0438\u043b\u043b\u043e \u0434\u0435\u0431 \u0431\u043e\u043b\u0430 \u044f\u0440\u0430\u0442\u0438\u0439\u043b\u0430",
                    "author": "@Ooo-i1l",
                    "likes": 0,
                    "publishedAt": "2026-04-27T06:16:03Z"
                },
                {
                    "text": "\u042f\u043d\u0433\u0438 \u0442\u0430\u0432\u0443\u043a\u043b\u0430\u0440 \u043a\u0430\u0439\u0434\u0430\u043d \u043a\u0435\u043b\u0434\u0438\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u0411\u0435\u043a\u0437\u0430\u0442\u0420\u0430\u0445\u0438\u043c\u043e\u0432-\u043b3\u043b",
                    "likes": 0,
                    "publishedAt": "2026-04-27T06:03:02Z"
                },
                {
                    "text": "\u0416\u0438\u043d\u043d\u0438\u043b\u0430\u0440\u043d\u0438 \u0441\u043e\u0433\u0438 \u0431\u0443\u043c\u0430\u0439\u0434\u0438.",
                    "author": "@\u0440\u0438\u043c-\u04497\u0435",
                    "likes": 0,
                    "publishedAt": "2026-04-27T03:36:17Z"
                },
                {
                    "text": "\u041e\u0451\u0433\u0438 \u043a\u0443\u0439\u0433\u0430\u043d \u0436\u0443\u0436\u0430\ud83d\ude05\ud83d\ude05\ud83d\ude05\ud83d\ude05",
                    "author": "@\u0414\u0438\u043b\u0440\u0430\u0431\u043e\u0420\u0430\u0445\u043c\u043e\u043d\u043e\u0432\u0430-\u044f3\u0431",
                    "likes": 1,
                    "publishedAt": "2026-04-26T10:38:30Z"
                },
                {
                    "text": "\u0411\u0430\u044c\u0437\u0438\u043b\u0430\u0440\u043d\u0438 \u043d\u0438\u043c\u0430 \u0436\u0438\u043d \u0443\u0440\u044f\u043f\u0434\u0438.\u0410\u0441\u0442\u0430\u0433\u0444\u0443\u0440\u0443\u043b\u043b\u043e.\ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@\u0420\u043e\u0437\u0430\u0421\u0430\u0439\u0434\u0430\u043c\u0435\u0442\u043e\u0432\u0430",
                    "likes": 1,
                    "publishedAt": "2026-04-26T05:32:45Z"
                },
                {
                    "text": "\u0410\u0442\u043b\u0430\u0441\u0442\u0438\u044f\u043c \u0442\u0438\u049b\u0435\u0434\u0438\u0433\u043e\u043d \u0436\u043e\u0439\u043b\u0430\u0440\u0438\u043d\u0433\u0430 \u0442\u0438\u049b\u0438\u043f\u0441\u0438\u043b\u0430\u0440",
                    "author": "@nodirsodiqov4581",
                    "likes": 0,
                    "publishedAt": "2026-04-27T03:36:09Z"
                },
                {
                    "text": "\u041e\u0437\u043e\u0434\u0431\u0435\u043a \u0441\u0430\u0445\u043d\u0430\u0441\u0438.\n\u0422\u0430\u043c\u043e\u0448\u043e\u0431\u0438\u043d \u043a\u0443\u0434\u0430\u0441\u0438",
                    "author": "@\u041a\u0430\u0440\u0430\u0431\u043e\u0434\u043e\u043c",
                    "likes": 0,
                    "publishedAt": "2026-04-27T02:44:17Z"
                },
                {
                    "text": "Vay. \ud83d\ude22 Endi bula kim ekan odam juda charchadi bu shaytonladan o'zlari uyalmasmikan qilayotgan ishidan",
                    "author": "@BekQodirov-i6v",
                    "likes": 1,
                    "publishedAt": "2026-04-27T04:51:27Z"
                },
                {
                    "text": "\u0401 \u0442\u0430\u0432\u0431\u0430 \u0430\u0441\u0442\u0430\u0444\u0443\u0440\u043b\u043b\u043e\u0445\ud83d\ude22\ud83d\ude0a\ud83d\ude22\ud83d\ude0a\ud83d\ude22\ud83d\ude0a",
                    "author": "@UmarjonTursunbaev",
                    "likes": 0,
                    "publishedAt": "2026-04-27T07:07:55Z"
                },
                {
                    "text": "\u041a\u043e\u0447 \u0448\u0430\u0439\u0442\u043e\u043b\u0430\u0440 \u043a\u0435\u043b\u044f\u043f\u0442\u0438\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u041c\u0443\u0445\u0430\u0439\u0451\u041d\u0430\u0437\u0430\u0440\u043e\u0432\u0430-\u04358\u044d",
                    "likes": 1,
                    "publishedAt": "2026-04-26T07:59:11Z"
                },
                {
                    "text": "\u041c\u0430\u043d\u0438\u043c\u0447\u0430 \u0431\u0443\u043b\u0430\u0440 \u043a\u0435\u0447\u0430\u0441\u0438 \u0436\u0438\u043d\u0438 \u0445\u043e\u043d\u0430\u0434\u0430\u043d \u043a\u043e\u0447\u0438\u0448\u0433\u0430\u043d \u0448\u0435\u043a\u0438\u043b\u0438 \u0445\u0430 \u0430\u043d\u0438\u043a \u043a\u043e\u0447\u0438\u0448\u0433\u0430\u043d \u0445\u043e\u0437\u0438\u0440 \u044f\u043d\u0430 \u043c\u0430\u043d\u0437\u0438\u043b\u0430\u0440\u0438\u0433\u0430 \u043e\u043b\u0438\u0431 \u043a\u0435\u0442\u0438\u0448\u0430\u0434\u0438 \u0431\u0443\u043b\u0430\u0440\u0434\u0438\u044f\u043c \u0434\u0430\u0432\u043e\u043b\u0430\u0441\u0430 \u0431\u043e\u043b\u0430\u0434\u0438",
                    "author": "@\u041d\u0443\u0440\u0434\u0438\u043d\u043e\u0432\u0430656",
                    "likes": 0,
                    "publishedAt": "2026-04-27T03:40:19Z"
                },
                {
                    "text": "\u0422\u0430\u0432\u0431\u0430 \u043a\u0443\u0440\u043a\u0438\u0431 \u043a\u0435\u0442\u0434\u0438\u043c. \u041a\u0443\u0440\u0438\u0431 .",
                    "author": "@SamsungNomer",
                    "likes": 2,
                    "publishedAt": "2026-04-26T08:33:12Z"
                },
                {
