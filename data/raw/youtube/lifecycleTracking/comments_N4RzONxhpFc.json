        {
            "fetchedAt": "20260414_074036",
            "commentCount": 25,
            "comments": [
                {
                    "text": "\u5168\u3066\u306e\u65e5\u672c\u4eba\u304c\u5b66\u3076\u3079\u304d\u6559\u8a13\u304c\u5148\u306e\u5927\u6226\u306b\u306f\u6ea2\u308c\u3066\u3044\u308b\u3002",
                    "author": "@turbo_excellent",
                    "likes": 70,
                    "publishedAt": "2026-04-13T10:35:52Z"
                },
                {
                    "text": "\u300c\u304a\u308c\u306f\u6b7b\u306c\u4fc2\u3067\u306f\u306a\u3044\u300d\n\u3058\u3083\u3042\u4e00\u4f53\u4f55\u306e\u4fc2\u3060\u3063\u305f\u306e\u3060\u2026\u3002",
                    "author": "@\u67f3\u6cbc\u5149",
                    "likes": 64,
                    "publishedAt": "2026-04-13T12:33:27Z"
                },
                {
                    "text": "\u4f1a\u793e\u751f\u6d3b\u3067\u8cac\u4efb\u56de\u907f\u3059\u308b\u4e0a\u53f8\u306f\u6ca2\u5c71\u3044\u305f\u304c\u3001\u8cac\u4efb\u3092\u3068\u3063\u305f\u4e0a\u53f8\u306f\u7a00\u3067\u3057\u305f\u3002",
                    "author": "@kerokero1919",
                    "likes": 19,
                    "publishedAt": "2026-04-13T15:06:02Z"
                },
                {
                    "text": "\u4e2d\u6fa4\u4f51\u306b\u3064\u3044\u3066\u306f\u3001\u300c\u6d77\u8ecd\u306e\u63d0\u7763\u306e\u4e2d\u3067\u3001\u6700\u3082\u6709\u80fd\u3067\u6f54\u7656\u306a\u4eba\u7269\u3067\u3042\u3063\u305f\u300d\u3068\u3044\u3046\u8a55\u304c\u3042\u308b\u53cd\u9762\u3001\u7279\u653b\u4f5c\u6226\u3092\u71b1\u5fc3\u306b\u63a8\u9032\u3057\u305f\u3053\u3068\u3002\u7279\u653b\u4f5c\u6226\u306e\u8cac\u4efb\u3092\u5168\u3066\u5927\u897f\u7027\u6cbb\u90ce\u306b\u62bc\u3057\u3064\u3051\u3066\u81ea\u88c1\u3092\u62d2\u5426\u3057\u305f\u3053\u3068\u306a\u3069\u3001\u8a55\u4fa1\u304c\u5206\u304b\u308c\u3066\u3044\u307e\u3059",
                    "author": "@\u5e30\u96f2\u57ce",
                    "likes": 73,
                    "publishedAt": "2026-04-13T10:08:55Z"
                },
                {
                    "text": "\u6559\u8a13\u3002\u56fd\u306e\u305f\u3081\u5927\u7fa9\u306e\u305f\u3081\u3068\u8a00\u3063\u3066\u81ea\u5206\u306b\u72a0\u7272\u3092\u547d\u3058\u308b\u5974\u304c\u3044\u305f\u3089\u3001\u307e\u305a\u305d\u3044\u3064\u3092\u72a0\u7272\u306b\u3057\u3066\u304b\u3089\u56fd\u3084\u5927\u7fa9\u306e\u305f\u3081\u306b\u3069\u3046\u3059\u308b\u304b\u6c7a\u3081\u3088\u3046\u3002",
                    "author": "@atraksus",
                    "likes": 34,
                    "publishedAt": "2026-04-13T11:17:02Z"
                },
                {
                    "text": "\u4eba\u306e\u75db\u307f\u304c\u308f\u304b\u3089\u306a\u3044\u4eba\u9593\u306f\u3001\u3044\u3064\u306e\u6642\u4ee3\u3082\u30e1\u30c1\u30e3\u30af\u30c1\u30e3\u306a\u3053\u3068\u3092\u3059\u308b\u3057\u3001\u6a29\u529b\u3060\u3051\u306f\u3042\u308b\u30fb\u30fb\u30fb",
                    "author": "@Manga_Anime_study_club",
                    "likes": 18,
                    "publishedAt": "2026-04-13T11:55:18Z"
                },
                {
                    "text": "\u3053\u306e\u6559\u8a13\u306f\u672c\u5f53\u306b\u5927\u4e8b\u3060\ud83d\ude22",
                    "author": "@kinamori3752",
                    "likes": 31,
                    "publishedAt": "2026-04-13T10:44:26Z"
                },
                {
                    "text": "\u3053\u306e\u5148\u3001\u6226\u5f8c100\u904e\u304e\u3066\u3082\u3001\u5b50\u3005\u5b6b\u3005\u8511\u307e\u308c\u308b\u3093\u3060\u308d\u3046\u306a\u3002",
                    "author": "@analysis0505",
                    "likes": 19,
                    "publishedAt": "2026-04-13T12:13:19Z"
                },
                {
                    "text": "\u5b89\u5168\u5730\u5e2f\u306b\u3044\u308b\u4eba\u306e\u8a00\u3046\u4e8b\u306f\u7591\u3048\u3002\n\u4eca\u3067\u3082\u5171\u901a\u306e\u8a00\u3060\u3068\u601d\u3046\u306a\u2026\n\u5e38\u306b\u73fe\u5834\u3070\u304b\u308a\u82e6\u52b4\u3057\u305f\u308a\u547d\u304c\u3051\u306a\u3093\u3060\u3002",
                    "author": "@\u30b8\u30fc\u30cb\u30fc\u30c8\u30e2\u30e6\u30ad",
                    "likes": 12,
                    "publishedAt": "2026-04-13T14:51:02Z"
                },
                {
                    "text": "\u73fe\u4ee3\u306e\u9ad8\u7d1a\u5e79\u90e8\u81ea\u885b\u5b98\u306e\u3059\u3079\u3066\u304c\u3001\u6226\u5834\u306e\u73fe\u5834\u3092\u8eab\u3092\u3082\u3063\u3066\u306f\u77e5\u3089\u306a\u3044\u3002\n\u305d\u3057\u3066\u3001\u672a\u7d4c\u9a13\u306e\u4e0a\u5f79\uff08\u8001\u4eba\uff09\u304c\u3001\u90e8\u4e0b\uff08\u82e5\u4eba\uff09\u3092\u6b7b\u5730\u306b\u9001\u308b\u3068\u3044\u3046\u3002\n\u3053\u308c\u306f\u4ed5\u65b9\u306a\u3044\u3053\u3068\u3060\u3068\u306f\u601d\u3046\u3002\n\u3057\u304b\u3057\u3001\u5404\u65b9\u9762\u968a\u306e\u53f8\u4ee4\u90e8\u3084\u9632\u885b\u7701\u306b\u3044\u308b\u5e79\u90e8\u305f\u3061\u306f\u3001\u982d\u306e\u7247\u9685\u306b\u3053\u306e\u3053\u3068\u3092\u7f6e\u3044\u3066\u304a\u304f\u3079\u304d\u3060\u308d\u3046\u3002",
                    "author": "@arahard25017",
                    "likes": 19,
                    "publishedAt": "2026-04-13T11:17:52Z"
                },
                {
                    "text": "\u65e5\u672c\u3067\u306f\u91d1\u5132\u3051\u306e\u70ba\u306b\u3001\u7279\u653b\u968a\u54e1\u3092\u3084\u305f\u3089\u306b\u7f8e\u5316\u3057\u305f\u5546\u696d\u6620\u753b\u304c\u4f5c\u3089\u308c\u308b\u304c\u3001\u305d\u308c\u306f\u3080\u3057\u308d\u3001\u5974\u3089\u3001\u7279\u653b\u3092\u3055\u305b\u3066\u751f\u304d\u5ef6\u3073\u305f\u9023\u4e2d\u3084\u305d\u306e\u5b50\u5b6b\u5171\u306e\u7f6a\u60aa\u611f\u3092\u6d88\u3057\u53bb\u308a\u3001\u554f\u984c\u306e\u672c\u8cea\u3092\u96a0\u3057\u3001\u307e\u305f\u518d\u3073\u3001\u56fd\u6c11\u3092\u3001\u82e5\u8005\u3092\u8001\u4eba\u6307\u5c0e\u8005\u5171\u3092\u5b88\u308b\u70ba\u306e\u76fe\u306b\u3055\u308c\u308b\u5371\u967a\u6027\u3092\u751f\u307f\u51fa\u3057\u3066\u3044\u308b\u3002",
                    "author": "@marty3612",
                    "likes": 8,
                    "publishedAt": "2026-04-13T14:16:27Z"
                },
                {
                    "text": "\u3082\u3057\u7279\u653b\u306b\u884c\u304b\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u72b6\u6cc1\u3060\u3068\u3057\u3066\u3002\n\u305b\u3081\u3066\u5927\u897f\u307f\u305f\u3044\u306a\u4eba\u306e\u547d\u4ee4\u306e\u5143\u3001\u81ea\u5206\u306e\u547d\u3092\u5dee\u3057\u51fa\u3057\u3066\u51fa\u6483\u3057\u305f\u3044\u306a",
                    "author": "@\u5c0f\u898b\u90a6\u8a13",
                    "likes": 5,
                    "publishedAt": "2026-04-13T14:00:43Z"
                },
                {
                    "text": "\u3082\u3046\u4e8c\u5ea6\u3068\u65e5\u672c\u306f\u6226\u4e89\u306a\u3093\u304b\u3057\u306a\u3044\u3067\u307b\u3057\u3044",
                    "author": "@mitsuki-h6z",
                    "likes": 8,
                    "publishedAt": "2026-04-13T13:09:44Z"
                },
                {
                    "text": "\u5b87\u57a3\u307f\u305f\u3044\u306b\u4e00\u4eba\u3067\u6b7b\u306d\u305a\u82e5\u3044\u90e8\u4e0b\u3092\u9053\u9023\u308c\u306b\u3057\u305f\u5974\u3082\u3044\u308b\u3002\u610f\u5473\u308f\u304b\u3089\u3093\u2026",
                    "author": "@yuichiamasaki984",
                    "likes": 2,
                    "publishedAt": "2026-04-13T22:42:24Z"
                },
                {
                    "text": "\u65e5\u9732\u6226\u4e89\u306e\u59cb\u307e\u308b\u524d\u306b\u65e5\u672c\u306b\u5f37\u304f\u3067\u308b\u3079\u304d\u3060\u3068\u4e3b\u5f35\u3057\u305f\u306e\u306f\u30cb\u30b3\u30e9\u30a4\u4e8c\u4e16\u306e\u5468\u308a\u306b\u3044\u308b\u5bae\u5ef7\u95a2\u4fc2\u8005\u3067\u3001\u73fe\u5834\u306e\u8ecd\u4eba\u306f\u614e\u91cd\u306a\u4eba\u304c\u591a\u304f\u3001\u7279\u306b\u6d77\u8ecd\u306b\u591a\u304f\u5b58\u5728\u3057\u3066\u3044\u305f\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002",
                    "author": "@\u3072\u308d\u307f1997",
                    "likes": 6,
                    "publishedAt": "2026-04-13T11:21:16Z"
                },
                {
                    "text": "\u7121\u8077\u30cd\u30c8\u30a6\u30e8\u300c\u304a\u308c\u306f\u50cd\u304f\u4fc2\u3058\u3083\u306a\u3044\u304b\u3089\u300d",
                    "author": "@unithouse1",
                    "likes": 2,
                    "publishedAt": "2026-04-13T20:17:16Z"
                },
                {
                    "text": "\u4e2d\u6fa4\u306f\u6226\u5f8c\u30a2\u30e1\u30ea\u30ab\u6d77\u8ecd\u6a2a\u6ca2\u57fa\u5730\u306b\u52e4\u52d9\u3001\u9000\u8077\u5f8c\u306f\u5929\u4e0b\u308a\u305783\u6b73\u3067\u5929\u5bff\u3092\u5168\u3046",
                    "author": "@\u5927\u540d-f2f",
                    "likes": 19,
                    "publishedAt": "2026-04-13T09:55:01Z"
                },
                {
                    "text": "\uff1f\uff1f\uff1f\u300c\u4e0a\u5b98\u304c\u884c\u304f\u306a\u3089\u4ffa\u3082\u884c\u304f\u300d",
                    "author": "@ekoozuakuto3",
                    "likes": 0,
                    "publishedAt": "2026-04-13T21:58:23Z"
                },
                {
                    "text": "\u300c\u6b7b\u306c\u4fc2\u3058\u3083\u306a\u3044\u304b\u3089\u300d\u30ad\u30bf\u30fc(\uff9f\u2200\uff9f \u4e09 \uff9f\u2200\uff9f)\n\u5175\u968a\u306f\u6b7b\u306c\u4fc2\u3001\u6d77\u8ecd\u5175\u5b66\u6821\u51fa\u8eab\u306e\u30a8\u30ea\u30fc\u30c8\u306f\u51fa\u4e16\u3059\u308b\u4fc2(\u82e6\u7b11)\n\u307e\u3041\u8cac\u4efb\u306f\u53d6\u3089\u305b\u308b\u3082\u306e\u3067\u3001\u81ea\u5206\u3067\u53d6\u3063\u305f\u3089\u8ca0\u3051\u306a\u306e\u3067\u3042\u308b\u3002",
                    "author": "@\u9234\u6728\u8cb4\u53f8-t9p",
                    "likes": 1,
                    "publishedAt": "2026-04-13T21:02:46Z"
                },
                {
                    "text": "\u5207\u8179\u3068\u3044\u3046\u81ea\u6c7a\u306e\u65e5\u672c\u306e\u6163\u7fd2\u304c\u3001\u7279\u653b\u3068\u3044\u3046\u4f5c\u6226\u3092\u73fe\u5b9f\u306e\u3082\u306e\u306b\u3057\u305f\u306e\u304b\u3082\u77e5\u308c\u306a\u3044\u3002",
                    "author": "@\u307e\u307f\u308b-p3g",
                    "likes": 0,
                    "publishedAt": "2026-04-14T06:38:48Z"
                },
                {
                    "text": "\u5927\u897f\u4e2d\u5c06\u306f\u3001\u6551\u3044\u3067\u3057\u305f\u306d\u3002\u4ed6\u306f\u8a00\u3046\u307e\u3044\u30fb\u30fb\u30fb\u3054\u51a5\u798f\u3092\u304a\u7948\u308a\u7533\u3057\u4e0a\u3052\u307e\u3059\u3002",
                    "author": "@yasutielyasutiel6329",
                    "likes": 1,
                    "publishedAt": "2026-04-13T19:26:24Z"
                },
                {
                    "text": "\u3053\u3093\u306a\u3093\u3060\u304b\u3089\u8ca0\u3051\u305f\u3093\u3060\u3088\ud83d\ude22",
                    "author": "@sujakuyasuhiro",
                    "likes": 2,
                    "publishedAt": "2026-04-13T13:01:07Z"
                },
                {
                    "text": "\u30ec\u30a4\u30c6\u5f53\u6642\u306e\u53c2\u8b00\u7dcf\u9577\u306f\u53ca\u5ddd\u3001\u5929\u4e00\u53f7\u3082\u53ca\u5ddd\u304c\u767a\u7aef\u3060\u3057\u3001\u5c0f\u6fa4\u306b\u4e38\u6295\u3052\u3057\u3066\u3044\u308b\u3002",
                    "author": "@omizo-p2t",
                    "likes": 1,
                    "publishedAt": "2026-04-13T11:57:19Z"
                },
                {
                    "text": "\u5143\u30cd\u30bf\u306e\u795e\u7acb\u5c1a\u7d00\u300e\u300c\u4ffa\u306f\u6b7b\u306c\u4fc2\u3058\u3083\u306a\u3044\u304b\u3089\u300d\u2026\u7279\u653b\u4f5c\u6226\u3092\u63a1\u7528\u3057\u305f\u7537\u304c\u3001\u7d42\u6226\u76f4\u5f8c\u306b\u8a00\u3044\u653e\u3063\u305f\u300c\u885d\u6483\u7684\u306a\u8a00\u8449\u300d\u300f\u306b\u306f\u3053\u3046\u3042\u308b\u3002\n\uff1e\u5143\u9632\u885b\u7701\u9632\u885b\u7814\u7a76\u6240\u4e3b\u4efb\u7814\u7a76\u5b98\u30fb\u67f4\u7530\u6b66\u5f66\u6c0f\u306b\u3088\u308b\u3068\u3001\u9678\u8ecd\u95a2\u4fc2\u306e\u8a18\u8ff0\u306f\u5931\u6557\u3078\u306e\u53cd\u7701\u3082\u542b\u3081\u3066\u6bd4\u8f03\u7684\u6b63\u76f4\u306b\u8a18\u3055\u308c\u3066\u3044\u308b\u306e\u306b\u5bfe\u3057\u3001\u6d77\u8ecd\u95a2\u4fc2\u306e\u8a18\u8ff0\u306f\u3001\u5143\u9ad8\u5b98\u304b\u3089\u7de8\u7e82\u5b98\u3078\u306e\u5727\u529b\u304c\u975e\u5e38\u306b\u5f37\u304f\u3001\u66f8\u304f\u3079\u304d\u3053\u3068\u304c\u66f8\u3051\u306a\u304b\u3063\u305f\u306e\u3060\u3068\u3044\u3046\u3002",
                    "author": "@whitepandajp",
                    "likes": 0,
                    "publishedAt": "2026-04-14T05:09:22Z"
                },
                {
                    "text": "\u5927\u897f\u4e2d\u5c06\u306f\u3001\"\u6709\u8a00\u5b9f\u884c\"\u3067\u306f\u306a\u304f\u3001\"\u7121\u8a00\u5b9f\u884c\"\u306e\u4eba\u3002",
                    "author": "@\u5211\u90e8\u7345\u5b50\u4e38-i5w",
