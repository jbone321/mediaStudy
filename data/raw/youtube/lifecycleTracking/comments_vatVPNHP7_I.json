                {
                    "text": "\u9006\u306b\u8a00\u3048\u3070\u3001\u8089\u4f53\u304c\u529b\u5c3d\u304d\u308b\u307e\u3067\u7cbe\u795e\u306f\u4e00\u5207\u5c48\u3057\u3088\u3046\u3068\u3057\u306a\u304b\u3063\u305f\u3002\n\u3069\u3053\u307e\u3067\u3082\u5f37\u3044\u6226\u58eb\u3060\u3002",
