                {
                    "text": "\u6298\u308c\u305a\u3001\u529b\u5c3d\u304d\u308b\u307e\u3067\u4f7f\u547d\u3092\u5168\u3046\u3057\u3066\u4ea1\u304f\u306a\u3063\u305f\u306e\u306f\u5b8c\u5168\u306a\u308b\u6b66\u58eb\u9053\u3092\u8cab\u3044\u305f\u6f22\n\n\u6b7b\u3093\u3060\u3053\u3068\u3092\u7f8e\u5316\u3059\u308b\u3064\u3082\u308a\u306f\u306a\u3044\u3002\n\u305f\u3060\u4f7f\u547d\u306b\u80cc\u304b\u305a\u3001\u9001\u308a\u51fa\u3057\u305f\u751f\u5f92\u3089\u306b\u6559\u3048\u305f\u3067\u3042\u308d\u3046\u6559\u8a13\u3092\u547d\u3092\u6301\u3063\u3066\u6210\u3057\u9042\u3052\u305f\u3002\u79c1\u306f\u305d\u306e\u4e0d\u5c48\u306e\u7cbe\u795e\u3092\u5c0a\u656c\u3059\u308b\u3002",
