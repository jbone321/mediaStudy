                {
                    "text": "\u5f7c\u306e\u5144\u5f1f\u4ee5\u5916\u306e\u89aa\u65cf\u95a2\u4fc2\u3084\u59bb\u5b50\u304c\u3044\u305f\u304b\u3069\u3046\u304b\u306e\u60c5\u5831\u3082\u306a\u3044\u306a\u3002\n\u3055\u3059\u304c\u30b9\u30d1\u30a4\u30de\u30b9\u30bf\u30fc\u3002",
