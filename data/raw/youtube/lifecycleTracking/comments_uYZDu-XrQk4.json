                },
                {
                    "text": "\u0413\u0440\u0443\u043f\u043f\u0430 \u041f\u043e\u0437\u0438\u0442\u0438\u0432\u0430. \u041e\u0442\u043b\u0438\u0447\u043d\u044b\u0439 \u0444\u0430\u043d\u043a",
                    "author": "@\u0418\u0432\u0430\u043d\u0411\u0435\u0441\u0444\u0430\u043c\u0438\u043b\u044c\u043d\u044b\u0439-\u04345\u0431",
