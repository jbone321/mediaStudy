                },
                {
                    "text": "\u041d\u0438\u0447\u0435\u0433\u043e \u0441\u0435\u0431\u0435 \u0421\u0435\u0440\u0451\u0433\u0430 \u0421\u0438\u043c\u043e\u043d\u043e\u0432 \u043f\u043e\u0445\u043e\u0440\u043e\u0448\u0435\u043b!",
                    "author": "@Alexandr_Shtern",
                    "likes": 5,
                    "publishedAt": "2026-04-30T07:38:11Z"
                },
                {
                    "text": "\u0422\u044b \u043b\u044e\u0431\u0438\u0448\u044c \u0444\u0430\u043d\u043a, \u0434\u0435\u0442\u043a\u0430!",
                    "author": "@maraks7924",
                    "likes": 1,
                    "publishedAt": "2026-04-30T16:08:54Z"
                },
                {
                    "text": "\u042f, \u043a\u0430\u043a \u0437\u0443\u043c\u0435\u0440, \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0444\u0430\u043d\u043a, \u0440\u043e\u043a \u0438 \u043c\u0435\u0442\u0430\u043b \u0438 \u0441\u043b\u0443\u0448\u0430\u044e \u044d\u0442\u0443 \u043c\u0443\u0437\u044b\u043a\u0443 \u0443\u0436\u0435 \u043b\u0435\u0442 \u0448\u0435\u0441\u0442\u044c. \u0418 \u043a\u043e\u0433\u0434\u0430 \u044f \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u044e, \u0447\u0442\u043e \u0432 2020 \u0433\u043e\u0434\u0443 \u0441\u043b\u0443\u0448\u0430\u043b \u0442\u0430\u043a\u0443\u044e \u043c\u0443\u0437\u044b\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u0435\u0439\u0447\u0430\u0441, \u0435\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0443, \u043c\u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u043f\u043b\u043e\u0445\u043e, \u0441\u0440\u0430\u0437\u0443 \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c Ich will, Wait and Bleed \u0438\u043b\u0438 Superstition \u0438 \u043d\u0430 \u0434\u0443\u0448\u0435 \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043b\u0435\u0433\u0447\u0435. \u042f \u043e\u0447\u0435\u043d\u044c \u0431\u043b\u0430\u0433\u0430\u0434\u0430\u0440\u0435\u043d \u043c\u043e\u0435\u043c\u0443 \u041e\u0442\u0446\u0443, \u0447\u0442\u043e \u043e\u043d \u043c\u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u044d\u0442\u0438 \u0436\u0430\u043d\u0440\u044b \u043c\u0443\u0437\u044b\u043a\u0438",
                    "author": "@VITRIUK",
                    "likes": 3,
                    "publishedAt": "2026-04-29T21:05:57Z"
                },
                {
                    "text": "\u041c\u043e\u0435\u0433\u043e \u043b\u0438\u0431\u043e\u0433\u043e \u0424\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b)))\u043e\u0431\u043e\u0436\u0430\u044e \u0420\u0425\u0427\u041f.\u0441\u043f\u0430\u0441\u0438\u0431\u043e)",
                    "author": "@loddduiefow",
                    "likes": 1,
                    "publishedAt": "2026-04-30T13:09:56Z"
                },
                {
                    "text": "\u041d\u0430\u043a\u043e\u043d\u0435\u0446 \u0442\u043e \u043a\u0442\u043e \u0442\u043e \u044d\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b",
                    "author": "@Dhbehdjdbdbejhdvrbd",
                    "likes": 1,
                    "publishedAt": "2026-04-30T11:50:14Z"
                },
                {
                    "text": "\u041e\u043a\u0430\u043a \u0441\u0442\u043e\u0438\u043b\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430 \u0431\u0430\u0441\u0443 - \u0432 \u043b\u0435\u043d\u0442\u0435 \u0443 \u043c\u0435\u043d\u044f \u043d\u0430\u0447\u0430\u043b \u043f\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0444\u0430\u043d\u043a, \u043f\u0440\u0438\u0447\u0435\u043c \u0437\u0430\u0431\u0430\u0432\u043d\u043e \u0447\u0442\u043e \u0440\u0443\u0441\u0441\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0439 - \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0436\u0430\u043d\u0440 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0433\u0434\u0435-\u0442\u043e \u0432 \u0430\u043d\u043d\u0430\u043b\u0430\u0445 \u0430\u043d\u0433\u043b\u043e\u044f\u0437\u044b\u0447\u043d\u043e\u0439 \u0438\u043d\u0434\u0438 \u043c\u0443\u0437\u044b\u043a\u0438",
                    "author": "@dmitryssss424",
                    "likes": 1,
                    "publishedAt": "2026-04-30T20:37:15Z"
                },
                {
                    "text": "\u042f \u0437\u0443\u043c\u0435\u0440, \u043d\u043e \u043f\u0440\u043e \u0442\u0435\u0431\u044f \u0437\u043d\u0430\u043b \u0435\u0449\u0451 \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u0440\u043e\u043b\u0438\u043a\u0430, \u043a\u0430\u043a \u0438 \u0432 \u0446\u0435\u043b\u043e\u043c \u043f\u0440\u043e \u0444\u0430\u043d\u043a. \u041c\u044b, \u0437\u0443\u043c\u0435\u0440\u044b \u0431\u044b\u0432\u0430\u0435\u043c \u043e\u0447\u0435\u043d\u044c \u0440\u0430\u0437\u043d\u044b\u0435 \ud83d\ude09",
                    "author": "@graas_emile",
