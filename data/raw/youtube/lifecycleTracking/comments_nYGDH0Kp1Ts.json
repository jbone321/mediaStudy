            "comments": [
                {
                    "text": "\"\ubb50\ub4e0\uc9c0 \ubd88\ub9ac\ud55c \uc0c1\ud669\uc774 \ub098\uc62c\ub54c \uae30\uc138\ub85c \ubc00\uc5b4\ubd99\uc5ec\ub77c\"-by \uc5d0\uc774\ubbf8 \ud30d",
                    "author": "@SVTmcarat0526",
                    "likes": 286,
                    "publishedAt": "2026-03-22T13:55:09Z"
                },
                {
                    "text": "\uc591\uc2dd \uc170\ud504\ub4e4\uc774 \uc911\uc2dd \ud560\ub54c\ub294 \ubc15\uc740\uc601\uc5d0 \uae40\ud48d \uc815\ub3c4\ub9cc \ud6c8\uc218 \uac00\ub2a5\ud55c\ub370 \ud558\ud544 \ub300\ubd80\ubd84 \uc591\uc2dd \uc170\ud504\ub4e4\uc774\ub77c\uc11c \ubc15\uc740\uc601\uc774 \uc591\uc2dd \uac74\ub4dc\ub9b4\ub54c\ub9c8\ub2e4 \ud6c8\uc218 \ud3ed\ubc1c\ud568 \u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@\uad34\ub77c\ub294\ub098\ubb3c\uc4f0",
                    "likes": 157,
                    "publishedAt": "2026-03-22T14:40:14Z"
                },
                {
                    "text": "\uc800 \uc815\ub3c4 \uae30\uc138\uba74 \uc694\ub9ac\uac00 \uc544\ub2cc \ub2e4\ub978 \uc77c\uc744 \ud588\uc5b4\ub3c4 \uc131\uacf5 \ud588\uc744\ub4ef\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@lovesick0607",
                    "likes": 150,
                    "publishedAt": "2026-03-22T13:57:45Z"
                },
                {
                    "text": "\uc5d0\uc774\ubbf8\ud30d\uc758 \uae30\uac1c\uc591\uc2dd \n\u314b\u314c\u314c\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@\uc774\ub9ac\ucf64-u1m",
                    "likes": 128,
                    "publishedAt": "2026-03-22T14:04:47Z"
                },
                {
                    "text": "8:30  \uc790\ub9c9 \ubbf8\ucce4\ub0d0 \u314b\u314b\u314b \uc8fc\uc804\uc790\ucc98\ub7fc \uc6c3\ub2e4\ub2c8 \u314b\u314b\u314b\u314b\u314b \uadfc\ub370 \uc9c4\uc9dc \ub611\uac19\ub124",
                    "author": "@\ubbf8\ucd78-v4z",
                    "likes": 53,
                    "publishedAt": "2026-03-22T14:34:18Z"
                },
                {
                    "text": "14:27 \ub108\ubb34 \ubcc0\ud574\ubc84\ub9b0 \ubc15\uc740\uc601\uc18a \u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@\uc815\uc6b0\uc9c4-e3o",
                    "likes": 79,
                    "publishedAt": "2026-03-22T14:13:42Z"
                },
                {
                    "text": "15:03 \u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b \ud588\ub2f5\ub2c8\ub2e4?\u314b\u314b\u314b\u314b\u314b\u314b \uc544 \ub0c9\ubd80 \uc81c\uc791\uc9c4 \uc9c4\uc9dc \uca50\ub2e4\ub2c8\uae4c\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@\uc54c\uc640\uc774\uc720",
                    "likes": 65,
                    "publishedAt": "2026-03-22T14:05:09Z"
                },
                {
                    "text": "\uc544\ub2c8 \uc624\ub298 \uc724\ub0a8\ub178 \uc694\ub9ac \uadf8\ub0e5 \ub9c8\ub2c8\ub610\uc5d0\uc11c \ud588\ub358 \ub808\uc2dc\ud53c \uadf8\ub300\ub85c\uc796\uc544 \u314b\u314b\u314b",
                    "author": "@\uc720\ub9b0\uae30-k1u",
                    "likes": 94,
                    "publishedAt": "2026-03-22T13:56:49Z"
                },
                {
                    "text": "\uc724\ub0a8\ub178\uc758 \ucc9c\uc801 \uae40\ud48d\uc5d0\uac8c \uc5f0\uc804\uc5f0\uc2b9\ud558\ub294 \ubc15\uc740\uc601\uc744 \ub610 \uaebe\uc740 \uc724\ub0a8\ub178\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@\ud53c\uace4\ud56811",
                    "likes": 28,
                    "publishedAt": "2026-03-22T14:33:22Z"
                },
                {
                    "text": "\ubc15\uc740\uc601 \uc170\ud504\ub2d8 \uc5d0\uc774\ubbf8 \ud30d \ub420 \ub54c\ub9c8\ub2e4 \uc8fc\ubcc0 \uc170\ud504\ub2d8\ub4e4\uaed8 \uc9c0\uc801 \ub4e4\uc5b4\uc624\ub294\ub370 \uae30\uc138\ub85c \ubab0\uace0 \uac00\uc2dc\ub294 \uac70 \ub118 \uc7ac\ubc0c\uc74c\ud83d\ude02 \uc774 \uce90\ubbf8 \ub108\ubb34 \uc88b\uc74c\u2764",
                    "author": "@minmu_",
                    "likes": 56,
                    "publishedAt": "2026-03-22T13:52:34Z"
                },
                {
                    "text": "\uc911\uc2dd\ub300\uc804\ub3c4 \ud574\uc8fc\uc138\uc694!! \n\uc740\uc601\uc18a\uc774 \ucfe0\uc0ac\ub9ac \ub123\ub294\uac70 \ubcf4\uace0\uc2f6\uc5b4\uc694\u3160\u3160\u314b\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@pupppppie",
                    "likes": 69,
                    "publishedAt": "2026-03-22T13:57:25Z"
                },
                {
                    "text": "\ud3c9\uc18c\uc5d0\ub294 \ucda4\ucd9c\ub54c\ub9cc \ub3cc\uc544\uc788\ub294\ub370 \uc5d0\uc774\ubbf8 \ud30d \ub098\uc624\uba74 \uc694\ub9ac\ub3c4 \ub3cc\uc544\uc788\uc74c\u314b\u314b\u314b \uc544 \ub098\uc911\uc5d0 \uc5d0\uc774\ubbf8 \ud30d \uae30\uc138\uc591\uc2dd \ubaa8\uc74c\uc9d1 \uc62c\ub77c\uc654\uc73c\uba74 \uc88b\uaca0\ub2e4",
                    "author": "@bluewhite_sky",
                    "likes": 24,
                    "publishedAt": "2026-03-22T14:09:14Z"
                },
                {
                    "text": "\uc774\uac70 \uac00\uc704\ubc14\uc6cc\ubcf4 \uc0dd\uac01\ub098\ub124 \uc724\ub0a8\ub178\ub97c \uc774\uae30\ub294 \uae40\ud48d\uc744 \uc774\uae34 \ubc15\uc740\uc601\uc744 \uc774\uae30\ub294 \uc724\ub0a8\ub178",
                    "author": "@\uc5d8\ub9ac\uc624\uc2a4-g9y",
                    "likes": 17,
                    "publishedAt": "2026-03-22T14:42:45Z"
                },
                {
                    "text": "\ud3ed\uc8fc\ud558\ub294 \uc6cd\ud14c\uce74\ub808 & \ud3ed\uc8fc\ud558\ub294 \ud3ed\uc2dd\uc758 \uc170\ud504!",
                    "author": "@Vinchaud-MulledWine",
                    "likes": 23,
                    "publishedAt": "2026-03-22T14:23:08Z"
                },
                {
                    "text": "\ubc15\uc740\uc601 \uac00\ub77c\uc0ac\ub300: \uc694\ub9ac\ub294 \uae30\uc138\ub2e4",
                    "author": "@yudyrifu458",
                    "likes": 31,
                    "publishedAt": "2026-03-22T13:56:13Z"
                },
                {
                    "text": "\uc815\ud1b5\uc740 \ubcf8\uc778\ub4e4 \uc5c5\uc7a5\uc5d0\uc11c \ud558\uc2dc\uace0.. \ub0c9\ubd80\uc5d0\uc11c\ub9cc\ud07c\uc740 \uaecd\ub370\uae30\uc5d0\uc11c \ubc97\uc5b4\ub098\uc11c \ud558\uace0\uc2f6\uace0 \ud574\ubcf4\uace0 \uc2f6\uc740\uac70 \ub2e4 \ud574\uc8fc\uae38.. \uc694\ub9ac\uac15\uc88c\ud504\ub85c\uadf8\ub7a8\uc774 \uc544\ub2c8\uace0 \uc608\ub2a5\ud504\ub85c\uadf8\ub7a8\uc774\uc796\uc544\uc694.",
                    "author": "@\uc0bc\uac01\uc885",
                    "likes": 8,
                    "publishedAt": "2026-03-22T15:13:29Z"
                },
                {
                    "text": "\ud5c8\uc170\ud504 \uc911\uc2dd \ud55c\ubc88 \ud574\ubd05\uc2dc\ub2e4",
                    "author": "@\uc774\ub9ac\ucf64-u1m",
                    "likes": 30,
                    "publishedAt": "2026-03-22T14:09:58Z"
                },
                {
                    "text": "\uc544 \uc774\ub7f4\uac70\uba74 \uc911\uc2dd\ud2b9\uc9d1\ub3c4 \ud574\uc918\ub77c \u314b\u314b\u314b\u314b\u314b",
                    "author": "@sone_zzz",
                    "likes": 5,
                    "publishedAt": "2026-03-22T14:41:23Z"
                },
                {
                    "text": "\uc5d0\uc774\ubbf8\ud30d \ud3fc \ubbf8\uccd0\ub530 \u314b\u314b\u314b\u314b \uc694\uc998 \uad8c\uc131\uc900\ubcf4\ub2e4 \ub354 \uc6c3\uae40\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b",
                    "author": "@kupsir-snulaw",
                    "likes": 19,
                    "publishedAt": "2026-03-22T14:12:42Z"
                },
                {
                    "text": "\uc724\ub0a8\ub178 win \ub098\uc62c \ub54c \uac19\uc774 \uc18c\ub9ac\uc9c0\ub984 \u314b\u314b\u314b\u314b\u314b\u314b\n\ub4dc\ub514\uc5b4 \uc2dc\uc98c \uccab \ubcc4!!!",
                    "author": "@oisieeramen1310",
                    "likes": 7,
                    "publishedAt": "2026-03-22T14:35:06Z"
                },
                {
                    "text": "\ub9e4\ubc88 \ubd88\ub9ac\ud55c \uc0c1\ud669\uc5d0 \ub3c4\uc6c0(?) \ub420 \uc218 \uc788\ub294 \uc5d0\uc774\ubbf8\ud30d\uc801\uc0ac\uace0 \uc798 \ubc30\uc6b0\uace0 \uac11\ub2c8\ub2e4!!",
                    "author": "@jdlibach",
                    "likes": 1,
                    "publishedAt": "2026-03-22T15:39:01Z"
                },
                {
                    "text": "\uba3c \uc774\ud0dc\ub9ac\uc5d0\uc11c \ub118\uc5b4\uc628 \uc5d0\uc774\ubbf8\ud30d, \ub0af\uc120 \ud55c\uad6d\ub545\uc5d0\uc11c \ub0a8\ub4e4\uc5d0\uac90 \uc0dd\uc18c\ud560 \uc218 \uc788\ub294 \uc774\ud0dc\ub9ac \uc0c1\ud558\uc774 \ucef4\ud15c\ud3ec\ub7ec\ub9ac \uc694\ub9ac\ub97c \uc120\ubcf4\uc774\ub290\ub77c \uace0\uc0dd\uc774 \ub9ce\uc73c\uc2ed\ub2c8\ub2e4. \ud56d\uc0c1 \uc751\uc6d0\ud569\ub2c8\ub2e4. \uc5d0\uc774\ubbf8 \ud30d \ud654\uc774\ud305 !!",
                    "author": "@yihyeonmin153",
                    "likes": 1,
                    "publishedAt": "2026-03-22T15:53:42Z"
                },
                {
                    "text": "\uc5b4 \uc800\uac70 \uc804\ubcf5 \ub5a1\uac08\ube44 \uc5b4\ub514\uc11c \ubd24\uc81c? \ud588\ub294\ub370 \ub9c8\ub2c8\ub610 \ud074\ub7fd\uc5d0\uc11c \ubcf8\uac70\uc600\ub124 \u314b\u314b\u314b",
                    "author": "@gon-f6c",
                    "likes": 3,
                    "publishedAt": "2026-03-22T15:08:44Z"
                },
                {
                    "text": "\uc544 \u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b\u314b \ubc15\uc740\uc601 \ub0b4 \uc6c3\uc74c\ubc84\ud2bc",
