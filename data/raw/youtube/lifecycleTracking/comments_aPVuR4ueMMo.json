                {
                    "text": "\ud83c\udfbb\ud83d\udc90\ud83c\udf0c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0435",
                    "author": "@Nikola-239",
                    "likes": 0,
