                    "likes": 2,
                    "publishedAt": "2026-04-06T16:43:06Z"
                },
                {
                    "text": "\u041d\u0430\u0441\u0442\u044f \u043a\u0440\u0430\u0441\u0438\u0432\u043e \u0441\u043f\u0435\u043b\u0430! \u2665\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f",
                    "author": "@\u0415\u0432\u0433\u0435\u043d\u0438\u0439\u0415\u0433\u043e\u0440\u043e\u0432-\u044c2\u043c",
                    "likes": 1,
                    "publishedAt": "2026-04-06T19:19:24Z"
                },
                {
                    "text": "\u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f \u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435, \u0441 \u043c\u0435\u043d\u044f \u043b\u0430\u0439\u043a!\ud83d\udc4d\ud83c\udffb\u2764\ufe0f",
                    "author": "@AldiyarAkhmetov2004",
                    "likes": 3,
                    "publishedAt": "2026-04-06T15:44:44Z"
                },
                {
                    "text": "\u041e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f, \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u043e\u0442\u0430 \u0438\u043c\u0435\u0435\u0442 \u0421\u0442\u0435\u0439\u043b\u0430, \u041f\u0440\u0438\u0432\u0435\u0442\u2764",
                    "author": "@ArturoRold\u00e1nG\u00f3mez",
                    "likes": 2,
                    "publishedAt": "2026-04-06T16:08:38Z"
                },
                {
                    "text": "\u041a\u0430\u043a \u044d\u0442\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u2764",
                    "author": "@sanguinnik",
                    "likes": 2,
                    "publishedAt": "2026-04-06T15:57:31Z"
                },
                {
                    "text": "\u0417\u0434\u043e\u0440\u043e\u0432\u043e, \u043a\u0440\u0443\u0442\u043e\u0439 \u0448\u043e\u0440\u0442\u0441\u0438\u043a \ud83c\udfb6\ud83d\udd25\ud83d\udc96\u263a\ufe0f",
