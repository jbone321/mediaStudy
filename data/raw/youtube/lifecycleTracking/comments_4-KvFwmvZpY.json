                {
                    "text": "\u591a\u7530\u99ff\u306f\u3001\u65e5\u4e2d\u6226\u4e89\u62e1\u5927\u8ad6\u8005\u306e\u6771\u6761\u82f1\u6a5f\u3068\u6fc0\u3057\u304f\u5bfe\u7acb\u3057\u3066\u3001\u6700\u7d42\u7684\u306b\u4e88\u5099\u5f79\u306b\u7de8\u5165\u3055\u308c\u307e\u3057\u305f\u3002\u65e5\u7c73\u958b\u6226\u5f8c\u306f\u3001\u4e88\u5099\u5f79\u306b\u7de8\u5165\u3055\u308c\u305f\u4eba\u7269\u306e\u591a\u304f\u304c\u3001\u8ecd\u306b\u5fa9\u5e30\u3057\u307e\u3057\u305f\u304c\u3001\u591a\u7530\u306b\u58f0\u304c\u304b\u304b\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f",
