                },
                {
                    "text": "\uff2e\uff28\uff2b\u306e\u30c9\u30e9\u30de\u3067\u306f\u60aa\u5f79\u6271\u3044\u3055\u308c\u307e\u3057\u305f\u306d\u3002\u3072\u3069\u3044",
                    "author": "@akkun-rq2nw",
                    "likes": 0,
                    "publishedAt": "2026-04-21T23:18:55Z"
                },
                {
                    "text": "\u81ea\u5206\u6240\u306e\u6749\u5c71\u304c\u3084\u308b\u6c17\u6e80\u3005\u4f55\u3060\u304c\u3002\u307e\u305a\u3001\u9678\u8ecd\u5927\u81e3\u3092\u3069\u3046\u306b\u304b\u305b\u3044\u3088\u3002",
