                    "likes": 0,
                    "publishedAt": "2026-04-22T01:30:19Z"
                },
                {
                    "text": "\u56fd\u6c11\u515a\u8ecd\u306e\u848b\u4ecb\u77f3\u3092\u5473\u65b9\u306b\u53d6\u308a\u8fbc\u307e\u306a\u304b\u3063\u305f\u6642\u70b9\u3067\u6ce5\u6cbc\u5316\u306f\u56de\u907f\u51fa\u6765\u306a\u304b\u3063\u305f\u2026\u6ce5\u6cbc\u306e\u4e2d\u56fd\u6226\u7dda\u3092\u62b1\u3048\u5bfe\u7c73\u958b\u6226\u306f\u7121\u8b00\u3059\u304e\u308b\u2026",
                    "author": "@hiro-dd9fv",
                    "likes": 3,
                    "publishedAt": "2026-04-21T21:05:05Z"
                },
                {
                    "text": "\u6e80\u5dde\u304c\u3042\u306e\u5834\u6240\u306b\u3042\u308c\u3070\u3001\u6771\u30a2\u30b8\u30a2\u306e\u5e73\u548c\u3068\u5b89\u5b9a\u306f\u304b\u306a\u308a\u5927\u304d\u304b\u3063\u305f\u306e\u306b\u3001\u30a2\u30e1\u30ea\u30ab\u3082\u6b27\u5dde\u3082\u30b9\u30bf\u30fc\u30ea\u30f3\u30fb\u848b\u4ecb\u77f3\u30fb\u6bdb\u6ca2\u6771\u306b\u52a0\u62c5\u3057\u3066\u5f8c\u306b\u5927\u304d\u306a\u798d\u6839\u3092\u6b8b\u3057\u305f\u306a",
                    "author": "@\u30da\u30cb\u30b7\u30ea\u30f3-h6f",
                    "likes": 1,
                    "publishedAt": "2026-04-22T00:31:05Z"
                },
                {
                    "text": "\u7c73\u5185\u5149\u653f\u3063\u3066\u3001\u7d42\u6226\u5de5\u4f5c\u306b\u547d\u5f35\u3063\u305f\u306e\u306f\u8a8d\u3081\u308b\u3051\u3069\u3001\u7d42\u6226\u9593\u969b\u3067\u3082\u8f9e\u8077\u3092\u30d6\u30e9\u30d5\u306b\u4f7f\u3063\u3066\u963f\u5357\u9678\u8ecd\u5927\u81e3\u306b\u7a98\u3081\u3089\u308c\u305f\u308a\u3057\u3066\u3066\u3001\u6614\u307b\u3069\u826f\u3044\u5370\u8c61\u304c\u6301\u3066\u306a\u304f\u306a\u3063\u3066\u308b\u3002",
                    "author": "@\u30c9\u30a5\u30c9\u30a5\u30c9\u30a5\u30d5\u30a7\u30c9\u30a5",
                    "likes": 1,
                    "publishedAt": "2026-04-21T22:59:07Z"
                },
                {
                    "text": "\u548c\u5e73\u4ea4\u6e09\u3068\u3044\u3046\u304c\u5357\u4eac\u3092\u843d\u3068\u3057\u305f\u6642\u70b9\u3067\u65e5\u672c\u306e\u52dd\u5229\n\u5357\u4eac\u306f\u6c6a\u5146\u9298\u306b\u4efb\u305b\u3066\u6df1\u8ffd\u3044\u305b\u305a\u306b\u6e80\u5dde\u3078\u51f1\u65cb\u3059\u308c\u3070\u3044\u3044\u3060\u3051",
                    "author": "@QBK48",
                    "likes": 3,
                    "publishedAt": "2026-04-21T14:02:54Z"
                },
                {
                    "text": "\u68ee\u7e41\u4e45\u5f25\u4f0a\u85e4\u535a\u6587",
