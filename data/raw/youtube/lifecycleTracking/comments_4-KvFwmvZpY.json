                    "likes": 2,
                    "publishedAt": "2026-04-21T18:04:47Z"
                },
                {
                    "text": "\u3053\u306e\u4eba\u3082\u6771\u689d\u306b\u7768\u307e\u308c\u3001\u4e88\u5099\u5f79\u306b\u56de\u3055\u308c\u305f\u306e\u304b\u2026\u3002",
