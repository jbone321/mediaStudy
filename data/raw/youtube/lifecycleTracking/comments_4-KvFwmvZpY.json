                },
                {
                    "text": "\u6b63\u3057\u3044\u3053\u3068\u3092\u4e3b\u5f35\u3059\u308b\u4eba\u306f\u3069\u3093\u306a\u4e16\u306e\u4e2d\u3067\u3082\u8ffd\u3044\u3084\u3089\u308c\u3066\u3057\u307e\u3046\u3002\u8ffd\u3044\u3084\u308b\u5974\u306f\u81ea\u5206\u304c\u9593\u9055\u3063\u3066\u3044\u308b\u3053\u3068\u304c\u4e16\u9593\u306b\u4f1d\u308f\u308b\u524d\u306b\u6d88\u305d\u3046\u3068\u3059\u308b\u3002\u5e73\u548c\u306a\u4e16\u306e\u4e2d\u3067\u3082\u540c\u3058\u3002\u7406\u4e0d\u5c3d\u3060",
                    "author": "@akioe95",
                    "likes": 7,
                    "publishedAt": "2026-04-21T16:46:30Z"
                },
                {
                    "text": "\u7c73\u5185\u304c\u5bfe\u7c73\u306e\u6587\u8108\u3067\u8a55\u4fa1\u3055\u308c\u304c\u3061\u3060\u3051\u3069\u7d50\u5c40\u3053\u3044\u3064\u304c\u5927\u5143\u306e\u5f15\u304d\u91d1\u3072\u3044\u305f\u3088\u3046\u306a\u3082\u3093\u3084\u304b\u3089\u7d50\u5c40\u306f\u677e\u5ca1\u3084\u6771\u689d\u3068\u540c\u3058\u7a74\u306e\u72e2",
                    "author": "@timothyshen6235",
                    "likes": 9,
                    "publishedAt": "2026-04-21T12:40:49Z"
                },
                {
                    "text": "\u65e5\u4e2d\u6226\u4e89\u306f\u5927\u6771\u4e9c\u6226\u4e89\u958b\u6226\u524d\u3067\uff11\uff16\u4e07\u4eba\u306e\u6226\u6ca1\u8005\u3092\u51fa\u3057\u3066\u304a\u308a\u3001\u65e5\u9732\u6226\u4e89\u6226\u6ca1\u8005\u306e\u7d04\u4e09\u500d\u8fd1\u304f\u3092\u51fa\u3057\u3066\u4f55\u3068\u3082\u306a\u3044\u3068\u306f\u8a00\u3048\u306a\u3044\u72b6\u6cc1\u3067\u3001\u6771\u689d\u306b\u81f3\u3063\u3066\u306f\u300c\u3053\u3053\u3067\u596e\u8d77\u305b\u306d\u3070\uff11\uff16\u4e07\u4eba\u306e\u82f1\u970a\u306b\u3042\u3044\u3059\u307e\u3093\u3002\u300d\u3068\u8fd1\u885b\u5185\u95a3\u306e\u9678\u8ecd\u5927\u81e3\u3060\u3063\u305f\u9803\u306b\u8a00\u660e\u3057\u3001\u3055\u3089\u306b\u5927\u304d\u306a\u6226\u4e89\u3092\u62db\u304f\u8981\u56e0\u306b\u306a\u3063\u305f\u3002",
