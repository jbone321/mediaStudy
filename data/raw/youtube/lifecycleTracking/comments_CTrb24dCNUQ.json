                {
                    "text": "\u0985\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u098f\u0995\u099f\u09bf.\u0997\u09be\u09a8 \u2764. \u0986\u09b0\u09cb.\u0995\u09be\u099b\u09c7.\u0995\u09be\u099b\u09c7.\u0986\u09b0\u09cb.\u0995\u09be\u099b\u09c7.\u098f\u09b8\u09cb\n\u09ae\u09b0\u09cd\u09ae\u09be\u09a8\u09cd\u09a4\u09bf\u0995.\u09a4\u09c1\u09ae\u09bf.\u09ae\u09be\u09a8\u09cd\u09a8\u09be.\u0985\u09ac\u09c1\u099d.\u09a8\u09be.\u0995\u09be\u099b\u09c7.\u0997\u09c7\u09b2\u09c7.\u0995\u09bf.\u09aa\u09be\u09ac\u09c8\ud83d\ude22\u0986\u099c.\u09af\u09c7\u09a4\u09c7.\u09a6\u09be \u0993.\u09a6\u09c1\u099f\u09bf.\u09aa\u09cd\u09b0\u09be\u09a3\u09c0.\u098f\u0995\u0987 \u09b0\u09ac\u09c7.\u0986\u09b0\u09cb.\u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf.\u0986\u09b0\u09cb.\u0995\u09be\u099b\u09c7.\u098f\u09b8\u09cb\ud83d\ude22\ud83d\ude22",
                    "author": "@ChandanaSadhukhan-p3y",
                    "likes": 0,
                    "publishedAt": "2026-04-12T07:49:30Z"
                },
                {
                    "text": "\u09a6\u09be\u09b0\u09c1\u09a3 \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u098f\u0995\u099f\u09bf.\u0997\u09be\u09a8 \u2764. \u0986\u09b2\u09cb.\u0986\u09b2\u09cb.\u099b\u09be\u09af\u09bc\u09be\u09a4\u09c7.\u0995\u09be\u09b0\u09cb\u09a8\u09af\u09bc.\u09b8\u09c1\u09a7\u09c1.\u09af\u09c7.\u09a4\u09cb\u09ae\u09be\u09b0. \u0986\u09ae\u09bf.\u0986\u0995\u09be\u09b6\u09c7.\u09a4\u09c1\u09ae\u09bf.\u09a7\u09c3\u09a4\u09c7\u09b0.\u09a4\u09be\u09b0\u09be\u09a4\u09be\u09b0\u09bf.\u09a8\u09af\u09bc.\u09af\u09c7\u099f\u09c1\u0995\u09c1.\u0986\u09ae\u09be\u09b0 \u099c\u09cb\u099b\u09a8\u09be.\u09ad\u09b0\u09be.\u09b0\u09be\u099c\u09be\u0995\u09c7.\u09aa\u09cd\u09b0\u09c7\u09ae.\u09b8\u09aa\u09cd\u09a8 \u09a3.\u09ae\u09b9\u09b2.\u098f\u09ae\u09a8\u0987.\u09a5\u09be\u0995\u09c7",
                    "author": "@ChandanaSadhukhan-p3y",
                    "likes": 0,
                    "publishedAt": "2026-04-12T07:37:39Z"
                },
                {
                    "text": "\u09b8\u09c1\u09a8\u09cd\u09a6\u09b0 \u098f\u0995\u099f\u09bf.\u0997\u09be\u09a8 \u2764\u0986\u099c.\u098f\u0987 \u09a6\u09bf\u09a8\u099f\u09be.\u0995\u09c7\u09be\u09a8\u09c7\u09be.\u09b2\u09bf\u0996\u09c7.\u09b0\u09be\u0996\u09cb.\u0986\u09ae\u09be\u09af\u09bc.\u09aa\u09b0\u09cd\u09ac\u09c7.\u09ae\u09a8\u09c7.\u0995\u09be\u099b\u09c7.\u09a6\u09c2\u09b0\u09c7.\u09af\u09c7\u0996\u09be\u09a8\u09c7.\u09a5\u09be\u0995\u09cb\u09b9\u09be \u0993\u09af\u09bc\u09be.\u0997\u09b2\u09cd\u09aa \u09aa\u09be\u0996\u09bf\u09a6\u09c7\u09b0. \u0997\u09be\u09a8. \u09b6\u09c1\u09a8\u09c7.\u098f\u09af\u09bc\u09be\u09b0.\u09ab\u09be\u0989\u09a8\u09cd\u09a1\u09c7\u09b6\u09a8\u09c7\u09b0.\u098f\u09b8\u09cb.\u0986\u0997\u09cd\u09a8\u09c7\u09af\u09bc\u09be\u09b8\u09cd\u09a4\u09cd\u09b0.\u09ac\u09b8\u09bf.\u09aa\u09be\u09b6\u09c7.\u09aa\u09be\u09b6\u099d\u0998\u098c\u0964\u09a3 \u09b0\u0999.\u09ac\u09b0\u09cd\u09b7\u09be.\u0993\u09a8\u09be\u0995\u09c7.\u099b\u09c7.\u0998\u09c1\u09b0\u09c7.\u0986\u09ae\u09be\u0995\u09c7.\u0986\u09b0\u09cb.\u0995\u09be\u099b\u09c7.\u09a6\u09c2\u09b0\u09c7.\u09a5\u09be\u0995\u09cb\ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@ChandanaSadhukhan-p3y",
