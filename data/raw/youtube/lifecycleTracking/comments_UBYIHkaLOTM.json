                },
                {
                    "text": "\u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u094d\u0915\u0942\u0932 \u092e\u0947\u0901 \u0936\u093f\u0915\u094d\u0937\u0915 \u0915\u0940 \u092d\u0930\u094d\u0924\u0940 \u0938\u0939\u0940 \u0915\u0930\u094b \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0924\u093f\u092d\u093e/ \u092e\u0947\u0930\u093f\u091f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092d\u0930\u094d\u0924\u0940, \u0930\u093e\u091c\u0928\u0948\u0924\u093f\u0915 \u0938\u093f\u092b\u093e\u0930\u093f\u0936 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u092c\u0948\u0915\u0921\u094b\u0930 \u092d\u0930\u094d\u0924\u0940 \u092f\u093e \u0920\u0947\u0915\u0947 \u092a\u0930 \u0905\u092a\u0928\u0947 \u091a\u0939\u0947\u0924\u094b \u0915\u0940  \u092d\u0930\u094d\u0924\u0940, \u092d\u0930\u094d\u0924\u0940 \u092e\u0947\u0902 \u0927\u093e\u0902\u0927\u0932\u0940, \u092a\u0947\u092a\u0930 \u0932\u0940\u0915 \u0906\u0926\u093f \u0938\u0947 \u0915\u094b\u0908 \u092d\u0930\u094d\u0924\u0940 \u0928\u093e \u0939\u094b, \u0938\u093f\u0930\u094d\u092b \u0915\u093e\u092c\u093f\u0932 \u0936\u093f\u0915\u094d\u0937\u0915 \u0915\u0940 \u092d\u0930\u094d\u0924\u0940 \u0915\u0930\u094b \u0914\u0930 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0927\u094d\u092f\u093e\u0928 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u093e \u092a\u0930 \u0926\u094b \u091c\u0939\u093e\u0901 \u0915\u092e \u0938\u0947 \u0915\u092e \u092a\u093e\u0902\u091a  \u0936\u093f\u0915\u094d\u0937\u0915 \u092d\u0930\u094d\u0924\u0940 \u0939\u094b \u0928\u093e \u0915\u093f \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0936\u093f\u0915\u094d\u0937\u0915 \u092a\u093e\u0902\u091a \u0915\u0915\u094d\u0937\u093e\u0913\u0902 \u0915\u094b \u092a\u095d\u093e\u0924\u093e \u0939\u094b \u0914\u0930 ,\u091c\u093f\u0938\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u091c\u094b \u092c\u091a\u094d\u091a\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u094d\u0915\u0942\u0932 \u0938\u0947 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0938\u094d\u0915\u0942\u0932 \u092e\u0947\u0901 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0935\u094b \u092b\u093f\u0930 \u0926\u0941\u092c\u093e\u0930\u093e \u0935\u093e\u092a\u093f\u0938 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u094d\u0915\u0942\u0932 \u092e\u0947\u0901 \u0928\u0939\u0940 \u0906\u0924\u093e \u091c\u093f\u0938\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u094d\u0915\u0942\u0932 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u092f\u0947\u0902\u0917\u0947 \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u093e \u0915\u093e \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u0940\u0915\u0930\u0923 \u0905\u092a\u0928\u0947 \u0906\u092a \u0939\u094b \u091c\u093e\u092f\u0947\u0917\u093e!\n\u0932\u0947\u0915\u093f\u0928 JEE/NEET Exam.\u0935\u0939\u0940 \u092c\u091a\u094d\u091a\u0947 \u0915\u094d\u0930\u0948\u0915 \u0915\u0930 \u092a\u093e \u0930\u0939\u0947 \u0939\u0948\u0901 \u091c\u094b \u0936\u0941\u0930\u0942 \u0938\u0947 \u0939\u0940  \u092c\u0939\u0941\u0924 \u0939\u0940 \u0905\u091a\u094d\u091b\u0947 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0938\u094d\u0915\u0942\u0932 \u0938\u0947 \u092a\u095d\u093e\u0908 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0901 \u0914\u0930 \u0938\u093e\u0925 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0939\u0940 \u0905\u091a\u094d\u091b\u0947 \u0915\u094b\u091a\u093f\u0902\u0917 \u0907\u0902\u0938\u094d\u091f\u093f\u091f\u094d\u092f\u0942\u091f \u0938\u0947 \u0915\u094b\u091a\u093f\u0902\u0917 \u0932\u0947  \u0930\u0939\u0947 \u0939\u0948\u0901 ,\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 Govt.\u0938\u094d\u0915\u0942\u0932 \u0915\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u094b \u0924\u094b \u092c\u0947\u0938\u093f\u0915 \u0915\u0902\u0938\u0947\u092a\u094d\u091f \u0915\u0940  \u092d\u0940 \u0938\u0939\u0940 \u0938\u092e\u091d  \u0928\u0939\u0940  \u0939\u094b \u092a\u093e\u0924\u0940  \u0939\u0948.",
