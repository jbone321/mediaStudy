                {
                    "text": "\u0907\u0938 \u0926\u0947\u0936 \u092e\u0947\u0902 \u092c\u0947\u0938\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u093e \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0936\u093f\u0915\u094d\u0937\u0923 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u092f\u0928\u0940\u092f \u0939\u094b\u0924\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948 \u0914\u0930 \u0907\u0938\u0940 \u0924\u0930\u094d\u091c \u092a\u0930 \u0938\u093e\u0930\u0947 MP, MLA, CM, PM ko hatao \u0914\u0930 \u090f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u092c\u0928\u093e\u0913 \u0907\u0924\u0928\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0915\u094d\u092f\u093e \u091c\u0930\u0942\u0930\u0924 \u0939\u0948 \u0915\u093e\u092e \u0924\u094b \u0935\u0948\u0938\u0947 \u092d\u0940 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948 \u092c\u0938 \u092c\u0948\u0920\u0947 \u092c\u0948\u0920\u0947 \u0938\u0948\u0932\u0930\u0940 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
