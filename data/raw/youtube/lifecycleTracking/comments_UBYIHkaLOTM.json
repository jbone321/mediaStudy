                {
                    "text": "\u0938\u0930\u0915\u093e\u0930\u0940 \u091f\u0940\u091a\u0930\u094b\u0902 \u0915\u0940 \u092d\u0930\u094d\u0924\u0940 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0938\u094d\u0915\u0942\u0932\u094b\u0902 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091f\u0940\u091a\u0930\u094b\u0902 \u0915\u0940 \u091c\u0917\u0939 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u094b \u0905\u0928\u0941\u0926\u093e\u0928\u093f\u0924 \u0915\u0930 \u0936\u093f\u0915\u094d\u0937\u093e \u0926\u0947\u0902  \u091c\u093f\u0938\u0938\u0947 \u0915\u0940 \u0938\u0948\u0932\u0930\u0940 \u0915\u0940 \u091c\u0917\u0939 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u094b \u0905\u0928\u0941\u0926\u093e\u0928 \u092e\u093f\u0932 \u091c\u093e\u090f\u0917\u093e\u0964",
