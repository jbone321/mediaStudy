                {
                    "text": "\u09ac\u09bf\u09a8\u09cb\u09a6\u09a8\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u0993\u2014\u098f\u0987 \u0995\u09be\u09b0\u09a3\u09c7\u0987 Family Entertainment BD \u098f\u09b0 \u09ad\u09bf\u09a1\u09bf\u0993 \u098f\u09a4 \u09ad\u09be\u09b2\u09cb \u09b2\u09be\u0997\u09c7\u0964 \u09b0\u09ae\u099c\u09be\u09a8\u09c7\u09b0 \u09a6\u09be\u09b0\u09c1\u09a3 \u09ae\u09c7\u09b8\u09c7\u099c \u0986\u099b\u09c7 \u098f\u0996\u09be\u09a8\u09c7\u0964 \ud83c\udf19",
