                },
                {
                    "text": "\u0412\u0430\u0443! \u0412\u043e\u0433\u0456\u043d\u044c)",
                    "author": "@oksanik0904",
                    "likes": 27,
                    "publishedAt": "2026-04-24T19:28:29Z"
                },
                {
                    "text": "\u2764\u2764\u2764,\u044f \u0432\u0430\u0441 \u043b\u044e\u0431\u043b\u044e \u2764 \u0423\u043a\u0440\u0430\u0457\u043d\u0430 \u041d\u0410\u0426\u0406\u042f \u2764 \u0421\u041b\u0410\u0412\u0410 \u0417\u0421\u0423 \u2764",
                    "author": "@Laura-h8m9c",
                    "likes": 33,
                    "publishedAt": "2026-04-24T23:19:42Z"
                },
                {
                    "text": "\u0414\u044f\u043a\u0443\u044e \u0437\u0430 \u043a\u043b\u0430\u0441\u043d\u0443 \u0434\u0432\u0456\u0436\u0443\u0445\u0443.\u041b\u044e\u0431\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0430 -\u0436\u0438\u0432\u0438,\u0440\u0430\u0434\u0456\u0439 \u0440\u0456\u0434\u043d\u0430,\u0432\u0441\u0435 \u0431\u0443\u0434\u0435 \u0443 \u043d\u0430\u0441 \u0434\u043e\u0431\u0440\u0435,\u0442\u0456\u043b\u044c\u043a\u0438 \u0434\u0443\u0436\u0435 \u0448\u043a\u043e\u0434\u0430 ,\u0449\u043e \u043f\u043b\u0430\u0442\u0438\u043c\u043e \u0434\u0443\u0436\u0435 \u0434\u043e\u0440\u043e\u0433\u043e,\u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u043c.",
                    "author": "@\u041b\u0435\u043d\u0430\u041c\u0430\u0440\u0443\u043d\u0435\u043d\u043a\u043e",
                    "likes": 39,
                    "publishedAt": "2026-04-24T22:40:12Z"
                },
                {
                    "text": "\u0417\u0440\u043e\u0431\u043b\u0435\u043d\u043e \u0428\u0432\u0438\u0434\u043a\u043e\u0440\u0443\u0447. \u041d\u0435 \u0441\u0443\u0434\u0456\u0442\u044c!)\r\n\u0422\u0443\u0430\u043f\u0441\u0435. \u041a\u043e\u043d\u0442\u0440\u0430\u0441\u0442 \u043c\u043e\u043c\u0435\u043d\u0442\u0456\u0432\r\n\u0426\u0435 \u0432\u0456\u0434\u0435\u043e \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0456 \u0441\u0443\u0447\u0430\u0441\u043d\u043e\u0457 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u0436\u0438\u0432\u043e\u0433\u043e \u043c\u0443\u0437\u0438\u0447\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f.\r\n\u0423 \u043d\u044c\u043e\u043c\u0443 \u2014 \u0435\u043c\u043e\u0446\u0456\u0457 \u0447\u0430\u0441\u0443, \u0431\u0456\u043b\u044c \u0432\u0442\u0440\u0430\u0442 \u0456 \u0441\u0438\u043b\u0430 \u0436\u0438\u0442\u0442\u044f, \u044f\u043a\u0435 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0432\u0456\u0442\u044c \u0443 \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u043f\u0435\u0440\u0456\u043e\u0434\u0438.\r\n\u041c\u0443\u0437\u0438\u043a\u0430 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c \u043f\u0435\u0440\u0435\u0436\u0438\u0442\u0438 \u0456 \u043e\u0441\u043c\u0438\u0441\u043b\u0438\u0442\u0438 \u0442\u0435, \u0449\u043e \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0432\u043a\u043e\u043b\u043e.#\u0430\u0432\u0442\u043e\u0440 #\u0443\u043a\u0440\u0430\u0457\u043d\u0430\ud83c\uddfa\ud83c\udde6 #\u0443\u043a\u0440\u0430\u0457\u043d\u0430 #\u0443\u043a\u0440\u0430\u0438\u043d\u0430 #\u0413\u0435\u0440\u043e\u0457 #\u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0430\u0437\u0430\u043d\u0430\u043c\u0438\ud83d\udc99\ud83d\udc9b\ud83d\udcaa #\u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0430 #\u0443\u043a\u0440\u0430\u0457\u043d\u0430\u043f\u0435\u0440\u0435\u043c\u043e\u0436\u0435 #\u0443\u043a\u0440\u0430\u0457\u043d\u0430\u043f\u043e\u043d\u0430\u0434\u0443\u0441\u0435\ud83d\udc99\ud83d\udc9b #\u0440\u0435\u043a\u0432\u0456\u0454\u043c #\u043a\u043e\u0432\u0430\u043b\u044e\u043a #\u0432\u0456\u0439\u043d\u0430\u0432\u0443\u043a\u0440\u0430\u0457\u043d\u0456\ud83c\uddfa\ud83c\udde6 #\u043a\u043e\u0445\u0430\u043d\u043d\u044f #\u0432\u0456\u0439\u0441\u044c\u043a\u043e\u0432\u0456 #\u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u0439\u0442\u0456\u043a\u0442\u043e\u043a #\u0432\u0456\u0439\u043d\u0430 #\u0445\u0456\u0442",
                    "author": "@fantom2112KVO",
                    "likes": 32,
                    "publishedAt": "2026-04-24T19:25:29Z"
                },
