                    "likes": 1,
                    "publishedAt": "2026-04-26T06:17:20Z"
                },
                {
                    "text": "\u041a\u0430\u043a\u043e\u0439 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0439 \u043d\u0430\u0440\u043e\u0434.\u041a\u0430\u043a \u0436\u0435 \u0436\u0430\u043b\u044c \u0447\u0442\u043e \u0442\u0430\u043a \u0432\u0441\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c.\u0412\u0441\u0435\u043c \u043c\u0438\u0440\u0430!!!",
                    "author": "@Fernandel-h3y",
                    "likes": 0,
                    "publishedAt": "2026-04-25T18:22:07Z"
                },
                {
                    "text": "\u041a\u0440\u0443\u0442\u043e!\u0441\u0443\u043f\u0435\u0440!",
                    "author": "@\u041d\u0430\u0442\u0430\u043b\u0456\u044f\u041f\u0440\u043e\u0441\u0432\u0454\u0442\u043e\u0432\u0430",
                    "likes": 0,
                    "publishedAt": "2026-04-26T02:47:50Z"
                },
                {
                    "text": "\u041d\u0456\u0456\u0456\u0456\u0456\u0456\u0456\u0456 !!!!!!!! \u0422\u0430\u043a \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 !!!!!!!",
                    "author": "@\u0412\u0406\u041b\u042c\u041d\u0418\u0419\u0423\u041a\u0420\u0410\u0407\u041d\u0415\u0426\u042c-\u04494\u043b",
                    "likes": 1,
