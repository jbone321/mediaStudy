            "comments": [
                {
                    "text": "\u041e\u0446\u0435 \u0414\u0412\u0406\u0416\u0423\u0425\u0410!\u261d\ufe0f\ud83e\udee1",
                    "author": "@\u0423\u041a\u0420\u0410\u0407\u041d\u041a\u0410-\u04491\u0449",
