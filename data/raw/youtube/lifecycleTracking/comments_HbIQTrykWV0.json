                },
                {
                    "text": "\u0627\u0643\u062a\u0631 \u0643\u0630\u0628\u0629 \u062e\u0648\u0627\u0641\u062a\u0646\u064a \u0648 \u0627\u0646\u0627 \u0635\u063a\u064a\u0631 \u0627\u0646\u0648 \u0627\u0647\u0644\u064a \u062c\u0627\u0628\u0648\u0646\u064a \u0645\u0646 \u0639\u0646\u062f \u0648\u0627\u062d\u062f \u062d\u0631\u0627\u0645\u064a \ud83d\udc80\ud83d\udc80",
