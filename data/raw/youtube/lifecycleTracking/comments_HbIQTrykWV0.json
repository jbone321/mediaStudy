                    "text": "\u0639\u062f\u062f \u0627\u0644\u0644\u0627\u064a\u0643\u0627\u062a 67 \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@EliasEdits0",
                    "likes": 293,
                    "publishedAt": "2026-03-26T18:55:43Z"
                },
                {
                    "text": "\u0627\u0643\u062a\u0631 \u0643\u0630\u0628\u0629 \u062e\u0648\u0627\u0641\u062a\u0646\u064a \u0648 \u0627\u0646\u0627 \u0635\u063a\u064a\u0631 \u0627\u0646\u0648 \u0627\u0647\u0644\u064a \u062c\u0627\u0628\u0648\u0646\u064a \u0645\u0646 \u0639\u0646\u062f \u0648\u0627\u062d\u062f \u062d\u0631\u0627\u0645\u064a \ud83d\udc80\ud83d\udc80",
                    "author": "@\u063a\u0631\u064a\u0645.\u064a\u0639\u0631\u0641.\u064a\u0644\u0639\u0628",
                    "likes": 52,
                    "publishedAt": "2026-03-26T20:25:36Z"
                },
                {
                    "text": "\u0632\u0645\u0627\u0646 \u0643\u0646\u062a \u0627\u062e\u0627\u0641 \u0645\u0646 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0645\u0631\u0639\u0628\u0629 \u0628\u0634\u0643\u0644 \u0639\u0627\u0645 \u0644\u0627\u0646\u0647 \u0627\u0635\u062d\u0627\u0628\u064a \u0642\u0627\u0644\u0648\u0627 \u0644\u064a \u0623\u0646\u0647 \u0625\u0630\u0627 \u0644\u0639\u0628\u062a\u0647\u0627 \u0631\u0627\u062d \u062a\u0642\u062a\u0644\u0643 \u0628\u0623\u0628\u0634\u0639 \u0627\u0644\u0637\u0631\u0642 \u0645\u0646 \u062a\u062d\u062a \u0627\u0644\u0627\u0631\u0636 \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@DarkShafiei",
                    "likes": 14,
                    "publishedAt": "2026-03-27T05:07:37Z"
                },
                {
                    "text": "\u0627\u0646\u062c\u064a\u0644\u0627 \u062e\u0648\u0641\u062a\u0646\u064a \u0648\u0627\u0646\u0627 \u0635\u063a\u064a\u0631\u0647",
                    "author": "@\u0627\u0631\u064a\u0646\u062a\u0627\u0644\u064a\u0646-\u06342\u0628",
                    "likes": 44,
                    "publishedAt": "2026-03-27T07:52:25Z"
                },
                {
                    "text": "\u0645\u064a\u0646 \u0634\u0627\u0641 \u0627\u0644\u0641\u062f\u064a\u0648 \u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633 \u0628\u0644\u064a\u0644",
                    "author": "@HoudaHassan-iz5cv",
                    "likes": 14,
                    "publishedAt": "2026-03-26T19:42:58Z"
                },
                {
                    "text": "\u0627\u0646 \u0641\u064a \u0648\u0627\u062d\u062f \u0645\u0646 \u0627\u0644\u062d\u0645\u0627\u0645 \u064a\u0637\u0644\u0639(\u0627\u0644\u062d\u0645\u0627\u0645 \u062a\u062d\u062f\u064a\u062f\u0627 \u0627\u0644\u0643\u0631\u0633\u064a) \u0648\u0634\u0643\u0644\u0647 \u0643\u0623\u0646\u0647 \u0645\u062a\u062d\u062c\u0628 \u062d\u062c\u0627\u0628 \u0627\u062d\u0645\u0631 \u0648\u0645\u0628\u062a\u0633\u0645 \u0648\u0641\u0627\u062a\u062d \u0639\u064a\u0648\u0646\u0647 \u060c \u0639\u0644\u0649 \u0627\u0644\u0627\u0642\u0644 \u0627\u062d\u0633\u0646 \u0645\u0646 \u0633\u0643\u064a\u0628\u062f\u064a \u062a\u0648\u0644\u064a\u062a \u0627\u0644\u0646\u062d\u0633 \ud83d\ude42",
                    "author": "@HONEY_JISOO.Xx12",
                    "likes": 25,
                    "publishedAt": "2026-03-27T04:32:25Z"
                },
                {
                    "text": "\u0632\u0645\u0627\u0646 \u0641\u064a \u0627\u062d\u062f \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0645\u0627\u064a\u0646 \u0643\u0631\u0627\u0641\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0644\u0648 \u0634\u0641\u0646\u0627 \u0644\u0627\u0626\u062d\u0629 \u0627\u0644\u0627\u0634\u064a\u0627\u0621 \u0627\u0644\u064a \u0636\u0627\u0641\u0648\u0647\u0627 \u0631\u0627\u062d \u0646\u0644\u0627\u0642\u064a \u062d\u0645\u0644\u0629 \" \u062a\u0645 \u062d\u0630\u0641 \u0627\u0644\u0647\u064a\u0631\u0648\u0628\u0631\u0627\u064a\u0646 \"\n\u0628\u0633 \u0627\u0644\u062d\u064a\u0646 \u0628\u062a\u062d\u062f\u064a\u062b 26.1 \u0634\u0641\u0646\u0627 \u0634\u064a \u0627\u0633\u0645\u0647 \" \u062a\u0645 \u0627\u0632\u0627\u0644\u0629 \u0627\u0644\u0628\u064a\u0628\u064a \u0647\u064a\u0631\u0648\u0628\u0631\u0627\u064a\u0646 \" \u0627\u064a\u0634 \u0647\u0630\u0627 \u0643\u064a\u0641 \u064a\u062d\u0630\u0641\u0648\u0646 \u0634\u064a \u0645\u062d\u062f \u0634\u0627\u0641\u0647 \u0627\u0648 \u0627\u062a\u0643\u0644\u0645 \u0639\u0646\u0647 \ud83d\ude42",
                    "author": "@AEKGAHMED",
                    "likes": 32,
                    "publishedAt": "2026-03-26T18:55:43Z"
                },
                {
                    "text": "\u0645\u0631\u064a\u0645 \u0644\u064a\u0634 \u0644\u0627\u0646 \u0643\u0646\u062a \u0627\u0644\u0639\u0628\u0647\u0627 \u0648\u0643\u0646\u062a \u0627\u062a\u0643\u0644\u0645 \u0628\u0635\u0648\u062a \u0645\u0646\u062e\u0641\u0636 \u0648\u0642\u0627\u0644\u062a \u0644\u064a\u0634 \u062a\u062a\u0643\u0644\u0645 \u0628\u0635\u0648\u062a \u0645\u0646\u062e\u0641\u0636\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@prosaood",
                    "likes": 11,
                    "publishedAt": "2026-03-27T10:29:50Z"
                },
                {
                    "text": "\u0644\u0643\u0644 \u0648\u0627\u062d\u062f \u0633\u062a\u0647\u0632\u0623\u0621 \u0628\u0644 \u0647\u064a\u0631\u0648\u0628\u0631\u064a\u0646 \u0627\u0639\u0631\u0641 \u0645\u0643\u0627\u0646\u062a\u0643 \u0642\u062f\u0627\u0645 \u0627\u0644\u0647\u064a\u0631\u0648\u0628\u0631\u064a\u0646",
                    "author": "@GasarSini",
                    "likes": 6,
                    "publishedAt": "2026-03-26T20:19:55Z"
                },
                {
                    "text": "\u0645\u0627\u0628\u0639\u0631\u0641 \u0623\u062d\u0633 \u0634\u0641\u062a \u0647\u0630\u0627 \u0627\u0644\u0645\u0642\u0637\u0639 \u0642\u0628\u0644 \u0643\u0630\u0627 \ud83e\uddd0",
                    "author": "@\u0627\u0644\u0645\u064a\u064a\u064a\u064a\u064a\u064a\u064a\u0645",
                    "likes": 23,
                    "publishedAt": "2026-03-26T20:12:32Z"
                },
                {
                    "text": "\u0644\u0639\u0628\u0629 \u0627\u0644\u062d\u0648\u062a \u0627\u0644\u0623\u0632\u0631\u0642 \u0628\u0633 \u0645\u0639\u0631\u0641\u0634 \u0643\u0627\u0646\u062a \u0643\u0630\u0628\u0629 \u0623\u0648 \u0644\u0627 \u0642\u0627\u0644\u0648\u0627 \u0644\u0646\u0627 \u0623\u0646\u0647\u0627 \u0647\u062a\u0639\u062f \u062a\u0647\u062f\u062f\u0643 \u0648 \u062a\u0642\u0648\u0644 \u0644\u0643 \u062d\u0627\u062c\u0627\u062a \u063a\u0631\u064a\u0628\u0629 \u0644\u063a\u0627\u064a\u0629 \u0623\u0645\u0627 \u062a\u062e\u0644\u064a\u0643 \u062a\u0646\u062a\u062d\u0631 \u0648 \u0645\u0637\u0648\u0631\u0647\u0627 \u062a\u0642\u0631\u064a\u0628\u0627 \u0633\u0641\u0627\u062d",
                    "author": "@nemox001",
                    "likes": 10,
                    "publishedAt": "2026-03-27T02:30:25Z"
                },
                {
                    "text": "\u0643\u0627\u0646\u0648\u0627 \u0627\u0647\u0644 \u064a\u0642\u0648\u0644\u0648\u0646 \u0625\u0630\u0627 \u0644\u0639\u0628\u062a \u0644\u0639\u0628\u0629 \u062a\u0648\u0645  \u062f\u0627\u0643 \u0627\u0644\u0623\u0633\u0648\u062f \u064a\u062c\u064a \u064a\u0642\u062a\u0644\u0643 \u0641\u064a \u0627\u0644\u064a\u0644 \u0647\u0648 \u0648 \u0623\u0635\u062f\u0642\u0627\u0626\u0647 \ud83d\ude02\ud83d\ude02",
                    "author": "@KamelGana-t8q",
                    "likes": 11,
                    "publishedAt": "2026-03-26T20:06:27Z"
                },
                {
                    "text": "\u0627\u0644\u0645\u0634\u0643\u0644 \u0627\u0646 \u0644\u0639\u0628\u0629 \u0645\u0631\u064a\u0645 \u0644\u0645\u0627 \u062a\u062d\u0628 \u062a\u062d\u062f\u0641\u0647\u0627 \u0645\u0627\u062a\u0646\u062d\u062f\u0641 \u062d\u062a\u0649 \u0643\u0633\u0631\u062a \u062a\u0644\u064a\u0641\u0648\u0646\u064a \ud83d\ude22\ud83d\ude22\n\u0635\u0631\u062a \u0645\u0634\u0647\u0648\u0631 \u0628\u0644\u0627\u064a\u0643 \ud83d\ude02\ud83d\ude02",
                    "author": "@NasserSniguer",
                    "likes": 1,
                    "publishedAt": "2026-04-05T19:19:42Z"
                },
                {
                    "text": "\u0627\u0644\u0646\u0627\u0633 \u062a\u062d\u0628 \u062a\u0633\u0648\u064a \u062f\u0631\u0627\u0645\u0627 \ud83d\ude2e",
                    "author": "@anes1990",
                    "likes": 6,
                    "publishedAt": "2026-03-26T20:43:23Z"
                },
                {
                    "text": "\u064a\u0627 \u0627\u062e\u064a \u0627\u0646\u062a \u0627\u0633\u0637\u0648\u0631\u0647 \u2764\u2764",
                    "author": "@IronMan-u3s",
                    "likes": 8,
                    "publishedAt": "2026-03-26T18:55:25Z"
                },
                {
                    "text": "\u0627\u0635\u0644\u0627 \u0647\u0648 \u0641\u0639\u0644\u0646 \u0647\u064a\u0628\u0627\u0646 \u0627\u0646\u0647\u0645 \u0634\u0627\u064a\u0641\u064a\u0646 \u0646\u0641\u0633\u0647\u0645 \u0641\u064a \u0639\u064a\u0646 \u0627\u0646\u062c\u064a\u0644\u0627 \u0628\u0633 \u0644\u0623\u0646 \u0627\u0644\u0639\u062f\u0633\u0629 \u0644\u0648\u0646\u0647\u0627 \u0633\u0648\u062f\u0627 \u0641 \u0627\u0646\u0639\u0643\u0627\u0633 \u0627\u0644\u062a\u0644\u0641\u0648\u0646 \u0628\u064a\u062c\u064a\u0628 \u0648\u0634\u0647\u0645 \u0627\u0635\u0644\u0627",
                    "author": "@hwwad",
                    "likes": 16,
                    "publishedAt": "2026-03-26T19:39:15Z"
                },
                {
                    "text": "\u0628\u0633 \u0643\u0644 \u0647\u0630\u0647 \u0627\u0644\u0627\u0644\u0639\u0627\u0628 \u0645\u0648\u062c\u062f\u0647 \u0628\u0628\u0627\u0644\u0639\u0631\u0627\u0642 \u0645\u0646\u062d\u0630\u062a \u064a\u0645\u0646\u0627\ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@mejeco1918",
                    "likes": 2,
                    "publishedAt": "2026-03-27T14:16:51Z"
                },
                {
                    "text": "\u0627\u0643\u062b\u0631 \u0644\u0639\u0628\u0647 \u062e\u0648\u0641\u062a\u0646\u064a \u0647\u064a \u0623\u0646\u062c\u064a\u0644\u0627 \u0648\u0627\u0646\u0627 \u0635\u063a\u064a\u0631\u0647",
                    "author": "@Alijan-v1t6v",
                    "likes": 3,
                    "publishedAt": "2026-03-28T17:59:18Z"
                },
                {
                    "text": "\u0648\u0646\u0627 \u0628\u0633\u0623\u0644 \u0646\u0641\u0633\u064a \u0644\u064a\u0634 \u0628\u062e\u0627\u0641  \u0645\u0646 \u0648\u0631\u0627 \u0645\u064a\u062f\u0648 \u0648\u062c\u0646\u0649 \u0643\u0646\u062a \u0628\u0634\u0648\u0641 \u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a\u0647\u0645 \u064a\u0642\u0648\u0644\u0648\u0627 \u0627\u0646 \u0645\u0631\u064a\u0645 \u0648\u0631\u0627\u0647\u0645 \ud83d\ude05\ud83d\ude05\ud83d\ude05\ud83d\ude05\ud83d\ude05\ud83d\ude05\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02\ud83d\ude02 \u0643\u0646\u062a \u0628\u062e\u0627\u0641 \u0627\u0646\u0647 \u064a\u0637\u0644\u0639 \u0644\u064a \u0633\u0644\u0646\u062f\u0631 \u0645\u0627\u0646 \u0645\u0646 \u062a\u062d\u062a \u0627\u0644\u0633\u0631\u064a\u0631\ud83d\ude05",
                    "author": "@imanesarah9701",
                    "likes": 2,
                    "publishedAt": "2026-03-30T21:49:31Z"
                },
                {
                    "text": "\u0627\u0646\u062a \u0645\u0648 \u0641\u0627\u0644\u0641\u0646\u062f\u0642\u061f",
                    "author": "@HaydaraRifaii666",
                    "likes": 4,
                    "publishedAt": "2026-03-26T18:54:29Z"
                },
                {
                    "text": "\u0633\u0648\u0631\u0629 \u0627\u0644\u0628\u0642\u0631\u0629 - \u0627\u0644\u0622\u064a\u0629 255 (\u0622\u064a\u0629 \u0627\u0644\u0643\u0631\u0633\u064a)\n\u200b{\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627\u06e4 \u0625\u0650\u0644\u064e\u0640\u0670\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u062d\u064e\u06cc\u0651\u064f \u0671\u0644\u06e1\u0642\u064e\u06cc\u0651\u064f\u0648\u0645\u064f\u06da \u0644\u064e\u0627 \u062a\u064e\u0623\u06e1\u062e\u064f\u0630\u064f\u0647\u064f\u06e5 \u0633\u0650\u0646\u064e\u0629\u08f1 \u0648\u064e\u0644\u064e\u0627 \u0646\u064e\u0648\u06e1\u0645\u08f1\u06da \u0644\u0651\u064e\u0647\u064f\u06e5 \u0645\u064e\u0627 \u0641\u0650\u06cc \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0640\u0670\u0648\u064e\u200a\u0670\u2060\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u06cc \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06d7 \u0645\u064e\u0646 \u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u06cc \u06cc\u064e\u0634\u06e1\u0641\u064e\u0639\u064f \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5\u06e4 \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0625\u0650\u0630\u06e1\u0646\u0650\u0647\u0650\u06e6\u06da \u06cc\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0628\u064e\u06cc\u06e1\u0646\u064e \u0623\u064e\u06cc\u06e1\u062f\u0650\u06cc\u0647\u0650\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u06e1\u0641\u064e\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0644\u064e\u0627 \u06cc\u064f\u062d\u0650\u06cc\u0637\u064f\u0648\u0646\u064e \u0628\u0650\u0634\u064e\u06cc\u06e1\u0621\u08f2 \u0645\u0651\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u0650\u0647\u0650\u06e6\u06e4 \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0645\u064e\u0627 \u0634\u064e\u0627\u06e4\u0621\u064e\u06da \u0648\u064e\u0633\u0650\u0639\u064e \u0643\u064f\u0631\u06e1\u0633\u0650\u06cc\u0651\u064f\u0647\u064f \u0671\u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0640\u0670\u0648\u064e\u200a\u0670\u2060\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e\u06d6 \u0648\u064e\u0644\u064e\u0627 \u06cc\u064e\u0640\u0654\u064f\u0648\u062f\u064f\u0647\u064f\u06e5 \u062d\u0650\u0641\u06e1\u0638\u064f\u0647\u064f\u0645\u064e\u0627\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u0639\u064e\u0644\u0650\u06cc\u0651\u064f \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u06cc\u0645\u064f}",
                    "author": "@AliAlmshhdi-x1v",
                    "likes": 5,
                    "publishedAt": "2026-03-26T19:03:07Z"
                }
            ]
        },
