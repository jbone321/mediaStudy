                },
                {
                    "text": "\u041d\u0435 \u0437\u043d\u0430\u044e \u043d\u0430\u0441\u0447\u0451\u0442 \u043a\u043e\u0440\u043e\u043b\u044f, \u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043a\u043e\u043b\u044c\u043d\u043e \u0432\u0438\u0434\u0435\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b \u0441 \u043e\u0431\u0440\u0430\u0437\u0430\u043c\u0438, \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u044e\u0449\u0438\u0435 \u0446\u0435\u043b\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e\n\u0420\u0430\u0441\u0441\u043a\u0430\u0436\u0438 \u043e \u0447\u0451\u043c-\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u043c \u0443 \u0422\u0430\u0439\u043b\u0435\u0440\u0430, \u043e\u043d \u0432 \u0442\u0430\u043a\u043e\u043c \u0442\u043e\u0436\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f",
                    "author": "@kuzia05",
                    "likes": 6,
                    "publishedAt": "2026-03-02T15:37:56Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u043f\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u0435! \u2764 \u041a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430 \u043b\u0443\u0447\u0448\u0438\u0439 \u043a\u0430\u043d\u0430\u043b \u043e \u043c\u0443\u0437\u044b\u043a\u0435 \ud83c\udfb8",
                    "author": "@valzap5444",
                    "likes": 3,
                    "publishedAt": "2026-03-02T15:12:03Z"
                },
                {
                    "text": "\u0418 \u0434\u0430 , \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u0430 \u0441 \u0432\u0430\u043c\u0438",
                    "author": "@svetdoroff8596",
                    "likes": 0,
                    "publishedAt": "2026-03-02T18:14:27Z"
                },
                {
                    "text": "\u0423 \u043d\u0435\u0433\u043e \u0442\u0430\u043a \u0436\u0435 \u0433\u043e\u043b\u043e\u0441 \u043f\u043e\u0445\u043e\u0436, \u043f\u0440\u044f\u043c \u043a\u0430\u043a \u0443 \u041c\u0430\u0439\u043a\u043b\u0430 \u0414\u0436\u0435\u043a\u0441\u043e\u043d\u0430",
                    "author": "@mrs0612",
                    "likes": 2,
                    "publishedAt": "2026-03-02T18:23:26Z"
                },
                {
                    "text": "\u041e\u0433\u043e \u0412\u0430\u043b\u0435\u0440\u0430 \u0415\u0441\u0438\u043f\u043e\u0432)",
                    "author": "@\u0414\u043c\u0438\u0442\u0440\u0438\u0439\u0423\u0441\u043a\u043e\u0432-\u04324\u0439",
                    "likes": 1,
                    "publishedAt": "2026-03-02T22:24:16Z"
                },
                {
                    "text": "\u042f \u043f\u043e\u0447\u0435\u043c\u0443-\u0442\u043e \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u043e\u0431\u043e\u0436\u0430\u044e \u0447\u0438\u0442\u0430\u0442\u044c \u043f\u043e\u0434 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435\u043c \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u0435\u0439 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u044b \u043e\u0442 \u0441\u043d\u043e\u0431\u043e\u0432 \u0438\u043b\u0438 \u043d\u0435\u0442\u0430\u043a\u0443\u0441\u044c \u0432 \u0434\u0443\u0445\u0435: \"\u0410 \u043a\u0442\u043e \u044d\u0442\u043e?\"",
                    "author": "@BornToSvr",
                    "likes": 18,
                    "publishedAt": "2026-03-02T17:08:20Z"
                },
                {
                    "text": "\u0414\u043b\u044f \u043c\u0435\u043d\u044f,\u043a\u0430\u043a \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430 \u043f\u043e\u043f-\u043a\u043e\u0440\u043e\u043b\u044e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438,\u044d\u0442\u043e \u0411\u0440\u0443\u043d\u043e \u041c\u0430\u0440\u0441 ,\u0431\u0435\u0437\u0443\u043c\u043d\u043e \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0439 \u0438 \u0445\u0430\u0440\u0438\u0437\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u0430\u0440\u0442\u0438\u0441\u0442\ud83c\udf89",
                    "author": "@bobyrevatravel",
                    "likes": 1,
                    "publishedAt": "2026-03-03T04:04:52Z"
                },
                {
                    "text": "\u0410 \u043a\u0430\u043a \u043f\u043e \u043c\u043d\u0435, \u0442\u0430\u043a \u0443 \u0411\u0440\u0443\u043d\u043e \u041c\u0430\u0440\u0441\u0430 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0430\u0439\u0431\u043e\u0432 \u0432 \u0441\u0442\u0438\u043b\u0435 \u041c\u0430\u0439\u043a\u043b\u0430. \u0418 \u043e\u043d \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u043e\u043b\u0435\u0435 \u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0439.",
                    "author": "@wonderfullife4907",
                    "likes": 430,
                    "publishedAt": "2026-03-02T16:03:13Z"
                },
                {
                    "text": "\u0421\u0430\u0442\u0438\u0440\u0430 \u043e\u0433\u043e\u043d\u044c. \u041a\u043e\u043c\u043c\u0435\u043d\u0442 \u0440\u0430\u0434\u0438 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430) \u043f\u043e \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438",
                    "author": "@\u041c\u0438\u0445\u0430\u0438\u043b\u0415\u0432\u0434\u043e\u043a\u0438\u043c\u043e\u0432-\u04311\u043a",
                    "likes": 0,
                    "publishedAt": "2026-03-03T04:45:53Z"
                },
                {
                    "text": "\u041c\u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u043d\u0440\u0430\u0432\u044f\u0442\u0441\u044f \u0432\u0441\u0442\u0430\u0432\u043e\u0447\u043d\u044b\u0435 \u044e\u043c\u043e\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u044b \u0432 \u0432\u0430\u0448\u0438\u0445 \u0432\u0438\u0434\u0435\u043e \ud83d\ude06\n\u041d\u043e \u044d\u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430\u0434\u043e \u0431\u044b\u0442\u044c \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435. \u041f\u0440\u043e \u0428\u0430\u043c\u0430\u043d\u0430 \u0438 \u0411\u0430\u0439\u043a\u0430\u043b \u0432\u043e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0434\u043d\u044f\u0445 \u0443\u0437\u043d\u0430\u043b\u0430 \ud83e\udd2d",
                    "author": "@Watanushka",
                    "likes": 0,
                    "publishedAt": "2026-03-02T19:06:28Z"
                },
                {
                    "text": "\u0421\u043a\u043e\u0440\u0435\u0435 3 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\ud83d\ude02",
                    "author": "@Sultanov_1994",
                    "likes": 0,
                    "publishedAt": "2026-03-02T18:17:05Z"
                },
                {
                    "text": "\u0442\u0440\u043e\u043d \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u043f\u0443\u0441\u0442\u044b\u043c",
                    "author": "@MorningJustItIs",
                    "likes": 0,
                    "publishedAt": "2026-03-02T20:43:38Z"
                },
                {
                    "text": "\u041e\u0447\u0435\u043d\u044c \u0434\u043e\u043b\u0433\u0430\u044f \u043f\u0430\u0441\u0445\u0430\u043b\u043a\u0430",
