                {
                    "text": "\u092f\u0947 \u0938\u092c \u0915\u092e\u093e\u0928\u0947 \u0915\u093e \u0927\u0902\u0927\u093e \u091a\u0932 \u092a\u0921\u093c\u093e \u0939\u0948\u0964\u0928\u0947\u0924\u093e \u0932\u094b\u0917 \u0905\u092e\u0940\u0930 \u0915\u0948\u0938\u0947 \u092c\u0928\u0947\u0902\u0917\u0947 \u0909\u0938\u0940 \u0915\u093e \u092b\u093e\u0930\u094d\u092e\u0942\u0932\u093e \u091a\u0932 \u092a\u0921\u093c\u093e \u0939\u0948\u0964\u0930\u094b\u091c\u0940\u0930\u094b\u091c\u0917\u093e\u0930 \u0914\u0930 \u0928\u094c\u0915\u0930\u0940 \u092a\u0930 \u0915\u092c \u092c\u093e\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u092a\u0924\u093e \u0928\u0939\u0940\u0902\u0964\ud83d\ude02\ud83d\ude02",
