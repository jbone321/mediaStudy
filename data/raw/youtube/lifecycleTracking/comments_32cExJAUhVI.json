                {
                    "text": "\u090f \u0939\u094b\u0924\u093e \u0939\u0948 \u0926\u092e \u0916\u092e \u0935\u093e\u0932\u093e \u0928\u0947\u0924\u093e, \u091c\u094b \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u0930 \u0915\u0947 \u0926\u093f\u0916\u093e \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0928\u0940\u0924\u0940\u0936 \u091c\u0940 \u0915\u094b \u0938\u0940\u090f\u092e \u092a\u0926 \u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0915\u0940 \u0915\u0938\u092e \u0916\u093e\u0908 \u0925\u0940, \u0939\u091f\u093e\u0915\u0947 \u0926\u092e \u0932\u093f\u092f\u093e, \u0938\u0948\u0932\u094d\u092f\u0942\u091f \u0939\u0948\u0902 \u090f\u0938\u0947 \u0928\u0947\u0924\u093e \u0915\u094b",
