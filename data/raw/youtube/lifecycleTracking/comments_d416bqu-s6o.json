                    "text": "\u041a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u044b\u2764\u2764\u2764\u2764\u2764\u2764",
                    "author": "@\u0420\u0443\u0441\u0442\u0430\u043c\u041c\u0438\u0440\u0430\u0445\u043c\u0435\u0434\u043e\u0432-\u04348\u0434",
