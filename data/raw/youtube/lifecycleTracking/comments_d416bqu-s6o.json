                {
                    "text": "\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83d\udc90\ud83d\udc90\ud83d\udc90\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc9d\ud83d\udc9d\ud83d\udc9d",
