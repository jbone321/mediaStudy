                },
                {
                    "text": "Hello. I think this band has very great talents . A very friendly band. Good luck in the future. My greetings from Hungary \u2764\ufe0f",
                    "author": "@NandorKaulics",
                    "likes": 0,
                    "publishedAt": "2026-04-27T08:53:44Z"
                },
                {
                    "text": "\u041b\u0438\u043e\u0442\u0442\u0430 \u043e\u0440\u043a\u0435\u0441\u0442\u0440\u0430 \u0434\u0435\u0432\u0443\u0448\u043a\u0438 \u0432\u044b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b \u0436\u0435\u043b\u0430\u044e \u0432\u0430\u043c \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0441\u043f\u0435\u0445\u043e\u0432 \u0438 \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u044f \u0432 \u0436\u0438\u0437\u043d\u0438 \u2764\u2764\u2764\u2764\u2764\u2764\u2764 \u0443\u0434\u0430\u0447\u0438 \u0432\u0430\u043c \u2764\u2764.",
                    "author": "@Saken-r8p",
                    "likes": 0,
                    "publishedAt": "2026-04-27T11:40:54Z"
                },
                {
                    "text": "\u0417\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442\u044b, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u041b\u0438 \u041e\u0442\u0442\u0430\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\ud83c\udfb6\ud83c\udfb6\ud83c\udfb6\ud83c\udfb6\ud83c\udfb6\ud83c\udfb6\ud83c\udfb6",
                    "author": "@plasebo",
                    "likes": 0,
                    "publishedAt": "2026-04-27T16:45:14Z"
                },
                {
                    "text": "All the best for you OTTA! Lovely greatings from Austria! \ud83d\udc4d\ud83c\udde6\ud83c\uddf9\u2764\ud83d\ude0a",
                    "author": "@carmenbalzer202",
                    "likes": 1,
                    "publishedAt": "2026-04-27T11:45:39Z"
                },
                {
                    "text": "Fantasztikus zen\u00e9szek vagytok l\u00e1nyok, csak \u00edgy tov\u00e1bb, rem\u00e9lem egyszer elj\u00f6tt\u00f6k Ausztr\u00e1li\u00e1ban is.",
                    "author": "@discorats",
                    "likes": 0,
                    "publishedAt": "2026-04-27T09:37:48Z"
                },
                {
                    "text": "\u041c\u043e\u043b\u043e\u0434\u0446\u044b \u0434\u0435\u0444\u0447\u043e\u043d\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u0439\u0444\u0443\u044e \u043e\u0442 \u0432\u0430\u0441\ud83d\udc4f\ud83d\udc4f",
                    "author": "@aisalkynshamyralieva1316",
                    "likes": 0,
                    "publishedAt": "2026-04-27T09:20:33Z"
                },
                {
                    "text": "\u0422\u0430\u043a\u0438\u0435 \u043c\u043e\u043b\u043e\u0434\u0435\u043d\u044c\u043a\u0438\u0435 \u0438 \u0442\u0430\u043a\u0438\u0435 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0435\u2764 \u0423\u0434\u0430\u0447\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0438 \u0432\u0435\u0437\u0434\u0435 \u0432\u0441\u0435\u043c \u0432\u0430\u043c. \u041b\u044e\u0431\u043b\u044e \u0432\u0430\u0441\u2764",
                    "author": "@user-Trazit5",
                    "likes": 0,
                    "publishedAt": "2026-04-27T19:19:29Z"
                },
                {
                    "text": "\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e !!! \ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc4c\ud83d\udc4c\ud83d\udc4c\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25\ud83d\udd25",
                    "author": "@\u0424\u0435\u0434\u043e\u0440\u041b\u0430\u043f\u0448\u0438\u043d-\u04472\u0442",
                    "likes": 0,
                    "publishedAt": "2026-04-28T06:19:46Z"
                },
                {
                    "text": "\u0423\u0434\u0430\u0447\u0438 \u0432\u0430\u043c!!!! \u0420\u0430\u0434\u0443\u044e\u0441\u044c  \u0437\u0430 \u0432\u0430\u0441.\u0423\u0441\u043f\u0435\u0445\u043e\u0432 \u0432\u0430\u043c\u2764\u2764\u2764\u2764",
                    "author": "@margaritakowal8697",
                    "likes": 0,
                    "publishedAt": "2026-04-27T12:08:02Z"
                },
                {
                    "text": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u043c\u043e\u0438 \u0434\u043e\u0440\u043e\u0433\u0438\u0435 \u0434\u0435\u0432\u043e\u0447\u043a\u0438 \u2764\u2764\u2764\ud83d\ude0a\ud83c\udf89\ud83c\udf89\ud83c\udf89",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0435\u0439\u041c\u043e\u0440\u0438\u043d-\u04429\u044c",
                    "likes": 2,
                    "publishedAt": "2026-04-27T09:00:05Z"
                },
                {
                    "text": "\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u041e\u0422\u0422\u041e \u043e\u0440\u043a\u0435\u0441\u0442\u0440 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445 \u0434\u0435\u0432\u0443\u0448\u0435\u043a \u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0441 \u0431\u0435\u0440\u0435\u0433\u043e\u0432 \u0440. \u0410\u043c\u0443\u0440 \u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u0433\u043e\ud83d\udc4b\ud83d\udc4b\ud83d\udc4b\ud83d\udcaf\ud83c\udf0c\ud83d\udca5\ud83c\udf39\ud83c\udf37\ud83c\udf39\ud83c\udf37\ud83c\udf39\ud83c\udf37\ud83d\udc51\ud83d\udc51\ud83d\udc51\ud83d\udc51\ud83d\udc51\ud83d\udc51\ud83d\udc51",
                    "author": "@\u0412\u044f\u0447\u0435\u0441\u043b\u0430\u0432\u0411\u0435\u043b\u044c\u0434\u044b-\u044c7\u0442",
                    "likes": 0,
                    "publishedAt": "2026-04-27T14:13:45Z"
                },
                {
                    "text": "\u0422\u043e\u043b\u044c\u043a\u043e \u0432\u0441\u0442\u0430\u043d\u0435\u0442 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\n\u044f \u043d\u0435\u0441\u0443 \u0432\u0430\u043c \u0431\u0443\u043a\u0435\u0442,\n\u0412 \u043d\u0451\u043c \u0440\u043e\u043c\u0430\u0448\u043a\u0438 , \u0431\u0430\u0433\u0443\u043b\u044c\u043d\u0438\u043a , \u0443\u0440\u0433\u0443\u0439\u043a\u0430.\n\u041b\u0443\u0447\u0448\u0435 \u0432\u0441\u044f\u0447\u0435\u0441\u043a\u0438\u0445  \u0441\u043b\u043e\u0432\n\u0417\u0430\u0431\u0430\u0439\u043a\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u0432\u044c .\n\u0423\u043b\u044b\u0431\u043d\u0438\u0442\u0435\u0441\u044c \u0441\u043a\u043e\u0440\u0435\u0439 , \u043a\u0440\u0430\u0441\u043e\u0442\u0443\u043b\u044c\u043a\u0438.",
                    "author": "@\u041d\u0438\u043a\u043e\u043b\u0430\u0439-\u04431\u044b2\u044b",
                    "likes": 0,
                    "publishedAt": "2026-04-28T03:37:39Z"
                }
