                {
                    "text": "\u0995\u09be\u09b2\u09c7\u09ae\u09be\u09b0 \u09a6\u09be\u0993\u09df\u09be\u09a4 \u09a6\u09bf\u09df\u09c7 \u0997\u09c7\u09b2\u09be\u09ae.!\n\u0644\u0627 \u0627\u0655\u0644\u0647 \u0627\u0655\u0644\u0627 \u0627\u0644\u0644\u0647 \u0645\u062d\u0645\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0651\u0647\n\"\u09b2\u09be \u0987\u09b2\u09be\u09b9\u09be \u0987\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6\u09c1\u09b0 \u09b0\u09be\u09b8\u09c1\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9\"(\u09b8\u09be:)",
                    "author": "@salman-yt009",
                    "likes": 11,
                    "publishedAt": "2026-04-23T18:28:58Z"
                },
                {
                    "text": "\u0987\u09a8\u09cd\u09a8\u09be \u09b2\u09bf\u09b2\u09cd\u09b2\u09be\u09b9\u09bf \u0993\u09df\u09be \u0987\u09a8\u09cd\u09a8\u09be \u0987\u09b2\u09be\u0987\u09b9\u09bf \u09b0\u09be\u099c\u09bf\u0989\u09a8\u0964\n\n\u0998\u099f\u09a8\u09be\u099f\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09ab\u09c7\u0995 \u09ae\u09a8\u09c7 \u0995\u09b0\u099b\u09bf\u09b2\u09be\u09ae \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09ad\u09be\u09b2\u09cb \u0995\u09b0\u09c7 \u0996\u09cb\u0981\u099c \u09a8\u09bf\u09df\u09c7 \u09a6\u09c7\u0996\u09be\u09b2\u09be\u09ae \u0986\u09b8\u09b2\u09c7 \u0998\u099f\u09a8\u09be\u099f\u09bf \u09b8\u09a4\u09cd\u09af\u09bf\n\n\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u098f\u0995\u09a6\u09bf\u09a8 \u099a\u09b2\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b9\u09ac\u09c7 \u0995\u09be\u09b0\u09cb \u0986\u0997\u09c7 \u09ac\u09be \u0995\u09be\u09b0\u09cb \u09aa\u09b0\u09c7\n\n\u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u09ae\u09be\u09a8\u09c1\u09b7 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09b0 \u09b8\u09cd\u09ac\u09be\u09a6 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09ac\u09c7\u0964\n\n\u0985\u09a8\u09c7\u0995\u09c7 \u09a6\u09c7\u0996\u09be\u09b2\u09be\u09ae \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09ac\u09bf\u09b7\u09df\u099f\u09be \u09a8\u09bf\u09df\u09c7 \u0985\u09a8\u09c7\u0995 \u0995\u09bf\u099b\u09c1 \u09ac\u09b2\u099b\u09c7\u09a8 \u09ac\u09b2\u09be\u099f\u09be \u09b9\u0987\u09a4\u09cb \u0985\u09a8\u09c7\u0995\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09b8\u09cd\u09ac\u09be\u09ad\u09be\u09ac\u09bf\u0995 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0995\u099f\u09be \u09ae\u09be\u09a8\u09c1\u09b7 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09cb\u09df\u09be \u0995\u09b0\u09be \u0989\u099a\u09bf\u09a4\u0964\n\n\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u0995\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u0