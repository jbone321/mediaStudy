                    "text": "\u4e09\u56fd\u540c\u76df\u3068\u5bfe\u30bd\u4e2d\u7acb\u6761\u7d04\u3067\u65e5\u672c\u3092\u8ffd\u3044\u8a70\u3081\u305f\u7a76\u6975\u306e\u30a8\u30b4\u30a4\u30b9\u30c8",
                    "author": "@flexwind057",
                    "likes": 17,
                    "publishedAt": "2026-04-25T15:19:03Z"
                },
                {
                    "text": "\u6226\u524d\u306e\u72b6\u614b\u3092\u8a9e\u308b\u3068\u304d\u306b\n\u4eba\u7a2e\u5dee\u5225\u304c\u3059\u3063\u307d\u308a\u629c\u3051\u3066\u3044\u308b\u306e\u306f\u4e8b\u5b9f\u3060\u3088\n\u767d\u4eba\u304c\u6bb4\u308a\u8fd4\u3055\u308c\u3066\u8a8d\u8b58\u3092\u591a\u5c11\u5909\u3048\u305f\u306e\u306f\u4e8b\u5b9f",
                    "author": "@\u308f\u3093\u592a\u90ce-u6k",
                    "likes": 20,
                    "publishedAt": "2026-04-25T18:57:00Z"
                },
                {
                    "text": "\u5c0f\u8aac\u5bb6\u306e\u5c71\u7530\u98a8\u592a\u90ce\u306f\u81ea\u8457\u306e\u4e2d\u3067\u300c\u677e\u5ca1\u306f\u76f8\u624b\u306e\u624b\u3092\u898b\u305a\u306b\u3001\u81ea\u5206\u306e\u624b\u3060\u3051\u3092\u898b\u3066\u3044\u308b\u9ebb\u96c0\u6253\u3061\u3067\u3042\u3063\u305f\u3002\u30e4\u30af\u30de\u30f3\u3092\u5fd7\u3057\u3066\u3001\u30e4\u30af\u30de\u30f3\u306b\u632f\u308a\u8fbc\u3093\u3060\u300d\u3068\u8a55\u3057\u3066\u3044\u307e\u3059",
                    "author": "@\u5e30\u96f2\u57ce",
                    "likes": 39,
                    "publishedAt": "2026-04-25T12:43:29Z"
                },
                {
                    "text": "\u307e\u30414\u5e74\u4ee5\u4e0a\u3082\u7768\u307f\u5408\u3063\u305f\u5f8c\u306b\u6bb4\u3063\u305f\u3093\u3060\u3088\u306a\u3002",
                    "author": "@arahard25017",
                    "likes": 14,
                    "publishedAt": "2026-04-25T14:01:52Z"
                },
                {
                    "text": "\u4eca\u306e\u30a2\u30e1\u30ea\u30ab\u4eba\u3082\u540c\u3058\u3002",
                    "author": "@\u7fbd\u86fe\u30b1\u30f3\u30b8",
                    "likes": 5,
                    "publishedAt": "2026-04-26T08:20:02Z"
                },
                {
                    "text": "\u4eca\u3067\u3082\u5148\u306e\u5927\u6226\u306f\u56de\u907f\u51fa\u6765\u305f\u3057\u7d76\u5bfe\u305d\u3046\u3059\u3079\u304d\u3067\u3042\u3063\u305f\u3068\u601d\u3046\u304c\u3001\u4eca\u65e5\u306e\u65e5\u7c73\u540c\u76df\u306f\u5927\u6771\u4e9c\u6226\u4e89\u304c\u7121\u304b\u3063\u305f\u3089\u679c\u305f\u3057\u3066\u3069\u3046\u306a\u3063\u3066\u3044\u305f\u3060\u308d\u3046\u304b\u3001\u3068\u3044\u3046\u601d\u3044\u3084\u30b8\u30ec\u30f3\u30de\u3092\u611f\u3058\u308b\u3002",
                    "author": "@giageor7636",
                    "likes": 8,
                    "publishedAt": "2026-04-26T03:01:11Z"
                },
                {
                    "text": "\u6226\u4e89\u3067\u306a\u3051\u308c\u3070\u5fae\u7b11\u307e\u3057\u3044\uff08\uff1f\uff09\u95a2\u4fc2\u306a\u306e\u304b\u3082\u77e5\u308c\u306a\u3044\u304c\u2026\u6226\u4e89\u306a\u306e\u3067\u306d\u2026",
                    "author": "@87\u30d2\u30ed\u30bf\u30b1",
                    "likes": 46,
                    "publishedAt": "2026-04-25T13:37:18Z"
                },
                {
                    "text": "\u305d\u306e\u9762\u5b50\u306e\u305f\u3081\u306b\u4f55\u767e\u4e07\u3082\u306e\u7121\u8f9c\u306e\u56fd\u6c11\u3092\u76fe\u306b\u3057\u3066\u6bba\u3055\u305b\u305f\u3089\u8a71\u306b\u306a\u3089\u3093\u3084\u308d\u3002",
                    "author": "@mukadetaru",
                    "likes": 3,
                    "publishedAt": "2026-04-26T02:40:05Z"
                },
                {
                    "text": "\u30dd\u30c1\u306b\u306a\u3063\u305f\u65e5\u672c\u306f\u3053\u308c\u304b\u3089\u9ad8\u3044\u30ac\u30bd\u30ea\u30f3\u3092\u30a2\u30e1\u30ea\u30ab\u306b\u4f9d\u5b58\u3057\u306a\u304d\u3083\u3044\u3051\u306a\u3044\uff01\u307e\u305f\u6226\u524d\u306b\u623b\u3063\u305f",
                    "author": "@\u5909\u614b\u304a\u3058\u3055\u3093\u30c1\u30e3\u30f3\u30cd\u30eb",
                    "likes": 2,
                    "publishedAt": "2026-04-26T13:18:03Z"
                },
                {
                    "text": "\u677e\u5ca1\u306e\u6700\u5927\u306e\u7279\u5fb4\u306f\u300c\u81ea\u5206\u306f\u30a2\u30e1\u30ea\u30ab\u306e\u5c02\u9580\u5bb6\u3067\u3042\u308b\u300d\u3068\u3044\u3046\u904e\u5270\u306a\u81ea\u4fe1\u306b\u3042\u308a\u307e\u3059\u3002\n\u5fc3\u7406\u5b66\u7684\u306b\u8a00\u3048\u3070\u3001\u81ea\u5206\u306e\u904e\u53bb\u306e\u7d4c\u9a13\uff08\u7279\u306b\u82e6\u52b4\u3084\u5dee\u5225\u306e\u8a18\u61b6\uff09\u3092\u4e00\u822c\u5316\u3057\u3059\u304e\u3066\u3001\u5f53\u6642\u306e\u30a2\u30e1\u30ea\u30ab\u56fd\u5185\u306e\u591a\u69d8\u306a\u653f\u6cbb\u529b\u5b66\u3084\u3001\u30eb\u30fc\u30ba\u30d9\u30eb\u30c8\u653f\u6a29\u306e\u771f\u610f\u3092\u8aad\u307f\u8aa4\u3063\u305f\u5074\u9762\u304c\u3042\u308a\u307e\u3059\u3002\u5f7c\u306b\u3068\u3063\u3066\u306e\u30a2\u30e1\u30ea\u30ab\u306f\u304b\u3064\u3066\u81ea\u5206\u3092\u51b7\u9047\u3057\u305f\u300c\u5f37\u8005\u306e\u8ad6\u7406\u3067\u52d5\u304f\u56fd\u300d\u306e\u307e\u307e\u6b62\u307e\u3063\u3066\u3044\u305f\u306e\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002",
                    "author": "@\u6771\u96f2\u5915\u59eb",
                    "likes": 2,
                    "publishedAt": "2026-04-26T10:06:58Z"
                },
                {
                    "text": "\u305d\u306e\u5f8c\u3092\u898b\u308b\u306b\u4e00\u672c\u9053\u3058\u3083\u306a\u304b\u3063\u305f\u3068\u3057\u3066\u3082\u6bb4\u308a\u306b\u3044\u304f\u3088\u3046\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u3088\u3046\u3060",
                    "author": "@shuro-kokokaradeep",
                    "likes": 1,
                    "publishedAt": "2026-04-26T11:27:31Z"
                },
                {
                    "text": "\u7121\u8b00\u306a\u6226\u3092\u58f2\u3063\u305f\u7d50\u679c\u3001\u53cb\u9054\u306b\u306f\u5230\u5e95\u53ca\u3070\u306a\u3044\u3001\u5b8c\u74a7\u306a\u30dd\u30c1\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u30aa\u30c1",
                    "author": "@MMKL-t8b",
                    "likes": 14,
                    "publishedAt": "2026-04-26T02:07:57Z"
                },
                {
                    "text": "\u7684\u3092\u5c04\u3066\u3044\u308b",
                    "author": "@\u4e9c\u5dde\u7ae5\u5b50",
                    "likes": 3,
                    "publishedAt": "2026-04-26T12:05:11Z"
                },
                {
                    "text": "\u51c4\u3048\u306a\u3001\u6226\u5f8c\u306e\u65e5\u7c73\u95a2\u4fc2\u3092\u898b\u4e8b\u306b\u8a00\u3044\u5f53\u3066\u3066\u3044\u308b",
                    "author": "@tobyon1973",
                    "likes": 0,
                    "publishedAt": "2026-04-27T06:14:31Z"
                },
                {
                    "text": "\u65e5\u672c\u304c\u5148\u306b\u6bb4\u3063\u305f\u3089\u30dc\u30b3\u30dc\u30b3\u306b\u3055\u308c\u305f",
                    "author": "@mune3740",
                    "likes": 1,
                    "publishedAt": "2026-04-26T16:04:26Z"
                },
                {
                    "text": "\u73fe\u4ee3\u3067\u3082\u305d\u306e\u307e\u3093\u307e\u3067\u3059\u306d\n\n\u3044\u3084\u3001\u307b\u3093\u3068\u306b\uff08\u4f55\u5ea6\u76ee\u304b\u306e\u7c73\u610f\u6226\u4e89\u898b\u306a\u304c\u3089\uff09",
                    "author": "@rt-qz8ig",
                    "likes": 0,
                    "publishedAt": "2026-04-27T07:00:47Z"
                },
                {
                    "text": "\u8a00\u3063\u3066\u3044\u308b\u3053\u3068\u306f\u5408\u3063\u3066\u3044\u308b",
                    "author": "@\u30b0\u30ea\u30d5\u30a9\u30f3\u5927\u7d71\u9818",
                    "likes": 0,
                    "publishedAt": "2026-04-27T00:05:08Z"
                },
                {
                    "text": "\u5c11\u5e74\u30b8\u30e3\u30f3\u30d7\u306e\u4e16\u754c\u89b3\u3067\u3059\u306d\u3002\n\u500b\u4eba\u306e\u8a71\u3057\u3068\u56fd\u5bb6\u6226\u4e89\u306e\u8a71\u3057\u306f\u4e00\u7dd2\u3067\u306f\u306a\u3044\u3068\u8fd1\u885b\u3055\u3093\u306f\u770b\u7834\u3057\u3066\u3044\u305f\u306d\u3002",
                    "author": "@\u9234\u6728\u8cb4\u53f8-t9p",
                    "likes": 12,
                    "publishedAt": "2026-04-25T13:36:18Z"
                },
                {
                    "text": "\u5b9f\u969b\u30a2\u30e1\u30ea\u30ab\u4eba\u5206\u6790\u3068\u3057\u3066\u306f\u6b63\u3057\u3044\u3068\u306f\u601d\u3046",
                    "author": "@\u30e9\u30f3\u30b0-q7r",
                    "likes": 21,
                    "publishedAt": "2026-04-25T13:19:56Z"
                },
                {
                    "text": "\u65e5\u7c73\u306f\u601d\u3044\u5207\u308a\u6226\u3063\u305f\u3002\u65e5\u672c\u3082\u601d\u3044\u6b8b\u3059\u3053\u3068\u306f\u7121\u3044\u3002\n\u6b74\u53f2\u306e\uff11\u30da\u30fc\u30b8\u3068\u306a\u3063\u305f\u3002\u3057\u304b\u3057\u305d\u308c\u4ee5\u964d\u306f\u9023\u52dd\u4e2d\u3002\n\u5b9f\u306f\u4eca\u3067\u3082\u9023\u52dd\u4e2d\u306a\u306e\u3060\u3088\u3002\u30e8\u30fc\u30ed\u30c3\u30d1\u3092\u898b\u308c\u3070\u5206\u304b\u308b\u3002",
                    "author": "@kaisermuto",
                    "likes": 0,
                    "publishedAt": "2026-04-27T06:01:13Z"
                },
                {
                    "text": "\u56fd\u969b\u9023\u76df\u3092\u8131\u9000\u3057\u4e16\u754c\u304b\u3089\u5b64\u7acb\u3057\u307e\u3057\u305f\u306d\u3002",
                    "author": "@Minami-f5r",
                    "likes": 0,
                    "publishedAt": "2026-04-26T07:13:56Z"
                },
                {
                    "text": "\u677e\u5ca1\u306f\u3001\u30a2\u30e1\u30ea\u30ab\u4eba\u3060\u3002\ud83d\ude02\ud83d\ude22\ud83d\ude05\ud83d\ude0a\ud83d\ude2e\ud83d\ude22\ud83d\ude22\ud83d\ude02\ud83d\ude02\ud83d\ude2e\ud83d\ude05\ud83d\ude0a",
                    "author": "@\u9577\u6fa4\u548c\u662d",
                    "likes": 0,
                    "publishedAt": "2026-04-27T05:30:27Z"
                },
                {
                    "text": "\u3053\u308c\u306f\u767d\u4eba\u540c\u58eb\u306e\u8a71\u3060\u306d",
                    "author": "@r.h.915",
