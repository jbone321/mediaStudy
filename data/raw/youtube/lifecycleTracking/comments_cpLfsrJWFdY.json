    "history": [
        {
            "fetchedAt": "20260314_170009",
            "commentCount": 9,
            "comments": [
                {
                    "text": "\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u043c\u0435\u043d\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c-\u043a\u0430\u043d\u0430\u043b\u0435 \"\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u044f \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u043b\", \u0441\u0441\u044b\u043b\u043a\u0430 \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u043a\u0430\u043d\u0430\u043b\u0430.",
                    "author": "@cultpluto",
                    "likes": 1,
                    "publishedAt": "2026-03-14T15:27:34Z"
                },
                {
                    "text": "\u0414\u044f\u0434\u044f \u0437\u0430\u043b\u0435\u0442\u0435\u043b \u043d\u0430 \u0445\u0445\u0440\u0443,\u043d\u0430\u043a\u0438\u0434\u0430\u043b \u043c\u0435\u0441\u0442\u043d\u044b\u043c \u0437\u0432\u0435\u0437\u0434\u0430\u043c \u0437\u0430 \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u043a \u0438 \u043f\u043e\u0448\u0435\u043b \u0434\u0430\u043b\u044c\u0448\u0435)\u041b\u0435\u0433\u0435\u043d\u0434\u0430!",
                    "author": "@vzen13",
                    "likes": 14,
                    "publishedAt": "2026-03-14T15:40:30Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u044e",
                    "author": "@shortsiinteresting",
                    "likes": 6,
                    "publishedAt": "2026-03-14T15:53:47Z"
                },
                {
                    "text": "\u0412\u0441\u0435 \u0435\u0449\u0451 \u043b\u0443\u0447\u0448\u0438\u0439 \u0434\u044f\u0434\u044c\u043a\u0430 \u0441\u043f\u0443\u0441\u0442\u044f \u043f\u043e\u0447\u0442\u0438 20 \u043b\u0435\u0442",
                    "author": "@maxsmith8071",
                    "likes": 4,
                    "publishedAt": "2026-03-14T16:22:04Z"
                },
                {
                    "text": "\u0421\u043b\u0443\u0448\u0430\u043b\u0438, \u0437\u043d\u0430\u0435\u043c, \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u0440\u0443\u0435\u043c. \n\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0438\u0434\u043e\u0441!",
                    "author": "@DamdinBatorov",
                    "likes": 0,
                    "publishedAt": "2026-03-14T16:32:15Z"
                },
                {
                    "text": "\u041e\u043e\u043e\u043e\u043e\u043e\u043e\u043e \u0414\u044f\u0434\u044f \u0416\u0435\u043d\u044f\u2764",
                    "author": "@Tor_Pirat",
                    "likes": 2,
                    "publishedAt": "2026-03-14T15:30:54Z"
                },
                {
                    "text": "\u0412\u043e\u043e\u0431\u0449\u0435 \u0414\u0416 \u043d\u0430\u0433\u043d\u0443\u043b \u0432 \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0430\u0432\u043b\u0438\u043d\u043e\u0432, \u043d\u043e \u0441\u0430\u043c\u044b\u0439 \u0441\u043c\u0430\u043a \u044d\u0442\u043e \u0435\u0433\u043e \u0444\u0438\u0442\u044b \u0441 \u0411\u0430\u0431\u0430\u043d\u043e\u043c",
                    "author": "@Tor_Pirat",
                    "likes": 6,
                    "publishedAt": "2026-03-14T15:35:19Z"
                },
                {
                    "text": "\u0414\u0416 \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \ud83d\udd25\u0435\u0433\u043e \u0438 \u043d\u0430 \u0412\u0435\u0440\u0441\u0443\u0441\u0435 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u0438. \u041f\u043e\u043c\u043d\u044e \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0431\u0430\u0442\u043b\u043e\u0432 \u0422\u043e\u043f\u043e\u0440\u0430 \u0441\u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u0441 \u043a\u0435\u043c \u043e\u043d \u0445\u043e\u0447\u0435\u0442 \u0431\u0430\u0442\u043b\u0438\u0442\u0441\u044f, \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0414\u0416 \u0438\u043b\u0438 \u0411\u0430\u043d\u043a. \u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e, \u0437\u0430 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043b\u0435\u0433\u0435\u043d\u0434\u044b\ud83d\ude0a",
                    "author": "@\u0415\u0432\u0433\u0435\u043d\u0438\u0439\u0422\u0440\u0443\u0431\u0435\u043d\u043a\u043e-\u04433\u0431",
                    "likes": 0,
                    "publishedAt": "2026-03-14T16:47:46Z"
                },
                {
                    "text": "\ud83d\udc4d",
                    "author": "@\u0418\u0432\u0430\u043d-\u044f1\u044d3\u0444",
                    "likes": 1,
                    "publishedAt": "2026-03-14T16:10:14Z"
                }
            ]
