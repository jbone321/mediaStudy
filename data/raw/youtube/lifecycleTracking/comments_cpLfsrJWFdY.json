        {
            "fetchedAt": "20260315_081915",
            "commentCount": 25,
            "comments": [
                {
                    "text": "\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u043c\u0435\u043d\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c-\u043a\u0430\u043d\u0430\u043b\u0435 \"\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u044f \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u043b\", \u0441\u0441\u044b\u043b\u043a\u0430 \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u043a\u0430\u043d\u0430\u043b\u0430.",
                    "author": "@cultpluto",
                    "likes": 13,
                    "publishedAt": "2026-03-14T15:27:34Z"
                },
                {
                    "text": "\u0414\u0416 \u043b\u0435\u0433\u0435\u043d\u0434\u0430 \u0438 \u0435\u0433\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0435 \u0441\u0442\u0440\u043e\u043a\u0438 \u043f\u0435\u0440\u0435\u0434 \u0442\u0440\u0435\u043a\u043e\u043c \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u0434:\n\n\u0422\u044b - \u0412\u0438\u0442\u044e\u0448\u0430, \u044f - \u0415\u0432\u0433\u0435\u043d\u0438\u0439, \n\u0442\u044b \u043d\u0435 \u0433\u0435\u043d\u0438\u0439, \u044f \u043d\u0435 \u0433\u0435\u043d\u0438\u0439 \n\u0422\u044b \u0433\u0430\u0432\u043d\u043e \u0438 \u044f \u0433\u0430\u0432\u043d\u043e\n\u042f \u043d\u0435\u0434\u0430\u0432\u043d\u043e, \u0442\u044b \u0434\u0430\u0432\u043d\u043e \ud83d\ude02",
                    "author": "@TheFreeman755",
                    "likes": 286,
                    "publishedAt": "2026-03-14T21:45:29Z"
                },
                {
                    "text": "\u0414\u044f\u0434\u044f \u0437\u0430\u043b\u0435\u0442\u0435\u043b \u043d\u0430 \u0445\u0445\u0440\u0443,\u043d\u0430\u043a\u0438\u0434\u0430\u043b \u043c\u0435\u0441\u0442\u043d\u044b\u043c \u0437\u0432\u0435\u0437\u0434\u0430\u043c \u0437\u0430 \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u043a \u0438 \u043f\u043e\u0448\u0435\u043b \u0434\u0430\u043b\u044c\u0448\u0435)\u041b\u0435\u0433\u0435\u043d\u0434\u0430!",
                    "author": "@vzen13",
                    "likes": 379,
                    "publishedAt": "2026-03-14T15:40:30Z"
                },
                {
                    "text": "\u041a\u043e\u0433\u0434\u0430 \u0441\u0443\u0434\u044c\u0438 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438 \u0448\u0442\u0443\u043a\u0443 \u0441 \"\u0440\" \u043e\u043d\u0438 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u0437\u0430\u0441\u0430\u0434\u0438\u0442\u044c \u0435\u0433\u043e, \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0432 \u0442\u0435\u043c\u0443 \u043f\u0440\u043e \u043f\u0438\u0440\u0430\u0442\u043e\u0432, \u043d\u0430\u0438\u0432\u043d\u043e \u043f\u043e\u043b\u0430\u0433\u0430\u044f, \u0447\u0442\u043e \u0414\u044f\u0434\u044f \u043d\u0435 \u0432\u044b\u0432\u0435\u0437\u0435\u0442 \u0442\u0435\u043a\u0441\u0442)",
                    "author": "@I_am_max_m",
                    "likes": 62,
                    "publishedAt": "2026-03-14T23:28:13Z"
                },
                {
                    "text": "\u042f \u0431\u044b\u043b \u043d\u0430 \u0435\u0433\u043e \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u0435 , \u043e\u043d \u043f\u0440\u0438\u0435\u0437\u0436\u0430\u043b \u0432 \u041c\u0443\u0440\u043e\u043c \u0432 \u0434\u0430\u043b\u0451\u043a\u0438\u0435 \u0431\u043e\u0440\u043e\u0434\u0430\u0442\u044b\u0435 \u0433\u043e\u0434\u0430 , \u0442\u043e\u0433\u0434\u0430 \u044f \u0435\u0449\u0451 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u043b \u043a\u0442\u043e \u044d\u0442\u043e \ud83d\ude2e",
                    "author": "@Tononatex",
                    "likes": 111,
                    "publishedAt": "2026-03-14T19:17:34Z"
                },
                {
                    "text": "\u0412\u0441\u0435 \u0435\u0449\u0451 \u043b\u0443\u0447\u0448\u0438\u0439 \u0434\u044f\u0434\u044c\u043a\u0430 \u0441\u043f\u0443\u0441\u0442\u044f \u043f\u043e\u0447\u0442\u0438 20 \u043b\u0435\u0442",
                    "author": "@maxsmith8071",
                    "likes": 92,
                    "publishedAt": "2026-03-14T16:22:04Z"
                },
                {
                    "text": "\u0414\u044f\u0434\u044e \u0416\u0435\u043d\u044e \u0432 10 \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u043b \u0438 \u043e\u0444\u0438\u0433\u0435\u043b. \u041e\u043d \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0431\u0438\u0432\u0430\u043b\u0441\u044f \u0441\u0432\u043e\u0435\u0439 \u043e\u0441\u0442\u0440\u043e\u0443\u043c\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u043a\u0440\u0443\u0442\u043e\u0441\u0442\u044c\u044e.",
                    "author": "@Rtartarta",
                    "likes": 53,
                    "publishedAt": "2026-03-14T17:15:48Z"
                },
                {
                    "text": "\u041e\u0442 \u0434\u0443\u0448\u0438 \u0437\u0430 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0435! \u0414\u044f\u0434\u044f \u0416\u0435\u043d\u044f \u043b\u0443\u0447\u0448\u0438\u0439, \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0440\u0435\u0441\u043f\u0435\u043a\u0442",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0422\u0438\u0442\u043e\u0432-\u04347\u0434",
                    "likes": 42,
                    "publishedAt": "2026-03-14T18:53:05Z"
                },
                {
                    "text": "\u041d\u0430\u0441\u0447\u0451\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0414\u044f\u0434\u044f \u0416\u0435\u043d\u044f \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b \u0432 \u0442\u0435\u043a\u0441\u0442\u0430\u0445 \u0431\u0443\u043a\u0432\u0443 \"\u0420\", \u044d\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043b\u0438\u043f\u043e\u0433\u0440\u0430\u043c\u043c\u0430. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c \u0432\u0435\u0441\u044c\u043c\u0430 \u0441\u043e\u043b\u0438\u0434\u043d\u0443\u044e \u043d\u0430\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0438 \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e, \u0447\u0442\u043e-\u0431\u044b \u044d\u0442\u043e \u0432\u0441\u0451 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u043b\u043e\u0436\u0438\u0442\u044c \u0432\u043e \u0447\u0442\u043e-\u0442\u043e \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0435 \u0438 \u0441\u0432\u044f\u0437\u043d\u043e\u0435.",
                    "author": "@my-own-hell",
                    "likes": 10,
                    "publishedAt": "2026-03-15T01:31:52Z"
                },
                {
                    "text": "\u0412\u043e\u043e\u0431\u0449\u0435 \u0414\u0416 \u043d\u0430\u0433\u043d\u0443\u043b \u0432 \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0430\u0432\u043b\u0438\u043d\u043e\u0432, \u043d\u043e \u0441\u0430\u043c\u044b\u0439 \u0441\u043c\u0430\u043a \u044d\u0442\u043e \u0435\u0433\u043e \u0444\u0438\u0442\u044b \u0441 \u0411\u0430\u0431\u0430\u043d\u043e\u043c",
                    "author": "@Tor_Pirat",
                    "likes": 53,
                    "publishedAt": "2026-03-14T15:35:19Z"
                },
                {
                    "text": "\u041e\u0444\u0438\u0433\u0435\u0442\u044c, \u044f \u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u043c\u043d\u044e, \u0442\u043a \u043d\u0435 \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0441\u044f \u044d\u0442\u043e\u0439 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043e\u0439. \u041d\u043e \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442, \u0447\u0442\u043e \u0437\u0430\u043b\u0435\u0442\u0435\u043b \u043d\u043e\u0443\u043d\u0435\u0439\u043c \u043c\u0443\u0436\u0438\u043a, \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0432\u0441\u0435\u043c \u043a\u0430\u043a \u043d\u0430\u0434\u043e, \u0437\u0430\u043a\u0440\u044b\u043b \u0438 \u0441\u0432\u043e\u044e \u0446\u0435\u043b\u044c. \u041d\u0435 \u0437\u0430\u0437\u0432\u0435\u0437\u0434\u0438\u043b\u0441\u044f \u0438 \u043d\u0435 \u0443\u0448\u0435\u043b \u0432 \u0448\u043e\u0443\u0431\u0438\u0437\u043d\u0435\u0441, \u0430 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f \u0432 \u043d\u0430\u0443\u043a\u0443! \u041a\u0440\u0443\u0442\u043e!",
                    "author": "@\u041c\u0430\u043a\u0441\u0438\u043c\u042e\u0444\u0435\u0440\u0435\u0432-\u04376\u0441",
                    "likes": 2,
                    "publishedAt": "2026-03-15T07:42:25Z"
                },
                {
                    "text": "\u0414\u044f\u0434\u044f \u0416\u0435\u043d\u044f \u2014 \u043e\u0434\u0438\u043d \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u043a\u043e\u0432 \u0432 \u0440\u0443\u0441\u0441\u043a\u043e\u043c \u0440\u044d\u043f\u0435 \u0437\u0430 \u0432\u0441\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e",
                    "author": "@mikhailfedotov2008",
                    "likes": 10,
                    "publishedAt": "2026-03-14T21:34:41Z"
                },
                {
                    "text": "\u0427\u0435\u043b\u043e\u0432\u0435\u043a\u0443 \u043d\u0443\u0436\u0435\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u0438 \u044d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435",
                    "author": "@\u0410\u043b\u0435\u043a\u0441\u0435\u0439\u0410\u043b\u0435\u043a\u0441\u0435\u0435\u0432-\u04379\u04346\u0441",
                    "likes": 4,
                    "publishedAt": "2026-03-14T23:08:28Z"
                },
                {
                    "text": "\u0427\u0435\u043b\u043e\u0432\u0435\u043a\u0443 \u043d\u0443\u0436\u0435\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0438 \u044d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435!",
                    "author": "@KlubCuts",
                    "likes": 0,
                    "publishedAt": "2026-03-15T08:16:31Z"
                },
                {
                    "text": "\u0412 \u043d\u0430\u0448\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e \u043e\u0434\u0438\u043d \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439 \u043f\u0440\u0438\u043d\u0451\u0441 \u0414\u044f\u0434\u044e \u0416\u0435\u043d\u044e \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c, \u043e\u0447\u0435\u043d\u044c \u043c\u043d\u043e\u0433\u043e \u0435\u0433\u043e \u0441\u043b\u0443\u0448\u0430\u043b\u0438, \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0438\u043d\u043e\u0433\u0434\u0430 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u043c, \u0441\u043f\u0430\u0441\u0438\u0431\u043e!",
                    "author": "@\u041a\u0438\u0440\u0438\u043b\u043b\u0410\u0433\u0430\u0444\u043e\u043d\u043e\u0432-\u04322\u044c",
                    "likes": 14,
                    "publishedAt": "2026-03-14T19:23:09Z"
                },
                {
                    "text": "\u0412\u043e\u0442 \u043e\u0442 \u0434\u0443\u0448\u0438 \u0437\u0430 \u0442\u043e \u0447\u0442\u043e \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b \u044d\u0442\u043e\n\u041d\u0435\u0437\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u043e \u043e\u0431\u0434\u0435\u043b\u0438\u043b\u0438 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u043c \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434 \u0440\u044d\u043f\u0430\n\u0425\u043e\u0442\u044f \u0441 \u0445\u0445.\u0440\u0443 \u0432\u0441\u0435 \u043d\u0430\u0447\u0430\u043b\u043e\u0441\u044c",
                    "author": "@ATAKA_ATAKA",
                    "likes": 10,
                    "publishedAt": "2026-03-14T18:28:53Z"
                },
                {
                    "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u044e",
                    "author": "@shortsiinteresting",
                    "likes": 15,
                    "publishedAt": "2026-03-14T15:53:47Z"
                },
                {
                    "text": "\u0415\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430 \u0434\u0430\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0432\u0443\u0447\u0430\u0442 \u043a\u0440\u0443\u0442\u043e \u0438 \u043a\u0440\u0443\u0447\u0435 \u0442\u0435\u043a\u0441\u0442\u043e\u0432 \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0445 \u043c\u0441, \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043b\u0435\u0433\u0435\u043d\u0434\u0430",
                    "author": "@Terro_red",
                    "likes": 2,
                    "publishedAt": "2026-03-15T03:30:26Z"
                },
                {
                    "text": "\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0431\u0430\u0442\u043b, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u044f \u0441\u043b\u0435\u0434\u0438\u043b \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0438 \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043b\u044e\u0442\u043e \u0431\u043e\u043b\u0435\u043b \u0437\u0430 \u0414\u044f\u0434\u044e \u0416\u0435\u043d\u044e \u043f\u043e\u0441\u043b\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0440\u0430\u0443\u043d\u0434\u0430 \u0438 \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u043a\u043e\u043d\u0446\u0430. \u0420\u0430\u0434 \u043f\u043e\u0431\u0435\u0434\u0435 \u0431\u044b\u043b, \u043a\u0430\u043a \u043f\u043e\u0431\u0435\u0434\u0435 \u043b\u044e\u0431\u0438\u043c\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 \u043b\u0438\u0433\u0435 \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u043e\u0432.",
                    "author": "@barcamaniacstr",
                    "likes": 1,
                    "publishedAt": "2026-03-15T04:12:25Z"
                },
                {
                    "text": "\u043f\u0440\u043e \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430 \u0444\u043b\u0438\u043d\u0442\u0430 \u0438 \u0441\u043e\u043b\u044f\u0440\u0438\u0441 \u043b\u044e\u0431\u0438\u043c\u044b\u0435 \u0442\u0440\u0435\u043a\u0438!",
                    "author": "@Nivelenn",
                    "likes": 5,
                    "publishedAt": "2026-03-14T18:50:37Z"
                },
                {
                    "text": "\u0423 \u043c\u0435\u043d\u044f \u0441\u043b\u0435\u0437\u044b \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435(( \u0447\u0442\u043e \u0432\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@alinaseagull4138",
                    "likes": 0,
                    "publishedAt": "2026-03-15T08:08:30Z"
                },
                {
                    "text": "\u041f\u0435\u0441\u043d\u0438 \u0414\u044f\u0434\u0438 \u0416\u0435\u043d\u0438 - \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043c\u0443\u0437\u044b\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u043d\u0430 \u043c\u043e\u0435\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435.",
                    "author": "@mirboors",
                    "likes": 0,
                    "publishedAt": "2026-03-15T07:21:40Z"
                },
                {
                    "text": "\u041f\u043e\u0439\u0434\u0443 \u043f\u0435\u0440\u0435\u0441\u043b\u0443\u0448\u0430\u044e \u0432\u0441\u0435 \u0435\u0433\u043e \u0442\u0440\u0435\u043a\u0438. \u041f\u0440\u044f\u043c \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u044f",
                    "author": "@zima996",
                    "likes": 0,
                    "publishedAt": "2026-03-15T04:18:47Z"
                },
                {
                    "text": "\u041f\u0440\u043e\u0441\u0442\u043e \u00ab\u0432\u044b\u0448\u0435\u043b \u043f\u043e\u043a\u0443\u0440\u0438\u0442\u00bb \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u0435 \u0438 \u043f\u043e\u0448\u0435\u043b \u0434\u0430\u043b\u044c\u0448\u0435 \u0443\u0447\u0438\u0442\u044c\u0441\u044f ..",
                    "author": "@\u041c\u0438\u0448\u0430\u0414\u0438\u043c\u0430\u0447\u043a\u0438\u043d",
                    "likes": 4,
                    "publishedAt": "2026-03-14T19:07:41Z"
                },
                {
                    "text": "\u041f\u0440\u043e\u0448\u043b\u043e \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u0438 \u043c\u043d\u0435 \u0443\u0436 37, \u0430 \u0414\u044f\u0434\u044c \u0416\u0435\u043d\u044f \u0435\u0449\u0435 \u0432 \u0443\u0448\u0430\u0445) \u041b\u0435\u0433\u0435\u043d\u0434\u0430 !",
