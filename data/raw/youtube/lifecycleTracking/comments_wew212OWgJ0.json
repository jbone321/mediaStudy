                {
                    "text": "\u81ea\u5206\u306f\u266c\u266a\u266a\u3063\u3066\u3044\u3046\u30ea\u30ba\u30e0\u3060\u3051\u306e\u30e2\u30c1\u30fc\u30d5\u306730\u5206\u304f\u3089\u3044\u306e\u4ea4\u97ff\u66f2\u66f8\u3051\u305f\u304b\u3089\u3001\u30e2\u30c1\u30fc\u30d5\u6c7a\u3081\u3066\u4f7f\u3044\u56de\u3059\u306e\u306f\u5927\u4e8b\u3002\u3042\u3068\u3044\u304f\u3064\u304b\u306e\u5b9a\u578b\u30d1\u30bf\u30fc\u30f3\u899a\u3048\u308b\u306e\u3082\u5927\u4e8b(\u30c9\u30b7\u30e9\u30b7\u30c9,\u30ec\u30c9\u30b7\u30c9,6\u5ea6\u8df3\u8e8d,\u30bd\u30c9\u30b7\u30c9,\u30e9\u30b7\u30c9,\u30bd\u30b7\u30c9,\u30d5\u30a1\u30df\u30df\u30ec\u30ec\u30c9\u30c9\u30b7\u301c,\u30b7\u30e9\u30b7\u30c9,\u30ec\u30b7\u30c9,\u30b7\u30ec\u30c9\u7b49)",
                    "author": "@SHIMEpaseri",
                    "likes": 8,
                    "publishedAt": "2026-02-28T12:01:03Z"
                },
                {
                    "text": "\u30e1\u30ed\u30c7\u30a3\u30e9\u30a4\u30f3\u3068\u8a00\u3046\u304f\u3089\u3044\u3060\u3057\u306d\u3002\n\u3053\u306e\u52d5\u753b\u3060\u3068\u6697\u793a\u3055\u308c\u3066\u308b\u3060\u3051\u3067\u660e\u793a\u3055\u308c\u3066\u306a\u3044\u3051\u3069\u3001\n\u97f3\u697d\u3063\u3066\u5b9f\u306f\u8996\u899a\u7684\u306a\u82b8\u8853\u3088\u306d\u3002\n\u697d\u8b5c\uff08\u30d4\u30a2\u30ce\u30ed\u30fc\u30eb\uff09\u3067\u898b\u305f\u6642\u306b\u3001\u4efb\u610f\u306e\u5c0f\u7bc0\u9593\u3067\u9577\u3044\u77ed\u3044\u4e0a\u304b\u4e0b\u304b\u591a\u3044\u304b\u5c11\u306a\u3044\u304b\u767d\u3044\u304b\u9ed2\u3044\u304b\u30d0\u30e9\u30f3\u30b9\u3092\u610f\u8b58\u3059\u308b\u3068\u3001\u305d\u308c\u304c\u7d50\u679c\u7684\u306b\u97f3\u697d\u7684\u306a\u30e1\u30ed\u306b\u306a\u308b\u306e\u3088\u306d\u3002",
                    "author": "@BVTK8",
                    "likes": 4,
                    "publishedAt": "2026-02-28T16:42:39Z"
                },
                {
                    "text": "\u3044\u308f\u3086\u308b\u3001\u8df3\u3093\u3060\u3089\u57cb\u3081\u308b\u3068\u3044\u3046\u4f5c\u7528\u3067\u3059\u306d\u3002\u30e2\u30fc\u30c4\u30a1\u30eb\u30c8\u306e\u4ea4\u97ff\u66f240\u756a\u5192\u982d\u3068\u304b\u3001\u826f\u3044\u4f8b\u3060\u3068\u601d\u3044\u307e\u3059\u3002",
                    "author": "@J.t.0530",
                    "likes": 0,
                    "publishedAt": "2026-02-28T16:20:48Z"
                },
                {
                    "text": "\u4eca\u3001\u81ea\u5206\u304c\u4f5c\u3063\u305f\u66f2\u306e\u7de8\u66f2\u3067\u3042\u308c\u3053\u308c\u8a66\u884c\u932f\u8aa4\u3057\u3066\u3044\u308b\u3093\u3067\u3059\u304c\u3001\u4e3b\u65cb\u5f8b\u304c\u9cf4\u3063\u3066\u3044\u308b\u9593\u306b\u5f8c\u308d\u3067\u9cf4\u3089\u3059\u97f3\u3092\u3001\u3042\u3048\u3066\u300c\u30e1\u30ed\u30c7\u30a3\u30fc\u3089\u3057\u304f\u306a\u3044\u97f3\u300d\u306b\u3059\u308b\u3053\u3068\u3067\u4e3b\u65cb\u5f8b\u3092\u90aa\u9b54\u3057\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u3001\u3068\u3044\u3046\u306e\u3082\u91cd\u8981\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306a\u306e\u3067\u306f\u306a\u3044\u304b\u3068\u611f\u3058\u307e\u3057\u305f\u2026\u3002\u307e\u3042\u8a00\u3044\u63db\u3048\u308c\u3070\u526f\u65cb\u5f8b\u3067\u306f\u306a\u3044\u30a2\u30eb\u30da\u30b8\u30aa\u7b49\u306e\u97f3\u3092\u9cf4\u3089\u3059\u3068\u3044\u3046\u3053\u3068\u306b\u306f\u306a\u308b\u3093\u3067\u3059\u304c\u3001\u81ea\u5206\u307f\u305f\u3044\u306b\u526f\u65cb\u5f8b\u3092\u76db\u308a\u3059\u304e\u308b\u7656\u304c\u3042\u308b\u4eba\u306b\u306f\u5fc5\u8981\u306a\u8003\u3048\u65b9\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002",
                    "author": "@\u3082\u308b\u3082\u3061-z2s",
                    "likes": 11,
                    "publishedAt": "2026-02-28T10:50:50Z"
                },
                {
                    "text": "\u30af\u30e9\u30b7\u30c3\u30af\u306e\u5909\u594f\u66f2\u3068\u304b\u306f\u8272\u3093\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u4e00\u6c17\u306b\u898b\u308c\u308b\u306e\u3067\u4fbf\u5229\u3067\u3059\u306d\u3002\u30e2\u30fc\u30c4\u30a1\u30eb\u30c8\u306e\u304d\u3089\u304d\u3089\u661f\u5909\u594f\u66f2\u3068\u304b\u306f\u73fe\u4ee3\u3067\u3082\u4f7f\u3048\u308b\u30d1\u30bf\u30fc\u30f3\u304c\u591a\u3044\u3068\u601d\u3044\u307e\u3059",
                    "author": "@user-hyekrtfkyiayfkt5q",
                    "likes": 2,
                    "publishedAt": "2026-03-01T03:46:58Z"
                },
                {
                    "text": "\u672c\u984c\u304b\u3089\u9038\u308c\u307e\u3059\u304c\u4f8b\u306b\u51fa\u3057\u3066\u304f\u308c\u305f\u66f2\u306e\u30ea\u30cf\u30e2\u304c\u7f8e\u3057\u304f\u3066\u30d6\u30c3\u523a\u3055\u308a\u307e\u3059",
                    "author": "@msd1624l",
                    "likes": 0,
                    "publishedAt": "2026-02-28T12:47:33Z"
                },
                {
                    "text": "\u30e1\u30ed\u30c7\u30a3\u306f\u30b5\u30d6\u30b8\u30a7\u30af\u30c8\u2192\u30d5\u30ec\u30fc\u30ba\u2192\u30e2\u30c1\u30fc\u30d5\u2192\u30bb\u30eb\u306b\u5206\u3051\u3089\u308c\u3066\u3044\u308b\u304c\u4f5c\u66f2\u5bb6\u306b\u3088\u3063\u3066\u9055\u3046\u3002\n\u30d0\u30c3\u30cf\u306f\u30d5\u30a3\u30b0\u30fc\u30ec\u30f3\u30ec\u30fc\u30ec(\u30d5\u30a3\u30fc\u30ae\u30e5\u30fc\u30eb)\u5bfe\u4f4d\u6cd5(\u30d5\u30fc\u30ac\u3084\u30ab\u30ce\u30f3)\u30d5\u30a9\u30eb\u30c8\u30b7\u30e5\u30d4\u30cc\u30f3\u30b0\u3084\u30bc\u30af\u30a8\u30f3\u30c4\u3001\u30aa\u30fc\u30ca\u30e1\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3(\u88c5\u98fe\u97f3\u6cd5)\u3092\u4f7f\u3063\u3066\u3044\u305f\u3002\n\u30d9\u30fc\u30c8\u30fc\u30f4\u30a7\u30f3\u306f\u30e2\u30c1\u30fc\u30d5\u2022\u30c7\u30a3\u30d9\u30ed\u30d7\u30e1\u30f3\u30c8\u3084\u30d5\u30e9\u30b0\u30e1\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u30b9\u30b1\u30eb\u30c4\u30a9\u3092\u4f7f\u3044\u30e1\u30ed\u30c7\u30a3\u3092\u8003\u3048\u3066\u3044\u305f\u3002",
                    "author": "@gemini-gpt",
                    "likes": 2,
                    "publishedAt": "2026-02-28T13:11:00Z"
                },
                {
                    "text": "\u300c\u81ea\u7136\u306a\u6d41\u308c\u300d\u306f\u975e\u5e38\u306b\u91cd\u8981\u306a\u97f3\u697d\u306e\u8981\u7d20\u306e1\u3064\u3067\u3059\u306d\uff01\u307e\u305f\u305d\u308c\u306b\u5bfe\u3057\u3066\u6211\u3005\u304c\u5927\u307e\u304b\u306b\u5171\u901a\u3057\u305f\u826f\u3057\u60aa\u3057\u306e\u611f\u899a\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u3082\u307e\u305f\u9762\u767d\u3044\u3067\u3059\u3002\n\n\u4eca\u56de\u306f\u300c\u97f3\u9ad8\u300d\u306b\u7126\u70b9\u3092\u7d5e\u3063\u305f\u89e3\u8aac\u3067\u3057\u305f\u304c\u3001\u3068\u3066\u3082\u8151\u306b\u843d\u3061\u308b\u3082\u306e\u3067\u3057\u305f\uff01\uff01\u540c\u3058\u3088\u3046\u306b\u300c\u97f3\u9577\uff08\u97f3\u4fa1\uff09\u300d\u306b\u3082\u300c\u97f3\u9ad8\u300d\u3068\u540c\u3058\u3088\u3046\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u306e\u95a2\u4fc2\uff08\u9ad8\u3044\u3068\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u5927\u304d\u3044\u3001\u9577\u3044\u3068\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u5927\u304d\u3044\uff09\u304c\u3042\u308a\u3001\u30e1\u30ed\u30c7\u30a3\u306f\u305d\u308c\u3089\u3092\u7d44\u307f\u5408\u308f\u305b\u3067\u30a8\u30cd\u30eb\u30ae\u30fc\u306e\u81ea\u7136\u306a\u6d41\u308c\u3092\u4f5c\u308b\u3093\u3060\uff01\u3068\u8003\u3048\u3066\u3044\u308b\u306e\u3067\u3001\u300c\u3082\u3057\u304b\u3057\u305f\u3089\u3001\u97f3\u9577\u3092\u7528\u3044\u308c\u3070\u4eca\u56de\u306e2\u3064\u306e\u30eb\u30fc\u30eb\u3092\u7834\u308b\u3053\u3068\u306f\u51fa\u6765\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u300d\u3068\u601d\u3044\u307e\u3057\u305f\uff01\uff08\u7814\u7a76\u3057\u3066\u307f\u307e\u3059\uff09\n\n\u305d\u308c\u306b\u3057\u3066\u3082\u300c\u30bb\u30f3\u30b9\u30bb\u30f3\u30b9\u300d\u3068\u8a00\u308f\u308c\u308b\u30e1\u30ed\u30c7\u30a3\u3092\u3053\u3053\u307e\u3067\u89e3\u8aac\u3067\u304d\u308b\u30c8\u30a4\u30c9\u30e9\u3055\u3093\u306f\u7d20\u6674\u3089\u3057\u3044\u3067\u3059\uff01\uff01\u672c\u65e5\u3082\u52d5\u753b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\u2728",
                    "author": "@rOttOnPen",
                    "likes": 2,
                    "publishedAt": "2026-02-28T12:07:50Z"
                },
                {
                    "text": "\u30e1\u30ed\u4f5c\u308a\u304c\u82e6\u624b\u3067\u3053\u3046\u3044\u3046\u5185\u5bb9\u3092\u52c9\u5f37\u3057\u3066\u305f\u6642\u671f\u304c\u3042\u3063\u305f\u3051\u3069\u3001\u3046\u3063\u305b\u3047\u308f\u304c\u51fa\u3066\u982d\u58ca\u308c\u3061\u3083\u3063\u305f\u3001\u3001\ud83d\ude02\n\u30e2\u30c1\u30fc\u30d5\u3068\u3057\u3066\u306f\u30a4\u30f3\u30d1\u30af\u30c8\u3042\u308b\u5f62\u3060\u3068\u601d\u3046\u306e\u3067\u5370\u8c61\u306b\u6b8b\u308a\u3084\u3059\u3044\u3093\u3067\u3059\u3051\u3069\u306d\u3001\u3001\u3001",
                    "author": "@y_mzhs",
                    "likes": 0,
                    "publishedAt": "2026-02-28T17:41:57Z"
                },
                {
                    "text": "\u3069\u7d20\u4eba\u3067\u3059\u3002\u30e1\u30ed\u30c7\u30a3\u30fc\u30e9\u30a4\u30f3\u306e\u6574\u3048\u65b9\u3092\u6559\u3048\u3066\u3044\u305f\u3060\u304d\u3001\u982d\u306e\u4e2d\u306e\u30e1\u30ed\u30c7\u30a3\u304c\u6574\u3044\u307e\u3057\u305f\u3002\u98db\u8e8d\u306e\u5148\u306b\u306f\u30d5\u30a9\u30ed\u30fc\u304c\u5fc5\u8981\uff01\u9806\u6b21\u9032\u884c\u3067\u6d41\u308c\u308b\u3088\u3046\u306a\u30e1\u30ed\u30c7\u30a3\u3002\u4ed6\u306e\u30e1\u30ed\u30c7\u30a3\u3092\u53c2\u8003\u306b\u898b\u3055\u305b\u3066\u3044\u305f\u3060\u3044\u3066\u3001\u5b9f\u969b\u306b\u97f3\u3092\u8074\u304d\u8aac\u660e\u3092\u53d7\u3051\u3001\u30b9\u30c3\u30ad\u30ea\u3057\u305f\u611f\u899a\u3092\u899a\u3048\u305f\u3053\u3068\u3068\u540c\u6642\u306b\u3001\u3068\u3066\u3082\u52c9\u5f37\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01<(_ _)>\u3000\u3053\u306e\u52d5\u753b\u3082\u3042\u308b\u610f\u5473\u3001\u4e00\u6b69\u4e00\u6b69\u9032\u3080\u30e1\u30ed\u30c7\u30a3\u306e\u3088\u3046\u306b\u611f\u3058\u307e\u3057\u305f\u3002\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01",
                    "author": "@\u516b\u96f2-d9p",
