                    "publishedAt": "2026-03-24T16:35:17Z"
                },
                {
                    "text": "\ubb50\ub77c\ub294 \uac70\uc57c \ucde8\ubbf8 \ud65c\ub3d9 \ud588\ub0d0",
                    "author": "@\ubbf8\uce5c\uad11\ub300-k2y",
                    "likes": 1,
                    "publishedAt": "2026-03-23T07:23:44Z"
                },
                {
                    "text": "\uc81c\uc774\ud30d\ud558\uba74 \ub418\ub2c8\uae4c \uc0c1\uad00\uc5c6\uc9c0\uc54a\ub098",
                    "author": "@minsuman1170",
                    "likes": 1,
                    "publishedAt": "2026-03-22T07:41:33Z"
                },
                {
                    "text": "\uc1fc\ubbf8\uac00 \ub610 \uc0ac\ub78c\ud55c\uba85 \ub9dd\uccd0\ub1a8\uad70\n\uacbd\ud76c\ub300 \uacf5\ub300 \uc778\ub370",
                    "author": "@\ucd08\uc774\uc368\ub2c8-q2t",
                    "likes": 9,
                    "publishedAt": "2026-03-22T07:15:00Z"
                },
                {
                    "text": "\uc194\uae4c \ub300\ud559\ubc84\ub9ac\uace0 \ud560\uc815\ub3c4\ub85c \ud560\uc218\uc900\uc740 \uc544\ub2cc\uac70\uac19\ub358\ub370",
                    "author": "@\u4ec1\u6587\u61b2\u6b66\u6b3d\u8056\u606d\u5b5d\u5927\u738b",
                    "likes": 5,
                    "publishedAt": "2026-03-22T15:43:53Z"
                }
            ]
        },
        {
            "fetchedAt": "20260409_072313",
            "commentCount": 20,
            "comments": [
                {
                    "text": "Souly \uc568\ubc94 \ubc1c\ub9e4 \uc774\ud6c4 \ub9c8\ube0c\ub77c\ub294 \uc544\ud2f0\uc2a4\ud2b8\uac00 \ub354 \uad81\uae08\ud574\uc838\uc11c, \uadf8\ub54c\ubd80\ud130 \uc778\ud130\ubdf0\ub098 \ub77c\ubc29 \uac19\uc740 \uac83\uae4c\uc9c0\ub3c4 \uccb4\ud06c\ud574\ubd24\uc5c8\ub294\ub370 \uc0dd\uac01\uc774 \ub418\uac8c \uae4a\uace0 \uba4b\uc788\ub294\uc810\ub4e4\uc774 \ub418\uac8c \ub9ce\uc558\uc2b5\ub2c8\ub2e4.\n\uc81c\uac00 \uc7ac\ubc0c\uac8c \ubd24\ub358, \uba4b\uc788\ub294 \ubd80\ubd84\ub4e4\uc744 \uc870\uba85\ud558\ub294 \uc601\uc0c1\uc744 \uba87 \uac1c \ub354 \ub9d0\uc544\uc640\ubcf4\uaca0\uc2b5\ub2c8\ub2e4!",
                    "author": "@\uad6d\ud799\uc815\ub9ac",
                    "likes": 56,
                    "publishedAt": "2026-03-22T02:44:02Z"
                },
                {
                    "text": "\uadf8\ub798\ub3c4 \ud798\ub4e4\uac8c \ub4e4\uc5b4\uac04\uac70 \uc878\uc5c5\uc740 \ud558\ub294\uac8c \ub9de\ub2e4\n\uc790\uba54\uc988\ub3c4 \ud55c\ucc3d \uc798\ub098\uac08\ub54c \ud55c\uc591\ub300 \uacbd\uc601\ud559\uacfc \uc790\ud1f4\ud558\uace0\uc11c \uc778\uc2a4\ud0c0 \uc62c\ub9ac\ub354\ub2c8 \uc2dc\uac04 \uc9c0\ub098\uc11c \ubcf4\ub2c8\uae4c\n\ub2e4\uc2dc \uc7ac\uc785\ud559\ud568\u314b\u314b\u314b1\ub144\ub9cc \ub354 \ub2e4\ub2c8\uba74 \uc878\uc5c5\uc778\ub370 \ube68\ub9ac \uc878\uc5c5\ud574\ubc84\ub9ac\uace0 \uc74c\uc545 \uc81c\ub300\ub85c \uba4b\uc788\uac8c \ud588\uc73c\uba74",
                    "author": "@kardinalodyssey",
                    "likes": 51,
                    "publishedAt": "2026-03-22T22:13:24Z"
                },
                {
                    "text": "\uc1fc\ubbf8\uc5d0\uc11c \uc77c\ucc0d \ub5a8\uc5b4\uc9c4 \ub798\ud37c\ub4e4 ( EK, \ucd5c\uc5d8\ube44, \uc2a4\ubbfc ) \uc774 \ub775\ubc18 \ud558\ub098 \ubf51\uace0 \uc52c\uc5d0\uc11c \uc8fc\ubaa9\uc744 \ubc1b\uace4 \ud558\ub358\ub370 \ub9c8\ube0c\ub3c4 \uc544\ud504\ub85c\ube44\uce20 \uc7a5\ub974 \uaf49 \ucc44\uc6cc\uc11c  \uadf8 \ub8e8\ud2b8 \ud0c0\uae38",
                    "author": "@\ucc3d\ub82c\uc2a4\ub7ec\uc6b4\ud61c\uc790\ub204\ub2d8",
                    "likes": 157,
                    "publishedAt": "2026-03-22T04:19:12Z"
                },
                {
                    "text": "\uce7c\ub9ac\uc9c0 \ub4dc\ub86d\uc544\uc6c3 \uac00\ubcf4\uc790 \uc751\uc6d0\ud55c\ub2e4",
                    "author": "@\uc804\uc9c4-q1f",
                    "likes": 255,
                    "publishedAt": "2026-03-22T05:31:04Z"
                },
                {
                    "text": "\uadfc\ub370 \ub300\ud559\uc740 \ub2e4\ub2c8\uba74\uc11c \ud588\uc73c\uba74...\n\ud799\ud569\uc774 \uc5bc\ub9c8\ub098 \ub354 \uac08\uc9c0\ub3c4 \ubaa8\ub974\ub294\uac70\uace0 \ud799\ud569\uc52c\uc5d0 \ub9c8\ube0c \uc774\uc0c1\uc73c\ub85c \uc798\ud558\ub294 \uc0ac\ub78c\ub4e4\ub3c4 \ub2e4\ub978 \uc77c \ud558\uba74\uc11c \uc0b4\uace0\uc788\uc73c\ub2c8\uae4c. \uc9c0\uc7a1\ub3c4 \uc544\ub2c8\uace0 \uc778\uc11c\uc6b8\uc778\ub370 \uc544\uc27d\uae34\ud558\ub124.",
                    "author": "@00olion",
                    "likes": 545,
                    "publishedAt": "2026-03-22T05:34:09Z"
                },
                {
                    "text": "Sm \ubbf8\ud305 \ud558\ub294 \uc2a4\ud1a0\ub9ac \uc62c\ub77c\uc624\ub358\ub370 \ub871\uc0f7 \ub2e4\uc74c\uc73c\ub85c \ub610 \ub2e4\ub978 \uae30\ud68c\uac00 \uc654\uc744\ub4ef",
                    "author": "@\ud788\uc57c\uce74j4y",
                    "likes": 76,
                    "publishedAt": "2026-03-22T03:07:01Z"
                },
                {
                    "text": "\ub9c8\ube0c\uc57c \ub2e4\ub978\uac74 \ubaa8\ub974\uaca0\uace0 \ub108\ub97c \ubcf4\uba74 \ub0b4\ubaa8\uc2b5\uc744 \ubcf4\ub294\uac70 \uac19\uc544\uc11c \ub354 \uc544\uc27d\ub2e4\u2026. \uba38\ub9ac\ud138 \uad00\ub9ac \uc798\ud574\ub77c\u2026.",
                    "author": "@213mine5",
                    "likes": 7,
                    "publishedAt": "2026-03-22T18:21:21Z"
                },
                {
                    "text": "\uae40\uc9c4\uc9dc \ud558\ub098\ub85c \ub354 \ubcf4\uc5ec\uc904 \ud544\uc694 \uc5c6\uc744 \ub9cc\ud07c \ub2e4 \ubcf4\uc5ec\uc90c\u314b\u3132",
                    "author": "@Osmin09",
                    "likes": 8,
                    "publishedAt": "2026-03-22T06:14:20Z"
                },
                {
                    "text": "\uc544\ub2c8 \uacf5\ubd80\ub3c4\uc798\ud558\ub124 \uae40 \uc9c4\uc9dc",
                    "author": "@YubinAkanmincheol",
                    "likes": 1,
                    "publishedAt": "2026-04-01T13:38:30Z"
                },
                {
                    "text": "\ub9c8\ube0c\uac00 \uc1fc\ubbf8 \ucd5c\ub300 \uc218\ud61c\uc790\uc778\ub4ef",
                    "author": "@leeseongyeop55",
                    "likes": 118,
                    "publishedAt": "2026-03-22T02:46:16Z"
                },
                {
                    "text": "\ud558\ub294 \uac70 \ubcf4\ub2c8\uae50 \uc74c\uc545\uc73c\ub85c \ucda9\ubd84\ud788 \ubc25 \ubc8c\uc5b4\uba39\uace0 \uc0b4 \uac83 \uac19\uc74c \ub0b4 \uc55e\uac00\ub9bc\uc774\ub098 \uc798\ud574\uc57c\uc9c0",
                    "author": "@dkanrjtehdksl",
                    "likes": 3,
                    "publishedAt": "2026-03-24T07:53:04Z"
                },
                {
                    "text": "\ud799\ud569\ud558\ub294 \uc0ac\ub78c\uc774 \uc0ac\ud68c\uc131\uc744 \ub17c\ud574? \ub10c \uc880 \uae30\ub300\ub97c \ubc1b\uc790",
                    "author": "@Aksqpp",
                    "likes": 16,
                    "publishedAt": "2026-03-22T07:25:43Z"
                },
                {
