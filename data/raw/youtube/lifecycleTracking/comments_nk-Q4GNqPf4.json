                    "likes": 2,
                    "publishedAt": "2026-03-22T09:28:54Z"
                },
                {
                    "text": "\ud799\ud569\ud558\ub294 \uc0ac\ub78c\uc774 \uc0ac\ud68c\uc131\uc744 \ub17c\ud574? \ub10c \uc880 \uae30\ub300\ub97c \ubc1b\uc790",
