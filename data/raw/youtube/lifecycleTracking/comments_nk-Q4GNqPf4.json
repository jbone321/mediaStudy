                    "likes": 4,
                    "publishedAt": "2026-03-22T09:28:54Z"
                },
                {
                    "text": "\uc544\ub2c8 \uc800\uac70 \ud734\ud559\ud55c\ub2e4\ub294\uac70\uc5d0\uc5ec \ub2e4\ub4e4 \uc664\ucf00 \ub2e4 \uc624\ud574\ud558\uace0 \ub4e4\uc74c",
