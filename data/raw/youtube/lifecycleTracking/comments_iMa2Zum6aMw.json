            "comments": [
                {
                    "text": "\u0631\u0627\u062d \u064a\u0639\u062a\u0631\u0641\u0644\u0647\u0627 \u0628\u0628\u062d\u0628\u0648 \u0648\u062a\u062c\u064a \u0645\u0648\u0646\u0643\u0627 \u0648\u062a\u062a\u0642\u0631\u0628 \u0645\u0646 \u0627\u062a\u064a\u0634 \u0648\u0645\u0631\u062c\u0627\u0646 \u062a\u063a\u0627\u0631 \u0639\u0644 \u0627\u062a\u064a\u0634 \u0648\u062a\u062c\u064a \u0645\u0631\u062c\u0627\u0646 \u062a\u0627\u062a\u062c\u064a \u062a\u0633\u0627\u0641\u0631 \u0645\u0646 \u063a\u064a\u0631\u062a\u0647\u0627 \u0639\u0644 \u0627\u062a\u064a\u0634 \u0648\u0627\u062a\u064a\u0634 \u064a\u0645\u0646\u0639\u0647\u0627 \u0648\u0645\u0631\u062c\u0627\u0646 \u062a\u0639\u062a\u0631\u0641 \u0628\u062d\u0628\u0647\u0627 \u0644\u0627\u062a\u064a\u0634 \u0627\u0631\u0641\u0639\u0648 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0645\u0634\u0627\u0646 \u0627\u0644\u0643\u0644 \u064a\u0634\u0648\u0641\u0648 \ud83d\ude02",
                    "author": "@\u0627\u0628\u0648\u062c\u0627\u0646\u062a\u064a-\u06312\u062a",
                    "likes": 73,
                    "publishedAt": "2026-04-20T18:31:04Z"
                },
                {
                    "text": "\u0644\u0643 \u0648\u0627\u0644\u0644\u0647 \u0643\u0631\u0647\u062a\u0648\u0646\u0627 \u0627\u0644\u0645\u0633\u0644\u0633\u0644 \u0639 \u0642\u062f \u0645\u0627 \u0628\u062a\u062a\u0623\u062e\u0631\u0648 \u0628\u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u062d\u0644\u0642\u0629 \u062d\u062a\u0649 \u0639\u0645 \u0646\u0646\u0633\u0649 \u0634\u0648 \u0635\u0627\u0631 \u0628\u0627\u062e\u0631 \u062d\u0644\u0642\u0629 \u0634\u0641\u0646\u0627\u0647\u0627 \u0648\u0627\u0644\u0644\u0647 \ud83d\ude02\u2728\ud83d\ude2d",
                    "author": "@elhamelham25584",
                    "likes": 11,
                    "publishedAt": "2026-04-23T19:38:14Z"
                },
                {
                    "text": "\u0643\u0644 \u0645\u0627\u062c\u0627\u0646\u064a \u0627\u0634\u0639\u0627\u0631  \u0627\u0639\u0631\u0641 \u0627\u0646\u0643 \u0635\u0644\u064a\u062a \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064a\ud83d\udc99",
                    "author": "@\u0647\u0627\u0646\u064a-\u06469\u0642",
                    "likes": 23,
                    "publishedAt": "2026-04-21T16:55:58Z"
                },
                {
                    "text": "\u062d\u0627\u0644\u064a\u0627 \u0639\u0645\u0631\u064a 0\u0643\u0644 \u0645\u0627 \u062a\u062e\u0644\u064a \u0644\u0627\u064a\u0643 \u064a\u0632\u064a\u062f \u0639\u0645\u0631\u064a\ud83d\ude02\u2764",
                    "author": "@3jj.i",
                    "likes": 3,
                    "publishedAt": "2026-04-24T14:39:22Z"
                },
                {
                    "text": "\u0639\u0646\u062c\u062f \u0645\u0627\u0628\u064a\u0646 \u062a\u0646\u0632\u0644 \u0627\u0644\u062d\u0644\u0642\u0647 \u0627\u0644\u0627 \u0646\u0643\u0648\u0646 \u0646\u0633\u064a\u064a\u0627\u0646\u064a\u064a\u0646 \u0627\u0644\u064a \u0642\u0628\u0644\u0647\u0627 \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u0645\u0646\u0627\u0644\u0627\u0644\u0639\u0628\u0627\u0633-\u06456\u0647",
                    "likes": 7,
                    "publishedAt": "2026-04-24T14:41:05Z"
                },
                {
                    "text": "\u064a\u0639\u0646\u064a \u0627\u0644\u0645\u0633\u0644\u0633\u0644 \u0628\u062f\u0647\u0645 \u064a\u0628\u0644\u0634\u0648  \u0628\u062c\u0632\u0621 \u0627\u0644\u062a\u0627\u0646\u064a \u0648 \u062d\u0646\u0627 \u0644\u0633\u0627 \u0628\u062d\u0644\u0642\u0647 36\u0645\u0646 \u0634\u0627\u0646 \u0627\u0644\u0644\u0647 \u064a\u062e\u0648\u0627\u0646",
                    "author": "@\u0627\u062d\u0645\u062f\u062a\u0639\u0645\u0631\u064a-\u06302\u0637",
                    "likes": 23,
                    "publishedAt": "2026-04-21T09:41:32Z"
                },
                {
                    "text": "\u0646\u0634\u0641 \u062f\u0645 \u0627\u0644\u0648\u0627\u062d\u062f \u0647\u0648\u0627 \u0628\u062d\u0643\u064a \u0628\u062f\u0646\u0627 \u0627\u0644\u062d\u0644\u0642\u0647 36 \ud83e\udd79",
                    "author": "@\u0632\u0647\u0648\u0631\u062e\u0627\u0644\u062f-\u06361\u063a",
                    "likes": 4,
                    "publishedAt": "2026-04-23T13:15:14Z"
                },
                {
                    "text": "\u0648\u0627\u0644\u0644\u0647 \u0643\u062a\u064a\u0631 \u0632\u0648\u062f\u0648\u0647\u0627 \u0635\u0627\u0631\u0644\u0648 \u064a\u0646\u0632\u0644\u0648 \u0643\u0644 \u0627\u0633\u0628\u0648\u0639 \u062d\u0644\u0642\u0647 \u0627\u0648 \u062d\u0644\u0642\u062a\u064a\u0646 \u062c\u062f \u0635\u0627\u0631 \u0642\u0631\u0641 \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0648\u0628\u0637\u0644\u062a \u0627\u062d\u0636\u0631\u0648 \u0632\u064a \u0642\u0628\u0644 \u0644\u0627\u0646\u064a \u0628\u0632\u0647\u0642 \u0648\u0627\u0646\u0627 \u0628\u0633\u062a\u0646\u0649 \u0645\u0634 \u0637\u0628\u064a\u0639\u064a \u0635\u0631\u0627\u062d\u0647!!!",
                    "author": "@RateelAbusaleh",
                    "likes": 6,
                    "publishedAt": "2026-04-22T17:23:30Z"
                },
                {
                    "text": "36\u0645\u0633\u0644\u0633\u0644 \u062a\u0631\u0643\u064a \u0645\u0631\u062c\u0646 \u0645\u062f\u0628\u0644\u062c \u0639\u0631\u0628\u064a \u0643\u0645\u0644 \u0637\u0644\u062d\u0648\u0644\u064a \u0644\u0644\u064a\u0644 \u0631\u062c\u0627\u0627\u0646 \u0637\u0644\u0628 \u0645\u0646\u0643 \u0642\u0646\u0627\u0629 \u0627\u0631\u0627\u0641\u062a \u2764\u2764\u2764\u2764",
                    "author": "@\u0639\u0644\u064a\u062d\u0633\u064a\u0646-\u06452\u062b3\u0637",
                    "likes": 4,
                    "publishedAt": "2026-04-20T16:44:14Z"
                },
                {
                    "text": "\u0646\u0631\u064a\u062f \u0627\u0644\u062d\u0644\u0642\u0629 36 \u0645\u062f\u0628\u0644\u062c\u0629 \u0648\u0643\u0627\u0645\u0644\u0629",
                    "author": "@HarounHaroun-v5f",
                    "likes": 8,
                    "publishedAt": "2026-04-21T18:24:48Z"
                },
                {
                    "text": "\u0646\u0631\u064a\u062f \u0627\u0644\u062d\u0644\u0642\u0647 \u0645\u062f\u0628\u0644\u062c\u0647 \u0648\u0643\u0627\u0645\u0644\u0647 36\ud83d\ude22\ud83d\ude22\ud83d\ude22",
                    "author": "@\u0632\u064a\u0646\u0628\u0631\u0633\u0648\u0644\u0631\u0633\u0648\u0644-\u06344\u0642",
                    "likes": 10,
                    "publishedAt": "2026-04-21T16:39:44Z"
                },
                {
                    "text": "\u0645\u0645\u0643\u0646 \u0646\u062a\u0632\u0644\u0648 \u0627\u0644\u062d\u0644\u0642\u0647 \u0641\u0648\u0631\u0627\u064b \u0641\u064a \u0627\u0633\u0631\u0639 \u0648\u0642\u062a \u0648\u0644\u0647 \u0646\u063a\u0644\u064a \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643",
                    "author": "@MohammedALeraqi-k1d",
                    "likes": 4,
                    "publishedAt": "2026-04-20T16:28:51Z"
                },
                {
                    "text": "\u0628\u062a\u0639\u0631\u0641\u0648\u0627  \u0634\u0648  \u0627\u0631\u0641\u0639\u0648 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0639\u0634\u0627\u0646 \u0643\u062f\u0627 \u0645\u0634 \u0647\u064a\u0646\u0632\u0644\u0648\u0647\u0627  \u062e\u0627\u0644\u0635  \u0634\u0648\u064a\u0647 \u0643\u0645\u0627\u0646 \u0648\u0647\u064a\u0642\u0648\u0644\u0648\u0627 \u062d\u0644\u0642\u0647 \u0648\u0627\u062d\u062f\u0647 \u0641\u064a \u0627\u0644\u0627\u0633\u0628\u0648\u0639",
                    "author": "@\u0623\u0633\u0645\u0627\u0621\u0639\u0627\u062f\u0644-\u06437\u0635",
                    "likes": 7,
                    "publishedAt": "2026-04-21T21:54:14Z"
                },
                {
                    "text": "\u0637\u064a\u0628 \u0645\u062a\u0627\u0621 \u0628\u064a\u0646\u0632\u0644\u0648 \u0628\u0642\u064a\u062a \u0627\u0644\u062d\u0644\u0642\u0627\u062a  \u0644\u0646\u0627 \u0627\u0643\u062b\u0631 \u0645\u0646 \u0627\u0633\u0628\u0648\u0639  \u0646\u0633\u062a\u0646\u064a\u0647\u0645",
                    "author": "@AhmedMohammed-q7x7d",
                    "likes": 3,
                    "publishedAt": "2026-04-23T20:11:00Z"
                },
                {
                    "text": "\u0627\u064a \u0648\u0627\u0644\u0644\u0647 \u0634\u0648 \u0647\u0630\u0643\u0627\u0621 \u0644\u0633\u0629 \u062a\u0642\u0637\u064a\u0631 \u0639\u0645 \u064a\u0639\u0631\u0636\u0648 \u0644\u062d\u0644\u0642\u0627\u062a \ud83d\ude2e\ud83d\ude2e\ud83d\ude2e",
                    "author": "@\u0645\u062d\u0645\u062f\u0645\u062d\u0645\u062f-\u062c7\u0641",
                    "likes": 2,
                    "publishedAt": "2026-04-24T10:54:55Z"
                },
                {
                    "text": "\u0645\u062a\u0649 \u062a\u0646\u0632\u0644 \u0627\u0644\u062d\u0644\u0642\u0647 36\u0633\u0624\u0627\u0644 \u0627\u062a\u064a\u0634 \u0628\u0623\u062e\u0631 \u0627\u0644\u0645\u0633\u0644\u0633\u0644 \u0647\u064a\u0645\u0648\u062a \ud83d\ude22\u0648\u0643\u0645 \u062d\u0644\u0642\u0647 \u0627\u0644\u0645\u0633\u0644\u0633\u0644 \u0643\u0644\u0648",
                    "author": "@AHmD-ne1rj",
                    "likes": 2,
                    "publishedAt": "2026-04-24T14:11:32Z"
                },
                {
                    "text": "\u0627\u0644\u0645\u0641\u0631\u0648\u0636 \u0628\u0642\u064a \u062a\u0646\u0632\u0644\u0648\u0627 \u062d\u0644\u0642\u062a\u064a\u0646",
                    "author": "@\u0623\u0633\u0645\u0627\u0621\u0639\u0627\u062f\u0644-\u06437\u0635",
                    "likes": 4,
                    "publishedAt": "2026-04-23T11:46:18Z"
                },
                {
                    "text": "\u0627\u0635\u0644\u0627 \u0643\u062f\u0627 \u0647\u0633\u062a\u0646\u064a \u0628\u0639\u062f \u062a\u0644\u0627\u062a \u0627\u064a\u0627\u0645 \u0627\u0631\u0628\u0639\u0647 \u0648\u0639\u0634\u0631\u064a\u0646 \u0627\u0631\u0628\u0639\u0647 \u0643\u062f\u0627 \u0643\u062a\u064a\u0631 \u0639\u0644\u064a\u0627 \u0648\u0627\u0644\u0644\u0647 \u0639\u0646\u062f\u064a \u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a \u0639\u0627\u064a\u0632\u0647 \u0627\u0633\u0645\u0639\u0647\u0645 \u0645\u0631\u0647 \u0648\u0627\u062d\u062f\u0647 \u2764\ud83d\ude22",
                    "author": "@\u0623\u0633\u0645\u0627\u0621\u0639\u0627\u062f\u0644-\u06437\u0635",
                    "likes": 3,
                    "publishedAt": "2026-04-21T08:21:02Z"
                },
                {
                    "text": "\u0647\u064a\u0647 \u0645\u0648 \u0627\u0631\u0628\u0639\u0627\u0621 \u062a\u0646\u0632\u0644 \u0644\u064a\u0634 \u0643\u0627\u062a\u0628\u064a\u0646 \u0628\u0639\u062f \u064a\u0648\u0645\u064a\u0646 \n\u0628\u0627\u062c\u0631 \u0627\u0631\u0628\u0639\u0627\u0621 \n\u0628\u0639\u062f \u064a\u0648\u0645 \u0648\u0644\u064a\u0633 \u064a\u0648\u0645\u064a\u0646 \ud83d\ude2e\ud83d\ude22\u2764",
                    "author": "@\u0627\u064a\u0647\u0627\u0644\u0631\u0643\u0627\u0628\u064a-\u06449\u0633",
                    "likes": 7,
                    "publishedAt": "2026-04-21T15:08:26Z"
                },
                {
                    "text": "\u064a\u0634\u0627\u0631 \u0628\u064a\u0636\u062d\u0643 \ud83d\ude02\ud83d\ude02\ud83d\ude02",
                    "author": "@\u062d\u0633\u0646\u0628\u0627\u0644\u062d\u0648\u0633",
                    "likes": 0,
                    "publishedAt": "2026-04-24T15:41:31Z"
                },
                {
                    "text": "\u062d\u0644\u0642\u0629 36 \u0628\u0633\u0631\u0639\u0629 \ud83d\ude22\ud83d\ude22",
                    "author": "@BouchraTaoutaou",
                    "likes": 3,
